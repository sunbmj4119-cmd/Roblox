---------------------------------------------------------------------------
-- objective logic
---------------------------------------------------------------------------
-- ☄️ what the meteor of this round wants from us (nil when there is none)
local function meteorGoal(data): string?
	local state = workspace:GetAttribute("MeteorState")
	local site = workspace:GetAttribute("MeteorSiteZone") or 0
	local siteName = workspace:GetAttribute("MeteorSite") or ""
	local kind = workspace:GetAttribute("MeteorKind") or ""
	if state == "Warning" or state == "Falling" then
		if site > data.ZoneLevel then
			return T("☄️ A %s is falling on %s (locked for you) - mine and get ready!", kind, siteName)
		end
		return T("☄️ A %s is falling on %s - run there!", kind, siteName)
	elseif state == "Active" and site <= data.ZoneLevel then
		return T("☄️ Smash the meteor with everyone - top 3 get the best egg!")
	end
	return nil
end

local function nextGoal(data, derived): string
	if player:GetAttribute("Carrying") then
		return T("Run home 🏠 with the egg - don't get bonked!")
	end
	local meteor = meteorGoal(data)
	if meteor then
		return meteor
	end
	-- a star egg on the ground we can reach?
	local map = workspace:FindFirstChild("Map")
	local stars = map and map:FindFirstChild("Shards")
	if stars then
		for _, model in stars:GetChildren() do
			local hitbox = model:FindFirstChild("Hitbox")
			local zone = hitbox and hitbox:IsA("BasePart") and Util.ZoneAt(Config, hitbox.Position)
			if zone and zone <= data.ZoneLevel and model:GetAttribute("Stolen") ~= true then
				return T("Grab a star egg 🥚 - carry it home and it hatches!")
			end
		end
	end
	local pets = #data.Pets
	if pets == 0 then
		return T("Wait for the next meteor ☄️ - its star eggs become your pets!")
	end
	local bank = player:GetAttribute("BaseBank") or 0
	if bank >= math.max(100, data.Coins * 0.25) then
		return T("Collect 💰%s at your base 🏠", Util.Format(bank))
	end
	local pedestals = 0
	for _, item in data.Base and data.Base.Items or {} do
		local def = Config.Decor[item.Id]
		if def and (def.Function == "Pedestal" or def.Function == "Vault") then
			pedestals += 1
		end
	end
	if pets < pedestals and data.Coins >= Config.Eggs.Meadow.Price then
		return T("You have empty pedestals - hatch more pets 🥚")
	end
	local pick = Config.Pickaxes[data.PickaxeTier + 1]
	local zone = Config.Zones[data.ZoneLevel + 1]
	if data.Coins >= (derived.RebirthCost or math.huge) then
		return T("You can REBIRTH for a permanent coin boost!")
	end
	if zone and data.Coins >= zone.Cost then
		return T("Unlock %s at the gate!", zone.Name)
	end
	if pick and data.Coins >= pick.Cost then
		return T("Buy the %s!", pick.Name)
	end
	local cheapest = math.huge
	for _, cost in { pick and pick.Cost, zone and zone.Cost } do
		if cost then
			cheapest = math.min(cheapest, cost)
		end
	end
	if cheapest < math.huge then
		return T("Mine until the next meteor: %s / %s coins for an upgrade", Util.Format(data.Coins), Util.Format(cheapest))
	end
	return T("Climb the weekly ☄️ meteor hunter leaderboard!")
end

-- returns text, progress (0-1 or nil)
local function currentObjective(data, derived)
	local tutorial = data.Tutorial
	if tutorial and not tutorial.Done then
		local steps = Config.Tutorial.Steps
		local step = steps[tutorial.Step]
		if step then
			-- a real meteor beats the tutorial's "mine" steps: go join it
			if step.Id == "Mine" or step.Id == "Pickaxe" then
				local meteor = meteorGoal(data)
				if meteor then
					return "🎯 " .. meteor, nil
				end
			end
			local text = T(step.Text)
			local progress = tutorial.Progress / step.Target
			local nextPick = Config.Pickaxes[(data.PickaxeTier or 1) + 1]
			if step.Id == "Mine" then
				text = string.format("%s  (%d/%d)", text, tutorial.Progress, step.Target)
			elseif step.Id == "Pickaxe" and nextPick and data.Coins < nextPick.Cost then
				text = T("Mine ore until you have %s coins", Util.Format(nextPick.Cost))
				progress = data.Coins / nextPick.Cost
			elseif step.Id == "Hatch" and data.Coins < Config.Eggs.Meadow.Price then
				text = T("Mine ore until you have %s coins", Util.Format(Config.Eggs.Meadow.Price))
				progress = data.Coins / Config.Eggs.Meadow.Price
			elseif step.Id == "Shard" and player:GetAttribute("Carrying") then
				text = T("Run home 🏠 with the egg - don't get bonked!")
			end
			return string.format("📘 %d/%d  %s", tutorial.Step, #steps, text), progress
		end
	end
	return "🎯 " .. nextGoal(data, derived), nil
end
HUD.CurrentObjective = currentObjective

---------------------------------------------------------------------------
-- badge helpers
---------------------------------------------------------------------------
local function anyQuestClaimable(data): boolean
	if data.Daily.LastClaimDay ~= (State.Derived.Today or -1) then
		return true
	end
	for _, quest in data.Daily.Quests do
		for _, def in Config.Quests do
			if def.Id == quest.Id and not quest.Claimed and quest.Progress >= def.Target then
				return true
			end
		end
	end
	return false
end

local function anyTierClaimable(data): boolean
	local tier = math.min(#Config.SeasonTiers, math.floor(data.Season.XP / Config.Season.XPPerTier))
	for t = 1, tier do
		if not data.Season.ClaimedFree[tostring(t)] then
			return true
		end
		if data.Season.Premium and not data.Season.ClaimedPremium[tostring(t)] then
			return true
		end
	end
	return false
end

local function anyGiftClaimable(derived): boolean
	local claimed = {}
	for _, index in derived.GiftsClaimed or {} do
		claimed[index] = true
	end
	local elapsed = State.Now() - (derived.SessionStart or State.Now())
	for i, gift in Config.PlaytimeGifts do
		if not claimed[i] and elapsed >= gift.Minutes * 60 then
			return true
		end
	end
	return false
end

function HUD.RewardsReady()
	local data, derived = State.Data, State.Derived
	if not data or not derived then
		return {}
	end
	return {
		Quests = anyQuestClaimable(data),
		Gifts = anyGiftClaimable(derived),
		Spin = (data.FreeSpinAt or 0) <= State.Now(),
	}
end

---------------------------------------------------------------------------
-- refresh
---------------------------------------------------------------------------
local lastCoins = nil
local coinValue = Instance.new("NumberValue")
coinValue.Changed:Connect(function(value)
	coinLabel.Text = Util.Format(math.floor(value))
end)
local eventDefs = {}
for _, def in Config.Events.List do
	eventDefs[def.Id] = def
end
local revealed = {}
local firstRefresh = true

function HUD.Refresh()
	local data, derived = State.Data, State.Derived
	if not data then
		return
	end
	-- money (numbers roll up instead of jumping)
	if lastCoins == nil then
		coinValue.Value = data.Coins
	elseif data.Coins ~= lastCoins then
		TweenService:Create(coinValue, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = data.Coins }):Play()
		if data.Coins > lastCoins then
			Lib.Pop(coinPill)
		end
	end
	lastCoins = data.Coins
	gemLabel.Text = Util.Format(data.Gems)
	dustLabel.Text = Util.Format(data.Stardust)
	dustPill.Visible = data.Stardust > 0

	local need = derived.XPNeeded or 1
	levelBadge.Text = "Lv." .. (data.Level or 1)
	setLevel((data.XP or 0) / need, string.format("%s / %s XP", Util.Format(data.XP or 0), Util.Format(need)))

	-- objective
	local text, progress = currentObjective(data, derived)
	if objectiveText.Text ~= text and not firstRefresh then
		Lib.Pop(objective)
	end
	objectiveText.Text = text
	objectiveFill.Visible = progress ~= nil
	if progress then
		objectiveFill.Size = UDim2.new(math.clamp(progress, 0, 1), -24, 0, 5)
	end

	-- menu reveal
	for _, item in MENU do
		local id = item[1]
		local show = item[5](data, derived) == true
		local button = menuButtons[id]
		if show and not revealed[id] then
			revealed[id] = true
			button.Visible = true
			if not firstRefresh then
				Lib.Pop(button)
				HUD.Toast(T("New menu unlocked: %s", item[3]), C.Gold)
			end
		elseif not show and revealed[id] then
			revealed[id] = nil
			button.Visible = false
		end
	end
	firstRefresh = false
	local ready = HUD.RewardsReady()
	badges.Rewards.Visible = ready.Quests or ready.Gifts or ready.Spin
	badges.Pass.Visible = anyTierClaimable(data)
	badges.Rebirth.Visible = data.Coins >= (derived.RebirthCost or math.huge)
	-- 📖 an index milestone is ready to claim
	local indexReady = false
	local found = Util.IndexCount(data)
	for i, milestone in Config.Index.Milestones do
		if found >= milestone.Count and not (data.IndexClaimed or {})[tostring(i)] then
			indexReady = true
		end
	end
	badges.Index.Visible = indexReady
	local hiddenBadge = false
	for id, badge in badges do
		if not PRIMARY[id] and id ~= "More" and badge.Visible and menuButtons[id].Visible then
			hiddenBadge = true
		end
	end
	badges.More.Visible = hiddenBadge and not moreMenu.Visible
	-- the objective moves out of the way once the tutorial is done
	local onTop = not tutorialDone(data)
	if onTop ~= objectiveOnTop then
		objectiveOnTop = onTop
		objective.Parent = if onTop then objectiveCluster else objectiveSlot
		layoutTop()
	end
	objectiveSlot.Visible = not onTop

	-- server event chip
	local eventId = workspace:GetAttribute("EventId")
	local eventDef = type(eventId) == "string" and eventDefs[eventId]
	local eventLeft = (workspace:GetAttribute("EventEnd") or 0) - State.Now()
	eventChip.Visible = eventDef ~= nil and eventLeft > 0
	if eventChip.Visible and eventDef then
		eventTitle.Text = T(eventDef.Name) .. "  " .. Util.FormatTime(eventLeft)
		eventTitle.TextColor3 = eventDef.Color
		eventDesc.Text = T(eventDef.Description)
		eventChip:FindFirstChildOfClass("UIStroke").Color = eventDef.Color
	end

	-- rank in this server
	local sr = derived.ServerRank
	rankChip.Visible = type(sr) == "table" and (sr.Count or 0) >= 2
	if rankChip.Visible then
		rankTitle.Text = T("🏆 #%d of %d in server", sr.Place, sr.Count)
		rankSub.Text = if sr.NextName
			then T("+%s pts to pass %s", Util.Comma(sr.NextGap or 0), sr.NextName)
			else T("You're #1 here - defend it!")
	end

	for key, row in boostRows do
		local remaining
		if key == "ServerLuck" then
			remaining = (workspace:GetAttribute("Server_ServerLuck") or 0) - State.Now()
		else
			remaining = State.BoostRemaining(key)
		end
		row.Row.Visible = remaining > 0
		if remaining > 0 then
			local name = if key == "ServerLuck" then T("🌟 Server Luck") else row.Name
			row.Label.Text = name .. "  " .. Util.FormatTime(remaining)
		end
	end

	-- bottom buttons only after the tutorial
	local done = tutorialDone(data)
	autoButton.Visible = done and State.HasPass("AutoMine")
	if State.HasPass("AutoMine") then
		Lib.SetButton(autoButton, if State.AutoMine then "🤖 AUTO: ON" else "🤖 AUTO: OFF", if State.AutoMine then C.Green else C.Gray)
	else
		Lib.SetButton(autoButton, "🤖 AUTO 🔒", C.Gray)
	end
	local remainingOffer = data.FirstJoin + Config.StarterPack.OfferHours * 3600 - State.Now()
	starterButton.Visible = done and not data.Flags.StarterPack and remainingOffer > 0
	if starterButton.Visible then
		Lib.SetButton(starterButton, "🎁 " .. T("STARTER PACK") .. " " .. Util.FormatTime(remainingOffer), C.Pink)
	end
end

---------------------------------------------------------------------------
-- effects
---------------------------------------------------------------------------
local function flyCoins(amount: number)
	local inset = GuiService:GetGuiInset()
	local target = coinPill.AbsolutePosition + coinPill.AbsoluteSize / 2 + inset
	local camera = workspace.CurrentCamera
	local center = if camera then camera.ViewportSize / 2 else Vector2.new(640, 380)
	local n = math.clamp(math.floor(math.log10(math.max(10, amount)) * 2), 3, 12)
	for i = 1, n do
		local icon = Lib.Text({
			Text = "💰",
			Size = UDim2.fromOffset(34, 34),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X + math.random(-80, 80), center.Y + math.random(-60, 60)),
			MaxTextSize = 30,
			Outline = false,
			ZIndex = 60,
			Parent = Root.Overlay,
		})
		task.delay(i * 0.04, function()
			local tween = TweenService:Create(icon, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromOffset(target.X, target.Y),
			})
			tween:Play()
			tween.Completed:Once(function()
				icon:Destroy()
				Lib.PlaySound("Coin", 0.35, i * 0.04)
			end)
		end)
	end
end

local function confetti()
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 760)
	local colors = { C.Gold, C.Pink, C.Cyan, C.Green, C.Purple }
	for _ = 1, 36 do
		local piece = New("Frame", {
			BackgroundColor3 = colors[math.random(1, #colors)],
			Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 22)),
			Position = UDim2.fromOffset(size.X / 2, size.Y * 0.4),
			Rotation = math.random(0, 360),
			ZIndex = 70,
			Parent = Root.Overlay,
		}, { Lib.Corner(3) })
		TweenService:Create(piece, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(size.X / 2 + math.random(-450, 450), size.Y * 0.4 + math.random(-250, 350)),
			Rotation = piece.Rotation + math.random(-360, 360),
			BackgroundTransparency = 1,
		}):Play()
		task.delay(1.5, function()
			piece:Destroy()
		end)
	end
end

local celebration = Root.Cluster("Celebration", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.36), UDim2.fromOffset(560, 120), Root.Overlay)
local celebrationTitle =
	Lib.Text({ Text = "", TextColor3 = C.Gold, Size = UDim2.fromScale(1, 0.62), MaxTextSize = 60, Visible = false, Parent = celebration })
local celebrationSub = Lib.Text({
	Text = "",
	Size = UDim2.fromScale(1, 0.34),
	Position = UDim2.fromScale(0, 0.64),
	MaxTextSize = 28,
	Visible = false,
	Parent = celebration,
})
local celebrationToken = 0
local function celebrate(title: string, sub: string, color: Color3, withConfetti: boolean?)
	celebrationToken += 1
	local token = celebrationToken
	celebrationTitle.Text = title
	celebrationTitle.TextColor3 = color
	celebrationSub.Text = sub
	celebrationTitle.Visible = true
	celebrationSub.Visible = true
	Lib.Pop(celebrationTitle)
	if withConfetti ~= false then
		confetti()
	end
	task.delay(2.4, function()
		if token == celebrationToken then
			celebrationTitle.Visible = false
			celebrationSub.Visible = false
		end
	end)
end
HUD.Celebrate = celebrate

-- new pets fly into the 🐾 Pets button (+N badge until you open it), with a
-- one-line summary of where they went
State.NewPets = State.NewPets or {} -- [petId] = true (NEW tags in the Pets panel)
local newPetCount = 0
local petsBadgeText = badges.Pets and badges.Pets:FindFirstChildWhichIsA("TextLabel")
local function refreshPetsBadge()
	if badges.Pets then
		badges.Pets.Visible = newPetCount > 0
		if petsBadgeText then
			petsBadgeText.Text = if newPetCount > 9 then "9+" else tostring(newPetCount)
		end
	end
end
local PLACE_ICONS = { Vault = "🔒", Display = "🏠", Storage = "📦", Sold = "💰" }
function HUD.PetsLanded(entries)
	local button = menuButtons.Pets
	local targetGui = if button and button.Visible then button else coinPill
	local inset = GuiService:GetGuiInset()
	local target = targetGui.AbsolutePosition + targetGui.AbsoluteSize / 2 + inset
	local camera = workspace.CurrentCamera
	local center = if camera then camera.ViewportSize / 2 else Vector2.new(640, 380)
	local counts = { Vault = 0, Display = 0, Storage = 0, Sold = 0 }
	for i, entry in entries do
		local where = entry.Where or "Storage"
		counts[where] = (counts[where] or 0) + 1
		if entry.Id and where ~= "Sold" then
			State.NewPets[entry.Id] = true
		end
		local icon = Lib.Text({
			Text = PLACE_ICONS[where] or "🐾",
			Size = UDim2.fromOffset(46, 46),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X + (i - (#entries + 1) / 2) * 70, center.Y),
			MaxTextSize = 40,
			Outline = false,
			ZIndex = 60,
			Parent = Root.Overlay,
		})
		task.delay((i - 1) * 0.12, function()
			Lib.PlaySound("Fly", 0.8, (i - 1) * 0.05)
			local tween = TweenService:Create(icon, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromOffset(target.X, target.Y),
				Size = UDim2.fromOffset(20, 20),
			})
			tween:Play()
			tween.Completed:Once(function()
				icon:Destroy()
				Lib.PlaySound(if where == "Sold" then "CoinBig" else "Store", 0.8)
				Lib.Pop(targetGui)
				if where ~= "Sold" then
					newPetCount += 1
					refreshPetsBadge()
				end
			end)
		end)
	end
	-- "where did they go?" in one short line
	local parts = {}
	if counts.Vault > 0 then
		table.insert(parts, T("🔒 vault %d", counts.Vault))
	end
	if counts.Display > 0 then
		table.insert(parts, T("🏠 display %d", counts.Display))
	end
	if counts.Storage > 0 then
		table.insert(parts, T("📦 storage %d", counts.Storage))
	end
	if counts.Sold > 0 then
		table.insert(parts, T("💰 sold %d", counts.Sold))
	end
	if #parts > 0 then
		HUD.Toast(T("🐾 Your new pets: %s", table.concat(parts, "  •  ")), Color3.fromRGB(150, 230, 160))
	end
end
-- opening the Pets panel clears the +N badge (NEW tags clear when it closes)
task.spawn(function()
	local wasOpen = false
	while true do
		task.wait(0.5)
		local open = Panels.Current == "Pets"
		if open and newPetCount > 0 then
			newPetCount = 0
			refreshPetsBadge()
		end
		if wasOpen and not open then
			State.NewPets = {}
		end
		wasOpen = open
	end
end)
HUD.FlyCoins = flyCoins

---------------------------------------------------------------------------
-- server messages
---------------------------------------------------------------------------
Net.On("Notify", function(text, color)
	HUD.Toast(text, color)
end)
Net.On("Announce", function(text, color)
	HUD.Announce(text, color)
end)
Net.On("Reward", function(text, source)
	HUD.Toast("🎁 " .. (if source then source .. ": " else "") .. text, C.Gold)
	Lib.PlaySound("Reward")
end)
-- coins granted all at once (coin crate purchase)
Net.On("Sold", function(coins)
	Lib.PlaySound("Coin")
	flyCoins(coins)
end)
-- egg shops restocked (the banner comes from the server announcement)
Net.On("Restock", function()
	Lib.PlaySound("Event", 0.6)
	if Panels.Current == "Egg" then
		Panels.RefreshCurrent()
	end
end)
Net.On("LevelUp", function(level, gems)
	Lib.PlaySound("LevelUp")
	celebrate(T("⭐ LEVEL %s!", tostring(level)), T("+%s 💎  •  +2%% coins forever", tostring(gems)), C.Gold)
end)
Net.On("RankUp", function(rankName)
	Lib.PlaySound("RankUp")
	celebrate(T("🏅 %s RANK!", tostring(rankName)), T("Weekly ranked - keep climbing!"), C.Cyan)
end)
-- 🌱 pets growing up / ⭐ evolving
Net.On("PetLevelUp", function(ups)
	if type(ups) ~= "table" or #ups == 0 then
		return
	end
	local grew = nil
	local names = {}
	for _, up in ups do
		if type(up) == "table" then
			if up.Grew then
				grew = up
			end
			table.insert(names, T(up.Name) .. " " .. Util.PetBadge(Config, up))
		end
	end
	if grew then
		Lib.PlaySound("LevelUp")
		local stage = Util.PetStage(Config, grew.Level)
		celebrate(
			T("%s %s grew up!", stage.Icon, T(grew.Name)),
			T("%s %s  •  more 💰 and ⚡", T(stage.Id), Util.PetBadge(Config, grew)),
			C.Green,
			false
		)
	else
		Lib.PlaySound("Reward", 0.6)
		HUD.Toast(T("🌱 Level up! %s", table.concat(names, "  •  ")), C.Green)
	end
end)
Net.On("PetEvolved", function(card)
	if type(card) ~= "table" then
		return
	end
	Lib.PlaySound("Fanfare")
	celebrate(
		T("⭐ EVOLVED! %s %s", string.rep("★", card.Stars or 1), T(card.Name)),
		T("x%d income & power - grow it again to level %d!", Config.Growth.Evolve.StarMult, Config.Growth.MaxLevel),
		C.Purple
	)
end)
Net.On("TutorialStep", function(_, rewardText)
	Lib.PlaySound("Reward")
	local text = tostring(rewardText or "")
	celebrate(T("✅ Step complete!"), if text ~= "" then "+" .. text else "", C.Green, false)
end)
Net.On("TutorialDone", function(rewardText)
	Lib.PlaySound("Legendary")
	celebrate(T("🎉 Tutorial complete!"), "+" .. tostring(rewardText), C.Gold)
	HUD.Toast(T("All menus unlocked - have fun!"), C.Gold)
end)
Net.On("EventStarted", function()
	Lib.PlaySound("Event")
end)
Net.On("Rebirthed", function(count, gems)
	HUD.Announce(T("♻️ REBIRTH %s!  +%s 💎", tostring(count), Util.Format(gems)), C.Purple)
end)
Net.On("ZoneUnlocked", function(index)
	local zone = Config.Zones[index]
	if zone then
		HUD.Announce(T("🔓 %s unlocked!", zone.Name), zone.Accent)
	end
end)
Net.On("OpenPanel", function(panel, arg)
	if panel == "Daily" then
		local data = State.Data
		if data and tutorialDone(data) then
			HUD.Toast(T("🎁 Your daily reward is ready - tap 🎁 Rewards!"), C.Gold)
		end
	else
		Panels.Open(panel, arg)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q then
		Panels.Toggle("Pets")
	elseif input.KeyCode == Enum.KeyCode.Escape and Panels.Current then
		Panels.Close()
	end
end)

State.OnChanged(HUD.Refresh)
task.spawn(function()
	while true do
		task.wait(1)
		local ok, err = pcall(HUD.Refresh)
		if not ok then
			warn("[HUD] refresh failed: " .. tostring(err))
		end
	end
end)

Panels.Provide("Toast", HUD.Toast)
Panels.Provide("Upsell", Upsell)
Panels.Provide("HUD", HUD)

return HUD
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">HowTo</string>
              <string name="Source"><![CDATA[--[[
	"How to play" card: three big pictures, one line each, one button.
	Shown once on a player's first visit (server remembers it, and once more
	for everyone after the ☄️ Meteor Rush update), and any time from
	Settings -> ❓ How to play.
]]
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent
local Net = require(Client.Net)
local State = require(Client.State)
local Lib = require(Client.UI.Lib)
local Root = require(Client.UI.Root)

local New, C = Lib.New, Lib.Colors
local HowTo = {}

local STEPS = {
	{
		Icon = "☄️",
		Title = "SMASH METEORS",
		Text = "A meteor falls every few minutes.\nRun there and smash it together!",
		Color = Color3.fromRGB(255, 150, 60),
	},
	{
		Icon = "🥚",
		Title = "GRAB & RUN",
		Text = "Grab a star egg and run home.\nGet bonked and you drop it!",
		Color = Color3.fromRGB(120, 200, 255),
	},
	{
		Icon = "🏠",
		Title = "YOUR SAFE HOME",
		Text = "It hatches into a pet that earns 💰.\nRaids only on 🌙 Thief Night!",
		Color = Color3.fromRGB(120, 220, 120),
	},
}

local screen = New("TextButton", {
	Name = "HowToPlay",
	Text = "",
	AutoButtonColor = false,
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.35,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 50,
	Parent = Root.Overlay,
})
local outer = Root.Cluster("HowToCards", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(820, 400), screen)
-- inner frame: its own UIScale for the pop animation (the cluster's UIScale fits the screen)
local cluster = New("Frame", {
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	Parent = outer,
})
Lib.Text({
	Text = "HOW TO PLAY",
	TextColor3 = Color3.fromRGB(255, 230, 120),
	Size = UDim2.new(1, 0, 0, 56),
	MaxTextSize = 46,
	ZIndex = 51,
	Parent = cluster,
})
local row = New("Frame", {
	BackgroundTransparency = 1,
	Size = UDim2.new(1, 0, 0, 250),
	Position = UDim2.fromOffset(0, 64),
	ZIndex = 51,
	Parent = cluster,
}, { Lib.List(Enum.FillDirection.Horizontal, 16, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })

for order, step in STEPS do
	local card = New("Frame", {
		BackgroundColor3 = C.Panel,
		Size = UDim2.fromOffset(250, 240),
		LayoutOrder = order,
		ZIndex = 51,
		Parent = row,
	}, { Lib.Corner(20), Lib.Stroke(step.Color, 4, 0) })
	Lib.Text({
		Text = tostring(order),
		TextColor3 = step.Color,
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.fromOffset(10, 6),
		MaxTextSize = 30,
		ZIndex = 52,
		Parent = card,
	})
	Lib.Text({
		Text = step.Icon,
		Size = UDim2.new(1, 0, 0, 90),
		Position = UDim2.fromOffset(0, 16),
		MaxTextSize = 80,
		Outline = false,
		ZIndex = 52,
		Parent = card,
	})
	Lib.Text({
		Text = step.Title,
		TextColor3 = step.Color,
		Size = UDim2.new(1, -16, 0, 36),
		Position = UDim2.fromOffset(8, 112),
		MaxTextSize = 30,
		ZIndex = 52,
		Parent = card,
	})
	Lib.Text({
		Text = step.Text,
		Font = Lib.BodyFont,
		Size = UDim2.new(1, -20, 0, 70),
		Position = UDim2.fromOffset(10, 154),
		MaxTextSize = 20,
		ZIndex = 52,
		Parent = card,
	})
end

local goButton = Lib.Button({
	Text = "LET'S GO!",
	Color = C.Green,
	Size = UDim2.fromOffset(260, 64),
	Position = UDim2.new(0.5, 0, 1, -66),
	AnchorPoint = Vector2.new(0.5, 0),
	TextSize = 32,
	ZIndex = 52,
	Parent = cluster,
	OnClick = function()
		HowTo.Hide()
	end,
})
local scale = New("UIScale", { Parent = cluster })

function HowTo.Show()
	screen.Visible = true
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	Lib.PlaySound("Reward")
end

function HowTo.Hide()
	if not screen.Visible then
		return
	end
	screen.Visible = false
	Net.Fire("SeenHowTo")
	Lib.Pop(goButton)
end

-- first visit: show it once the save has loaded
local shownOnce = false
State.OnChanged(function()
	local data = State.Data
	if shownOnce or not data or not data.Flags then
		return
	end
	shownOnce = true
	if not data.Flags.HowToSeen or not data.Flags.HowToRush then
		task.delay(1.5, function()
			if Players.LocalPlayer.Parent then
				HowTo.Show()
			end
		end)
	end
end)

return HowTo
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">MeteorUI</string>
              <string name="Source"><![CDATA[--[[
	Meteor event UI: always-visible countdown (anticipation) with WHAT is
	falling WHERE ("🔥 Big Lava Meteor -> Hub"), "GO" button during the
	warning, live top-5 ranking with your own place, camera shake on impact,
	"grab the eggs!" after the burst and the result popup (+ meteor index).
]]
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local Net = require(Client.Net)
local State = require(Client.State)
local Lib = require(Client.UI.Lib)
local Root = require(Client.UI.Root)
local HUD = require(Client.Controllers.HUD)

local New, C = Lib.New, Lib.Colors
local T = Lib.T
local player = Players.LocalPlayer
local MeteorUI = {}

-- countdown pill ---------------------------------------------------------
local top = Root.Cluster("Meteor", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 8), UDim2.fromOffset(380, 44))
local pill = New("Frame", {
	BackgroundColor3 = Color3.fromRGB(20, 22, 34),
	BackgroundTransparency = 0.15,
	Size = UDim2.fromOffset(250, 40),
	Position = UDim2.fromOffset(0, 2),
	Parent = top,
}, { Lib.Corner(20), Lib.Stroke(Color3.fromRGB(255, 150, 60), 2, 0) })
local pillText = Lib.Text({
	Text = "☄️ Meteor",
	TextColor3 = Color3.fromRGB(255, 190, 120),
	Size = UDim2.new(1, -16, 1, -8),
	Position = UDim2.fromOffset(8, 4),
	MaxTextSize = 20,
	Parent = pill,
})
local goButton = Lib.Button({
	Text = "GO ☄️",
	Color = Color3.fromRGB(255, 120, 40),
	Size = UDim2.fromOffset(120, 42),
	Position = UDim2.fromOffset(258, 1),
	Parent = top,
	OnClick = function()
		Net.Fire("GoToMeteor")
	end,
})
goButton.Visible = false
local summonButton = Lib.Button({
	Text = "☄️+",
	Color = Color3.fromRGB(150, 80, 40),
	Size = UDim2.fromOffset(56, 42),
	Position = UDim2.fromOffset(258, 1),
	TextSize = 18,
	Parent = top,
	OnClick = function()
		Net.Fire("BuyProduct", "SummonMeteor")
	end,
})

-- live ranking -------------------------------------------------------------
local rankFrame = New("Frame", {
	BackgroundColor3 = Color3.fromRGB(20, 22, 34),
	BackgroundTransparency = 0.1,
	Size = UDim2.fromOffset(240, 250),
	LayoutOrder = 10,
	Visible = false,
	Parent = HUD.RightColumn,
}, { Lib.Corner(14), Lib.Stroke(Color3.fromRGB(255, 150, 60), 2.5, 0) })
Lib.Text({
	Text = "☄️ LIVE RANKING",
	TextColor3 = Color3.fromRGB(255, 180, 100),
	Size = UDim2.new(1, -16, 0, 28),
	Position = UDim2.fromOffset(8, 6),
	MaxTextSize = 22,
	Parent = rankFrame,
})
local rankLines = {}
for i = 1, 5 do
	rankLines[i] = Lib.Text({
		Text = "",
		Size = UDim2.new(1, -16, 0, 26),
		Position = UDim2.fromOffset(8, 36 + (i - 1) * 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 19,
		TextColor3 = if i == 1
			then C.Gold
			elseif i == 2 then Color3.fromRGB(220, 225, 240)
			elseif i == 3 then Color3.fromRGB(230, 150, 80)
			else C.Text,
		Parent = rankFrame,
	})
end
local myLine = Lib.Text({
	Text = "",
	TextColor3 = C.Green,
	Size = UDim2.new(1, -16, 0, 30),
	Position = UDim2.fromOffset(8, 192),
	MaxTextSize = 22,
	Parent = rankFrame,
})
local hint = Lib.Text({
	Text = "Hit the meteor with your pickaxe!",
	Font = Lib.BodyFont,
	TextColor3 = C.Sub,
	Size = UDim2.new(1, -16, 0, 18),
	Position = UDim2.fromOffset(8, 224),
	MaxTextSize = 13,
	Parent = rankFrame,
})

local MEDALS = { "🥇", "🥈", "🥉", "4.", "5." }
Net.On("MeteorRank", function(list, myPlace, myScore)
	local entries = if type(list) == "table" then list else {}
	for i = 1, 5 do
		local entry = entries[i]
		rankLines[i].Text = if entry
			then string.format("%s %s  <font color='#BBBBBB'>%d</font>", MEDALS[i], entry.Name, entry.Score)
			else ""
	end
	if myPlace then
		myLine.Text = T("You: #%d  •  %d pts", myPlace, myScore or 0)
		hint.Text = if myPlace <= 3 then T("Top 3 wins big rewards - keep going!") else T("Hit harder to reach the top 3!")
	else
		myLine.Text = T("You: not participating")
		hint.Text = T("Hit the meteor with your pickaxe!")
	end
end)

-- result popup ---------------------------------------------------------------
local resultCluster =
	Root.Cluster("MeteorResult", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.42), UDim2.fromOffset(460, 220), Root.Overlay)
local result = New("Frame", {
	BackgroundColor3 = C.Panel,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	Parent = resultCluster,
}, { Lib.Corner(20), Lib.Stroke(C.Gold, 3, 0) })
local resultTitle =
	Lib.Text({ Text = "", Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 14), MaxTextSize = 40, Parent = result })
local resultBody = Lib.Text({
	Text = "",
	Size = UDim2.new(1, -20, 0, 70),
	Position = UDim2.fromOffset(10, 70),
	TextWrapped = true,
	MaxTextSize = 24,
	Parent = result,
})
Lib.Button({
	Text = "Awesome!",
	Size = UDim2.fromOffset(180, 46),
	Position = UDim2.new(0.5, -90, 1, -60),
	Parent = result,
	OnClick = function()
		result.Visible = false
	end,
})

Net.On("MeteorResult", function(info)
	if type(info) ~= "table" then
		return
	end
	local placeText = if info.Place == 1
		then T("🥇 1ST PLACE!")
		elseif info.Place == 2 then T("🥈 2ND PLACE!")
		elseif info.Place == 3 then T("🥉 3RD PLACE!")
		else T("#%d of %d", info.Place, info.Total)
	resultTitle.Text = placeText
	resultTitle.TextColor3 = if info.Place <= 3 then C.Gold else C.Text
	local parts = { "+" .. Util.Format(info.Stardust) .. " ✨" }
	if info.Gems > 0 then
		table.insert(parts, "+" .. Util.Format(info.Gems) .. " 💎")
	end
	table.insert(parts, T("+%d ranked pts", info.Points))
	local extra = ""
	if not info.Destroyed then
		extra = "\n<font color='#FF8888'>" .. T("The meteor escaped - half rewards") .. "</font>"
	elseif info.FirstCrack and type(info.Kind) == "string" then
		extra = "\n<font color='#FFD25A'>" .. T("📖 NEW in your meteor index: %s %s!", info.Icon or "☄️", info.Kind) .. "</font>"
	else
		extra = "\n<font color='#9BE7FF'>" .. T("🥚 Now grab a star egg and run home!") .. "</font>"
	end
	resultBody.Text = table.concat(parts, "   ") .. extra
	result.Visible = true
	Lib.Pop(result)
	Lib.PlaySound(if info.Place <= 3 then "RankUp" else "Reward")
	task.delay(7, function()
		result.Visible = false
	end)
end)

-- hit feedback -------------------------------------------------------------------
local lastHitSound = 0
Net.On("MeteorHit", function(score)
	if os.clock() - lastHitSound > 0.15 then
		lastHitSound = os.clock()
		Lib.PlaySound("HitStone", 0.8)
	end
	if type(score) == "number" then
		myLine.Text = T("+%s pts!", string.format("%.1f", score))
	end
end)

-- camera shake on impact -------------------------------------------------------
-- 💥 impact: an expanding shockwave ring + a dust cloud where it hit
local function shockwave(position: Vector3)
	local ground = Vector3.new(position.X, 0.3, position.Z)
	local ring = Instance.new("Part")
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.CastShadow = false
	ring.Shape = Enum.PartType.Cylinder
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 170, 80)
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.4, 6, 6)
	ring.CFrame = CFrame.new(ground) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	TweenService:Create(ring, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.2, 90, 90),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.9)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(16, 1, 16)
	holder.CFrame = CFrame.new(ground + Vector3.new(0, 1, 0))
	holder.Parent = workspace
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(170, 150, 130), Color3.fromRGB(110, 95, 85))
	dust.Size = NumberSequence.new(4, 12)
	dust.Transparency = NumberSequence.new(0.3, 1)
	dust.Lifetime = NumberRange.new(1.5, 2.5)
	dust.Speed = NumberRange.new(18, 34)
	dust.SpreadAngle = Vector2.new(80, 10)
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Drag = 3
	dust.Rate = 0
	dust.Parent = holder
	dust:Emit(40)
	Debris:AddItem(holder, 3)
end

Net.On("MeteorImpact", function(position)
	Lib.PlaySound("Impact")
	if typeof(position) == "Vector3" then
		shockwave(position)
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart
	if not humanoid or not root or typeof(position) ~= "Vector3" then
		return
	end
	local distance = (root.Position - position).Magnitude
	local strength = math.clamp(1 - distance / 300, 0.15, 1) * 1.6
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		if t > 0.8 then
			humanoid.CameraOffset = Vector3.zero
			connection:Disconnect()
			return
		end
		local fade = 1 - t / 0.8
		humanoid.CameraOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * strength * fade
	end)
end)

-- countdown loop ---------------------------------------------------------------
local lastStateName = "Idle"
task.spawn(function()
	while true do
		task.wait(0.25)
		local stateName = workspace:GetAttribute("MeteorState") or "Idle"
		if stateName ~= lastStateName then
			if stateName == "Warning" then
				-- siren-like warning: three low hits
				for i = 0, 2 do
					task.delay(i * 0.45, function()
						Lib.PlaySound("MeteorWarn")
					end)
				end
			end
			lastStateName = stateName
		end
		local now = State.Now()
		local stroke = pill:FindFirstChildOfClass("UIStroke")
		if stateName == "Idle" then
			local nextAt = workspace:GetAttribute("MeteorNext") or now
			pillText.Text = T("☄️ Next meteor in %s", Util.FormatTime(nextAt - now))
			pillText.TextColor3 = Color3.fromRGB(255, 190, 120)
			stroke.Color = Color3.fromRGB(255, 150, 60)
			goButton.Visible = false
			summonButton.Visible = true
			rankFrame.Visible = false
		elseif stateName == "Warning" or stateName == "Falling" then
			local warnEnd = workspace:GetAttribute("MeteorWarnEnd") or now
			local blink = math.floor(os.clock() * 3) % 2 == 0
			local golden = workspace:GetAttribute("MeteorGolden") == true
			local icon = workspace:GetAttribute("MeteorIcon") or "☄️"
			local site = workspace:GetAttribute("MeteorSite") or ""
			local siteZone = workspace:GetAttribute("MeteorSiteZone") or 0
			local data = State.Data
			local locked = data ~= nil and siteZone > data.ZoneLevel
			pillText.Text = if stateName == "Falling"
				then T("☄️ IMPACT!")
				else T(
					"%s%s %s → %s  %s",
					if golden then "✨" else "",
					icon,
					workspace:GetAttribute("MeteorKind") or "",
					site,
					Util.FormatTime(warnEnd - now)
				)
			pillText.TextColor3 = if golden then C.Gold elseif blink then C.Red else Color3.fromRGB(255, 220, 120)
			stroke.Color = if golden then C.Gold else C.Red
			goButton.Visible = stateName == "Warning"
			local goLabel = goButton:FindFirstChild("Label") :: TextLabel
			local goText = if locked then "🔒" else T("GO ☄️")
			if goLabel and goLabel.Text ~= goText then
				goLabel.Text = goText
			end
			summonButton.Visible = false
			rankFrame.Visible = false
		elseif stateName == "Active" then
			local endsAt = workspace:GetAttribute("MeteorEnd") or now
			local hp = workspace:GetAttribute("MeteorHP") or 0
			local maxHp = math.max(1, workspace:GetAttribute("MeteorMaxHP") or 1)
			pillText.Text = T("☄️ SMASH IT! %s  •  %d%%", Util.FormatTime(endsAt - now), math.ceil(hp / maxHp * 100))
			pillText.TextColor3 = C.Gold
			stroke.Color = C.Gold
			goButton.Visible = false
			summonButton.Visible = false
			rankFrame.Visible = true
		else
			goButton.Visible = false
			rankFrame.Visible = false
		end
		-- right after the burst: everyone races for the eggs
		if stateName == "Idle" and (workspace:GetAttribute("MeteorLootUntil") or 0) > State.Now() then
			pillText.Text = T("🥚 GRAB THE STAR EGGS & RUN HOME!")
			pillText.TextColor3 = Color3.fromRGB(150, 230, 255)
			stroke.Color = Color3.fromRGB(150, 230, 255)
		end
	end
end)

return MeteorUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Mining</string>
              <string name="Source"><![CDATA[--[[
	Client mining.
	Input: TAP / CLICK a block (or a shard carrier, a dropped shard, the
	meteor) and your character walks there and keeps swinging until it
	breaks. HOLD the mouse or the big ⛏️ button (phones) to mine the nearest
	blocks nonstop. Moving with the joystick/WASD cancels the auto-walk.
	The pickaxe is always kept in hand (no hotbar needed).
	Juice: material hit sounds, block squash, damage numbers, CRIT pops and
	shockwaves, combo counter with rising pitch, FEVER mode, lucky-ore
	bursts, bonk feedback. The server re-validates range and cooldown.
]]
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local Net = require(Client.Net)
local State = require(Client.State)
local Lib = require(Client.UI.Lib)
local Root = require(Client.UI.Root)

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local C = Lib.Colors
local New = Lib.New
local T = Lib.T

local Mining = {}

local tool: Tool? = nil
local lastSwing = 0
local oresFolder = nil
local ORE_SIZE = Vector3.one * Config.World.OreSize

local function getOres()
	if oresFolder and oresFolder.Parent then
		return oresFolder
	end
	local map = workspace:FindFirstChild("Map")
	oresFolder = map and map:FindFirstChild("Ores")
	return oresFolder
end

local function hitSoundFor(oreId: string?): string
	local ore = oreId and Config.Ores[oreId]
	if ore then
		local m = ore.Material
		if m == Enum.Material.Metal or m == Enum.Material.Foil then
			return "HitMetal"
		elseif m == Enum.Material.Ice or m == Enum.Material.Glass or m == Enum.Material.Neon then
			return "HitIce"
		end
	end
	return "HitStone"
end

-- selection + hp bar ------------------------------------------------------
local selection = Instance.new("SelectionBox")
selection.LineThickness = 0.06
selection.Color3 = Color3.fromRGB(255, 230, 120)
selection.SurfaceTransparency = 1
selection.Parent = workspace

local hpGui = New("BillboardGui", {
	Size = UDim2.fromOffset(120, 18),
	StudsOffsetWorldSpace = Vector3.new(0, 4, 0),
	AlwaysOnTop = true,
	Enabled = false,
	ResetOnSpawn = false, -- module runs once; don't let respawn delete it
	Parent = player:WaitForChild("PlayerGui"),
})
local _, setHp = Lib.Bar({ Size = UDim2.fromScale(1, 1), Color = C.Green, TextSize = 12, Parent = hpGui })
local hpTarget: BasePart? = nil
local hpHideAt = 0

local function showHp(part: BasePart, ratio: number)
	hpTarget = part
	hpGui.Adornee = part
	hpGui.Enabled = true
	local ore = Config.Ores[part:GetAttribute("Ore") or ""]
	local name = if ore then T(ore.Name) else ""
	local lucky = part:GetAttribute("Lucky")
	if type(lucky) == "string" then
		name = T(lucky) .. " " .. name
	end
	setHp(ratio, name, if ratio > 0.5 then C.Green elseif ratio > 0.25 then C.Gold else C.Red)
	hpHideAt = os.clock() + 2
end

-- effects ----------------------------------------------------------------
local function burst(position: Vector3, color: Color3, amount: number, speed: number?)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.Position = position
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	emitter.Speed = NumberRange.new(10 * (speed or 1), 24 * (speed or 1))
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -45, 0)
	emitter.Rate = 0
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.Parent = part
	part.Parent = workspace
	emitter:Emit(amount)
	Debris:AddItem(part, 1.5)
end

local function floatText(position: Vector3, text: string, color: Color3, size: number?, rise: number?)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one * 0.2
	anchor.Position = position + Vector3.new(math.random(-10, 10) / 10, 3, math.random(-10, 10) / 10)
	anchor.Parent = workspace
	local px = size or 36
	local gui = New("BillboardGui", { Size = UDim2.fromOffset(px * 6, px * 1.3), AlwaysOnTop = true, Adornee = anchor, Parent = anchor })
	local label = Lib.Text({ Text = text, TextColor3 = color, Size = UDim2.fromScale(1, 1), MaxTextSize = px, Parent = gui })
	local scale = New("UIScale", { Scale = 0.4, Parent = label })
	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	TweenService:Create(anchor, TweenInfo.new(1.1), { Position = anchor.Position + Vector3.new(0, rise or 4, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1.2)
end

-- block squash on hit (purely local, restores the real size)
local function squash(part: BasePart)
	part.Size = ORE_SIZE * 0.86
	TweenService:Create(part, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = ORE_SIZE }):Play()
end

local function shake(strength: number, duration: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		if t > duration then
			humanoid.CameraOffset = Vector3.zero
			connection:Disconnect()
			return
		end
		local fade = 1 - t / duration
		humanoid.CameraOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * strength * fade
	end)
end

-- combo counter (center right) -------------------------------------------
local comboCluster = Root.Cluster("Combo", Vector2.new(1, 0.5), UDim2.new(1, -30, 0.38, 0), UDim2.fromOffset(240, 90))
local comboLabel = Lib.Text({
	Text = "",
	TextColor3 = Color3.fromRGB(255, 170, 60),
	Size = UDim2.fromScale(1, 0.65),
	MaxTextSize = 48,
	Parent = comboCluster,
})
local comboSub = Lib.Text({
	Text = "",
	Font = Lib.BodyFont,
	TextColor3 = Color3.fromRGB(255, 230, 160),
	Size = UDim2.fromScale(1, 0.3),
	Position = UDim2.fromScale(0, 0.66),
	MaxTextSize = 18,
	Parent = comboCluster,
})
local comboScale = New("UIScale", { Parent = comboLabel })
local comboHideAt = 0

local function showCombo(count: number)
	if count < 3 then
		return
	end
	local bonus = math.min(Config.Combo.MaxBonus, (count - 1) * Config.Combo.BonusPer)
	comboLabel.Text = T("🔥 x%d COMBO", count)
	comboLabel.TextColor3 = if count >= 30
		then Color3.fromRGB(255, 80, 200)
		elseif count >= 15 then Color3.fromRGB(255, 90, 60)
		else Color3.fromRGB(255, 170, 60)
	comboSub.Text = T("+%d%% ore", math.floor(bonus * 100 + 0.5))
	comboScale.Scale = 1.35
	TweenService:Create(comboScale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	comboLabel.Visible = true
	comboSub.Visible = true
	comboHideAt = os.clock() + Config.Combo.Window
end

-- input + targeting ---------------------------------------------------------
local REACH = Config.World.Reach
local target = nil -- { Kind = "Ore" | "Player" | "Meteor" | "Shard", Part = BasePart }
local autoWalk = false
local holdMouse = false
local holdButton = false
local lastMoveTo = 0
local lastSearch = 0

local targetHighlight = Instance.new("Highlight")
targetHighlight.Name = "MineTarget"
targetHighlight.FillColor = Color3.fromRGB(255, 230, 120)
targetHighlight.FillTransparency = 0.82
targetHighlight.OutlineColor = Color3.fromRGB(255, 230, 120)
targetHighlight.OutlineTransparency = 0
targetHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
targetHighlight.Parent = workspace

-- the default PlayerModule tells us when the player steers by themselves
local controls = nil
task.spawn(function()
	local scripts = player:WaitForChild("PlayerScripts", 20)
	local module = scripts and scripts:WaitForChild("PlayerModule", 20)
	if module and module:IsA("ModuleScript") then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" and result.GetControls then
			controls = result:GetControls()
		end
	end
end)

local function userIsSteering(): boolean
	if not controls then
		return false
	end
	local ok, vector = pcall(function()
		return controls:GetMoveVector()
	end)
	return ok and typeof(vector) == "Vector3" and vector.Magnitude > 0.2
end

local function playSwing()
	if not tool then
		return
	end
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	Debris:AddItem(anim, 0.5)
	Lib.PlaySound("Swing")
end

local function feverActive(): boolean
	local untilTime = player:GetAttribute("FeverUntil")
	return type(untilTime) == "number" and untilTime > workspace:GetServerTimeNow()
end

local function cooldownNow(): number
	local cooldown = (State.Derived and State.Derived.Cooldown) or 0.36
	if feverActive() then
		cooldown *= Config.Fever.CooldownMult
	end
	return cooldown
end

local function setTarget(newTarget, walk: boolean)
	target = newTarget
	autoWalk = walk and newTarget ~= nil
	lastMoveTo = 0
	targetHighlight.Adornee = if newTarget and newTarget.Kind ~= "Meteor" then newTarget.Part else nil
end

-- what did the player tap on?
local function classify(hit: Instance?)
	if not hit or not hit:IsA("BasePart") then
		return nil
	end
	local ores = getOres()
	if ores then
		if hit.Parent == ores then
			return { Kind = "Ore", Part = hit }
		end
		local parent = hit.Parent
		if parent and parent.Parent == ores and parent:IsA("BasePart") then
			return { Kind = "Ore", Part = parent }
		end
	end
	if hit.Name == "Meteor" or hit.Name == "TutorialMeteor_" .. tostring(player.UserId) then
		return { Kind = "Meteor", Part = hit }
	end
	local model = hit:FindFirstAncestorOfClass("Model")
	if model and model.Parent and model.Parent:IsA("Model") and model.Parent:GetAttribute("Rival") == true then
		model = model.Parent -- (the egg above a rival's head)
	end
	if model then
		local other = Players:GetPlayerFromCharacter(model)
		-- (rivals: only worth a swing while they carry an egg)
		local rivalWithEgg = model:GetAttribute("Rival") == true and model:GetAttribute("Carrying") == true
		if (other and other ~= player) or rivalWithEgg then
			local otherRoot = model:FindFirstChild("HumanoidRootPart")
			if otherRoot and otherRoot:IsA("BasePart") then
				return { Kind = "Player", Part = otherRoot }
			end
		end
		local map = workspace:FindFirstChild("Map")
		local shardFolder = map and map:FindFirstChild("Shards")
		if shardFolder and model.Parent == shardFolder and model.Name == "StarGuardian" then
			local guardianRoot = model:FindFirstChild("HumanoidRootPart")
			if guardianRoot and guardianRoot:IsA("BasePart") then
				return { Kind = "Player", Part = guardianRoot } -- walk up and bonk it
			end
		end
		if shardFolder and model.Parent == shardFolder then
			local hitbox = model:FindFirstChild("Hitbox")
			if hitbox and hitbox:IsA("BasePart") then
				return { Kind = "Shard", Part = hitbox }
			end
		end
	end
	return nil
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function pickAt(position: Vector3)
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local ray = camera:ScreenPointToRay(position.X, position.Y)
	rayParams.FilterDescendantsInstances = { player.Character :: Instance }
	local result = workspace:Raycast(ray.Origin, ray.Direction * 500, rayParams)
	return classify(result and result.Instance)
end

local function reachFor(kind: string, part: BasePart?): number
	if kind == "Player" then
		return Config.PvP.BonkRange - 1.5
	elseif kind == "Meteor" then
		-- meteors come in sizes: reach the surface, not the center
		local radius = part and part:GetAttribute("Radius") or Config.Meteor.Radius
		return radius + REACH - 2
	elseif kind == "Shard" then
		return 2
	end
	return REACH
end

local function flatDistance(a: Vector3, b: Vector3): number
	return ((a - b) * Vector3.new(1, 0, 1)).Magnitude
end

local function swingAt(root: BasePart, current)
	local now = os.clock()
	if now - lastSwing < cooldownNow() then
		return
	end
	lastSwing = now
	if current and current.Part then
		local p = current.Part.Position
		local look = Vector3.new(p.X, root.Position.Y, p.Z)
		if (look - root.Position).Magnitude > 0.5 then
			root.CFrame = CFrame.lookAt(root.Position, look)
		end
	end
	playSwing()
	local hint = if current and (current.Kind == "Ore" or current.Kind == "Player") then current.Part else nil
	Net.Fire("Swing", hint)
end

-- the closest block in the zone we're standing in
local function nearestOre(root: BasePart): BasePart?
	local ores = getOres()
	local zone = Util.ZoneAt(Config, root.Position)
	local data = State.Data
	if not ores or not zone or zone == 0 or not data or zone > data.ZoneLevel then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for _, part in ores:GetChildren() do
		if part:IsA("BasePart") and part:GetAttribute("Zone") == zone then
			local distance = (part.Position - root.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = part, distance
			end
		end
	end
	return best
end

-- star guardians (rock golems) near us - bonk them to stun them
local function nearestGuardian(root: BasePart): BasePart?
	local map = workspace:FindFirstChild("Map")
	local folder = map and map:FindFirstChild("Shards")
	if not folder then
		return nil
	end
	local best, bestDistance = nil, Config.PvP.BonkRange + 6
	for _, model in folder:GetChildren() do
		if model.Name == "StarGuardian" then
			local guardianRoot = model:FindFirstChild("HumanoidRootPart")
			if guardianRoot and guardianRoot:IsA("BasePart") then
				local distance = (guardianRoot.Position - root.Position).Magnitude
				if distance < bestDistance then
					best, bestDistance = guardianRoot, distance
				end
			end
		end
	end
	return best
end

local function nearestCarrier(root: BasePart): BasePart?
	local best, bestDistance = nil, Config.PvP.BonkRange + 6
	for _, other in Players:GetPlayers() do
		if other ~= player and other:GetAttribute("Carrying") then
			local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot and otherRoot:IsA("BasePart") then
				local distance = (otherRoot.Position - root.Position).Magnitude
				if distance < bestDistance then
					best, bestDistance = otherRoot, distance
				end
			end
		end
	end
	-- rivals running home with an egg
	for _, model in workspace:GetChildren() do
		if model:IsA("Model") and model:GetAttribute("Rival") == true and model:GetAttribute("Carrying") == true then
			local otherRoot = model:FindFirstChild("HumanoidRootPart")
			if otherRoot and otherRoot:IsA("BasePart") then
				local distance = (otherRoot.Position - root.Position).Magnitude
				if distance < bestDistance then
					best, bestDistance = otherRoot, distance
				end
			end
		end
	end
	return best
end

local function bindTool(newTool: Tool)
	tool = newTool
end

local function onCharacter(character: Model)
	tool = nil
	setTarget(nil, false)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == "Pickaxe" then
			bindTool(child)
		end
	end)
	local existing = character:FindFirstChild("Pickaxe")
	if existing and existing:IsA("Tool") then
		bindTool(existing)
	end
end

player.CharacterAdded:Connect(onCharacter)
if player.Character then
	onCharacter(player.Character)
end

-- keep the pickaxe in hand no matter what (the hotbar is hidden)
task.spawn(function()
	while true do
		task.wait(0.5)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 and not character:FindFirstChildOfClass("Tool") then
			local backpack = player:FindFirstChildOfClass("Backpack")
			local pickaxe = backpack and backpack:FindFirstChild("Pickaxe")
			if pickaxe and pickaxe:IsA("Tool") then
				humanoid:EquipTool(pickaxe)
			end
		end
	end
end)

-- tap / click ------------------------------------------------------------------
local touches = {} -- [InputObject] = { Start = Vector3, Time = number, Drag = bool }

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or State.BuildMode then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		holdMouse = true
		local picked = pickAt(input.Position)
		if picked then
			setTarget(picked, true)
		end
	elseif input.UserInputType == Enum.UserInputType.Touch then
		touches[input] = { Start = input.Position, Time = os.clock(), Drag = false }
	end
end)

UserInputService.InputChanged:Connect(function(input)
	local touch = touches[input]
	if touch and (input.Position - touch.Start).Magnitude > 16 then
		touch.Drag = true -- that was a camera swipe, not a tap
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		holdMouse = false
	elseif input.UserInputType == Enum.UserInputType.Touch then
		local touch = touches[input]
		touches[input] = nil
		if touch and not touch.Drag and os.clock() - touch.Time < 0.45 and not State.BuildMode then
			local picked = pickAt(input.Position)
			if picked then
				setTarget(picked, true)
			end
		end
	end
end)

-- big MINE button for phones (left of the jump button) ------------------------
local mineGui = New("ScreenGui", {
	Name = "MineButtonGui",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 6,
	Enabled = UserInputService.TouchEnabled,
	Parent = player:WaitForChild("PlayerGui"),
})
local mineButton = New("TextButton", {
	Name = "Mine",
	AnchorPoint = Vector2.new(1, 1),
	BackgroundColor3 = Color3.fromRGB(255, 170, 50),
	BackgroundTransparency = 0.08,
	AutoButtonColor = false,
	Text = "",
	Parent = mineGui,
}, {
	Lib.Corner(999),
	Lib.Stroke(Color3.new(1, 1, 1), 3, 0.1),
	Lib.Gradient(Color3.new(1, 1, 1), Color3.fromRGB(200, 130, 60)),
})
local mineIcon = Lib.Text({
	Text = "⛏️",
	Size = UDim2.fromScale(0.62, 0.55),
	Position = UDim2.fromScale(0.5, 0.42),
	AnchorPoint = Vector2.new(0.5, 0.5),
	MaxTextSize = 60,
	Parent = mineButton,
})
local mineCaption = Lib.Text({
	Text = "MINE",
	Size = UDim2.fromScale(0.8, 0.22),
	Position = UDim2.fromScale(0.5, 0.78),
	AnchorPoint = Vector2.new(0.5, 0.5),
	MaxTextSize = 18,
	Parent = mineButton,
})
local mineScale = New("UIScale", { Parent = mineButton })

local function layoutMineButton()
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(800, 400)
	local small = math.min(size.X, size.Y) <= 500
	local diameter = if small then 80 else 118
	mineButton.Size = UDim2.fromOffset(diameter, diameter)
	-- sits just left of Roblox's jump button
	mineButton.Position = if small then UDim2.new(1, -108, 1, -20) else UDim2.new(1, -186, 1, -88)
end
layoutMineButton()
task.spawn(function()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutMineButton)
	end
end)
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(function()
	mineGui.Enabled = UserInputService.TouchEnabled
end)

mineButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		holdButton = true
		mineScale.Scale = 0.9
	end
end)
mineButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
		holdButton = false
		TweenService:Create(mineScale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
end)

-- main loop -------------------------------------------------------------------
RunService.Heartbeat:Connect(function()
	-- hover highlight (PC)
	local ores = getOres()
	local hover = mouse.Target
	if not UserInputService.TouchEnabled and hover and ores and hover.Parent == ores and hover ~= targetHighlight.Adornee then
		selection.Adornee = hover
	else
		selection.Adornee = nil
	end
	if hpGui.Enabled and (os.clock() > hpHideAt or not hpTarget or not hpTarget.Parent) then
		hpGui.Enabled = false
	end
	if comboLabel.Visible and os.clock() > comboHideAt then
		comboLabel.Visible = false
		comboSub.Visible = false
	end

	mineGui.Enabled = UserInputService.TouchEnabled and not State.BuildMode
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart
	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end
	if State.BuildMode then
		if target then
			setTarget(nil, false)
		end
		return
	end

	-- hands full while carrying a shard: no mining (but you can still walk to things)
	local carrying = player:GetAttribute("Carrying") ~= nil
	local icon = if carrying then "🏃" elseif feverActive() then "🔥" else "⛏️"
	if mineIcon.Text ~= icon then
		mineIcon.Text = icon
		mineCaption.Text = T(if carrying then "RUN HOME!" else "MINE")
		mineButton.BackgroundTransparency = if carrying then 0.55 else 0.08
	end
	if carrying and target and target.Kind ~= "Shard" then
		setTarget(nil, false)
	end

	-- drop targets that vanished (block broken, player left, meteor gone)
	if target and (not target.Part or not target.Part.Parent) then
		setTarget(nil, false)
	end
	if target and autoWalk and userIsSteering() then
		autoWalk = false -- the player took over
	end

	local wantsMore = (holdMouse or holdButton or (State.AutoMine and State.HasPass("AutoMine"))) and not carrying
	if not target and wantsMore and os.clock() - lastSearch > 0.12 then
		lastSearch = os.clock()
		local meteorActive = workspace:GetAttribute("MeteorState") == "Active"
		local map = workspace:FindFirstChild("Map")
		local drops = map and map:FindFirstChild("Drops")
		local meteor = drops and drops:FindFirstChild("Meteor")
		if not (meteorActive and meteor) then
			meteor = drops and drops:FindFirstChild("TutorialMeteor_" .. tostring(player.UserId))
		end
		local carrierRoot = nearestCarrier(root)
		if meteor and meteor:IsA("BasePart") and flatDistance(meteor.Position, root.Position) <= reachFor("Meteor", meteor) then
			setTarget({ Kind = "Meteor", Part = meteor }, false)
		elseif carrierRoot then
			setTarget({ Kind = "Player", Part = carrierRoot }, true)
		elseif nearestGuardian(root) then
			setTarget({ Kind = "Player", Part = nearestGuardian(root) :: BasePart }, true)
		else
			local ore = nearestOre(root)
			if ore then
				setTarget({ Kind = "Ore", Part = ore }, true)
			end
		end
	end

	if not target then
		return
	end
	local distance = flatDistance(target.Part.Position, root.Position)
	local reach = reachFor(target.Kind, target.Part)
	if distance > reach then
		if autoWalk then
			if os.clock() - lastMoveTo > 0.25 then
				lastMoveTo = os.clock()
				humanoid:MoveTo(target.Part.Position)
			end
		elseif not wantsMore or target.Kind ~= "Ore" then
			setTarget(nil, false) -- walked away from it
		else
			autoWalk = true
		end
		return
	end
	if autoWalk then
		autoWalk = false
		humanoid:MoveTo(root.Position) -- arrived: stop here
	end
	if target.Kind == "Shard" then
		setTarget(nil, false) -- touching it picks it up
	elseif not carrying then
		swingAt(root, target)
	end
end)

-- rainbow ores cycle their color locally (only tracked rainbow parts)
local rainbowParts = {}
local function trackOre(part: Instance)
	if part:IsA("BasePart") and part:GetAttribute("Lucky") == "Rainbow" then
		rainbowParts[part] = true
	end
end
task.spawn(function()
	local map = workspace:WaitForChild("Map", 60)
	local ores = map and map:WaitForChild("Ores", 60)
	if not ores then
		return
	end
	for _, part in ores:GetChildren() do
		trackOre(part)
	end
	ores.ChildAdded:Connect(trackOre)
	ores.ChildRemoved:Connect(function(part)
		rainbowParts[part] = nil
	end)
end)
RunService.RenderStepped:Connect(function()
	if next(rainbowParts) == nil then
		return
	end
	local color = Color3.fromHSV((os.clock() * 0.35) % 1, 0.75, 1)
	for part in rainbowParts do
		part.Color = color
		for _, child in part:GetChildren() do
			if child:IsA("BasePart") then
				child.Color = color
			end
		end
	end
end)

-- server feedback ----------------------------------------------------------
Net.On("MineHit", function(part, ratio, crit, damage, isSplash)
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return
	end
	squash(part)
	local top = part.Position + Vector3.new(0, 2.5, 0)
	if isSplash then
		burst(top, part.Color, 3)
		return
	end
	showHp(part, ratio)
	burst(top, part.Color, if crit then 10 else 4)
	Lib.PlaySound(hitSoundFor(part:GetAttribute("Ore")))
	if crit then
		Lib.PlaySound("Crit")
		floatText(top, T("💥 CRIT %s", Util.Format(damage or 0)), Color3.fromRGB(255, 120, 60), 44, 5)
		shake(0.25, 0.15)
	elseif type(damage) == "number" then
		floatText(top, Util.Format(damage), Color3.fromRGB(255, 255, 255), 26, 3)
	end
end)

Net.On("MineBreak", function(position, oreId, gained, extra)
	extra = extra or {}
	local ore = Config.Ores[oreId]
	local color = if ore then ore.Color else Color3.new(1, 1, 1)
	hpGui.Enabled = false
	Lib.PlaySound(hitSoundFor(oreId), 1.1, -0.15)
	Lib.PlaySound("Break")

	if extra.Lucky then
		local rainbow = extra.Lucky == "Rainbow"
		local luckyColor = if rainbow then Color3.fromRGB(255, 120, 230) else Color3.fromRGB(255, 210, 60)
		burst(position, luckyColor, 60, 1.6)
		burst(position, Color3.new(1, 1, 1), 25, 1.2)
		Lib.PlaySound("Lucky")
		shake(if rainbow then 0.8 else 0.4, 0.35)
		floatText(position, (if rainbow then T("🌈 RAINBOW!") else T("✨ GOLDEN!")) .. " +" .. Util.Format(gained), luckyColor, 56, 6)
	else
		burst(position, color, if extra.Fever then 26 else 18)
		floatText(
			position,
			"+" .. Util.Format(gained),
			if extra.Fever then Color3.fromRGB(255, 170, 60) else Color3.fromRGB(255, 255, 255),
			if extra.Fever then 36 else 30
		)
	end
	if extra.Crit then
		Lib.PlaySound("Crit", 0.8)
	end
	if extra.Gems then
		floatText(position + Vector3.new(0, 2, 0), "+" .. extra.Gems .. " 💎", C.Gems, 34, 5)
		Lib.PlaySound("Reward", 0.7)
	end
	if extra.Stardust then
		floatText(position + Vector3.new(0, 2, 0), "+" .. extra.Stardust .. " ✨", C.Stardust, 30, 5)
	end
	if type(extra.Combo) == "number" then
		showCombo(extra.Combo)
		-- coin "ding" climbs in pitch as the combo grows
		Lib.PlaySound("Coin", 0.6, math.min(0.9, extra.Combo * 0.03))
	end
end)

local flash = New("Frame", {
	BackgroundColor3 = Color3.fromRGB(255, 40, 60),
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 90,
	Parent = Root.Overlay,
})

Net.On("Knockback", function(velocity)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and typeof(velocity) == "Vector3" then
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		end
		root.AssemblyLinearVelocity = velocity
	end
end)

Net.On("Bonked", function(attackerName, dropped, hadShard)
	flash.BackgroundTransparency = 0.55
	TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	Lib.PlaySound("Bonked")
	shake(0.6, 0.3)
	local hud = Mining.HUD
	if hud then
		if hadShard then
			hud.Toast(T("💥 %s bonked you! You dropped your shard!", attackerName), C.Red)
		end
		if type(dropped) == "number" and dropped > 0 then
			hud.Toast(T("💥 %s bonked you! You dropped %s ore", attackerName, Util.Format(dropped)), C.Red)
		end
	end
end)

Net.On("BonkHit", function(position)
	if typeof(position) == "Vector3" then
		burst(position + Vector3.new(0, 2, 0), Color3.fromRGB(255, 200, 80), 24, 1.4)
		floatText(position, T("💥 BONK!"), Color3.fromRGB(255, 170, 60), 50, 5)
		Lib.PlaySound("Crit")
		shake(0.35, 0.15)
	end
end)

-- crit / fever shockwave ring --------------------------------------------------
Net.On("Shockwave", function(center, radius, fever)
	if typeof(center) ~= "Vector3" then
		return
	end
	local color = if fever then Color3.fromRGB(255, 120, 40) else Color3.fromRGB(255, 220, 120)
	local ring = Instance.new("Part")
	ring.Name = "Shockwave"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.2
	ring.Size = Vector3.new(0.4, 2, 2)
	ring.CFrame = CFrame.new(center.X, 0.6, center.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = workspace
	local size = (radius or 9) * 2
	TweenService:Create(ring, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.4, size, size),
		Transparency = 1,
	}):Play()
	Debris:AddItem(ring, 0.4)
	Lib.PlaySound("Crit", 0.6, -0.2)
	shake(if fever then 0.3 else 0.45, 0.18)
end)

-- FEVER --------------------------------------------------------------------------
local camera = workspace.CurrentCamera
local BASE_FOV = 70
local feverGlow = New("Frame", {
	Name = "FeverGlow",
	BackgroundColor3 = Color3.fromRGB(255, 110, 30),
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 80,
	Parent = Root.Overlay,
}, {
	New("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.18, 0.85),
			NumberSequenceKeypoint.new(0.82, 0.85),
			NumberSequenceKeypoint.new(1, 0),
		}),
	}),
})
local feverOn = false

local function setFov(fov: number, time: number)
	camera = workspace.CurrentCamera
	if camera then
		TweenService:Create(camera, TweenInfo.new(time, Enum.EasingStyle.Quad), { FieldOfView = fov }):Play()
	end
end

Net.On("Fever", function(duration)
	feverOn = true
	Lib.PlaySound("Lucky")
	Lib.PlaySound("LevelUp", 0.8)
	setFov(BASE_FOV + 10, 0.4)
	shake(0.7, 0.35)
	local hud = Mining.HUD
	if hud and hud.Celebrate then
		hud.Celebrate(T("🔥 FEVER!"), T("2x ore • faster swings • shockwaves!"), Color3.fromRGB(255, 130, 40))
	end
	comboLabel.TextColor3 = Color3.fromRGB(255, 120, 40)
	task.spawn(function()
		local started = os.clock()
		while feverOn and os.clock() - started < (duration or 8) + 10 do
			feverGlow.BackgroundTransparency = 0.55 + math.sin(os.clock() * 8) * 0.12
			RunService.RenderStepped:Wait()
		end
		feverGlow.BackgroundTransparency = 1
	end)
end)

Net.On("FeverEnd", function()
	feverOn = false
	feverGlow.BackgroundTransparency = 1
	setFov(BASE_FOV, 0.6)
end)

-- dash pads ---------------------------------------------------------------------
Net.On("SpeedPad", function()
	Lib.PlaySound("Swing", 1.2, -0.3)
	setFov(BASE_FOV + 14, 0.15)
	task.delay(Config.SpeedPads.Seconds, function()
		setFov(if feverOn then BASE_FOV + 10 else BASE_FOV, 0.5)
	end)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") and not root:FindFirstChild("DashTrail") then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(0, 1, 0)
		a0.Parent = root
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(0, -1.5, 0)
		a1.Parent = root
		local trail = Instance.new("Trail")
		trail.Name = "DashTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(Color3.fromRGB(90, 230, 255))
		trail.LightEmission = 1
		trail.Lifetime = 0.35
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.Parent = root
		Debris:AddItem(trail, Config.SpeedPads.Seconds)
		Debris:AddItem(a0, Config.SpeedPads.Seconds)
		Debris:AddItem(a1, Config.SpeedPads.Seconds)
	end
end)

return Mining
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">PetFollow</string>
              <string name="Source"><![CDATA[--[[
	Renders every player's equipped pets locally (server only replicates a
	JSON attribute). Pets float behind their owner in rows of three.
	🐾 Pet help: when the server says a player's pets hit something
	("PetHelp"), each pet hops over to its target and back.
]]
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PetModel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PetModel"))
local Net = require(script.Parent.Parent.Net)
local Lib = require(script.Parent.Parent.UI.Lib)

local HOP_TIME = 0.5

local folder = Instance.new("Folder")
folder.Name = "ClientPets"
folder.Parent = workspace

local owners = {} -- [player] = { Models = { Model }, Key = string }

local function clear(player: any)
	local entry = owners[player]
	if entry then
		for _, model in entry.Models do
			model:Destroy()
		end
	end
	owners[player] = nil
end

local function rebuild(player: any)
	local raw = player:GetAttribute("Pets")
	local key = if type(raw) == "string" then raw else "[]"
	local entry = owners[player]
	if entry and entry.Key == key then
		return
	end
	clear(player)
	local ok, names = pcall(HttpService.JSONDecode, HttpService, key)
	if not ok or type(names) ~= "table" then
		names = {}
	end
	local models = {}
	for i, entry in names do
		if type(entry) == "string" then
			-- entries look like "Golden|Fox|7|1" (variant|name|level|stars) or "|Fox"
			local parts = string.split(entry, "|")
			local variant, name = parts[1] or "", parts[2]
			if not name then
				variant, name = "", entry
			end
			local growth = { Level = tonumber(parts[3]) or 1, Stars = tonumber(parts[4]) or 0 }
			local model = PetModel.Build(name, if variant ~= "" then variant else nil, growth)
			model.Name = player.Name .. "_" .. i
			model.Parent = folder
			table.insert(models, model)
		end
	end
	owners[player] = { Models = models, Key = key, Positions = {}, Hops = {} }
end

local function track(player: any)
	player:GetAttributeChangedSignal("Pets"):Connect(function()
		rebuild(player)
	end)
	rebuild(player)
end

Players.PlayerAdded:Connect(track)
Players.PlayerRemoving:Connect(clear)
for _, player in Players:GetPlayers() do
	track(player)
end

-- rival players (server game characters) have pets following them too
local function trackRival(model: Instance)
	if model:IsA("Model") and model:GetAttribute("Rival") == true then
		track(model)
		model.AncestryChanged:Connect(function()
			if not model.Parent then
				clear(model)
			end
		end)
	end
end
workspace.ChildAdded:Connect(function(child)
	task.defer(trackRival, child)
end)
for _, child in workspace:GetChildren() do
	trackRival(child)
end

local function rootOf(owner: any): BasePart?
	local character = if owner:IsA("Player") then owner.Character else owner
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	local rainbow = Color3.fromHSV((t * 0.3) % 1, 0.7, 1)
	local alpha = 1 - math.exp(-dt * 9)
	for player, entry in owners do
		local root = rootOf(player)
		if root then
			local base = root.CFrame
			for i, model in entry.Models do
				local index = i - 1
				local row = math.floor(index / 3)
				local col = index % 3
				local offset = Vector3.new((col - 1) * 3.6, -0.6 + math.sin(t * 3 + i) * 0.35, 4.2 + row * 3.4)
				local target = base * CFrame.new(offset)
				local current = entry.Positions[i] or target
				local position = current.Position:Lerp(target.Position, alpha)
				local look = base.LookVector
				local cf = CFrame.lookAt(position, position + Vector3.new(look.X, 0, look.Z) + Vector3.new(0, 0.001, 0))
				entry.Positions[i] = cf
				-- hopping over to hit an ore / the meteor (and back)
				local hop = entry.Hops[i]
				if hop then
					local p = (t - hop.Start) / HOP_TIME
					if p >= 1 then
						entry.Hops[i] = nil
					elseif p > 0 then
						local weight = math.sin(p * math.pi)
						local at = position:Lerp(hop.Target, weight) + Vector3.new(0, weight * 2.5, 0)
						local face = hop.Target - position
						face = Vector3.new(face.X, 0, face.Z)
						cf = if face.Magnitude > 0.1 then CFrame.lookAt(at, at + face) else CFrame.new(at)
					end
				end
				model:PivotTo(cf)
				if model:GetAttribute("Variant") == "Rainbow" and model.PrimaryPart then
					model.PrimaryPart.Color = rainbow
				end
			end
		end
	end
end)

Net.On("PetHelp", function(userId, targets)
	local owner = type(userId) == "number" and Players:GetPlayerByUserId(userId)
	local entry = owner and owners[owner]
	if not entry or type(targets) ~= "table" or #targets == 0 then
		return
	end
	local t = os.clock()
	for i in entry.Models do
		local target = targets[((i - 1) % #targets) + 1]
		if typeof(target) == "Vector3" and not entry.Hops[i] then
			-- stop just short of the target, a little above the ground
			entry.Hops[i] = { Target = target + Vector3.new(0, 1, 0), Start = t + (i - 1) * 0.08 }
		end
	end
	if owner == Players.LocalPlayer then
		Lib.PlaySound("Pop", 0.18)
	end
end)

return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Shards</string>
              <string name="Source"><![CDATA[--[[
	Client side of the star-shard loop:
	* falling-star streaks + impact FX
	* carry banner ("run home!"), delivery / theft / recovery celebrations
	* base alarm when a thief grabs one of your shards
	* base prompts: you only see "Sell"/"Buy" on your own base and "Steal"
	  on other people's (and not while they're locked); your own lock shield
	  never blocks you
	* displayed / dropped shards slowly spin and bob
]]
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local Net = require(Client.Net)
local Lib = require(Client.UI.Lib)
local Root = require(Client.UI.Root)

local player = Players.LocalPlayer
local C = Lib.Colors
local New = Lib.New
local T = Lib.T

local Shards = {}

local function rarity(id: string)
	return Config.Shards.Rarities[id] or Config.Shards.Rarities.Common
end

-- colour of a value tier 1..7 (Common .. Secret)
local TIER_COLORS = {}
for _, def in Config.Rarities do
	TIER_COLORS[def.Order] = def.Color
end
local function tierColor(tier: number?): Color3
	return TIER_COLORS[math.clamp(tier or 1, 1, 7)] or C.Gold
end

local function hud()
	return Shards.HUD
end

local function toast(text: string, color: Color3?)
	local h = hud()
	if h then
		h.Toast(text, color)
	end
end

local function celebrate(title: string, sub: string, color: Color3, confetti: boolean?)
	local h = hud()
	if h and h.Celebrate then
		h.Celebrate(title, sub, color, confetti)
	end
end

---------------------------------------------------------------------------
-- carry banner (bottom center, above the action row)
---------------------------------------------------------------------------
local cluster = Root.Cluster("Carry", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -152), UDim2.fromOffset(500, 58))
local banner = New("Frame", {
	BackgroundColor3 = Color3.fromRGB(20, 22, 36),
	BackgroundTransparency = 0.1,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	Parent = cluster,
}, { Lib.Corner(14), Lib.Stroke(C.Gold, 3, 0) })
local bannerTitle = Lib.Text({
	Text = "",
	Size = UDim2.new(1, -16, 0, 30),
	Position = UDim2.fromOffset(8, 3),
	MaxTextSize = 24,
	Parent = banner,
})
local bannerSub = Lib.Text({
	Text = "",
	Font = Lib.BodyFont,
	TextColor3 = C.Sub,
	Size = UDim2.new(1, -16, 0, 18),
	Position = UDim2.fromOffset(8, 35),
	MaxTextSize = 14,
	Parent = banner,
})
local bannerStroke = banner:FindFirstChildOfClass("UIStroke") :: UIStroke
local bannerScale = New("UIScale", { Parent = banner })

local function refreshBanner()
	local carrying = player:GetAttribute("Carrying")
	if type(carrying) ~= "string" then
		banner.Visible = false
		return
	end
	local color = tierColor(player:GetAttribute("CarryTier"))
	local stolen = player:GetAttribute("CarryStolen") == true
	bannerTitle.Text = T(if stolen then "🏃 STOLEN %s - RUN HOME! 🏠" else "🌠 %s - RUN HOME! 🏠", T(carrying))
	bannerTitle.TextColor3 = color
	bannerSub.Text = T("You're slower and anyone can bonk you - don't get caught!")
	bannerStroke.Color = color
	banner.Visible = true
	bannerScale.Scale = 1.25
	TweenService:Create(bannerScale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end
player:GetAttributeChangedSignal("Carrying"):Connect(refreshBanner)
player:GetAttributeChangedSignal("CarryStolen"):Connect(refreshBanner)
refreshBanner()

RunService.RenderStepped:Connect(function()
	if banner.Visible then
		bannerStroke.Thickness = 3 + math.sin(os.clock() * 6) * 1.2
	end
end)

---------------------------------------------------------------------------
-- events
---------------------------------------------------------------------------
Net.On("CarryStart", function(name, fromName, tier)
	Lib.PlaySound("Lucky", 0.8)
	if not fromName then
		toast(T("🌠 You got a %s! Bring it to your base 🏠", T(tostring(name))), tierColor(tier))
	end
end)

Net.On("CarryLost", function(name)
	toast(T("💥 You dropped the %s!", T(tostring(name))), C.Red)
end)

-- star eggs show the normal hatch animation (HatchResult); stolen pets get a cheer
-- (stolen pets get the reveal card from HatchResult - it says where the pet went)
Net.On("ShardDelivered", function(_name, _result) end)

Net.On("ShardRecovered", function(name)
	Lib.PlaySound("Reward")
	celebrate(T("🛡️ RECOVERED!"), T(tostring(name)), C.Cyan)
end)

Net.On("BaseCollected", function(amount)
	Lib.PlaySound("CoinBig")
	local h = hud()
	if h and h.FlyCoins then
		h.FlyCoins(amount)
	end
	toast("+💰" .. Util.Format(amount), C.Coins)
end)

Net.On("OfflineEarnings", function(amount, seconds)
	local minutes = math.floor((seconds or 0) / 60)
	celebrate(
		T("💤 Your base earned 💰%s", Util.Format(amount)),
		T("while you were away (%d min) - collect it at your base!", minutes),
		C.Coins,
		true
	)
end)

-- base alarm: a thief took one of your shards
local alarm = New("Frame", {
	BackgroundColor3 = Color3.fromRGB(255, 30, 50),
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 85,
	Parent = Root.Overlay,
})
Net.On("BaseAlarm", function(thiefName, shardName)
	Lib.PlaySound("Bonked", 1.2)
	celebrate(T("🚨 THIEF!"), T("%s grabbed your %s - bonk them!", thiefName, T(shardName)), C.Red)
	task.spawn(function()
		for _ = 1, 4 do
			alarm.BackgroundTransparency = 0.6
			TweenService:Create(alarm, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
			Lib.PlaySound("Alarm", 0.8)
			task.wait(0.45)
		end
	end)
end)

-- jump pads / traps / guardians / likes -----------------------------------------
Net.On("Launch", function(velocity)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if root and root:IsA("BasePart") and typeof(velocity) == "Vector3" then
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		end
		root.AssemblyLinearVelocity = velocity
		Lib.PlaySound("Swing", 1.3, 0.4)
	end
end)

local stunFrame = New("Frame", {
	BackgroundColor3 = Color3.fromRGB(255, 230, 80),
	BackgroundTransparency = 1,
	Size = UDim2.fromScale(1, 1),
	ZIndex = 84,
	Parent = Root.Overlay,
})
Net.On("Stunned", function(seconds)
	Lib.PlaySound("Crit", 1, 0.3)
	stunFrame.BackgroundTransparency = 0.5
	TweenService:Create(stunFrame, TweenInfo.new(seconds or 2), { BackgroundTransparency = 1 }):Play()
end)

Net.On("GuardianChase", function(seconds)
	Lib.PlaySound("MeteorWarn", 0.8)
	celebrate(T("🗿 THE GUARDIAN WOKE UP!"), T("Run! It chases you for %d seconds", seconds or 12), Color3.fromRGB(255, 150, 80))
end)

Net.On("CaughtByGuardian", function(name)
	Lib.PlaySound("Bonked")
	toast(T("🗿 The guardian took the %s back!", T(tostring(name))), C.Red)
end)

Net.On("BaseLiked", function()
	Lib.PlaySound("Reward", 0.8, 0.2)
end)

---------------------------------------------------------------------------
-- falling stars: a bright streak from the sky, then a flash + shake
---------------------------------------------------------------------------
local function shakeCamera(strength: number, duration: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local start = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = os.clock() - start
		if t > duration then
			humanoid.CameraOffset = Vector3.zero
			connection:Disconnect()
			return
		end
		local fade = 1 - t / duration
		humanoid.CameraOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * strength * fade
	end)
end

Net.On("StarFall", function(position, id, flight)
	if typeof(position) ~= "Vector3" then
		return
	end
	local def = rarity(id)
	local duration = flight or 1.8
	local landing = position + Vector3.new(0, 5, 0)
	local start = landing + Vector3.new(90, 320, 70)

	local star = Instance.new("Part")
	star.Name = "FallingStar"
	star.Shape = Enum.PartType.Ball
	star.Size = Vector3.one * 5
	star.Material = Enum.Material.Neon
	star.Color = def.Color
	star.Anchored = true
	star.CanCollide = false
	star.CanQuery = false
	star.CanTouch = false
	star.CFrame = CFrame.new(start)
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 2, 0)
	a0.Parent = star
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -2, 0)
	a1.Parent = star
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), def.Color)
	trail.LightEmission = 1
	trail.Lifetime = 0.6
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Transparency = NumberSequence.new(0, 1)
	trail.FaceCamera = true
	trail.Parent = star
	local light = Instance.new("PointLight")
	light.Color = def.Color
	light.Range = 40
	light.Brightness = 4
	light.Parent = star
	star.Parent = workspace
	Lib.PlaySound("Swing", 1.5, -0.5)
	TweenService:Create(star, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(landing) })
		:Play()

	task.delay(duration, function()
		star:Destroy()
		-- impact
		local flashPart = Instance.new("Part")
		flashPart.Shape = Enum.PartType.Ball
		flashPart.Anchored = true
		flashPart.CanCollide = false
		flashPart.CanQuery = false
		flashPart.CanTouch = false
		flashPart.Material = Enum.Material.Neon
		flashPart.Color = def.Color
		flashPart.Size = Vector3.one * 4
		flashPart.CFrame = CFrame.new(landing)
		flashPart.Parent = workspace
		TweenService:Create(flashPart, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.one * 26,
			Transparency = 1,
		}):Play()
		Debris:AddItem(flashPart, 0.5)
		Lib.PlaySound("Break", 1.3, -0.3)
		Lib.PlaySound("Crit", 0.9, -0.4)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			local distance = (root.Position - landing).Magnitude
			if distance < 120 then
				shakeCamera(math.clamp(1.2 - distance / 100, 0.2, 1.2), 0.4)
			end
		end
	end)
end)

---------------------------------------------------------------------------
-- base prompts / shields / spinning shards
---------------------------------------------------------------------------
local function refreshBases()
	local map = workspace:FindFirstChild("Map")
	local bases = map and map:FindFirstChild("Bases")
	if not bases then
		return
	end
	local serverNow = workspace:GetServerTimeNow()
	for _, plot in bases:GetChildren() do
		local ownerId = plot:GetAttribute("OwnerId")
		if type(ownerId) == "number" then
			local mine = ownerId == player.UserId
			local locked = (plot:GetAttribute("LockedUntil") or 0) > serverNow
			-- shields (newbie / after a theft / being robbed) hide the steal prompts,
			-- except for the victim's revenge (locks and shields don't stop it)
			local protection = plot:GetAttribute("Protection") or ""
			local revengeHere = player:GetAttribute("RevengeTarget") == ownerId and (player:GetAttribute("RevengeUntil") or 0) > serverNow
			local robbing = plot:GetAttribute("Robbing") == true
			local open = not robbing and ((protection == "" and not locked) or revengeHere)
			for _, prompt in plot:GetDescendants() do
				if prompt:IsA("ProximityPrompt") then
					local role = prompt:GetAttribute("Role")
					local enabled = if role == "Owner"
						then mine
						elseif role == "Thief" then not mine and open
						elseif role == "Visitor" then not mine
						else true
					if prompt.Enabled ~= enabled then
						prompt.Enabled = enabled
					end
				end
			end
			local shield = plot:FindFirstChild("Shield")
			if shield and shield:IsA("BasePart") and (mine or revengeHere) and shield.CanCollide then
				shield.CanCollide = false -- your own lock never blocks you (nor does it stop revenge)
			end
		end
	end
end

task.spawn(function()
	while true do
		local ok, err = pcall(refreshBases)
		if not ok then
			warn("[Shards] base refresh failed: " .. tostring(err))
		end
		task.wait(0.5)
	end
end)

-- spin + bob: displayed and dropped shards (each keeps its server pivot)
local spinning = {} -- [model] = base pivot
local function track(inst: Instance)
	if inst:IsA("Model") and inst:GetAttribute("Spin") then
		spinning[inst] = inst:GetPivot()
		inst.AncestryChanged:Connect(function()
			if not inst:IsDescendantOf(workspace) then
				spinning[inst] = nil
			end
		end)
	end
end
task.spawn(function()
	local map = workspace:WaitForChild("Map", 60)
	if not map then
		return
	end
	for _, name in { "Bases", "Shards" } do
		local folder = map:WaitForChild(name, 30)
		if folder then
			folder.DescendantAdded:Connect(function(inst)
				task.defer(track, inst)
			end)
			for _, inst in folder:GetDescendants() do
				track(inst)
			end
		end
	end
end)
RunService.RenderStepped:Connect(function()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local eye = camera.CFrame.Position
	local t = os.clock()
	for model, pivot in spinning do
		-- only animate what's near the camera (cheap on phones)
		if model.Parent and (pivot.Position - eye).Magnitude < 140 then
			if model:GetAttribute("PetId") then
				-- pets on pedestals: happy bounce + little sway (they face the street)
				local phase = t * 3 + pivot.X
				local hop = math.abs(math.sin(phase)) * 0.5
				model:PivotTo(pivot * CFrame.new(0, hop, 0) * CFrame.Angles(0, math.sin(phase * 0.5) * 0.35, math.sin(phase) * 0.06))
				if model:GetAttribute("Variant") == "Rainbow" and model.PrimaryPart then
					model.PrimaryPart.Color = Color3.fromHSV((t * 0.3) % 1, 0.7, 1)
				end
			else
				model:PivotTo(pivot * CFrame.new(0, math.sin(t * 2 + pivot.X) * 0.4, 0) * CFrame.Angles(0, t * 1.6, 0))
			end
		end
	end
end)

return Shards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Spectacle</string>
              <string name="Source"><![CDATA[--[[
	Spectacle: the "clip it!" moments.
	  * 🎉 confetti (lucky block prizes, prank pets) and 💥 booms (prank blocks)
	  * a pillar of light where someone hatched a HUGE / TITANIC / secret pet
	  * 🌙 Thief Night turns the sky dark for everyone
	  * 🎉 party: a little fireworks show now and then
]]
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Client = script.Parent.Parent
local Net = require(Client.Net)
local Lib = require(Client.UI.Lib)

local Spectacle = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 80)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 230, 120)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 110, 255)),
})

local function anchorAt(position: Vector3): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.CFrame = CFrame.new(position)
	p.Parent = workspace
	return p
end

local function burst(position: Vector3, colors: ColorSequence, amount: number, speed: number, size: number)
	local holder = anchorAt(position + Vector3.new(0, 3, 0))
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLE
	emitter.Color = colors
	emitter.LightEmission = 0.6
	emitter.Size = NumberSequence.new(size, 0)
	emitter.Lifetime = NumberRange.new(1.2, 2.2)
	emitter.Speed = NumberRange.new(speed * 0.6, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, -30, 0)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-200, 200)
	emitter.Rate = 0
	emitter.Parent = holder
	emitter:Emit(amount)
	Debris:AddItem(holder, 3)
end

-- how loud something at this spot is for us (far away = quiet / silent)
local function nearVolume(position: Vector3): number
	local camera = workspace.CurrentCamera
	if not camera then
		return 1
	end
	local distance = (camera.CFrame.Position - position).Magnitude
	return math.clamp(1 - (distance - 30) / 90, 0, 1)
end

Net.On("Confetti", function(position)
	if typeof(position) ~= "Vector3" then
		return
	end
	burst(position, RAINBOW, 60, 30, 0.8)
	local volume = nearVolume(position)
	if volume > 0 then
		Lib.PlaySound("Pop", volume)
		Lib.PlaySound("Success", volume * 0.8)
	end
end)

Net.On("Boom", function(position)
	if typeof(position) ~= "Vector3" then
		return
	end
	burst(position, ColorSequence.new(Color3.fromRGB(255, 140, 40), Color3.fromRGB(60, 50, 50)), 45, 40, 1.4)
	local volume = nearVolume(position)
	if volume > 0 then
		Lib.PlaySound("Boom", volume)
	end
end)

-- a pillar of light on a lucky player (everyone sees it)
Net.On("BigHatch", function(userId, kind)
	local other = type(userId) == "number" and Players:GetPlayerByUserId(userId)
	local root = other and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local color = if kind == "Titanic"
		then Color3.fromRGB(255, 120, 60)
		elseif kind == "Huge" then Color3.fromRGB(255, 210, 80)
		elseif kind == "Meteor" then Color3.fromRGB(255, 150, 70)
		elseif kind == "Evolve" then Color3.fromRGB(150, 220, 255)
		else Color3.fromRGB(200, 120, 255)
	local pillar = Instance.new("Part")
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Material = Enum.Material.Neon
	pillar.Color = color
	pillar.Transparency = 0.35
	pillar.Size = Vector3.new(400, 5, 5)
	pillar.CFrame = CFrame.new(root.Position + Vector3.new(0, 200, 0)) * CFrame.Angles(0, 0, math.rad(90))
	pillar.Parent = workspace
	burst(root.Position, RAINBOW, if kind == "Titanic" then 160 else 80, 45, 1)
	if other ~= Players.LocalPlayer then
		Lib.PlaySound("Cheer", 0.8) -- (the lucky player hears the fanfare on their card)
	end
	TweenService:Create(pillar, TweenInfo.new(8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Transparency = 1,
		Size = Vector3.new(400, 0.5, 0.5),
	}):Play()
	Debris:AddItem(pillar, 8.5)
end)

Net.On("Party", function()
	Lib.PlaySound("Cheer")
end)

-- 🚨 a rival is stealing from my home
Net.On("RaidAlarm", function()
	for i = 0, 2 do
		task.delay(i * 0.5, function()
			Lib.PlaySound("Alarm", 0.9)
		end)
	end
end)

-- 🌙 Thief Night is coming (20s): a short alarm so everyone runs home
Net.On("RaidWarning", function()
	for i = 0, 1 do
		task.delay(i * 0.6, function()
			Lib.PlaySound("Alarm", 0.7)
		end)
	end
end)

-- 🌙 Thief Night: the sky goes dark while it lasts
local normalClock = nil
local function refreshNight()
	local night = workspace:GetAttribute("EventId") == "ThiefNight"
	if night and normalClock == nil then
		normalClock = Lighting.ClockTime
		TweenService:Create(Lighting, TweenInfo.new(3), { ClockTime = 0.3 }):Play()
	elseif not night and normalClock ~= nil then
		TweenService:Create(Lighting, TweenInfo.new(3), { ClockTime = normalClock }):Play()
		normalClock = nil
	end
end
workspace:GetAttributeChangedSignal("EventId"):Connect(refreshNight)
refreshNight()

-- 🎉 party: fireworks over the hub every few seconds
task.spawn(function()
	while true do
		task.wait(4)
		local partyEnd = workspace:GetAttribute("PartyEnd") or 0
		if partyEnd > workspace:GetServerTimeNow() then
			local spot = Vector3.new(math.random(-60, 60), 40 + math.random(0, 20), math.random(-60, 60))
			burst(spot, RAINBOW, 70, 35, 1.2)
		end
	end
end)

return Spectacle
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">TradeUI</string>
              <string name="Source"><![CDATA[--[[
	Trading glue: incoming request popup + keeps the live trade state for
	the Trade panel (UI/Panels/Trade.luau). The server does all the checks.
]]
local Client = script.Parent.Parent
local Net = require(Client.Net)
local Lib = require(Client.UI.Lib)
local Root = require(Client.UI.Root)
local Panels = require(Client.UI.Panels)

local New, C, T = Lib.New, Lib.Colors, Lib.T
local TradeUI = { State = nil }

-- request popup ------------------------------------------------------------
local cluster = Root.Cluster("TradeRequest", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 120), UDim2.fromOffset(440, 130), Root.Overlay)
local popup = New("Frame", {
	BackgroundColor3 = C.Panel,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	Parent = cluster,
}, { Lib.Corner(16), Lib.Stroke(C.Cyan, 3, 0) })
local popupText = Lib.Text({
	Text = "",
	Size = UDim2.new(1, -20, 0, 44),
	Position = UDim2.fromOffset(10, 8),
	MaxTextSize = 24,
	Parent = popup,
})
local requestFrom = nil
local requestToken = 0
local function hidePopup()
	popup.Visible = false
	requestFrom = nil
end
Lib.Button({
	Text = "✅ Accept",
	Color = C.Green,
	Size = UDim2.fromOffset(190, 54),
	Position = UDim2.new(0.5, -200, 1, -66),
	TextSize = 22,
	Parent = popup,
	OnClick = function()
		if requestFrom then
			Net.Fire("TradeRespond", true)
		end
		hidePopup()
	end,
})
Lib.Button({
	Text = "X Decline",
	Color = C.Red,
	Size = UDim2.fromOffset(190, 54),
	Position = UDim2.new(0.5, 10, 1, -66),
	TextSize = 22,
	Parent = popup,
	OnClick = function()
		if requestFrom then
			Net.Fire("TradeRespond", false)
		end
		hidePopup()
	end,
})

Net.On("TradeRequested", function(userId, name)
	requestFrom = userId
	requestToken += 1
	local token = requestToken
	popupText.Text = T("🤝 %s wants to trade!", tostring(name))
	popup.Visible = true
	Lib.Pop(popup)
	Lib.PlaySound("Reward")
	task.delay(20, function()
		if token == requestToken then
			hidePopup()
		end
	end)
end)

-- live trade ---------------------------------------------------------------------
Net.On("TradeState", function(state)
	TradeUI.State = state
	if Panels.Current == "Trade" then
		Panels.RefreshCurrent()
	else
		Panels.Open("Trade")
	end
end)

Net.On("TradeClosed", function(reason)
	TradeUI.State = nil
	if Panels.Current == "Trade" then
		Panels.Close()
	end
	local hud = TradeUI.HUD
	if hud and type(reason) == "string" then
		hud.Toast(reason, C.Red)
	end
end)

Net.On("TradeDone", function(partner)
	Lib.PlaySound("Legendary")
	local hud = TradeUI.HUD
	if hud and hud.Celebrate then
		hud.Celebrate(T("🤝 TRADE COMPLETE!"), T("with %s", tostring(partner)), C.Cyan, true)
	end
end)

Panels.Provide("TradeUI", TradeUI)

return TradeUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">WorldFX</string>
              <string name="Source"><![CDATA[--[[
	Local world state: zone gates open only for players who unlocked them,
	and chat tags ([VIP], [CLUB], weekly titles) via TextChatService.
]]
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local Client = script.Parent.Parent
local State = require(Client.State)

local player = Players.LocalPlayer

local function gatesFolder()
	local map = workspace:FindFirstChild("Map")
	return map and map:FindFirstChild("Gates")
end

local function refreshGates()
	local data = State.Data
	local folder = gatesFolder()
	if not data or not folder then
		return
	end
	for _, gate in folder:GetChildren() do
		if gate:IsA("BasePart") then
			local index = gate:GetAttribute("ZoneIndex") or 99
			local open = data.ZoneLevel >= index
			gate.CanCollide = not open
			gate.Transparency = if open then 1 else 0.1
			local label = gate:FindFirstChild("Label")
			if label and label:IsA("BillboardGui") then
				label.Enabled = not open
			end
			local prompt = gate:FindFirstChildOfClass("ProximityPrompt")
			if prompt then
				prompt.Enabled = not open and data.ZoneLevel + 1 == index
			end
		end
	end
end

State.OnChanged(refreshGates)
task.spawn(function()
	local map = workspace:WaitForChild("Map", 30)
	local folder = map and map:WaitForChild("Gates", 30)
	if folder then
		folder.ChildAdded:Connect(refreshGates)
		refreshGates()
	end
end)

-- world text translation -----------------------------------------------------
-- Server-built signs carry LangFmt (+ JSON LangArgs); render them in OUR language.
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lang = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Lang"))

local function applyLabel(label: TextLabel)
	local fmt = label:GetAttribute("LangFmt")
	if type(fmt) ~= "string" then
		return
	end
	local args = {}
	local raw = label:GetAttribute("LangArgs")
	if type(raw) == "string" and raw ~= "" then
		local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and type(decoded) == "table" then
			args = decoded
		end
	end
	local text = Lang.T(fmt, table.unpack(args))
	if label.Text ~= text then
		label.Text = text
	end
end

local function hook(inst: Instance)
	if inst:IsA("TextLabel") then
		applyLabel(inst)
		inst:GetAttributeChangedSignal("LangFmt"):Connect(function()
			applyLabel(inst)
		end)
		inst:GetAttributeChangedSignal("LangArgs"):Connect(function()
			applyLabel(inst)
		end)
		inst:GetPropertyChangedSignal("Text"):Connect(function()
			task.defer(applyLabel, inst)
		end)
	elseif inst:IsA("ProximityPrompt") then
		inst.ActionText = Lang.T(inst.ActionText)
		inst.ObjectText = Lang.T(inst.ObjectText)
	end
end

-- overhead tags (titles) live on characters, not in the map
local Players = game:GetService("Players")
local function hookCharacter(character: Model)
	for _, d in character:GetDescendants() do
		hook(d)
	end
	character.DescendantAdded:Connect(hook)
end
local function hookPlayer(other: Player)
	other.CharacterAdded:Connect(hookCharacter)
	if other.Character then
		hookCharacter(other.Character)
	end
end
Players.PlayerAdded:Connect(hookPlayer)
for _, other in Players:GetPlayers() do
	hookPlayer(other)
end

task.spawn(function()
	local map = workspace:WaitForChild("Map", 60)
	if not map then
		return
	end
	map.DescendantAdded:Connect(hook)
	for _, inst in map:GetDescendants() do
		hook(inst)
	end
end)

-- chat tags ----------------------------------------------------------------
TextChatService.OnIncomingMessage = function(message: TextChatMessage)
	local props = Instance.new("TextChatMessageProperties")
	local source = message.TextSource
	if source then
		local speaker = Players:GetPlayerByUserId(source.UserId)
		if speaker then
			local tags = {}
			local title = speaker:GetAttribute("Title")
			if type(title) == "string" and title ~= "" then
				table.insert(tags, "<font color='#FFD84A'>[" .. title .. "]</font>")
			end
			if speaker:GetAttribute("VIP") then
				table.insert(tags, "<font color='#FFC93C'>[VIP]</font>")
			end
			if speaker:GetAttribute("Club") then
				table.insert(tags, "<font color='#5CF2FF'>[CLUB]</font>")
			end
			if #tags > 0 then
				props.PrefixText = table.concat(tags, " ") .. " " .. message.PrefixText
			end
		end
	end
	return props
end

player:GetAttributeChangedSignal("DataLoaded"):Connect(refreshGates)

return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">YardPets</string>
              <string name="Source"><![CDATA[--[[
	YardPets: the pets waiting in storage don't vanish - they wander around
	their owner's yard (the server publishes up to Config.Base.YardPets of
	them per house as the plot attribute "Yard"). Only houses near the camera
	get models, so phones stay smooth.

	Also: a small "welcome" when you step onto your own land or someone
	else's (house name, level, likes).
]]
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DecorModel = require(Shared.DecorModel)
local PetModel = require(Shared.PetModel)

local Client = script.Parent.Parent
local Lib = require(Client.UI.Lib)

local YardPets = {}
local player = Players.LocalPlayer
local T = Lib.T

local VIEW_DISTANCE = 150
local MAX_YARDS = 3 -- only the nearest houses get wandering pets (phones stay smooth)
local STEP = 1 / 20 -- pets move 20 times a second
local SPEED = 4
local folder = Instance.new("Folder")
folder.Name = "YardPets"
folder.Parent = workspace

local yards = {} -- [plot Model] = { Key, Pets = { { Model, Pos, Target, Wait, Lift } } }
local rng = Random.new()

local function plotFrame(plot: Model): CFrame?
	local floor = plot:FindFirstChild("Floor")
	return if floor and floor:IsA("BasePart") then floor.CFrame * CFrame.new(0, 0.2, 0) else nil
end

local function clear(plot: Model)
	local yard = yards[plot]
	if yard then
		for _, pet in yard.Pets do
			pet.Model:Destroy()
		end
	end
	yards[plot] = nil
end

local function randomSpot(plot: Model): Vector3
	local bounds = DecorModel.Bounds(Config, plot:GetAttribute("HouseLevel") or 1)
	return Vector3.new(rng:NextNumber(bounds.MinX + 2, bounds.MaxX - 2), 0, rng:NextNumber(bounds.MinZ + 2, bounds.MaxZ - 2))
end

local function build(plot: Model, key: string)
	clear(plot)
	local ok, names = pcall(HttpService.JSONDecode, HttpService, key)
	if not ok or type(names) ~= "table" then
		return
	end
	local pets = {}
	for i, entry in names do
		if type(entry) == "string" then
			local variant, name = string.match(entry, "^(.-)|(.+)$")
			if name and Config.Pets[name] then
				local model = PetModel.Build(name, if variant ~= "" then variant else nil)
				model.Name = plot.Name .. "_yard_" .. i
				model:PivotTo(CFrame.new())
				local box, size = model:GetBoundingBox()
				-- how far the pivot sits above the model's feet
				local lift = model:GetPivot().Position.Y - (box.Position.Y - size.Y / 2)
				for _, d in model:GetDescendants() do
					if d:IsA("Light") or d:IsA("ParticleEmitter") or d:IsA("Sparkles") or d:IsA("Fire") then
						d:Destroy() -- (cheap yard copies: no lights / particles)
					elseif d:IsA("BasePart") then
						d.CanCollide = false
						d.CanQuery = false
						d.CanTouch = false
					end
				end
				model.Parent = folder
				local start = randomSpot(plot)
				table.insert(pets, { Model = model, Pos = start, Target = randomSpot(plot), Wait = rng:NextNumber(0, 2), Lift = lift })
			end
		end
	end
	yards[plot] = { Key = key, Pets = pets }
end

local function bases(): { Model }
	local map = workspace:FindFirstChild("Map")
	local folderBases = map and map:FindFirstChild("Bases")
	return if folderBases then folderBases:GetChildren() :: any else {}
end

-- which houses get pets (near the camera only)
local function refreshYards()
	local camera = workspace.CurrentCamera
	local eye = camera and camera.CFrame.Position or Vector3.zero
	-- the nearest few houses within view distance
	local candidates = {}
	for _, plot in bases() do
		local frame = plotFrame(plot)
		if frame then
			local distance = (frame.Position - eye).Magnitude
			if distance < VIEW_DISTANCE then
				table.insert(candidates, { Plot = plot, Distance = distance })
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Distance < b.Distance
	end)
	local chosen = {}
	for i = 1, math.min(MAX_YARDS, #candidates) do
		chosen[candidates[i].Plot] = true
	end
	for _, plot in bases() do
		local ownerId = plot:GetAttribute("OwnerId")
		local key = plot:GetAttribute("Yard")
		local near = chosen[plot] == true
		if near and type(ownerId) == "number" and ownerId ~= 0 and type(key) == "string" then
			local yard = yards[plot]
			if not yard or yard.Key ~= key then
				build(plot, key)
			end
		elseif yards[plot] then
			clear(plot)
		end
	end
end

-- welcome banner when you step onto a piece of land
local insidePlot: Model? = nil
local lastHome = 0
local function checkLand()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local found = nil
	local half = Config.Base.PlotSize / 2
	for _, plot in bases() do
		local frame = plotFrame(plot)
		if frame and (plot:GetAttribute("OwnerId") or 0) ~= 0 then
			local p = frame:PointToObjectSpace(root.Position)
			if math.abs(p.X) <= half and math.abs(p.Z) <= half then
				found = plot
			end
		end
	end
	if found == insidePlot then
		return
	end
	insidePlot = found
	local hud = YardPets.HUD
	if not found or not hud then
		return
	end
	if found:GetAttribute("OwnerId") == player.UserId then
		if os.clock() - lastHome > 30 then
			hud.Toast(T("🏡 Welcome home!"), Color3.fromRGB(140, 230, 160))
		end
		lastHome = os.clock()
	else
		local name = found:GetAttribute("HouseName")
		local title = if type(name) == "string" and name ~= ""
			then name
			else T("%s's House", tostring(found:GetAttribute("OwnerName") or "?"))
		local crown = if found:GetAttribute("BestHouse") then "👑 " else ""
		hud.Toast(
			crown
				.. "🏘️ "
				.. title
				.. "  •  Lv."
				.. tostring(found:GetAttribute("HouseLevel") or 1)
				.. "  ❤️ "
				.. tostring(found:GetAttribute("Likes") or 0),
			Color3.fromRGB(255, 170, 200)
		)
	end
end

task.spawn(function()
	while true do
		pcall(refreshYards)
		pcall(checkLand)
		task.wait(0.5)
	end
end)

local accumulator = 0
RunService.Heartbeat:Connect(function(frameDt)
	accumulator += frameDt
	if accumulator < STEP then
		return
	end
	local dt = math.min(accumulator, 0.2)
	accumulator = 0
	local t = os.clock()
	for plot, yard in yards do
		local frame = plotFrame(plot)
		if not frame or not plot.Parent then
			clear(plot)
			continue
		end
		for i, pet in yard.Pets do
			if pet.Wait > 0 then
				pet.Wait -= dt
			else
				local offset = pet.Target - pet.Pos
				local distance = offset.Magnitude
				if distance < 0.5 then
					pet.Target = randomSpot(plot)
					pet.Wait = rng:NextNumber(1, 4) -- sit for a moment
				else
					pet.Pos += offset.Unit * math.min(distance, SPEED * dt)
				end
			end
			local moving = pet.Wait <= 0
			local hop = if moving then math.abs(math.sin(t * 9 + i)) * 0.5 else 0
			local look = pet.Target - pet.Pos
			local world = frame * CFrame.new(pet.Pos + Vector3.new(0, pet.Lift + hop, 0))
			local facing = if look.Magnitude > 0.1 then frame:VectorToWorldSpace(look.Unit) else world.LookVector
			pet.Model:PivotTo(CFrame.lookAt(world.Position, world.Position + Vector3.new(facing.X, 0, facing.Z) + Vector3.new(0, 0.001, 0)))
		end
	end
end)

return YardPets
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="55">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Client entry point: wires state sync and loads every controller.
]]
local Client = script.Parent

local Net = require(Client:WaitForChild("Net"))
local State = require(Client:WaitForChild("State"))

Net.On("Data", function(payload)
	State.Set(payload)
end)

-- language: saved preference (Settings) or the player's Roblox language
local Players = game:GetService("Players")
local LocalizationService = game:GetService("LocalizationService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lang = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Lang"))
local player = Players.LocalPlayer
local deadline = os.clock() + 8
while player:GetAttribute("Lang") == nil and os.clock() < deadline do
	task.wait(0.1)
end
local forced = player:GetAttribute("Lang")
if forced == "ko" or forced == "en" then
	Lang.SetLocale(forced)
else
	local ok, locale = pcall(function()
		return LocalizationService.RobloxLocaleId
	end)
	Lang.SetLocale(if ok then locale else player.LocaleId)
end

-- the default tool bar would cover our buttons; the pickaxe auto-equips
pcall(function()
	game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local UI = Client:WaitForChild("UI")
local Controllers = Client:WaitForChild("Controllers")

local Panels = require(UI:WaitForChild("Panels"))
local Hatch = require(UI:WaitForChild("Hatch"))
Panels.Provide("Hatch", Hatch)

local HUD = require(Controllers:WaitForChild("HUD"))
Hatch.HUD = HUD
local Mining = require(Controllers:WaitForChild("Mining"))
Mining.HUD = HUD
require(Controllers:WaitForChild("PetFollow"))
require(Controllers:WaitForChild("WorldFX"))
require(Controllers:WaitForChild("MeteorUI"))
require(Controllers:WaitForChild("DevTools"))
require(Controllers:WaitForChild("Guide"))
require(Controllers:WaitForChild("Ambience"))
require(Controllers:WaitForChild("Shards")).HUD = HUD
require(Controllers:WaitForChild("Build")).HUD = HUD
Panels.Provide("HowTo", require(Controllers:WaitForChild("HowTo")))
require(Controllers:WaitForChild("TradeUI")).HUD = HUD
require(Controllers:WaitForChild("YardPets")).HUD = HUD
require(Controllers:WaitForChild("Spectacle"))

-- ask for a fresh snapshot in case the first one arrived before we listened
Net.Fire("Sync")
task.delay(3, function()
	if not State.Ready() then
		Net.Fire("Sync")
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local action = remotes:WaitForChild("Action") :: RemoteEvent
local request = remotes:WaitForChild("Request") :: RemoteFunction
local message = remotes:WaitForChild("Message") :: RemoteEvent

local Net = {}
local handlers = {}

message.OnClientEvent:Connect(function(kind, ...)
	local list = handlers[kind]
	if list then
		for _, fn in list do
			task.spawn(fn, ...)
		end
	end
end)

function Net.Fire(name: string, ...)
	action:FireServer(name, ...)
end

function Net.Invoke(name: string, ...)
	local results = table.pack(pcall(request.InvokeServer, request, name, ...))
	if not results[1] then
		warn("[Net] request failed: " .. tostring(results[2]))
		return nil
	end
	return table.unpack(results, 2, results.n)
end

function Net.On(kind: string, fn)
	handlers[kind] = handlers[kind] or {}
	table.insert(handlers[kind], fn)
end

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[--[[
	Client-side mirror of the player's data + server-computed multipliers.
]]
local State = {
	Data = nil,
	Derived = nil,
	ReceivedAt = 0,
}

local listeners = {}

function State.OnChanged(fn)
	table.insert(listeners, fn)
	if State.Data then
		task.spawn(fn)
	end
end

function State.Set(payload)
	if type(payload) ~= "table" then
		return
	end
	State.Data = payload.Data
	State.Derived = payload.Derived or {}
	State.ReceivedAt = os.clock()
	for _, fn in listeners do
		local ok, err = pcall(fn)
		if not ok then
			warn("[State] listener error: " .. tostring(err))
		end
	end
end

function State.Ready(): boolean
	return State.Data ~= nil
end

function State.Now(): number
	return workspace:GetServerTimeNow()
end

function State.HasPass(key: string): boolean
	local derived = State.Derived
	return derived ~= nil and derived.Passes ~= nil and derived.Passes[key] == true
end

-- remaining seconds of a personal boost, counted down locally between syncs
function State.BoostRemaining(key: string): number
	local data = State.Data
	if not data or not data.Boosts then
		return 0
	end
	local remaining = data.Boosts[key] or 0
	return math.max(0, remaining - (os.clock() - State.ReceivedAt))
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="58">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Hatch</string>
              <string name="Source"><![CDATA[--[[
	Pet reveal: the egg shakes (rising whoosh), cracks, and the pet pops out
	in a 3D viewport with a rarity-coloured flash. Every card says clearly
	WHAT you got and WHERE it went:
	    🔒 safe in your vault · 🏠 on display (earning) · 📦 in storage
	    ⭐ follows you · 💰 sold (storage full) · ✨ NEW (first of its kind)
	Tap anywhere to continue; afterwards the pets fly into the 🐾 Pets button.
	Stolen pets and reward pets use the same card (no egg).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local PetModel = require(Shared.PetModel)
local Lib = require(script.Parent.Lib)
local Root = require(script.Parent.Root)
local Net = require(script.Parent.Parent.Net)

local New, C, T = Lib.New, Lib.Colors, Lib.T
local Hatch = {}
Hatch.Playing = false
Hatch.HUD = nil -- set by Main (fly-to-pets animation)

local dim = New("TextButton", {
	Name = "HatchOverlay",
	Text = "",
	AutoButtonColor = false,
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.35,
	Visible = false,
	ZIndex = 100,
	Parent = Root.Overlay,
})
local holder = Root.Cluster("HatchHolder", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(900, 440), dim)
New("UIListLayout", {
	FillDirection = Enum.FillDirection.Horizontal,
	HorizontalAlignment = Enum.HorizontalAlignment.Center,
	VerticalAlignment = Enum.VerticalAlignment.Center,
	Padding = UDim.new(0, 20),
	Parent = holder,
})
local titleCluster = Root.Cluster("HatchTitle", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.12), UDim2.fromOffset(700, 60), dim)
local title = Lib.Text({ Text = "", Size = UDim2.fromScale(1, 1), MaxTextSize = 46, ZIndex = 104, Parent = titleCluster })
local hintCluster = Root.Cluster("HatchHint", Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -24), UDim2.fromOffset(400, 34), dim)
local hint = Lib.Text({
	Text = "",
	Font = Lib.BodyFont,
	TextColor3 = Color3.fromRGB(220, 220, 230),
	Size = UDim2.fromScale(1, 1),
	MaxTextSize = 20,
	ZIndex = 104,
	Parent = hintCluster,
})

local queue = {}
local skip = false
dim.Activated:Connect(function()
	skip = true
end)

local VARIANT_COLORS = {
	Rainbow = Color3.fromRGB(255, 120, 230),
	Golden = Color3.fromRGB(255, 210, 60),
	Galaxy = Color3.fromRGB(190, 140, 255),
	Frozen = Color3.fromRGB(170, 225, 255),
	Molten = Color3.fromRGB(255, 130, 50),
	Huge = Color3.fromRGB(255, 190, 60),
	Titanic = Color3.fromRGB(255, 120, 60),
}

-- where the pet went, in words + colour
local function placeText(entry): (string, Color3)
	local where = entry.Where
	if where == "Vault" then
		return T("🔒 Safe in your vault"), Color3.fromRGB(110, 170, 255)
	elseif where == "Display" then
		return T("🏠 On display - earning!"), Color3.fromRGB(110, 230, 140)
	elseif where == "Sold" then
		return T("💰 Storage full - sold for %s", Util.Format(entry.Coins or 0)), C.Gold
	elseif where == "Storage" then
		return T("📦 Saved in storage"), Color3.fromRGB(200, 200, 215)
	end
	return "", C.Sub
end

local function slot(entry, eggColor: Color3?)
	local petName, variant = entry.Name, entry.Variant
	local info = Config.Pets[petName]
	local variantColor = variant and VARIANT_COLORS[variant]
	local rarity = Config.Rarities[info.Rarity]
	local frame = New("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(260, 430),
		ZIndex = 101,
		Parent = holder,
	})
	local viewport = New("ViewportFrame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(260, 240),
		ZIndex = 102,
		Ambient = Color3.fromRGB(200, 200, 200),
		LightColor = Color3.new(1, 1, 1),
		Parent = frame,
	})
	local camera = New("Camera", { FieldOfView = 40, Parent = viewport })
	viewport.CurrentCamera = camera
	local egg = nil
	if eggColor then
		egg = New("Part", {
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(4, 4, 4),
			Color = eggColor,
			Material = Enum.Material.SmoothPlastic,
			Anchored = true,
			CFrame = CFrame.new(),
			Parent = viewport,
		}, { New("SpecialMesh", { MeshType = Enum.MeshType.Sphere, Scale = Vector3.new(1, 1.3, 1) }) })
	end
	camera.CFrame = CFrame.new(Vector3.new(0, 0.6, 11), Vector3.new(0, 0, 0))

	local labels = {}
	if entry.New then
		table.insert(
			labels,
			New("Frame", {
				BackgroundColor3 = C.Pink,
				Size = UDim2.fromOffset(150, 30),
				Position = UDim2.new(0.5, -75, 0, 4),
				ZIndex = 105,
				Visible = false,
				Parent = frame,
			}, {
				Lib.Corner(15),
				Lib.Stroke(Color3.new(1, 1, 1), 2, 0),
				Lib.Text({ Text = "✨ NEW! 📖 +1", Size = UDim2.fromScale(1, 1), MaxTextSize = 18, ZIndex = 106 }),
			})
		)
	end
	local name = Util.PetDisplayName(T(petName), variant and T(variant))
	if entry.Serial then
		name ..= " #" .. tostring(entry.Serial)
	end
	table.insert(
		labels,
		Lib.Text({
			Text = name,
			Size = UDim2.new(1, 0, 0, 38),
			Position = UDim2.fromOffset(0, 242),
			MaxTextSize = 32,
			ZIndex = 103,
			Visible = false,
			Parent = frame,
		})
	)
	table.insert(
		labels,
		Lib.Text({
			Text = (if entry.Meteor then "☄️ " .. T("METEOR PET") .. "  " else "") .. (if variant
				then "✨ " .. string.upper(T(variant)) .. " ✨  "
				else "") .. string.upper(T(info.Rarity)) .. (if (entry.Stars or 0) > 0 then "  " .. string.rep("★", entry.Stars) else ""),
			TextColor3 = if entry.Meteor then Color3.fromRGB(255, 160, 80) else variantColor or rarity.Color,
			Size = UDim2.new(1, 0, 0, 30),
			Position = UDim2.fromOffset(0, 280),
			MaxTextSize = 26,
			ZIndex = 103,
			Visible = false,
			Parent = frame,
		})
	)
	-- where it went (only when the server told us)
	local text, color = placeText(entry)
	if text ~= "" then
		table.insert(
			labels,
			New("Frame", {
				BackgroundColor3 = Color3.fromRGB(20, 22, 34),
				BackgroundTransparency = 0.1,
				Size = UDim2.fromOffset(250, 34),
				Position = UDim2.fromOffset(5, 316),
				ZIndex = 103,
				Visible = false,
				Parent = frame,
			}, {
				Lib.Corner(17),
				Lib.Stroke(color, 2.5, 0),
				Lib.Text({
					Text = text,
					TextColor3 = color,
					Size = UDim2.new(1, -12, 1, -6),
					Position = UDim2.fromOffset(6, 3),
					MaxTextSize = 18,
					ZIndex = 104,
				}),
			})
		)
	end
	local income = Util.PetIncome(Config, petName, variant)
	local line
	if entry.Where == "Display" or entry.Where == "Vault" then
		line = T("💰 %s/s in your base", Util.Format(entry.Rate or income))
	elseif entry.Where == "Storage" then
		line = T("Earns 💰%s/s on a pedestal", Util.Format(income))
	elseif entry.Where == "Sold" then
		line = ""
	else
		line = T("💰 %s/s in your base", Util.Format(income))
	end
	if entry.Follow then
		line = (if line ~= "" then line .. "  •  " else "") .. T("⭐ follows you")
	end
	table.insert(
		labels,
		Lib.Text({
			Text = line,
			Font = Lib.BodyFont,
			Size = UDim2.new(1, 0, 0, 24),
			Position = UDim2.fromOffset(0, 356),
			MaxTextSize = 19,
			ZIndex = 103,
			Visible = false,
			Parent = frame,
		})
	)
	return {
		Frame = frame,
		Viewport = viewport,
		Camera = camera,
		Egg = egg,
		Labels = labels,
		Rarity = rarity,
		Entry = entry,
		FlashColor = variantColor or rarity.Color,
	}
end

local function play(pets, eggId, mode)
	Hatch.Playing = true
	skip = false
	Lib.Clear(holder)
	local egg = eggId and Config.Eggs[eggId]
	local stolen = mode == "Stolen"
	local eggColor = if stolen then nil elseif egg then egg.Color else C.Gold
	local slots = {}
	local entries = {}
	for _, raw in pets do
		-- entries are { Name, Variant, Where, ... } (older format: plain name)
		local entry = if type(raw) == "table" then raw else { Name = raw }
		if Config.Pets[entry.Name] then
			table.insert(entries, entry)
			table.insert(slots, slot(entry, eggColor))
		end
	end
	if #slots == 0 then
		Hatch.Playing = false
		return
	end
	title.Text = if stolen then T("🦹 STOLEN!") else ""
	title.TextColor3 = C.Pink
	hint.Text = ""
	dim.Visible = true

	-- shake (eggs only): a rising whoosh while it wobbles
	if eggColor then
		Lib.PlaySound("EggShake")
		local start = os.clock()
		local shakeTime = if egg then 1.3 else 0.5
		while os.clock() - start < shakeTime do
			local t = os.clock() - start
			local intensity = t / shakeTime
			for _, s in slots do
				if s.Egg then
					s.Egg.CFrame = CFrame.Angles(0, 0, math.sin(t * 40) * 0.35 * intensity)
				end
			end
			RunService.RenderStepped:Wait()
		end
		Lib.PlaySound("EggCrack")
	end

	-- reveal
	local best, anyVariant, anyNew, big = 0, false, false, false
	for _, s in slots do
		if s.Egg then
			s.Egg:Destroy()
		end
		local model = PetModel.Build(s.Entry.Name, s.Entry.Variant)
		model.Parent = s.Viewport
		model:PivotTo(CFrame.new())
		local size = model:GetExtentsSize().Magnitude
		s.Camera.CFrame = CFrame.new(Vector3.new(0, size * 0.25, size * 2.4), Vector3.zero)
		s.Model = model
		for _, label in s.Labels do
			label.Visible = true
		end
		Lib.Pop(s.Frame)
		best = math.max(best, s.Rarity.Order)
		anyVariant = anyVariant or s.Entry.Variant ~= nil
		anyNew = anyNew or s.Entry.New == true
		big = big or s.Entry.Variant == "Huge" or s.Entry.Variant == "Titanic"
		local flash = New("Frame", {
			BackgroundColor3 = s.FlashColor,
			BackgroundTransparency = 0.2,
			Size = UDim2.fromOffset(240, 240),
			Position = UDim2.fromOffset(10, 0),
			ZIndex = 101,
			Parent = s.Frame,
		}, { Lib.Corner(120) })
		TweenService:Create(flash, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
	end
	-- the sound matches how special it is
	if big or best >= 6 then
		Lib.PlaySound("Fanfare")
		Lib.PlaySound("Cheer")
	elseif best >= 5 or stolen then
		Lib.PlaySound("Fanfare")
	elseif best >= 3 or anyVariant then
		Lib.PlaySound("RevealRare")
	else
		Lib.PlaySound("Reveal")
	end
	if anyNew then
		task.delay(0.35, function()
			Lib.PlaySound("Discover")
		end)
	end

	-- spin until tapped (or a few seconds)
	skip = false
	task.delay(0.6, function()
		if dim.Visible then
			hint.Text = T("Tap to continue")
		end
	end)
	local spinStart = os.clock()
	local duration = if best >= 5 or big then 4.5 else 3
	while os.clock() - spinStart < duration and not (skip and os.clock() - spinStart > 0.5) do
		for _, s in slots do
			if s.Model then
				s.Model:PivotTo(CFrame.Angles(0, (os.clock() - spinStart) * 2, 0))
			end
		end
		RunService.RenderStepped:Wait()
	end
	dim.Visible = false
	Lib.Clear(holder)
	Hatch.Playing = false
	-- the pets fly into the Pets button (so you see where they went)
	local hud = Hatch.HUD
	if hud and hud.PetsLanded then
		task.spawn(hud.PetsLanded, entries)
	end
end

function Hatch.Play(pets, eggId, mode)
	table.insert(queue, { Pets = pets, Egg = eggId, Mode = mode })
	if Hatch.Playing then
		return
	end
	task.spawn(function()
		while #queue > 0 do
			local item = table.remove(queue, 1)
			local ok, err = pcall(play, item.Pets, item.Egg, item.Mode)
			if not ok then
				warn("[Hatch] " .. tostring(err))
				dim.Visible = false
				Hatch.Playing = false
			end
		end
	end)
end

-- star eggs, rewards, lucky blocks, stolen pets, quick hatches at the stands
Net.On("HatchResult", function(pets, eggId, mode)
	Hatch.Play(pets, eggId, mode)
end)

return Hatch
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Lib</string>
              <string name="Source"><![CDATA[--[[
	Tiny UI toolkit: every screen in the game is built from code with these
	helpers, so there are no Studio-made GUIs to keep in sync.
]]
local Debris = game:GetService("Debris")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Lang = require(ReplicatedStorage.Shared.Lang)

local Lib = {}
Lib.T = Lang.T
Lib.Muted = false

Lib.Colors = {
	Panel = Color3.fromRGB(26, 28, 44),
	PanelLight = Color3.fromRGB(40, 43, 66),
	Card = Color3.fromRGB(52, 56, 86),
	Text = Color3.fromRGB(255, 255, 255),
	Sub = Color3.fromRGB(185, 190, 215),
	Green = Color3.fromRGB(60, 205, 105),
	Blue = Color3.fromRGB(70, 150, 255),
	Purple = Color3.fromRGB(150, 90, 255),
	Gold = Color3.fromRGB(255, 190, 45),
	Red = Color3.fromRGB(235, 75, 90),
	Pink = Color3.fromRGB(255, 90, 200),
	Cyan = Color3.fromRGB(50, 215, 255),
	Gray = Color3.fromRGB(105, 108, 130),
	Coins = Color3.fromRGB(255, 205, 60),
	Gems = Color3.fromRGB(80, 220, 255),
	Stardust = Color3.fromRGB(255, 120, 230),
	Robux = Color3.fromRGB(110, 255, 140),
}
Lib.Font = Enum.Font.FredokaOne
Lib.BodyFont = Enum.Font.GothamBold

function Lib.New(className: string, props: { [string]: any }?, children: { Instance }?)
	local inst = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(inst :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end
local New = Lib.New

function Lib.Corner(radius: number?)
	return New("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Lib.Stroke(color: Color3?, thickness: number?, transparency: number?)
	return New("UIStroke", {
		Color = color or Color3.new(0, 0, 0),
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Lib.Padding(px: number)
	return New("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

function Lib.List(direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?)
	return New("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 6),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Lib.Grid(cell: UDim2, padding: number?)
	return New("UIGridLayout", {
		CellSize = cell,
		CellPadding = UDim2.fromOffset(padding or 8, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
	})
end

function Lib.Gradient(top: Color3, bottom: Color3)
	return New("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = 90,
	})
end

-- TextLabel with outline and sane defaults
function Lib.Text(props)
	local maxSize = props.MaxTextSize or 28
	props.MaxTextSize = nil
	if type(props.Text) == "string" then
		props.Text = Lang.T(props.Text)
	end
	local label = New("TextLabel", {
		BackgroundTransparency = 1,
		Font = props.Font or Lib.Font,
		TextColor3 = props.TextColor3 or Lib.Colors.Text,
		TextScaled = true,
		RichText = true,
		Size = props.Size or UDim2.new(1, 0, 0, 24),
	})
	for key, value in props do
		if key ~= "Parent" and key ~= "Outline" then
			(label :: any)[key] = value
		end
	end
	New("UITextSizeConstraint", { MaxTextSize = maxSize, MinTextSize = 8, Parent = label })
	if props.Outline ~= false then
		New("UIStroke", { Thickness = 1.5, Color = Color3.new(0, 0, 0), Transparency = 0.2, Parent = label })
	end
	if props.Parent then
		label.Parent = props.Parent
	end
	return label
end

-- Play a named sound from Config.Sounds (random variant + pitch variance),
-- or a raw sound id. pitchOffset lets combos/coins rise in pitch.
-- sound effects play in their own group (music has another one, see Ambience)
local sfxGroup = Instance.new("SoundGroup")
sfxGroup.Name = "SFX"
sfxGroup.Volume = 1
sfxGroup.Parent = SoundService
Lib.SfxGroup = sfxGroup
Lib.DuckMusic = nil -- set by Ambience: lowers the music under big stingers

-- load every sound once at start so the first hatch / coin isn't silent
task.spawn(function()
	local list = {}
	for _, def in Config.Sounds do
		for _, id in def.Ids or {} do
			if string.find(id, "rbxassetid://", 1, true) then
				table.insert(list, Lib.New("Sound", { SoundId = id, Parent = sfxGroup }))
			end
		end
	end
	pcall(function()
		game:GetService("ContentProvider"):PreloadAsync(list)
	end)
	for _, sound in list do
		sound:Destroy()
	end
end)

function Lib.PlaySound(name: string?, volumeMult: number?, pitchOffset: number?)
	if not name or name == "" or Lib.Muted then
		return
	end
	local def = Config.Sounds[name]
	local id, volume, pitch
	if type(def) == "table" then
		id = def.Ids[math.random(1, #def.Ids)]
		volume = (def.Volume or 0.5) * (volumeMult or 1)
		pitch = (def.Pitch or 1) + (pitchOffset or 0) + (math.random() * 2 - 1) * (def.Variance or 0)
	else
		id = name
		volume = volumeMult or 0.5
		pitch = 1 + (pitchOffset or 0)
	end
	if not id or id == "" then
		return
	end
	local sound = New("Sound", {
		SoundId = id,
		Volume = volume,
		PlaybackSpeed = math.max(0.1, pitch),
		SoundGroup = sfxGroup,
		Parent = sfxGroup,
	})
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	Debris:AddItem(sound, 12)
	if type(def) == "table" and def.Duck and Lib.DuckMusic then
		Lib.DuckMusic(def.Duck)
	end
end

-- Big chunky game button. props.Color, props.Text, props.OnClick
function Lib.Button(props)
	local color = props.Color or Lib.Colors.Green
	local button = New("TextButton", {
		Name = props.Name or "Button",
		AutoButtonColor = false,
		BackgroundColor3 = color,
		Size = props.Size or UDim2.fromOffset(140, 44),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		LayoutOrder = props.LayoutOrder or 0,
		Text = "",
		ZIndex = props.ZIndex or 1,
		Parent = props.Parent,
	}, {
		Lib.Corner(props.Radius or 12),
		Lib.Stroke(Color3.new(0, 0, 0), 2, 0.35),
		Lib.Gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
	})
	local label = Lib.Text({
		Name = "Label",
		Text = props.Text or "",
		Size = UDim2.new(1, -10, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = props.TextSize or 24,
		ZIndex = (props.ZIndex or 1) + 1,
		Parent = button,
	})
	local scale = New("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.05 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	button.Activated:Connect(function()
		scale.Scale = 0.92
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		Lib.PlaySound("UI")
		if props.OnClick then
			props.OnClick()
		end
	end)
	return button, label
end

function Lib.SetButton(button: TextButton, text: string?, color: Color3?)
	if text then
		(button:FindFirstChild("Label") :: TextLabel).Text = Lang.T(text)
	end
	if color then
		button.BackgroundColor3 = color
	end
end

-- Progress bar: returns frame and setter(ratio, text?)
function Lib.Bar(props)
	local back = New("Frame", {
		Name = props.Name or "Bar",
		BackgroundColor3 = props.Back or Color3.fromRGB(20, 20, 30),
		Size = props.Size or UDim2.new(1, 0, 0, 20),
		Position = props.Position or UDim2.new(),
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, {
		Lib.Corner(props.Radius or 10),
		Lib.Stroke(Color3.new(0, 0, 0), 2, 0.3),
	})
	local fill = New("Frame", {
		Name = "Fill",
		BackgroundColor3 = props.Color or Lib.Colors.Green,
		Size = UDim2.fromScale(0, 1),
		Parent = back,
	}, { Lib.Corner(props.Radius or 10), Lib.Gradient(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200)) })
	local label = Lib.Text({
		Name = "Label",
		Text = "",
		Size = UDim2.new(1, -8, 1, -2),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		MaxTextSize = props.TextSize or 18,
		ZIndex = 3,
		Parent = back,
	})
	local function set(ratio: number, text: string?, color: Color3?)
		fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
		fill.Visible = ratio > 0.001
		if text then
			label.Text = text
		end
		if color then
			fill.BackgroundColor3 = color
		end
	end
	return back, set
end

function Lib.Scroll(props)
	local scroll = New("ScrollingFrame", {
		Name = props.Name or "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = props.Horizontal and Enum.AutomaticSize.X or Enum.AutomaticSize.Y,
		ScrollingDirection = props.Horizontal and Enum.ScrollingDirection.X or Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Color3.fromRGB(200, 200, 220),
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	})
	return scroll
end

function Lib.Clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

function Lib.Pop(gui: GuiObject)
	local scale = gui:FindFirstChildOfClass("UIScale") or New("UIScale", { Parent = gui })
	scale.Scale = 0.6
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Real Robux prices (falls back to the suggested price in Config)
local priceCache = {}
function Lib.Price(kind: string, key: string): number
	local entry = if kind == "Pass" then Config.GamePasses[key] else Config.Products[key]
	if not entry then
		return 0
	end
	if entry.Id == 0 then
		return entry.Price
	end
	local cacheKey = kind .. key
	if priceCache[cacheKey] == nil then
		priceCache[cacheKey] = entry.Price
		task.spawn(function()
			local ok, info = pcall(
				MarketplaceService.GetProductInfo,
				MarketplaceService,
				entry.Id,
				if kind == "Pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
			)
			if ok and info and info.PriceInRobux then
				priceCache[cacheKey] = info.PriceInRobux
			end
		end)
	end
	return priceCache[cacheKey]
end

return Lib
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[--[[
	Panel manager: one modal window at a time. Each panel module returns
	{ Title, Color, Build(content, ctx) -> { Refresh(arg), OnOpen(arg) } }.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Lib = require(script.Parent.Lib)
local Root = require(script.Parent.Root)
local State = require(script.Parent.Parent.State)

local Panels = {}
Panels.Current = nil
Panels.CurrentArg = nil

local New = Lib.New
local C = Lib.Colors

-- dim backdrop: the HUD stays visible but clearly behind the panel; tap it to close
local backdrop = New("TextButton", {
	Name = "Backdrop",
	Text = "",
	AutoButtonColor = false,
	BackgroundColor3 = Color3.new(0, 0, 0),
	BackgroundTransparency = 0.45,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 0,
	Parent = Root.PanelGui,
})
local cluster = Root.Cluster("Panels", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.52), UDim2.fromOffset(700, 500), Root.PanelGui)
local registry = {}
local opened = {} -- [name] = { Window, Api }

local ctx = {
	Lib = Lib,
	State = State,
	Net = require(script.Parent.Parent.Net),
	Config = require(ReplicatedStorage.Shared.Config),
	Util = require(ReplicatedStorage.Shared.Util),
	Panels = Panels,
}

-- share other systems with panels (Upsell, Hatch, Toast)
function Panels.Provide(key: string, value: any)
	ctx[key] = value
end

local function makeWindow(name: string, def)
	local window = New("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Panel,
		Visible = false,
		Parent = cluster,
	}, {
		Lib.Corner(20),
		Lib.Stroke(Color3.new(0, 0, 0), 3, 0.2),
	})
	local header = New("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 58),
		BackgroundColor3 = def.Color or C.Blue,
		Parent = window,
	}, {
		Lib.Corner(20),
		Lib.Gradient(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)),
	})
	-- square off the header's bottom corners
	New("Frame", {
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.new(0, 0, 1, -20),
		BackgroundColor3 = def.Color or C.Blue,
		BorderSizePixel = 0,
		Parent = header,
	}, { Lib.Gradient(Color3.fromRGB(205, 205, 205), Color3.fromRGB(170, 170, 170)) })
	Lib.Text({
		Name = "Title",
		Text = def.Title or name,
		Size = UDim2.new(1, -140, 0, 40),
		Position = UDim2.fromOffset(20, 9),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 34,
		ZIndex = 2,
		Parent = header,
	})
	Lib.Button({
		Name = "Close",
		Text = "X",
		Color = C.Red,
		Size = UDim2.fromOffset(46, 46),
		Position = UDim2.new(1, -54, 0, 6),
		ZIndex = 3,
		Parent = header,
		OnClick = function()
			Panels.Close()
		end,
	})
	local content = New("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(14, 68),
		Size = UDim2.new(1, -28, 1, -80),
		Parent = window,
	})
	return window, content
end

function Panels.Register(name: string, def)
	registry[name] = def
end

local function ensure(name: string)
	if opened[name] then
		return opened[name]
	end
	local def = registry[name]
	if not def then
		return nil
	end
	local window, content = makeWindow(name, def)
	local ok, api = pcall(def.Build, content, ctx)
	if not ok then
		warn("[Panels] failed to build " .. name .. ": " .. tostring(api))
		api = {}
	end
	opened[name] = { Window = window, Api = api or {} }
	return opened[name]
end

function Panels.Open(name: string, arg: any?)
	if not State.Ready() then
		return
	end
	local entry = ensure(name)
	if not entry then
		return
	end
	if Panels.Current and Panels.Current ~= name and opened[Panels.Current] then
		opened[Panels.Current].Window.Visible = false
	end
	if Panels.Current ~= name then
		Lib.PlaySound("Open")
	end
	Panels.Current = name
	Panels.CurrentArg = arg
	backdrop.Visible = true
	entry.Window.Visible = true
	Lib.Pop(entry.Window)
	for _, hook in { "OnOpen", "Refresh" } do
		if entry.Api[hook] then
			local ok, err = pcall(entry.Api[hook], arg)
			if not ok then
				warn(string.format("[Panels] %s.%s failed: %s", name, hook, tostring(err)))
			end
		end
	end
end

function Panels.Close()
	local name = Panels.Current
	if name then
		Lib.PlaySound("Close")
	end
	if name and opened[name] then
		local window = opened[name].Window
		local scale = window:FindFirstChildOfClass("UIScale")
		if scale then
			local tween = TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 0.85 })
			tween:Play()
			tween.Completed:Once(function()
				if Panels.Current ~= name then
					window.Visible = false
				end
			end)
		else
			window.Visible = false
		end
	end
	Panels.Current = nil
	Panels.CurrentArg = nil
	backdrop.Visible = false
end

function Panels.Toggle(name: string, arg: any?)
	if Panels.Current == name then
		Panels.Close()
	else
		Panels.Open(name, arg)
	end
end

function Panels.RefreshCurrent()
	local name = Panels.Current
	local entry = name and opened[name]
	if entry and entry.Api.Refresh then
		local ok, err = pcall(entry.Api.Refresh, Panels.CurrentArg)
		if not ok then
			warn(string.format("[Panels] %s.Refresh failed: %s", name, tostring(err)))
		end
	end
end

backdrop.Activated:Connect(function()
	Panels.Close()
end)

State.OnChanged(Panels.RefreshCurrent)
task.spawn(function()
	while true do
		task.wait(1)
		local name = Panels.Current
		local entry = name and opened[name]
		if entry and entry.Api.Tick then
			pcall(entry.Api.Tick, Panels.CurrentArg)
		end
	end
end)

for _, module in script:GetChildren() do
	if module:IsA("ModuleScript") then
		local ok, def = pcall(require, module)
		if ok and type(def) == "table" then
			Panels.Register(def.Name or module.Name, def)
		else
			warn("[Panels] failed to load " .. module.Name .. ": " .. tostring(def))
		end
	end
end

return Panels
]]></string>
            </Properties>
            <Item class="ModuleScript" referent="62">
              <Properties>
                <string name="Name">Codes</string>
                <string name="Source"><![CDATA[-- Promo codes: free rewards for players who find codes on YouTube / TikTok /
-- Discord / the group wall. Cheap, proven growth loop on Roblox.
local Codes = { Title = "🎟 CODES", Color = Color3.fromRGB(120, 200, 90) }

function Codes.Build(content, ctx)
	local Lib, State, Net = ctx.Lib, ctx.State, ctx.Net
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T

	Lib.Text({
		Text = "Enter a code for free rewards!",
		Size = UDim2.new(1, 0, 0, 36),
		Position = UDim2.fromOffset(0, 20),
		MaxTextSize = 30,
		Parent = content,
	})
	local box = New("TextBox", {
		PlaceholderText = T("Type code here..."),
		Text = "",
		ClearTextOnFocus = false,
		Font = Lib.Font,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		PlaceholderColor3 = Color3.fromRGB(150, 150, 170),
		BackgroundColor3 = C.Card,
		Size = UDim2.new(0.8, 0, 0, 64),
		Position = UDim2.new(0.1, 0, 0, 80),
		Parent = content,
	}, { Lib.Corner(14), Lib.Stroke(C.Gold, 2, 0.2), Lib.Padding(10) })
	local status = Lib.Text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 30),
		Position = UDim2.fromOffset(0, 230),
		MaxTextSize = 24,
		Parent = content,
	})
	local busy = false
	Lib.Button({
		Text = "🎁 REDEEM",
		Color = C.Green,
		Size = UDim2.fromOffset(260, 60),
		Position = UDim2.new(0.5, -130, 0, 160),
		TextSize = 28,
		Parent = content,
		OnClick = function()
			if busy then
				return
			end
			busy = true
			local ok, message = Net.Invoke("RedeemCode", box.Text)
			busy = false
			status.Text = (if ok then "✅ " else "❌ ") .. tostring(message or T("Try again"))
			status.TextColor3 = if ok then C.Green else C.Red
			Lib.Pop(status)
			if ok then
				box.Text = ""
				Lib.PlaySound("Reward")
			end
		end,
	})
	Lib.Text({
		Text = "👍 Like & ⭐ favorite the game - new codes at like milestones!\nFind codes on our group, YouTube and TikTok.",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		TextWrapped = true,
		Size = UDim2.new(1, -40, 0, 60),
		Position = UDim2.fromOffset(20, 290),
		MaxTextSize = 16,
		Parent = content,
	})
	local redeemed = Lib.Text({
		Text = "",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 360),
		MaxTextSize = 14,
		Parent = content,
	})

	return {
		Refresh = function()
			local data = State.Data
			if data and data.Codes then
				local n = 0
				for _ in data.Codes do
					n += 1
				end
				redeemed.Text = T("Codes redeemed: %d", n)
			end
		end,
	}
end

return Codes
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="63">
              <Properties>
                <string name="Name">Egg</string>
                <string name="Source"><![CDATA[-- Egg shop: shows exact odds (incl. your luck) and what each pet earns
-- BEFORE buying - required for paid random items and good for trust.
-- Coin eggs restock every 5 minutes (stock + countdown shown here).
-- Golden Egg is hidden where restricted.
local Egg = { Title = "🥚 EGG", Color = Color3.fromRGB(255, 200, 70) }

local CURRENCY_ICON = { Coins = "💰", Gems = "💎", Stardust = "✨" }

function Egg.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T
	local eggId = "Meadow"
	local hatching = false

	local info = Lib.Text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		Parent = content,
	})
	local luckLabel = Lib.Text({
		Text = "",
		Font = Lib.BodyFont,
		TextColor3 = C.Green,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 16,
		Parent = content,
	})
	local grid = Lib.Scroll({ Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, 0, 1, -122), Parent = content })
	Lib.Grid(UDim2.fromOffset(150, 96), 8).Parent = grid
	Lib.Padding(4).Parent = grid

	local buttons = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.new(0, 0, 1, -58),
		Size = UDim2.new(1, 0, 0, 56),
		Parent = content,
	}, { Lib.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center) })

	local function hatch(count: number)
		if hatching then
			return
		end
		local egg = Config.Eggs[eggId]
		if egg.Currency == "Robux" then
			Net.Fire("BuyProduct", if count == 3 then egg.ProductTriple else egg.ProductSingle)
			return
		end
		if count == 3 and not State.HasPass("TripleHatch") then
			if ctx.Upsell then
				ctx.Upsell.Pass("TripleHatch", true)
			end
			return
		end
		hatching = true
		local result = Net.Invoke("Hatch", eggId, count)
		hatching = false
		if type(result) ~= "table" then
			return
		end
		if result.Error then
			ctx.Toast(result.Error, C.Red)
			if result.Upsell and ctx.Upsell then
				ctx.Upsell.Pass(result.Upsell, true)
			end
			return
		end
		if ctx.Hatch then
			ctx.Hatch.Play(result.Pets, eggId)
		end
	end

	local single = Lib.Button({
		Size = UDim2.fromOffset(190, 50),
		LayoutOrder = 1,
		Parent = buttons,
		OnClick = function()
			hatch(1)
		end,
	})
	local triple = Lib.Button({
		Size = UDim2.fromOffset(190, 50),
		LayoutOrder = 2,
		Color = C.Purple,
		Parent = buttons,
		OnClick = function()
			hatch(3)
		end,
	})
	local lucky = Lib.Button({
		Text = "🍀 Lucky Hatch",
		Size = UDim2.fromOffset(170, 50),
		LayoutOrder = 3,
		Color = C.Gold,
		Parent = buttons,
		OnClick = function()
			if ctx.Upsell then
				ctx.Upsell.Pass("Lucky", true)
			end
		end,
	})

	local builtFor = nil
	local cards = {}

	local function buildCards()
		Lib.Clear(grid)
		cards = {}
		local egg = Config.Eggs[eggId]
		for i, entry in egg.Pets do
			local petName = entry[1]
			local pet = Config.Pets[petName]
			local rarity = Config.Rarities[pet.Rarity]
			local card = New("Frame", {
				BackgroundColor3 = C.Card,
				LayoutOrder = i,
				Parent = grid,
			}, { Lib.Corner(12), Lib.Stroke(rarity.Color, 3, 0) })
			local name = Lib.Text({
				Text = petName,
				Size = UDim2.new(1, -8, 0, 24),
				Position = UDim2.fromOffset(4, 4),
				MaxTextSize = 18,
				Parent = card,
			})
			Lib.Text({
				Text = string.upper(T(pet.Rarity)),
				TextColor3 = rarity.Color,
				Size = UDim2.new(1, -8, 0, 18),
				Position = UDim2.fromOffset(4, 28),
				MaxTextSize = 14,
				Parent = card,
			})
			local chance =
				Lib.Text({ Text = "", Size = UDim2.new(1, -8, 0, 22), Position = UDim2.fromOffset(4, 48), MaxTextSize = 20, Parent = card })
			Lib.Text({
				Text = "💰" .. Util.Format(pet.Income) .. "/s",
				Font = Lib.BodyFont,
				TextColor3 = C.Coins,
				Size = UDim2.new(1, -8, 0, 18),
				Position = UDim2.fromOffset(4, 72),
				MaxTextSize = 14,
				Parent = card,
			})
			cards[petName] = { Chance = chance, Name = name }
		end
	end

	local function refresh()
		local data, derived = State.Data, State.Derived
		if not data then
			return
		end
		luckLabel.TextColor3 = C.Green
		local egg = Config.Eggs[eggId]
		if builtFor ~= eggId then
			builtFor = eggId
			buildCards()
		end
		local luck = derived.Luck or 1
		local odds = Util.Odds(egg.Pets, function(name, weight)
			local rarity = Config.Rarities[Config.Pets[name].Rarity]
			if rarity.Order >= Config.LuckAffectsFromRarity then
				return weight * luck
			end
			return weight
		end)
		for petName, card in cards do
			card.Chance.Text = Util.FormatPercent(odds[petName] or 0)
			local discovered = data.PetIndex[petName] == true
			card.Name.Text = (if discovered then "✅ " else "") .. T(petName)
		end

		local luckText = T("🍀 Your luck: x%s", string.format("%.2f", luck))
		if (workspace:GetAttribute("Server_ServerLuck") or 0) > State.Now() then
			luckText ..= "  •  " .. T("🌟 SERVER LUCK ACTIVE!")
		end
		luckLabel.Text = luckText
		lucky.Visible = not State.HasPass("Lucky")

		if egg.Currency == "Robux" then
			local restricted = derived.PaidRandomRestricted
			info.Text = T("%s  •  exclusive pets, only from this egg", egg.Name)
			single.Visible = not restricted
			triple.Visible = not restricted
			Lib.SetButton(single, T("Hatch 1  R$%s", Lib.Price("Product", egg.ProductSingle)), C.Green)
			Lib.SetButton(triple, T("Hatch 3  R$%s", Lib.Price("Product", egg.ProductTriple)), C.Purple)
			if restricted then
				luckLabel.Text = T("This egg is not available in your region.")
				luckLabel.TextColor3 = C.Red
			else
				luckLabel.TextColor3 = C.Green
			end
		else
			local icon = CURRENCY_ICON[egg.Currency]
			local locked = data.ZoneLevel < egg.Zone
			info.Text = T("%s  •  %s %s each", egg.Name, icon, Util.Format(egg.Price))
			single.Visible = true
			triple.Visible = true
			local balance = data[egg.Currency] or 0
			-- restocking eggs: how many are left for us + time to the next restock
			local now = State.Now()
			local slot = Util.ShopSlot(Config, now)
			local stock = Util.EggStock(Config, eggId, slot)
			local left = nil
			if stock then
				local shop = data.Shop
				local bought = if shop and shop.Slot == slot then (shop.Bought[eggId] or 0) else 0
				left = math.max(0, stock - bought)
				local wait = Util.FormatTime(Util.ShopRestockIn(Config, now))
				luckLabel.Text = luckLabel.Text .. "  •  " .. T("📦 %d left  •  🔄 new stock in %s", left, wait)
			end
			if left == 0 then
				Lib.SetButton(single, T("SOLD OUT  •  %s", Util.FormatTime(Util.ShopRestockIn(Config, now))), C.Gray)
			else
				Lib.SetButton(
					single,
					if locked then "🔒 Unlock zone" else T("Hatch 1  %s", icon .. Util.Format(egg.Price)),
					if balance >= egg.Price then C.Green else C.Red
				)
			end
			local tripleText = if State.HasPass("TripleHatch") then T("Hatch 3  %s", icon .. Util.Format(egg.Price * 3)) else "🔒 Hatch 3"
			Lib.SetButton(triple, tripleText, C.Purple)
		end
	end

	-- tick the restock countdown while the panel is open
	task.spawn(function()
		while content.Parent do
			task.wait(1)
			local window = content.Parent
			if window and window:IsA("GuiObject") and window.Visible and Config.Eggs[eggId].Stock then
				refresh()
			end
		end
	end)

	return {
		OnOpen = function(arg)
			if type(arg) == "string" and Config.Eggs[arg] then
				eggId = arg
			end
			local window = content.Parent
			local title = window and window:FindFirstChild("Header") and window.Header:FindFirstChild("Title")
			if title then
				title.Text = "🥚 " .. string.upper(T(Config.Eggs[eggId].Name))
			end
		end,
		Refresh = refresh,
	}
end

return Egg
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="64">
              <Properties>
                <string name="Name">Gifts</string>
                <string name="Source"><![CDATA[-- Playtime gifts: claimable after N minutes in this session (session length)
local Gifts = { Title = "🎁 FREE GIFTS", Color = Color3.fromRGB(255, 90, 160) }

function Gifts.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T

	Lib.Text({
		Text = "Stay in the game to unlock free gifts!",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		Size = UDim2.new(1, 0, 0, 22),
		MaxTextSize = 18,
		Parent = content,
	})
	local grid = New(
		"Frame",
		{ BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 1, -32), Parent = content },
		{
			Lib.Grid(UDim2.fromOffset(150, 160), 12),
		}
	)
	local boxes = {}
	for i, gift in Config.PlaytimeGifts do
		local box = New(
			"Frame",
			{ BackgroundColor3 = C.Card, LayoutOrder = i, Parent = grid },
			{ Lib.Corner(14), Lib.Stroke(C.Pink, 2, 0.2) }
		)
		Lib.Text({ Text = "🎁", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 6), MaxTextSize = 40, Parent = box })
		Lib.Text({
			Text = Util.RewardText(gift.Reward, T),
			Size = UDim2.new(1, -10, 0, 40),
			Position = UDim2.fromOffset(5, 52),
			TextWrapped = true,
			MaxTextSize = 18,
			Parent = box,
		})
		local button = Lib.Button({
			Size = UDim2.new(1, -16, 0, 44),
			Position = UDim2.new(0, 8, 1, -52),
			Parent = box,
			OnClick = function()
				Net.Fire("ClaimGift", i)
			end,
		})
		boxes[i] = { Button = button, Gift = gift }
	end

	local function refresh()
		local derived = State.Derived
		if not derived then
			return
		end
		local elapsed = State.Now() - (derived.SessionStart or State.Now())
		local claimed = {}
		for _, index in derived.GiftsClaimed or {} do
			claimed[index] = true
		end
		for i, box in boxes do
			local remaining = box.Gift.Minutes * 60 - elapsed
			if claimed[i] then
				Lib.SetButton(box.Button, "✅ Claimed", C.Gray)
			elseif remaining <= 0 then
				Lib.SetButton(box.Button, "CLAIM!", C.Green)
			else
				Lib.SetButton(box.Button, Util.FormatTime(remaining), Color3.fromRGB(70, 72, 92))
			end
		end
	end

	return { Refresh = refresh, Tick = refresh }
end

return Gifts
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="65">
              <Properties>
                <string name="Name">Houses</string>
                <string name="Source"><![CDATA[--[[
	Houses: every house in this server, most liked first.
	Visit one (you arrive at its gate), tap the ❤️ post there to like it -
	the owner gets gems + ranked points. Your own house: "Go home".
]]
local Players = game:GetService("Players")

local Houses = { Title = "🏘️ HOUSES", Color = Color3.fromRGB(255, 130, 170) }

local LEVEL_ICONS = { "🏡", "🏘️", "🏛️", "🏰", "🌌" }

function Houses.Build(content, ctx)
	local Lib, Net, Util = ctx.Lib, ctx.Net, ctx.Util
	local New, C, T = Lib.New, Lib.Colors, Lib.T
	local player = Players.LocalPlayer

	Lib.Text({
		Text = "Visit houses in this server • tap ❤️ at their gate to like them",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		Size = UDim2.new(1, 0, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 15,
		Parent = content,
	})
	local list = Lib.Scroll({ Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 1, -30), Parent = content })
	Lib.List(Enum.FillDirection.Vertical, 8).Parent = list
	Lib.Padding(4).Parent = list

	local function houses()
		local result = {}
		local map = workspace:FindFirstChild("Map")
		local bases = map and map:FindFirstChild("Bases")
		for _, plot in (bases and bases:GetChildren() or {}) do
			local ownerId = plot:GetAttribute("OwnerId")
			if type(ownerId) == "number" and ownerId ~= 0 then
				table.insert(result, {
					OwnerId = ownerId,
					Name = plot:GetAttribute("HouseName") or "",
					Owner = plot:GetAttribute("OwnerName") or "?",
					Level = plot:GetAttribute("HouseLevel") or 1,
					Likes = plot:GetAttribute("Likes") or 0,
					Rate = plot:GetAttribute("Rate") or 0,
					Protection = plot:GetAttribute("Protection") or "",
					Best = plot:GetAttribute("BestHouse") == true,
				})
			end
		end
		table.sort(result, function(a, b)
			if a.Likes ~= b.Likes then
				return a.Likes > b.Likes
			end
			if a.Level ~= b.Level then
				return a.Level > b.Level
			end
			return a.OwnerId < b.OwnerId
		end)
		return result
	end

	local signature = ""
	local function refresh()
		local entries = houses()
		local parts = {}
		for _, h in entries do
			table.insert(parts, table.concat({ h.OwnerId, h.Name, h.Level, h.Likes, h.Rate, h.Protection, tostring(h.Best) }, ":"))
		end
		local sig = table.concat(parts, ",")
		if sig == signature then
			return
		end
		signature = sig
		Lib.Clear(list)
		for order, h in entries do
			local mine = h.OwnerId == player.UserId
			local row = New("Frame", {
				BackgroundColor3 = if mine then Color3.fromRGB(45, 70, 60) else C.Card,
				Size = UDim2.new(1, -12, 0, 64),
				LayoutOrder = order,
				Parent = list,
			}, { Lib.Corner(12), Lib.Stroke(if order == 1 then C.Gold else Color3.new(0, 0, 0), 2, if order == 1 then 0 else 0.5) })
			local medal = if h.Best then "👑 " elseif order == 2 then "🥈 " elseif order == 3 then "🥉 " else ""
			local title = if h.Name ~= "" then h.Name else T("%s's House", h.Owner)
			Lib.Text({
				Text = medal .. (LEVEL_ICONS[h.Level] or "🏠") .. " " .. title,
				Size = UDim2.new(1, -200, 0, 30),
				Position = UDim2.fromOffset(12, 4),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 21,
				Parent = row,
			})
			local shield = if h.Protection == "locked"
				then "🔒"
				elseif h.Protection == "newbie" or h.Protection == "shield" then "🛡️"
				else ""
			Lib.Text({
				Text = T("by %s  •  Lv.%d  •  ❤️ %s  •  💰%s/s", h.Owner, h.Level, Util.Comma(h.Likes), Util.Format(h.Rate))
					.. " "
					.. shield,
				Font = Lib.BodyFont,
				TextColor3 = C.Sub,
				Size = UDim2.new(1, -200, 0, 20),
				Position = UDim2.fromOffset(12, 36),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 14,
				Parent = row,
			})
			Lib.Button({
				Text = if mine then "🏠 Go home" else "🚪 Visit",
				Color = if mine then C.Green else C.Pink,
				Size = UDim2.fromOffset(170, 46),
				Position = UDim2.new(1, -180, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				TextSize = 19,
				Parent = row,
				OnClick = function()
					if mine then
						Net.Fire("GoBase")
					else
						Net.Fire("VisitBase", h.OwnerId)
					end
					ctx.Panels.Close()
				end,
			})
		end
		if #entries == 0 then
			Lib.Text({ Text = T("No houses yet"), Size = UDim2.new(1, 0, 0, 40), Parent = list })
		end
	end

	return {
		Refresh = refresh,
		Tick = refresh,
		OnOpen = function()
			signature = ""
			refresh()
		end,
	}
end

return Houses
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="66">
              <Properties>
                <string name="Name">Index</string>
                <string name="Source"><![CDATA[--[[
	📖 Index: every pet in the game, egg by egg. Discovered pets show their
	colour and name, missing ones are "?" - so you always know what to hunt.
	Milestones (5, 10, 15 ... pets) pay gems and a PERMANENT home income
	bonus; completing an egg's set adds a little more.
]]
local Index = { Title = "📖 INDEX", Color = Color3.fromRGB(110, 190, 255) }

local EGG_ICONS = {
	Meadow = "🌿",
	Gem = "💎",
	Cosmic = "🌌",
	Frost = "❄️",
	Lava = "🔥",
	Void = "🔮",
	Meteor = "☄️",
}

function Index.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C, T = Lib.New, Lib.Colors, Lib.T

	local header = Lib.Text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		Parent = content,
	})
	-- milestones: a row of reward chips
	local milestones = Lib.Scroll({
		Horizontal = true,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 74),
		Parent = content,
	})
	Lib.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left).Parent = milestones
	local list = Lib.Scroll({ Position = UDim2.fromOffset(0, 110), Size = UDim2.new(1, 0, 1, -110), Parent = content })
	Lib.List(Enum.FillDirection.Vertical, 10).Parent = list
	Lib.Padding(4).Parent = list

	local function claim(index: number)
		local result = Net.Invoke("IndexClaim", index)
		if type(result) == "table" and result.Ok then
			Lib.PlaySound("Fanfare")
			ctx.Toast(
				if (result.Bonus or 0) > 0
					then T("📖 +%s 💎 and +%d%% home income forever!", Util.Format(result.Gems), math.floor(result.Bonus * 100))
					else T("📖 +%s 💎!", Util.Format(result.Gems)),
				C.Gold
			)
		elseif type(result) == "table" and result.Error then
			Lib.PlaySound("Error")
			ctx.Toast(result.Error, C.Red)
		end
	end

	local function setPets(eggId: string): { string }
		if eggId == "Meteor" then
			return Config.Meteor.MeteorPets
		end
		local names = {}
		for _, entry in Config.Eggs[eggId].Pets do
			table.insert(names, entry[1])
		end
		return names
	end

	local signature = ""
	local function refresh()
		local data = State.Data
		if not data then
			return
		end
		local count = Util.IndexCount(data)
		local claimed = data.IndexClaimed or {}
		local sets = Util.IndexSets(Config, data)
		local parts = { tostring(count) }
		for key in claimed do
			table.insert(parts, key)
		end
		for name in data.PetIndex do
			table.insert(parts, name)
		end
		table.sort(parts)
		local sig = table.concat(parts, ",")
		if sig == signature then
			return
		end
		signature = sig
		local total = 0
		for _ in Config.Pets do
			total += 1
		end
		header.Text = T(
			"📖 %d/%d pets discovered  •  🏠 +%d%% income forever",
			count,
			total,
			math.floor(Util.IndexBonus(Config, data) * 100 + 0.5)
		)

		Lib.Clear(milestones)
		for i, milestone in Config.Index.Milestones do
			local done = claimed[tostring(i)] == true
			local ready = not done and count >= milestone.Count
			local chip = New("Frame", {
				BackgroundColor3 = if done then Color3.fromRGB(40, 70, 55) elseif ready then Color3.fromRGB(90, 70, 20) else C.Card,
				Size = UDim2.fromOffset(122, 68),
				LayoutOrder = i,
				Parent = milestones,
			}, { Lib.Corner(12), Lib.Stroke(if ready then C.Gold elseif done then C.Green else C.Sub, 2, if ready then 0 else 0.5) })
			Lib.Text({
				Text = T("🐾 %d pets", milestone.Count),
				Size = UDim2.new(1, -8, 0, 22),
				Position = UDim2.fromOffset(4, 4),
				MaxTextSize = 16,
				Parent = chip,
			})
			Lib.Text({
				Text = "💎" .. Util.Format(milestone.Gems or 0) .. (if milestone.Bonus
					then "  🏠+" .. math.floor(milestone.Bonus * 100) .. "%"
					else ""),
				TextColor3 = C.Gold,
				Size = UDim2.new(1, -8, 0, 18),
				Position = UDim2.fromOffset(4, 26),
				MaxTextSize = 14,
				Parent = chip,
			})
			if ready then
				local button = New("TextButton", {
					Text = "",
					BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 1),
					Parent = chip,
				})
				button.Activated:Connect(function()
					claim(i)
				end)
			end
			Lib.Text({
				Text = if done
					then T("✅ claimed")
					elseif ready then T("👆 CLAIM!")
					else string.format("%d/%d", math.min(count, milestone.Count), milestone.Count),
				TextColor3 = if done then C.Green elseif ready then C.Gold else C.Sub,
				Size = UDim2.new(1, -8, 0, 18),
				Position = UDim2.fromOffset(4, 46),
				MaxTextSize = 14,
				Parent = chip,
			})
		end

		Lib.Clear(list)
		for order, set in sets do
			local section = New("Frame", {
				BackgroundColor3 = C.Card,
				BackgroundTransparency = 0.2,
				Size = UDim2.new(1, -8, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = order,
				Parent = list,
			}, { Lib.Corner(12), Lib.Padding(6) })
			Lib.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Left).Parent = section
			local eggName = if set.Egg == "Meteor" then T("☄️ Meteor pets (only from meteors)") else T(Config.Eggs[set.Egg].Name)
			Lib.Text({
				Text = string.format("%s %s  %d/%d", EGG_ICONS[set.Egg] or "🥚", eggName, set.Have, set.Total)
					.. (if set.Done then "  ✅ +" .. math.floor(Config.Index.SetBonus * 100) .. "%" else ""),
				TextColor3 = if set.Done then C.Green else C.Text,
				Size = UDim2.new(1, 0, 0, 24),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 18,
				LayoutOrder = 1,
				Parent = section,
			})
			local grid = New("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 2,
				Parent = section,
			})
			local layout = Lib.Grid(UDim2.fromOffset(92, 78), 6)
			layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
			layout.Parent = grid
			for i, name in setPets(set.Egg) do
				local info = Config.Pets[name]
				local found = data.PetIndex[name] == true
				local rarity = info and Config.Rarities[info.Rarity]
				local tile = New("Frame", {
					BackgroundColor3 = if found then Color3.fromRGB(34, 38, 54) else Color3.fromRGB(22, 24, 32),
					LayoutOrder = i,
					Parent = grid,
				}, { Lib.Corner(10), Lib.Stroke(if found and rarity then rarity.Color else Color3.fromRGB(70, 70, 85), 2, 0) })
				New("Frame", {
					Size = UDim2.fromOffset(34, 34),
					Position = UDim2.new(0.5, 0, 0, 6),
					AnchorPoint = Vector2.new(0.5, 0),
					BackgroundColor3 = if found and info then info.Color else Color3.fromRGB(45, 45, 55),
					Parent = tile,
				}, {
					Lib.Corner(17),
					Lib.Text({ Text = if found then "" else "?", Size = UDim2.fromScale(1, 1), MaxTextSize = 22 }),
				})
				Lib.Text({
					Text = if found then T(name) else "???",
					Size = UDim2.new(1, -6, 0, 16),
					Position = UDim2.fromOffset(3, 42),
					MaxTextSize = 12,
					Parent = tile,
				})
				Lib.Text({
					Text = if info then T(info.Rarity) else "",
					Font = Lib.BodyFont,
					TextColor3 = if rarity then rarity.Color else C.Sub,
					Size = UDim2.new(1, -6, 0, 14),
					Position = UDim2.fromOffset(3, 58),
					MaxTextSize = 11,
					Parent = tile,
				})
			end
		end
	end

	return {
		Refresh = refresh,
		OnOpen = function()
			signature = ""
			refresh()
		end,
	}
end

return Index
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="67">
              <Properties>
                <string name="Name">Pass</string>
                <string name="Source"><![CDATA[-- Season pass: free + premium tracks, XP bar, premium / skip upsells
local Pass = { Title = "🎫 SEASON PASS", Color = Color3.fromRGB(255, 120, 60) }

function Pass.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T

	local title = Lib.Text({
		Text = Config.Season.Name,
		Size = UDim2.new(0.5, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 22,
		Parent = content,
	})
	local tierText = Lib.Text({
		Text = "",
		Size = UDim2.new(0.5, 0, 0, 26),
		Position = UDim2.fromScale(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 22,
		Parent = content,
	})
	local _, setXp = Lib.Bar({ Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 30), Color = C.Gold, Parent = content })

	local actions = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 0, 44),
		Parent = content,
	}, { Lib.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center) })
	local premiumButton = Lib.Button({
		Size = UDim2.fromOffset(230, 42),
		Color = C.Gold,
		LayoutOrder = 1,
		Parent = actions,
		OnClick = function()
			Net.Fire("BuyProduct", "SeasonPremium")
		end,
	})
	local skipButton = Lib.Button({
		Size = UDim2.fromOffset(200, 42),
		Color = C.Purple,
		LayoutOrder = 2,
		Parent = actions,
		OnClick = function()
			Net.Fire("BuyProduct", "SkipTiers")
		end,
	})
	Lib.Button({
		Text = "✅ Claim All",
		Size = UDim2.fromOffset(150, 42),
		Color = C.Green,
		LayoutOrder = 3,
		Parent = actions,
		OnClick = function()
			Net.Fire("ClaimAllTiers")
		end,
	})

	local lanes =
		New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 108), Size = UDim2.new(1, 0, 1, -108), Parent = content })
	Lib.Text({
		Text = "FREE",
		TextColor3 = C.Sub,
		Size = UDim2.fromOffset(70, 20),
		Position = UDim2.fromOffset(0, 70),
		MaxTextSize = 16,
		Parent = lanes,
	})
	Lib.Text({
		Text = "PREMIUM",
		TextColor3 = C.Gold,
		Size = UDim2.fromOffset(70, 20),
		Position = UDim2.fromOffset(0, 190),
		MaxTextSize = 16,
		Parent = lanes,
	})
	local scroll = Lib.Scroll({ Horizontal = true, Position = UDim2.fromOffset(74, 0), Size = UDim2.new(1, -74, 1, 0), Parent = lanes })
	Lib.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left).Parent = scroll

	local columns = {}
	local function rewardBox(parent, y, reward, onClick)
		local box = New("TextButton", {
			Text = "",
			AutoButtonColor = true,
			BackgroundColor3 = C.Card,
			Size = UDim2.fromOffset(104, 104),
			Position = UDim2.fromOffset(0, y),
			Parent = parent,
		}, { Lib.Corner(12), Lib.Stroke(C.Gray, 2, 0) })
		Lib.Text({
			Text = Util.RewardText(reward, T),
			Size = UDim2.new(1, -8, 1, -30),
			Position = UDim2.fromOffset(4, 4),
			TextWrapped = true,
			MaxTextSize = 16,
			Parent = box,
		})
		local status = Lib.Text({
			Name = "Status",
			Text = "",
			Size = UDim2.new(1, -8, 0, 20),
			Position = UDim2.new(0, 4, 1, -24),
			MaxTextSize = 14,
			Parent = box,
		})
		box.Activated:Connect(onClick)
		return box, status
	end

	for tier, def in Config.SeasonTiers do
		local column = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(104, 250), LayoutOrder = tier, Parent = scroll })
		Lib.Text({ Text = T("Tier %d", tier), Size = UDim2.new(1, 0, 0, 22), MaxTextSize = 18, Parent = column })
		local freeBox, freeStatus = rewardBox(column, 26, def.Free, function()
			Net.Fire("ClaimTier", tier, "Free")
		end)
		local premiumBox, premiumStatus = rewardBox(column, 140, def.Premium, function()
			Net.Fire("ClaimTier", tier, "Premium")
		end)
		columns[tier] = { FreeBox = freeBox, FreeStatus = freeStatus, PremiumBox = premiumBox, PremiumStatus = premiumStatus }
	end

	local function styleBox(box, status, claimed, unlocked, locked)
		local stroke = box:FindFirstChildOfClass("UIStroke")
		if claimed then
			status.Text = "✅"
			stroke.Color = C.Green
			box.BackgroundColor3 = Color3.fromRGB(40, 80, 55)
		elseif locked then
			status.Text = "🔒"
			stroke.Color = C.Gold
			box.BackgroundColor3 = Color3.fromRGB(60, 52, 30)
		elseif unlocked then
			status.Text = T("CLAIM!")
			stroke.Color = C.Gold
			box.BackgroundColor3 = Color3.fromRGB(110, 85, 30)
		else
			status.Text = ""
			stroke.Color = C.Gray
			box.BackgroundColor3 = C.Card
		end
	end

	local function refresh()
		local data = State.Data
		if not data then
			return
		end
		local season = data.Season
		local perTier = Config.Season.XPPerTier
		local tier = math.min(#Config.SeasonTiers, math.floor(season.XP / perTier))
		tierText.Text = T("Tier %d / %d", tier, #Config.SeasonTiers)
		if tier >= #Config.SeasonTiers then
			setXp(1, T("SEASON COMPLETE!"))
		else
			local into = season.XP - tier * perTier
			setXp(into / perTier, string.format("%s / %s XP", Util.Comma(into), Util.Comma(perTier)))
		end
		if Config.Season.EndsAt > 0 then
			title.Text = T("%s  •  ends in %s", Config.Season.Name, Util.FormatTime(Config.Season.EndsAt - State.Now()))
		end
		premiumButton.Visible = not season.Premium
		Lib.SetButton(premiumButton, T("🎫 Unlock Premium  R$%s", Lib.Price("Product", "SeasonPremium")), C.Gold)
		Lib.SetButton(skipButton, T("⏩ Skip 5 tiers  R$%s", Lib.Price("Product", "SkipTiers")), C.Purple)
		for t, column in columns do
			local unlocked = tier >= t
			styleBox(column.FreeBox, column.FreeStatus, season.ClaimedFree[tostring(t)] == true, unlocked, false)
			styleBox(column.PremiumBox, column.PremiumStatus, season.ClaimedPremium[tostring(t)] == true, unlocked, not season.Premium)
		end
	end

	return { Refresh = refresh }
end

return Pass
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="68">
              <Properties>
                <string name="Name">Pets</string>
                <string name="Source"><![CDATA[--[[
	Pet collection: every pet you own, best earners first.
	🔒 = in a VAULT (can never be stolen, 50% income)
	🏠 = on display (full income, thieves can try to take it)
	💎 = exclusive (never stolen)   ⭐ = following you   📦 = storage
	Tap 🔒/🏠 on a card to choose: keep it safe in a vault, or show it off.
	Tap 💰 twice to sell a pet (pays one minute of its income).
	Tap a card: 🌱 grow it (level, ✨ feed) and ⭐ evolve it (Lv10 + 2 copies).
]]
local PetModel = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("PetModel"))

local Pets = { Title = "🐾 PETS", Color = Color3.fromRGB(120, 200, 90) }

local MAX_VIEWPORTS = 24 -- 3D previews for the best pets (keeps phones smooth)

local function viewport(parent: GuiObject, petName: string, variant: string?, growth)
	local frame = Instance.new("ViewportFrame")
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.fromOffset(64, 56)
	frame.Position = UDim2.new(0.5, 0, 0, 4)
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Ambient = Color3.fromRGB(200, 200, 210)
	frame.LightColor = Color3.new(1, 1, 1)
	frame.Parent = parent
	local model = PetModel.Build(petName, variant, growth)
	model.Parent = frame
	local camera = Instance.new("Camera")
	local _, size = model:GetBoundingBox()
	local pivot = model:GetPivot()
	local center = pivot.Position + Vector3.new(0, size.Y * 0.45, 0)
	local distance = math.max(size.X, size.Y) * 1.55
	camera.CFrame = CFrame.lookAt(center + pivot.LookVector * distance + Vector3.new(0, size.Y * 0.15, 0), center)
	camera.FieldOfView = 40
	camera.Parent = frame
	frame.CurrentCamera = camera
	return frame
end

function Pets.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T

	local header = Lib.Text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		Parent = content,
	})
	local actions = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 40),
		Parent = content,
	}, { Lib.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left) })

	local confirmBulk = {}
	local function bulkButton(rarity: string, text: string, order: number)
		local button
		button = Lib.Button({
			Text = text,
			Color = C.Gold,
			Size = UDim2.fromOffset(150, 38),
			LayoutOrder = order,
			TextSize = 16,
			Parent = actions,
			OnClick = function()
				local last = confirmBulk[rarity]
				if last and os.clock() - last < 2.5 then
					confirmBulk[rarity] = nil
					Net.Fire("SellRarity", rarity)
					Lib.SetButton(button, text)
				else
					confirmBulk[rarity] = os.clock()
					Lib.SetButton(button, T("Tap again to sell"))
					task.delay(2.5, function()
						if button.Parent then
							Lib.SetButton(button, text)
						end
					end)
				end
			end,
		})
		return button
	end
	bulkButton("Common", "💰 Sell Commons", 1)
	bulkButton("Uncommon", "💰 Sell Uncommons", 2)
	Lib.Button({
		Text = "📖 Index",
		Color = Color3.fromRGB(110, 190, 255),
		Size = UDim2.fromOffset(104, 38),
		LayoutOrder = 5,
		TextSize = 16,
		Parent = actions,
		OnClick = function()
			ctx.Panels.Open("Index")
		end,
	})
	Lib.Button({
		Text = "🤝 Trade",
		Color = C.Cyan,
		Size = UDim2.fromOffset(104, 38),
		LayoutOrder = 4,
		TextSize = 16,
		Parent = actions,
		OnClick = function()
			ctx.Panels.Open("Trade")
		end,
	})
	local slotsButton = Lib.Button({
		Text = "🐾 +3 Helpers",
		Color = C.Purple,
		Size = UDim2.fromOffset(150, 38),
		LayoutOrder = 3,
		TextSize = 16,
		Parent = actions,
		OnClick = function()
			if ctx.Upsell then
				ctx.Upsell.Pass("ExtraPets", true)
			end
		end,
	})

	-- how following works (people asked: "who decides which pets follow me?")
	local followInfo = Lib.Text({
		Text = "",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 74),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 14,
		Parent = content,
	})
	local grid = Lib.Scroll({ Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 1, -96), Parent = content })
	Lib.Grid(UDim2.fromOffset(122, 136), 8).Parent = grid
	Lib.Padding(4).Parent = grid

	local signature = ""
	local confirmSell = {} -- [petId] = os.clock()
	local xpBars = {} -- [petId] = fill frame (updated in place)

	local function income(pet)
		return Util.PetIncomeOf(Config, pet)
	end

	-- 🌱 pet detail: grow (feed ✨) and ⭐ evolve -------------------------------
	local selectedId = nil
	local detail = New("TextButton", {
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(16, 18, 28),
		BackgroundTransparency = 0.05,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 30,
		Visible = false,
		Parent = content,
	}, { Lib.Corner(14) })
	local detailView = Instance.new("Frame")
	detailView.BackgroundTransparency = 1
	detailView.Size = UDim2.fromOffset(170, 170)
	detailView.Position = UDim2.fromOffset(10, 10)
	detailView.ZIndex = 31
	detailView.Parent = detail
	local function line(y: number, height: number, size: number, color: Color3?)
		return Lib.Text({
			Text = "",
			TextColor3 = color or C.Text,
			Size = UDim2.new(1, -200, 0, height),
			Position = UDim2.fromOffset(190, y),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = size,
			ZIndex = 31,
			Parent = detail,
		})
	end
	local dName = line(10, 30, 26)
	local dStage = line(42, 24, 20, C.Gold)
	local dIncome = line(68, 22, 18, C.Coins)
	local xpBack = New("Frame", {
		BackgroundColor3 = Color3.fromRGB(40, 44, 60),
		Size = UDim2.new(1, -200, 0, 16),
		Position = UDim2.fromOffset(190, 96),
		ZIndex = 31,
		Parent = detail,
	}, { Lib.Corner(8) })
	local xpFill = New("Frame", {
		BackgroundColor3 = C.Green,
		Size = UDim2.fromScale(0, 1),
		ZIndex = 32,
		Parent = xpBack,
	}, { Lib.Corner(8) })
	local xpText = Lib.Text({ Text = "", Size = UDim2.fromScale(1, 1), MaxTextSize = 12, ZIndex = 33, Parent = xpBack })
	local dHelp = Lib.Text({
		Text = "",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		TextWrapped = true,
		Size = UDim2.new(1, -200, 0, 54),
		Position = UDim2.fromOffset(190, 116),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		MaxTextSize = 13,
		ZIndex = 31,
		Parent = detail,
	})
	local feedButton, evolveButton
	local evolveConfirm = 0
	local function act(name: string)
		if not selectedId then
			return
		end
		if name == "PetEvolve" and os.clock() - evolveConfirm > 2.5 then
			-- (evolving uses up copies: tap twice)
			evolveConfirm = os.clock()
			ctx.Toast(T("⭐ Tap again to evolve - it uses %d plain copies of this pet", Config.Growth.Evolve.Copies), C.Purple)
			return
		end
		evolveConfirm = 0
		local result = Net.Invoke(name, selectedId)
		if type(result) == "table" and result.Error then
			Lib.PlaySound("Error")
			ctx.Toast(result.Error, C.Red)
		elseif type(result) == "table" and result.Ok then
			Lib.PlaySound(if name == "PetEvolve" then "Fanfare" elseif result.Up then "LevelUp" else "Pop")
		end
	end
	feedButton = Lib.Button({
		Text = "🍖 Feed",
		Color = C.Green,
		Size = UDim2.new(0.5, -110, 0, 46),
		Position = UDim2.new(0, 190, 1, -58),
		TextSize = 17,
		ZIndex = 31,
		Parent = detail,
		OnClick = function()
			act("PetFeed")
		end,
	})
	evolveButton = Lib.Button({
		Text = "⭐ Evolve",
		Color = C.Purple,
		Size = UDim2.new(0.5, -110, 0, 46),
		Position = UDim2.new(0.5, 90, 1, -58),
		TextSize = 17,
		ZIndex = 31,
		Parent = detail,
		OnClick = function()
			act("PetEvolve")
		end,
	})
	Lib.Button({
		Text = "✕",
		Color = C.Gray,
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -46, 0, 6),
		TextSize = 20,
		ZIndex = 32,
		Parent = detail,
		OnClick = function()
			selectedId = nil
			detail.Visible = false
		end,
	})
	local detailKey = ""
	local function showDetail(data)
		local pet = nil
		for _, p in data.Pets do
			if p.Id == selectedId then
				pet = p
			end
		end
		if not pet or not Config.Pets[pet.Name] then
			detail.Visible = false
			selectedId = nil
			return
		end
		detail.Visible = true
		local growth = Config.Growth
		local level, stars = Util.PetLevel(pet), Util.PetStars(pet)
		local stage = Util.PetStage(Config, level)
		local key = pet.Id .. "|" .. level .. "|" .. stars .. "|" .. tostring(pet.Variant)
		if key ~= detailKey then
			detailKey = key
			Lib.Clear(detailView)
			local vp = viewport(detailView, pet.Name, pet.Variant, { Level = level, Stars = stars })
			vp.Size = UDim2.fromScale(1, 1)
			vp.Position = UDim2.fromScale(0.5, 0)
			vp.ZIndex = 31
		end
		local name = T(pet.Name)
		if pet.Variant then
			name = T(pet.Variant) .. " " .. name
		end
		dName.Text = name .. (if stars > 0 then "  " .. string.rep("★", stars) else "")
		dStage.Text = T("%s %s  •  Level %d/%d", stage.Icon, T(stage.Id), level, growth.MaxLevel)
		dIncome.Text = T("💰 %s/s  •  ⚡ x%s", Util.Format(income(pet)), string.format("%.2f", Util.PetGrowthMult(Config, pet)))
		local maxed = level >= growth.MaxLevel
		if maxed then
			xpFill.Size = UDim2.fromScale(1, 1)
			xpText.Text = T("👑 MAX LEVEL")
		else
			local need = Util.PetXPNeed(Config, pet)
			local xp = tonumber(pet.XP) or 0
			xpFill.Size = UDim2.fromScale(math.clamp(xp / need, 0, 1), 1)
			xpText.Text = string.format("%d / %d XP", xp, need)
		end
		-- copies available for evolving (plain, not more evolved - same rule as the server)
		local copies = #Util.EvolveCopies(Config, data, pet)
		local need = growth.Evolve.Copies
		if stars >= growth.Evolve.MaxStars then
			dHelp.Text = T("★★★ Fully evolved! The best version of this pet.")
		elseif maxed then
			dHelp.Text = T(
				"⭐ Evolve: this pet + %d more %s (you have %d) -> ★%d, x%d income! (back to level 1)",
				need,
				T(pet.Name),
				copies,
				stars + 1,
				growth.Evolve.StarMult
			)
		else
			dHelp.Text = T(
				"🌱 Grows while it follows you and helps, while it stands in your home, and when you feed it ✨ stardust. At level %d it can ⭐ evolve.",
				growth.MaxLevel
			)
		end
		local cost, xp = Util.PetFeed(Config, pet)
		Lib.SetButton(feedButton, if maxed then T("👑 Max") else T("🍖 +%d XP  ✨%s", xp, Util.Format(cost)))
		Lib.SetButton(
			evolveButton,
			if stars >= growth.Evolve.MaxStars then "★★★" else T("⭐ Evolve (%d/%d)", math.min(copies, need), need)
		)
		evolveButton.BackgroundColor3 = if maxed and copies >= need and stars < growth.Evolve.MaxStars then C.Purple else C.Gray
		feedButton.BackgroundColor3 = if maxed then C.Gray elseif (data.Stardust or 0) >= cost then C.Green else C.Gray
	end

	local function pedestalKey(data): string
		local display, vault = Util.Pedestals(Config, data.Base and data.Base.Items or {})
		return #display .. "/" .. #vault
	end

	local function rebuild(data, derived)
		Lib.Clear(grid)
		xpBars = {}
		local following = {}
		for _, id in data.Equipped do
			following[id] = true
		end
		local pets = {}
		for _, pet in data.Pets do
			if Config.Pets[pet.Name] then
				table.insert(pets, pet)
			end
		end
		-- same order as the server uses for pedestals: best income first
		table.sort(pets, function(a, b)
			if income(a) == income(b) then
				return a.Id < b.Id
			end
			return income(a) > income(b)
		end)
		-- same rules as the server (Util.ArrangePets)
		local vaultPets, displayPets = Util.ArrangePets(Config, data)
		local where = {}
		for _, pet in vaultPets do
			where[pet.Id] = "vault"
		end
		for _, pet in displayPets do
			where[pet.Id] = "display"
		end
		local mult = (derived.CoinMult or 1)
			* (if State.HasPass("DoubleBase") then 2 else 1)
			* (1 + Util.SetBonus(Config, data.Base.Items))
			* (1 + Util.IndexBonus(Config, data))
		for order, pet in pets do
			local info = Config.Pets[pet.Name]
			local rarity = Config.Rarities[info.Rarity]
			local place = where[pet.Id]
			local onDisplay = place ~= nil
			local exclusive = info.Exclusive == true
			local card = New("Frame", {
				BackgroundColor3 = if place == "vault"
					then Color3.fromRGB(45, 55, 85)
					elseif onDisplay then Color3.fromRGB(40, 70, 60)
					else C.Card,
				LayoutOrder = order,
				Parent = grid,
			}, {
				Lib.Corner(12),
				Lib.Stroke(if pet.Variant then Color3.fromRGB(255, 210, 60) else rarity.Color, if pet.Variant then 4 else 3, 0),
			})
			-- tap the card: grow / evolve this pet
			local open = New("TextButton", {
				Text = "",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Parent = card,
			})
			open.Activated:Connect(function()
				Lib.PlaySound("UI")
				selectedId = pet.Id
				detailKey = ""
				showDetail(State.Data)
			end)
			if order <= MAX_VIEWPORTS then
				viewport(card, pet.Name, pet.Variant, { Level = Util.PetLevel(pet), Stars = Util.PetStars(pet) })
			else
				New("Frame", {
					Size = UDim2.fromOffset(44, 44),
					Position = UDim2.new(0.5, 0, 0, 10),
					AnchorPoint = Vector2.new(0.5, 0),
					BackgroundColor3 = info.Color,
					Parent = card,
				}, { Lib.Corner(22), Lib.Stroke(Color3.new(0, 0, 0), 2, 0.3) })
			end
			local name = T(pet.Name)
			if pet.Variant then
				name = T(pet.Variant) .. " " .. name
			end
			if pet.Serial then
				name ..= " #" .. tostring(pet.Serial)
			end
			Lib.Text({
				Text = name,
				Size = UDim2.new(1, -6, 0, 20),
				Position = UDim2.fromOffset(3, 62),
				MaxTextSize = 14,
				Parent = card,
			})
			-- 🌱 level / ★ badge + xp bar
			New("Frame", {
				BackgroundColor3 = Color3.fromRGB(20, 22, 34),
				BackgroundTransparency = 0.2,
				Size = UDim2.fromOffset(58, 20),
				Position = UDim2.new(1, -62, 0, 34),
				ZIndex = 2,
				Parent = card,
			}, {
				Lib.Corner(10),
				Lib.Text({
					Text = Util.PetBadge(Config, pet),
					TextColor3 = C.Gold,
					Size = UDim2.fromScale(1, 1),
					MaxTextSize = 13,
					ZIndex = 3,
				}),
			})
			local level = Util.PetLevel(pet)
			local xpShare = if level >= Config.Growth.MaxLevel
				then 1
				else math.clamp((tonumber(pet.XP) or 0) / Util.PetXPNeed(Config, pet), 0, 1)
			local bar = New("Frame", {
				BackgroundColor3 = Color3.fromRGB(40, 44, 60),
				Size = UDim2.new(1, -10, 0, 4),
				Position = UDim2.fromOffset(5, 104),
				Parent = card,
			}, { Lib.Corner(2) })
			xpBars[pet.Id] = New("Frame", {
				BackgroundColor3 = if level >= Config.Growth.MaxLevel then C.Gold else C.Green,
				Size = UDim2.fromScale(xpShare, 1),
				Parent = bar,
			}, { Lib.Corner(2) })
			local petMult = if place == "vault" then mult * Config.Base.VaultIncome else mult
			Lib.Text({
				Text = "💰" .. Util.Format(income(pet) * petMult) .. "/s",
				TextColor3 = C.Coins,
				Size = UDim2.new(1, -6, 0, 18),
				Position = UDim2.fromOffset(3, 84),
				MaxTextSize = 15,
				Parent = card,
			})
			local status
			if pet.Away then
				status = T("🏃 being stolen!")
			elseif place == "vault" then
				status = T("🔒 safe")
			elseif type(pet.HotUntil) == "number" and pet.HotUntil > os.time() and onDisplay then
				status = T("🔥 just stolen")
			elseif onDisplay and exclusive then
				status = T("💎 safe")
			elseif onDisplay then
				status = T("🏠 on display")
			else
				status = T("📦 storage")
			end
			if following[pet.Id] then
				status = "⭐ " .. status
			end
			Lib.Text({
				Text = status,
				Font = Lib.BodyFont,
				TextColor3 = if onDisplay then C.Green else C.Sub,
				Size = UDim2.new(1, -34, 0, 16),
				Position = UDim2.fromOffset(4, 110),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 11,
				Parent = card,
			})
			if State.NewPets and State.NewPets[pet.Id] then
				New("Frame", {
					BackgroundColor3 = C.Pink,
					Size = UDim2.fromOffset(46, 20),
					Position = UDim2.new(1, -50, 0, 4),
					ZIndex = 3,
					Parent = card,
				}, { Lib.Corner(10), Lib.Text({ Text = "NEW", Size = UDim2.fromScale(1, 1), MaxTextSize = 13, ZIndex = 4 }) })
			end
			-- vault or show off? (exclusive pets are always safe)
			if not pet.Away and not exclusive then
				local toggle = New("TextButton", {
					Text = if pet.Show then "🏠" else "🔒",
					TextScaled = true,
					BackgroundColor3 = if pet.Show then C.Green else C.Blue,
					Size = UDim2.fromOffset(26, 26),
					Position = UDim2.new(0, 4, 0, 4),
					Parent = card,
				}, { Lib.Corner(6) })
				toggle.Activated:Connect(function()
					Lib.PlaySound("UI")
					Net.Fire("PetShow", pet.Id, not pet.Show)
					ctx.Toast(
						if pet.Show
							then T("🔒 This pet may go into a vault again (safe)")
							else T("🏠 This pet stays on display: full income, but it can be stolen!"),
						if pet.Show then C.Blue else C.Gold
					)
				end)
			end
			if not pet.Away then
				local sell = New("TextButton", {
					Text = "💰",
					TextScaled = true,
					BackgroundColor3 = C.Gold,
					Size = UDim2.fromOffset(26, 26),
					Position = UDim2.new(1, -30, 1, -30),
					Parent = card,
				}, { Lib.Corner(6) })
				sell.Activated:Connect(function()
					local last = confirmSell[pet.Id]
					if last and os.clock() - last < 2.5 then
						Net.Fire("SellPet", pet.Id)
					else
						confirmSell[pet.Id] = os.clock()
						sell.Text = "?"
						ctx.Toast(
							T("Tap again to sell for 💰%s", Util.Format(math.max(1, math.floor(income(pet) * Config.PetSellSeconds)))),
							C.Gold
						)
						task.delay(2.5, function()
							if sell.Parent then
								sell.Text = "💰"
							end
						end)
					end
				end)
			end
		end
	end

	local function refresh()
		local data, derived = State.Data, State.Derived
		if not data then
			return
		end
		local indexCount, totalPets = 0, 0
		for _ in data.PetIndex do
			indexCount += 1
		end
		for _ in Config.Pets do
			totalPets += 1
		end
		local player = game:GetService("Players").LocalPlayer
		header.Text = T(
			"🏠 Base 💰%s/s  •  Pets %d/%d  •  Index %d/%d",
			Util.Format(player:GetAttribute("BaseRate") or 0),
			#data.Pets,
			Config.MaxPets,
			indexCount,
			totalPets
		)
		local derivedNow = State.Derived or {}
		followInfo.Text = T(
			"⭐ Your %d strongest pets follow you and help you mine & smash meteors (+%s%% power)",
			derivedNow.PetSlots or Config.BasePetSlots,
			Util.Format(math.floor((derivedNow.PetPower or 0) * 100))
		)
		slotsButton.Visible = not State.HasPass("ExtraPets")
		local parts = {}
		for _, pet in data.Pets do
			table.insert(
				parts,
				pet.Id
					.. (pet.Variant or "")
					.. (if pet.Away then "!" else "")
					.. (if pet.Show then "s" else "")
					.. (pet.Serial or "")
					.. (if type(pet.HotUntil) == "number" and pet.HotUntil > os.time() then "h" else "")
					.. "L"
					.. Util.PetLevel(pet)
					.. "s"
					.. Util.PetStars(pet)
			)
		end
		local newCount = 0
		for _ in State.NewPets or {} do
			newCount += 1
		end
		local sig = table.concat(parts, ",")
			.. "|new"
			.. newCount
			.. "|"
			.. table.concat(data.Equipped, ",")
			.. "|"
			.. tostring(derived.CoinMult)
			.. "|"
			.. pedestalKey(data)
			.. "|"
			.. tostring(Util.SetBonus(Config, data.Base.Items))
			.. "|"
			.. tostring(State.HasPass("DoubleBase"))
		if sig ~= signature then
			signature = sig
			rebuild(data, derived)
		end
		-- xp bars move without rebuilding the grid
		for _, pet in data.Pets do
			local fill = xpBars[pet.Id]
			if fill and Util.PetLevel(pet) < Config.Growth.MaxLevel then
				fill.Size = UDim2.fromScale(math.clamp((tonumber(pet.XP) or 0) / Util.PetXPNeed(Config, pet), 0, 1), 1)
			end
		end
		if selectedId then
			showDetail(data)
		end
	end

	return { Refresh = refresh }
end

return Pets
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="69">
              <Properties>
                <string name="Name">Quests</string>
                <string name="Source"><![CDATA[-- Daily login streak, daily quests, weekly ranked ladder, VIP chest, group reward
local Quests = { Title = "📜 DAILY & RANKED", Color = Color3.fromRGB(90, 160, 255) }

function Quests.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T

	local scroll = Lib.Scroll({ Parent = content })
	Lib.List(Enum.FillDirection.Vertical, 10).Parent = scroll
	Lib.Padding(4).Parent = scroll

	local function section(title: string, order: number, height: number)
		local frame = New("Frame", {
			BackgroundColor3 = C.PanelLight,
			Size = UDim2.new(1, -12, 0, height),
			LayoutOrder = order,
			Parent = scroll,
		}, { Lib.Corner(14) })
		Lib.Text({
			Text = title,
			Size = UDim2.new(1, -20, 0, 28),
			Position = UDim2.fromOffset(12, 6),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 22,
			Parent = frame,
		})
		return frame
	end

	-- daily login -----------------------------------------------------------
	local login = section("📅 Daily Login Streak", 1, 150)
	local days = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 38),
		Size = UDim2.new(1, -20, 0, 62),
		Parent = login,
	}, { Lib.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center) })
	local dayBoxes = {}
	for i, reward in Config.DailyRewards do
		local box = New("Frame", {
			BackgroundColor3 = C.Card,
			Size = UDim2.fromOffset(84, 62),
			LayoutOrder = i,
			Parent = days,
		}, { Lib.Corner(10), Lib.Stroke(C.Gray, 2, 0) })
		Lib.Text({
			Text = T("Day %d", i),
			Size = UDim2.new(1, -4, 0, 18),
			Position = UDim2.fromOffset(2, 3),
			MaxTextSize = 15,
			Parent = box,
		})
		Lib.Text({
			Text = Util.RewardText(reward, T),
			Font = Lib.BodyFont,
			Size = UDim2.new(1, -6, 0, 36),
			Position = UDim2.fromOffset(3, 22),
			MaxTextSize = 12,
			TextWrapped = true,
			Parent = box,
		})
		dayBoxes[i] = box
	end
	local claimDaily = Lib.Button({
		Text = "CLAIM",
		Size = UDim2.fromOffset(200, 38),
		Position = UDim2.new(0.5, 0, 0, 106),
		AnchorPoint = Vector2.new(0.5, 0),
		Parent = login,
		OnClick = function()
			Net.Fire("ClaimDaily")
		end,
	})

	-- daily quests ------------------------------------------------------------
	local questFrame = section("🎯 Daily Quests", 2, 40 + Config.DailyQuestCount * 64)
	local questTimer = Lib.Text({
		Text = "",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		Size = UDim2.new(0.5, 0, 0, 20),
		Position = UDim2.new(0.5, -12, 0, 10),
		TextXAlignment = Enum.TextXAlignment.Right,
		MaxTextSize = 14,
		Parent = questFrame,
	})
	local questRows = {}
	for i = 1, Config.DailyQuestCount do
		local row = New("Frame", {
			BackgroundColor3 = C.Card,
			Size = UDim2.new(1, -20, 0, 56),
			Position = UDim2.fromOffset(10, 38 + (i - 1) * 64),
			Parent = questFrame,
		}, { Lib.Corner(10) })
		local text = Lib.Text({
			Text = "",
			Size = UDim2.new(0.62, 0, 0, 22),
			Position = UDim2.fromOffset(10, 4),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 18,
			Parent = row,
		})
		local bar, setBar = Lib.Bar({ Size = UDim2.new(0.62, 0, 0, 18), Position = UDim2.fromOffset(10, 32), Color = C.Blue, Parent = row })
		local button = Lib.Button({
			Size = UDim2.fromOffset(180, 42),
			Position = UDim2.new(1, -188, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Parent = row,
			OnClick = function()
				Net.Fire("ClaimQuest", i)
			end,
		})
		questRows[i] = { Text = text, SetBar = setBar, Button = button, Bar = bar }
	end

	-- weekly ranked -------------------------------------------------------------
	local ranked = section("🏆 Weekly Ranked", 3, 190)
	local rankText = Lib.Text({
		Text = "",
		Size = UDim2.new(1, -20, 0, 30),
		Position = UDim2.fromOffset(12, 36),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 26,
		Parent = ranked,
	})
	local _, setRankBar = Lib.Bar({ Size = UDim2.new(1, -24, 0, 22), Position = UDim2.fromOffset(12, 70), Color = C.Gold, Parent = ranked })
	local rankInfo = Lib.Text({
		Text = "",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		Size = UDim2.new(1, -24, 0, 40),
		Position = UDim2.fromOffset(12, 98),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		MaxTextSize = 14,
		Parent = ranked,
	})
	local tiers = {}
	for _, rank in Config.Ranks do
		table.insert(
			tiers,
			string.format("<font color='#%s'>%s</font> %s💎", rank.Color:ToHex(), T(rank.Name), Util.Format(rank.RewardGems))
		)
	end
	Lib.Text({
		Text = table.concat(tiers, "  ") .. "  •  " .. T("Global Top 10: up to 5K💎"),
		Font = Lib.BodyFont,
		Size = UDim2.new(1, -24, 0, 36),
		Position = UDim2.fromOffset(12, 146),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		MaxTextSize = 13,
		Parent = ranked,
	})

	-- perks -----------------------------------------------------------------------
	local perks = section("🎁 Free Perks", 4, 150)
	local perkRow = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(10, 40),
		Size = UDim2.new(1, -20, 0, 104),
		Parent = perks,
	}, { Lib.Grid(UDim2.fromOffset(300, 46), 10) })
	local vipButton = Lib.Button({
		Color = C.Gold,
		LayoutOrder = 1,
		Parent = perkRow,
		OnClick = function()
			Net.Fire("ClaimVip")
		end,
	})
	local groupButton = Lib.Button({
		Color = C.Blue,
		LayoutOrder = 2,
		Parent = perkRow,
		OnClick = function()
			Net.Fire("ClaimGroup")
		end,
	})
	local premiumButton = Lib.Button({
		Color = C.Purple,
		LayoutOrder = 3,
		Parent = perkRow,
		OnClick = function()
			Net.Fire("BuyPremium")
		end,
	})
	-- viral loop: every friend in the server = +10% coins for both of you
	Lib.Button({
		Text = "📨 Invite friends: +10% each",
		Color = C.Green,
		LayoutOrder = 4,
		Parent = perkRow,
		OnClick = function()
			local SocialService = game:GetService("SocialService")
			local player = game:GetService("Players").LocalPlayer
			local ok, canInvite = pcall(SocialService.CanSendGameInviteAsync, SocialService, player)
			if ok and canInvite then
				pcall(SocialService.PromptGameInvite, SocialService, player)
			elseif ctx.Toast then
				ctx.Toast("Invites aren't available right now.", C.Red)
			end
		end,
	})

	local function refresh()
		local data, derived = State.Data, State.Derived
		if not data then
			return
		end
		local today = derived.Today or Util.DayNumber(math.floor(State.Now()))
		-- login
		local claimedToday = data.Daily.LastClaimDay == today
		local streak = data.Daily.Streak
		local nextStreak = if claimedToday then streak else (if data.Daily.LastClaimDay == today - 1 then streak + 1 else 1)
		local currentIndex = ((nextStreak - 1) % #Config.DailyRewards) + 1
		for i, box in dayBoxes do
			local stroke = box:FindFirstChildOfClass("UIStroke")
			if i == currentIndex then
				stroke.Color = if claimedToday then C.Green else C.Gold
				box.BackgroundColor3 = if claimedToday then Color3.fromRGB(45, 95, 60) else Color3.fromRGB(110, 85, 30)
			elseif i < currentIndex then
				stroke.Color = C.Green
				box.BackgroundColor3 = Color3.fromRGB(45, 95, 60)
			else
				stroke.Color = C.Gray
				box.BackgroundColor3 = C.Card
			end
		end
		if claimedToday then
			Lib.SetButton(claimDaily, T("Next in %s", Util.FormatTime(Util.SecondsUntilNextDay(math.floor(State.Now())))), C.Gray)
		else
			Lib.SetButton(claimDaily, T("🎁 CLAIM DAY %d", currentIndex), C.Green)
		end

		-- quests
		questTimer.Text = T("New quests in %s", Util.FormatTime(Util.SecondsUntilNextDay(math.floor(State.Now()))))
		for i, row in questRows do
			local quest = data.Daily.Quests[i]
			local def
			for _, q in Config.Quests do
				if quest and q.Id == quest.Id then
					def = q
				end
			end
			if quest and def then
				row.Text.Text = T(def.Text)
				row.SetBar(quest.Progress / def.Target, string.format("%d / %d", quest.Progress, def.Target))
				if quest.Claimed then
					Lib.SetButton(row.Button, "✅ DONE", C.Gray)
				elseif quest.Progress >= def.Target then
					Lib.SetButton(row.Button, T("CLAIM %s", Util.RewardText(def.Reward, T)), C.Green)
				else
					Lib.SetButton(row.Button, Util.RewardText(def.Reward, T), Color3.fromRGB(70, 72, 92))
				end
			else
				row.Text.Text = "-"
			end
		end

		-- ranked
		local points = data.Weekly.Points
		local rank, index = Util.RankFor(Config, points)
		local nextRank = Config.Ranks[index + 1]
		rankText.Text = T("<font color='#%s'>%s</font>  •  %s pts", rank.Color:ToHex(), string.upper(T(rank.Name)), Util.Comma(points))
		if nextRank then
			setRankBar(
				(points - rank.Min) / (nextRank.Min - rank.Min),
				T("%s / %s to %s", Util.Comma(points), Util.Comma(nextRank.Min), nextRank.Name),
				rank.Color
			)
		else
			setRankBar(1, T("MAX RANK!"), rank.Color)
		end
		rankInfo.Text = T(
			"Earn points by mining, meteor events, quests and PvP. Season resets in %s - rewards are paid when it ends!",
			Util.FormatTime(Util.SecondsUntilNextWeek(math.floor(State.Now())))
		)

		-- perks
		if State.HasPass("VIP") then
			local claimed = data.Daily.VipChestDay == today
			Lib.SetButton(vipButton, if claimed then "👑 VIP chest ✅" else "👑 VIP chest 100💎", if claimed then C.Gray else C.Gold)
		else
			Lib.SetButton(vipButton, "👑 VIP: daily 100💎", C.Gold)
		end
		groupButton.Visible = Config.GroupId ~= 0
		Lib.SetButton(
			groupButton,
			if data.Flags.GroupReward then "👥 Group bonus +10% ✅" else T("👥 Join group: %s💎", Config.Social.GroupJoinGems),
			if data.Flags.GroupReward then C.Gray else C.Blue
		)
		premiumButton.Visible = not derived.Premium
		Lib.SetButton(premiumButton, "⭐ Premium: +10% coins", C.Purple)
	end

	return { Refresh = refresh, Tick = refresh }
end

return Quests
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="70">
              <Properties>
                <string name="Name">Rebirth</string>
                <string name="Source"><![CDATA[-- Rebirth: reset coins/upgrades for a permanent coin multiplier + gems
local Rebirth = { Title = "♻️ REBIRTH", Color = Color3.fromRGB(170, 90, 255) }

function Rebirth.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local C = Lib.Colors
	local T = Lib.T

	local big =
		Lib.Text({ Text = "", Size = UDim2.new(1, 0, 0, 44), Position = UDim2.fromOffset(0, 10), MaxTextSize = 40, Parent = content })
	local mult = Lib.Text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 62),
		MaxTextSize = 30,
		TextColor3 = C.Gold,
		Parent = content,
	})
	local perks = Lib.Text({
		Text = "",
		Font = Lib.BodyFont,
		Size = UDim2.new(1, -40, 0, 60),
		Position = UDim2.fromOffset(20, 104),
		TextWrapped = true,
		MaxTextSize = 18,
		Parent = content,
	})
	local _, setBar = Lib.Bar({
		Size = UDim2.new(1, -80, 0, 30),
		Position = UDim2.fromOffset(40, 176),
		Color = C.Purple,
		TextSize = 20,
		Parent = content,
	})
	Lib.Text({
		Text = "⚠️ Resets: coins, pickaxe.  Keeps: pets, zones, base, shards, gems, passes.",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		Size = UDim2.new(1, -40, 0, 22),
		Position = UDim2.fromOffset(20, 218),
		MaxTextSize = 15,
		Parent = content,
	})
	local button = Lib.Button({
		Size = UDim2.fromOffset(300, 64),
		Position = UDim2.new(0.5, 0, 0, 256),
		AnchorPoint = Vector2.new(0.5, 0),
		TextSize = 30,
		Parent = content,
		OnClick = function()
			Net.Fire("Rebirth")
		end,
	})

	local function refresh()
		local data, derived = State.Data, State.Derived
		if not data then
			return
		end
		local r = data.Rebirths
		local per = Config.Rebirth.CoinBonusPer
		local cost = derived.RebirthCost or Util.RebirthCost(Config, r)
		big.Text = T("Rebirths: %d", r)
		mult.Text = T("💰 x%s  ➜  x%s coins", Util.Format(1 + r * per), Util.Format(1 + (r + 1) * per))
		local nextSlot = Config.Rebirth.ExtraPetSlotEvery - (r % Config.Rebirth.ExtraPetSlotEvery)
		perks.Text = T(
			"Reward: +%s 💎 gems  •  +1 pet slot every %d rebirths (next in %d)",
			Util.Format(Config.Rebirth.GemsPer * (r + 1)),
			Config.Rebirth.ExtraPetSlotEvery,
			nextSlot
		)
		setBar(data.Coins / cost, string.format("💰 %s / %s", Util.Format(data.Coins), Util.Format(cost)))
		local ready = data.Coins >= cost
		Lib.SetButton(
			button,
			if ready then "♻️ REBIRTH NOW" else T("Need %s more", Util.Format(cost - data.Coins)),
			if ready then C.Purple else C.Gray
		)
	end

	return { Refresh = refresh }
end

return Rebirth
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="71">
              <Properties>
                <string name="Name">Rewards</string>
                <string name="Source"><![CDATA[-- One place for every free reward (instead of 4 separate menu buttons)
local Rewards = { Title = "🎁 REWARDS", Color = Color3.fromRGB(255, 90, 160) }

function Rewards.Build(content, ctx)
	local Lib, State = ctx.Lib, ctx.State
	local New, C, T = Lib.New, Lib.Colors, Lib.T

	local grid = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content }, {
		Lib.Grid(UDim2.fromOffset(315, 190), 14),
	})
	local tiles = {}
	local DEFS = {
		{ "Quests", "📅", "Daily & Quests", Color3.fromRGB(90, 160, 255) },
		{ "Gifts", "🎁", "Free Gifts", Color3.fromRGB(255, 90, 160) },
		{ "Spin", "🎡", "Prize Wheel", Color3.fromRGB(255, 170, 40) },
		{ "Codes", "🎟", "Codes", Color3.fromRGB(120, 200, 90) },
	}
	for order, def in DEFS do
		local tile = New("TextButton", {
			Text = "",
			AutoButtonColor = true,
			BackgroundColor3 = def[4],
			LayoutOrder = order,
			Parent = grid,
		}, { Lib.Corner(18), Lib.Stroke(Color3.new(0, 0, 0), 3, 0.3), Lib.Gradient(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)) })
		Lib.Text({
			Text = def[2],
			Size = UDim2.new(1, 0, 0, 70),
			Position = UDim2.fromOffset(0, 12),
			MaxTextSize = 60,
			Outline = false,
			Parent = tile,
		})
		Lib.Text({ Text = def[3], Size = UDim2.new(1, -16, 0, 36), Position = UDim2.fromOffset(8, 86), MaxTextSize = 28, Parent = tile })
		local status = Lib.Text({
			Text = "",
			Font = Lib.BodyFont,
			Size = UDim2.new(1, -16, 0, 26),
			Position = UDim2.fromOffset(8, 128),
			MaxTextSize = 18,
			Parent = tile,
		})
		local badge = New("Frame", {
			BackgroundColor3 = C.Red,
			Size = UDim2.fromOffset(30, 30),
			Position = UDim2.new(1, -24, 0, -8),
			Visible = false,
			ZIndex = 3,
			Parent = tile,
		}, { Lib.Corner(15), Lib.Stroke(Color3.new(1, 1, 1), 2, 0) })
		Lib.Text({ Text = "!", Size = UDim2.fromScale(1, 1), MaxTextSize = 22, ZIndex = 4, Parent = badge })
		tile.Activated:Connect(function()
			Lib.PlaySound("UI")
			ctx.Panels.Open(def[1])
		end)
		tiles[def[1]] = { Status = status, Badge = badge }
	end

	local function refresh()
		local data = State.Data
		local hud = ctx.HUD
		if not data or not hud then
			return
		end
		local ready = hud.RewardsReady()
		tiles.Quests.Badge.Visible = ready.Quests == true
		tiles.Quests.Status.Text = if ready.Quests then T("Rewards ready to claim!") else T("Come back tomorrow")
		tiles.Gifts.Badge.Visible = ready.Gifts == true
		tiles.Gifts.Status.Text = if ready.Gifts then T("A gift is ready!") else T("Stay online for gifts")
		tiles.Spin.Badge.Visible = ready.Spin == true
		local left = (data.FreeSpinAt or 0) - State.Now()
		tiles.Spin.Status.Text = if left <= 0 then T("Free spin ready!") else T("Next free spin in %s", ctx.Util.FormatTime(left))
		tiles.Codes.Status.Text = T("Enter codes for free rewards")
	end

	return { Refresh = refresh, Tick = refresh }
end

return Rewards
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="72">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[-- Settings: language (auto / 한국어 / English), sound, how to play
local TeleportService = game:GetService("TeleportService")

local Settings = { Title = "⚙️ SETTINGS", Color = Color3.fromRGB(110, 115, 140) }

function Settings.Build(content, ctx)
	local Lib, State, Net = ctx.Lib, ctx.State, ctx.Net
	local New, C, T = Lib.New, Lib.Colors, Lib.T

	Lib.Text({
		Text = "🌐 Language",
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 10),
		MaxTextSize = 28,
		Parent = content,
	})
	local row = New(
		"Frame",
		{ BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(0, 54), Parent = content },
		{
			Lib.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center),
		}
	)
	local note = Lib.Text({
		Text = "",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		Size = UDim2.new(1, -40, 0, 24),
		Position = UDim2.fromOffset(20, 122),
		MaxTextSize = 16,
		Parent = content,
	})
	local buttons = {}
	local OPTIONS = { { "auto", "Auto" }, { "ko", "한국어" }, { "en", "English" } }
	for order, option in OPTIONS do
		buttons[option[1]] = Lib.Button({
			Text = option[2],
			Size = UDim2.fromOffset(180, 54),
			LayoutOrder = order,
			TextSize = 26,
			Parent = row,
			OnClick = function()
				local current = State.Data and State.Data.Settings and State.Data.Settings.Lang or "auto"
				if current == option[1] then
					return
				end
				Net.Fire("SetLanguage", option[1])
				note.Text = T("Changing language... rejoining")
				-- the whole UI is built in one language, so rejoin to switch cleanly
				task.delay(1.5, function()
					pcall(function()
						TeleportService:Teleport(game.PlaceId)
					end)
				end)
			end,
		})
	end

	Lib.Text({ Text = "🔊 Sound", Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 170), MaxTextSize = 28, Parent = content })
	local function saveAudio()
		Net.Fire("SetAudio", not Lib.Muted, not Lib.MusicOff)
	end
	local soundButton = Lib.Button({
		Size = UDim2.fromOffset(200, 54),
		Position = UDim2.new(0.5, -316, 0, 214),
		TextSize = 22,
		Parent = content,
		OnClick = function()
			Lib.Muted = not Lib.Muted
			saveAudio()
			ctx.Panels.RefreshCurrent()
		end,
	})
	local musicButton = Lib.Button({
		Size = UDim2.fromOffset(200, 54),
		Position = UDim2.new(0.5, -100, 0, 214),
		TextSize = 22,
		Parent = content,
		OnClick = function()
			if Lib.SetMusic then
				Lib.SetMusic(Lib.MusicOff == true)
			else
				Lib.MusicOff = not Lib.MusicOff
			end
			saveAudio()
			ctx.Panels.RefreshCurrent()
		end,
	})
	Lib.Button({
		Text = "❓ How to play",
		Color = C.Blue,
		Size = UDim2.fromOffset(200, 54),
		Position = UDim2.new(0.5, 116, 0, 214),
		TextSize = 24,
		Parent = content,
		OnClick = function()
			ctx.Panels.Close()
			if ctx.HowTo then
				ctx.HowTo.Show()
			end
		end,
	})

	local function refresh()
		local current = State.Data and State.Data.Settings and State.Data.Settings.Lang or "auto"
		for id, button in buttons do
			Lib.SetButton(button, nil, if id == current then C.Gold else C.Gray)
		end
		Lib.SetButton(soundButton, if Lib.Muted then "🔇 Sound: OFF" else "🔊 Sound: ON", if Lib.Muted then C.Gray else C.Green)
		Lib.SetButton(musicButton, if Lib.MusicOff then "🎵 Music: OFF" else "🎵 Music: ON", if Lib.MusicOff then C.Gray else C.Green)
	end

	return { Refresh = refresh }
end

return Settings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="73">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[-- Pickaxe + running-speed upgrades (coins sink, sequential tiers)
local Shop = { Title = "⛏️ UPGRADES", Color = Color3.fromRGB(255, 160, 50) }

function Shop.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T
	local tab = "Pickaxes"

	local tabs = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = content }, {
		Lib.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left),
	})
	local scroll = Lib.Scroll({ Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 1, -52), Parent = content })
	Lib.List(Enum.FillDirection.Vertical, 8).Parent = scroll
	Lib.Padding(4).Parent = scroll

	local rows = {}
	local refresh

	local tabButtons = {}
	local TABS = {
		Pickaxes = { Label = "⛏️ Pickaxes", Field = "PickaxeTier", Buy = "BuyPickaxe", Icon = "⛏️" },
		Boots = { Label = "👟 Speed", Field = "SpeedTier", Buy = "BuyBoots", Icon = "👟" },
	}
	for i, name in { "Pickaxes", "Boots" } do
		local button = Lib.Button({
			Text = TABS[name].Label,
			Color = C.Blue,
			Size = UDim2.fromOffset(170, 40),
			LayoutOrder = i,
			Parent = tabs,
			OnClick = function()
				tab = name
				refresh()
			end,
		})
		tabButtons[name] = button
	end

	local function buildRows()
		Lib.Clear(scroll)
		rows = {}
		local list = Config[tab]
		for tier, item in list do
			local row = New("Frame", {
				Size = UDim2.new(1, -12, 0, 64),
				BackgroundColor3 = C.Card,
				LayoutOrder = tier,
				Parent = scroll,
			}, { Lib.Corner(12) })
			local swatch = New("Frame", {
				Size = UDim2.fromOffset(44, 44),
				Position = UDim2.fromOffset(10, 10),
				BackgroundColor3 = item.Color or Color3.fromRGB(150, 110, 70),
				Parent = row,
			}, { Lib.Corner(10), Lib.Stroke(Color3.new(0, 0, 0), 2, 0.4) })
			Lib.Text({
				Text = TABS[tab].Icon,
				Size = UDim2.fromScale(0.8, 0.8),
				Position = UDim2.fromScale(0.1, 0.1),
				Parent = swatch,
			})
			Lib.Text({
				Text = item.Name,
				Size = UDim2.new(0.5, 0, 0, 28),
				Position = UDim2.fromOffset(64, 6),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 24,
				Parent = row,
			})
			local statText = if tab == "Boots"
				then T("👟 +%s%% running speed", tostring(math.floor(item.Bonus * 100 + 0.5)))
				else T("💥 Power %s  •  ⚡ %ss swing", Util.Format(item.Power), string.format("%.2f", item.Cooldown))
			Lib.Text({
				Text = statText,
				Font = Lib.BodyFont,
				TextColor3 = C.Sub,
				Size = UDim2.new(0.55, 0, 0, 20),
				Position = UDim2.fromOffset(64, 36),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 16,
				Parent = row,
			})
			local button = Lib.Button({
				Size = UDim2.fromOffset(170, 46),
				Position = UDim2.new(1, -180, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Parent = row,
				OnClick = function()
					Net.Fire(TABS[tab].Buy)
				end,
			})
			rows[tier] = { Button = button, Item = item }
		end
	end

	local builtFor = nil
	refresh = function()
		local data = State.Data
		if not data then
			return
		end
		if builtFor ~= tab then
			builtFor = tab
			buildRows()
		end
		for name, button in tabButtons do
			Lib.SetButton(button, nil, if name == tab then C.Gold else C.Gray)
		end
		local current = data[TABS[tab].Field] or 1
		for tier, row in rows do
			if tier <= current then
				Lib.SetButton(row.Button, if tier == current then "EQUIPPED" else "OWNED", C.Gray)
			elseif tier == current + 1 then
				local affordable = data.Coins >= row.Item.Cost
				Lib.SetButton(row.Button, "💰 " .. Util.Format(row.Item.Cost), if affordable then C.Green else C.Red)
			else
				Lib.SetButton(row.Button, "🔒 " .. Util.Format(row.Item.Cost), Color3.fromRGB(70, 72, 92))
			end
		end
	end

	return {
		OnOpen = function(arg)
			tab = if arg == "Boots" then "Boots" else "Pickaxes"
		end,
		Refresh = refresh,
	}
end

return Shop
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="74">
              <Properties>
                <string name="Name">Spin</string>
                <string name="Source"><![CDATA[-- Free prize wheel: one spin every few hours (VIP: faster). The server picks
-- the prize; the wheel animation reveals it. Odds are always visible.
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Spin = { Title = "🎡 PRIZE WHEEL", Color = Color3.fromRGB(255, 170, 40) }

local BOOST_ICON = { Coins2x = "2x💰", Luck2x = "2x🍀", Power2x = "2x💥" }

local function short(Util, T, reward): string
	if reward.Gems then
		return Util.Format(reward.Gems) .. "💎"
	elseif reward.Stardust then
		return Util.Format(reward.Stardust) .. "✨"
	elseif reward.Boost then
		return (BOOST_ICON[reward.Boost[1]] or "Boost") .. "\n" .. T("%dm", math.floor(reward.Boost[2] / 60))
	elseif reward.Pet then
		return "🐾 " .. T(reward.Pet)
	end
	return "?"
end

function Spin.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T
	local rewards = Config.Spin.Rewards
	local count = #rewards
	local step = 360 / count
	local spinning = false

	-- wheel ------------------------------------------------------------------
	local holder = New(
		"Frame",
		{ BackgroundTransparency = 1, Size = UDim2.fromOffset(340, 340), Position = UDim2.fromOffset(6, 40), Parent = content }
	)
	local wheel = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(34, 36, 58),
		Parent = holder,
	}, {
		New("UICorner", { CornerRadius = UDim.new(0.5, 0) }),
		Lib.Stroke(C.Gold, 5, 0),
	})
	for i = 1, count / 2 do
		New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 3, 1, -10),
			Rotation = (i - 1) * step + step / 2,
			BackgroundColor3 = Color3.fromRGB(70, 72, 100),
			BorderSizePixel = 0,
			Parent = wheel,
		})
	end
	for i, entry in rewards do
		local angle = math.rad((i - 1) * step)
		local radius = 0.34
		New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + math.sin(angle) * radius, 0.5 - math.cos(angle) * radius),
			Size = UDim2.fromOffset(84, 52),
			Rotation = (i - 1) * step,
			BackgroundColor3 = entry.Color or C.Blue,
			Parent = wheel,
		}, {
			Lib.Corner(12),
			Lib.Stroke(if entry.Jackpot then Color3.new(1, 1, 1) else Color3.new(0, 0, 0), if entry.Jackpot then 3 else 2, 0.2),
			Lib.Gradient(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)),
			Lib.Text({
				Text = short(Util, T, entry.Reward),
				Size = UDim2.new(1, -6, 1, -4),
				Position = UDim2.fromOffset(3, 2),
				MaxTextSize = 20,
			}),
		})
	end
	New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(54, 54),
		BackgroundColor3 = C.Gold,
		Parent = wheel,
	}, { New("UICorner", { CornerRadius = UDim.new(0.5, 0) }), Lib.Stroke(Color3.new(0, 0, 0), 3, 0.2) })
	Lib.Text({
		Text = "▼",
		TextColor3 = C.Gold,
		Size = UDim2.fromOffset(50, 44),
		Position = UDim2.new(0.5, -25, 0, -36),
		MaxTextSize = 44,
		Parent = holder,
	})

	-- info -------------------------------------------------------------------
	local right =
		New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(362, 0), Size = UDim2.new(1, -362, 1, 0), Parent = content })
	local result = Lib.Text({ Text = "Spin for free prizes!", Size = UDim2.new(1, 0, 0, 44), MaxTextSize = 30, Parent = right })
	local oddsLines = {}
	local total = 0
	for _, entry in rewards do
		total += entry.Weight
	end
	for i, entry in rewards do
		local text = Util.RewardText(entry.Reward, T)
		table.insert(oddsLines, string.format("%s  <font color='#BBBBBB'>%s</font>", text, Util.FormatPercent(entry.Weight / total * 100)))
		if entry.Jackpot then
			oddsLines[i] ..= "  🎰 JACKPOT"
		end
	end
	Lib.Text({
		Text = table.concat(oddsLines, "\n"),
		Font = Lib.BodyFont,
		Size = UDim2.new(1, 0, 0, 200),
		Position = UDim2.fromOffset(0, 50),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		MaxTextSize = 15,
		Parent = right,
	})
	local vipHint = Lib.Text({
		Text = "👑 VIP spins every 2 hours",
		Font = Lib.BodyFont,
		TextColor3 = C.Gold,
		Size = UDim2.new(1, 0, 0, 20),
		Position = UDim2.fromOffset(0, 258),
		MaxTextSize = 14,
		Parent = right,
	})
	local spinButton = Lib.Button({
		Text = "🎡 SPIN!",
		Size = UDim2.new(1, -10, 0, 64),
		Position = UDim2.fromOffset(0, 290),
		TextSize = 30,
		Color = C.Gold,
		Parent = right,
	})

	local function readyIn(): number
		local data = State.Data
		if not data then
			return math.huge
		end
		return (data.FreeSpinAt or 0) - State.Now()
	end

	local function refresh()
		if spinning then
			return
		end
		local remaining = readyIn()
		if remaining <= 0 then
			Lib.SetButton(spinButton, "🎡 SPIN!", C.Gold)
		else
			Lib.SetButton(spinButton, T("Free spin in %s", Util.FormatTime(remaining)), C.Gray)
		end
		vipHint.Visible = not State.HasPass("VIP")
	end

	local function animateTo(index: number, text: string)
		spinning = true
		local start = wheel.Rotation
		local jitter = math.random(-math.floor(step * 0.3), math.floor(step * 0.3))
		local landing = (-(index - 1) * step) % 360
		local final = math.ceil(start / 360) * 360 + 360 * 5 + landing + jitter
		local tween = TweenService:Create(wheel, TweenInfo.new(4.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Rotation = final })
		local lastSlot = math.floor((start + step / 2) / step)
		local ticker = RunService.RenderStepped:Connect(function()
			local slot = math.floor((wheel.Rotation + step / 2) / step)
			if slot ~= lastSlot then
				lastSlot = slot
				Lib.PlaySound("SpinTick")
			end
		end)
		tween:Play()
		tween.Completed:Wait()
		ticker:Disconnect()
		wheel.Rotation = final % 360
		local entry = rewards[index]
		result.Text = "🎉 " .. text
		result.TextColor3 = if entry.Jackpot then C.Gold else C.Green
		Lib.Pop(result)
		Lib.PlaySound(if entry.Jackpot then "Legendary" else "Reward")
		if ctx.Toast then
			ctx.Toast("🎡 Prize: " .. text, C.Gold)
		end
		spinning = false
		refresh()
	end

	spinButton.Activated:Connect(function()
		if spinning then
			return
		end
		if readyIn() > 0 then
			if not State.HasPass("VIP") and ctx.Upsell then
				ctx.Upsell.Pass("VIP", true)
			end
			return
		end
		spinning = true
		Lib.SetButton(spinButton, "...", C.Gray)
		local res = Net.Invoke("Spin")
		if type(res) ~= "table" or not res.Index then
			spinning = false
			if ctx.Toast then
				ctx.Toast((type(res) == "table" and res.Error) or "Try again in a moment", C.Red)
			end
			refresh()
			return
		end
		animateTo(res.Index, res.Text or "")
	end)

	return { Refresh = refresh, Tick = refresh }
end

return Spin
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="75">
              <Properties>
                <string name="Name">Store</string>
                <string name="Source"><![CDATA[-- Robux store: game passes, consumables (gems/boosts/server luck/meteor),
-- Miner Club subscription, Roblox Premium and rewarded video ads.
local Store = { Title = "🛒 STORE", Color = Color3.fromRGB(70, 210, 120) }

function Store.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T
	local tab = "Passes"

	local tabs = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = content }, {
		Lib.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left),
	})
	local pages = {}
	local tabButtons = {}
	local refresh

	for i, name in { "Passes", "Items", "Club" } do
		local labels = { Passes = "⭐ Game Passes", Items = "💎 Items & Boosts", Club = "👑 Club & Free" }
		tabButtons[name] = Lib.Button({
			Text = labels[name],
			Size = UDim2.fromOffset(200, 40),
			LayoutOrder = i,
			Parent = tabs,
			OnClick = function()
				tab = name
				refresh()
			end,
		})
		local page = Lib.Scroll({ Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 1, -52), Parent = content })
		page.Visible = false
		Lib.Padding(4).Parent = page
		pages[name] = page
	end
	Lib.Grid(UDim2.fromOffset(205, 170), 10).Parent = pages.Passes
	Lib.Grid(UDim2.fromOffset(205, 150), 10).Parent = pages.Items
	Lib.List(Enum.FillDirection.Vertical, 10).Parent = pages.Club

	local function card(parent, order, icon, name, description, tag)
		local frame = New(
			"Frame",
			{ BackgroundColor3 = C.Card, LayoutOrder = order, Parent = parent },
			{ Lib.Corner(14), Lib.Stroke(C.Gold, 2, 0.4) }
		)
		Lib.Text({ Text = icon, Size = UDim2.fromOffset(44, 44), Position = UDim2.fromOffset(8, 8), MaxTextSize = 38, Parent = frame })
		Lib.Text({
			Text = name,
			Size = UDim2.new(1, -60, 0, 26),
			Position = UDim2.fromOffset(56, 10),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 20,
			Parent = frame,
		})
		if tag then
			New(
				"Frame",
				{ BackgroundColor3 = C.Red, Size = UDim2.fromOffset(90, 20), Position = UDim2.new(1, -94, 0, -8), Parent = frame },
				{
					Lib.Corner(8),
					Lib.Text({ Text = tag, Size = UDim2.fromScale(1, 1), MaxTextSize = 13 }),
				}
			)
		end
		Lib.Text({
			Text = description or "",
			Font = Lib.BodyFont,
			TextColor3 = C.Sub,
			Size = UDim2.new(1, -16, 0, 50),
			Position = UDim2.fromOffset(8, 54),
			TextWrapped = true,
			TextYAlignment = Enum.TextYAlignment.Top,
			MaxTextSize = 14,
			Parent = frame,
		})
		return frame
	end

	-- passes
	local passButtons = {}
	for order, key in Config.GamePassOrder do
		local pass = Config.GamePasses[key]
		local frame = card(pages.Passes, order, pass.Icon or "⭐", pass.Name, pass.Description, if key == "VIP" then "BEST" else nil)
		passButtons[key] = Lib.Button({
			Size = UDim2.new(1, -16, 0, 42),
			Position = UDim2.new(0, 8, 1, -50),
			Parent = frame,
			OnClick = function()
				Net.Fire("BuyPass", key)
			end,
		})
	end

	-- items
	local itemCards = {}
	local itemButtons = {}
	for order, key in Config.StoreOrder do
		local product = Config.Products[key]
		local description = product.Description
		if product.Kind == "Gems" then
			description = "Spend on Gem Eggs and more"
		elseif product.Kind == "Boost" then
			description = "Stacks with every other boost"
		end
		local frame = card(pages.Items, order, product.Icon or "💎", product.Name, description, product.Tag)
		itemCards[key] = frame
		itemButtons[key] = Lib.Button({
			Size = UDim2.new(1, -16, 0, 40),
			Position = UDim2.new(0, 8, 1, -48),
			Parent = frame,
			OnClick = function()
				Net.Fire("BuyProduct", key)
			end,
		})
	end

	-- club & free
	local function wideCard(order, icon, title, description, buttonText, color, onClick)
		local frame = New(
			"Frame",
			{ BackgroundColor3 = C.Card, Size = UDim2.new(1, -12, 0, 96), LayoutOrder = order, Parent = pages.Club },
			{
				Lib.Corner(14),
				Lib.Stroke(color, 2, 0.2),
			}
		)
		Lib.Text({ Text = icon, Size = UDim2.fromOffset(60, 60), Position = UDim2.fromOffset(10, 18), MaxTextSize = 48, Parent = frame })
		Lib.Text({
			Text = title,
			Size = UDim2.new(1, -310, 0, 30),
			Position = UDim2.fromOffset(80, 12),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 24,
			Parent = frame,
		})
		Lib.Text({
			Text = description,
			Font = Lib.BodyFont,
			TextColor3 = C.Sub,
			Size = UDim2.new(1, -310, 0, 40),
			Position = UDim2.fromOffset(80, 44),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			MaxTextSize = 15,
			Parent = frame,
		})
		local button = Lib.Button({
			Text = buttonText,
			Color = color,
			Size = UDim2.fromOffset(210, 50),
			Position = UDim2.new(1, -220, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Parent = frame,
			OnClick = onClick,
		})
		return frame, button
	end

	local sub = Config.Subscription
	local _, clubButton = wideCard(
		1,
		"👑",
		T("%s (subscription)", sub.Name),
		sub.Description,
		T("Join %s", sub.PriceText),
		C.Cyan,
		function()
			Net.Fire("BuySubscription")
		end
	)
	local premiumCard = wideCard(
		2,
		"⭐",
		"Roblox Premium bonus",
		"Premium members get +10% coins in this game, forever.",
		"Get Premium",
		C.Purple,
		function()
			Net.Fire("BuyPremium")
		end
	)
	local adCard, adButton = wideCard(
		3,
		"📺",
		"Free 2x Coins",
		"Watch a short video for a free 10 minute 2x Coins boost.",
		"Watch",
		C.Green,
		function()
			local ok, message = Net.Invoke("WatchAd")
			if ctx.Toast and message then
				ctx.Toast(message, if ok then C.Green else C.Red)
			end
		end
	)
	local _, goldenButton = wideCard(
		4,
		"🥚",
		"Golden Egg",
		"Exclusive golden pets. Odds are shown before you buy.",
		"View odds",
		C.Gold,
		function()
			ctx.Panels.Open("Egg", "Golden")
		end
	)

	refresh = function()
		local data, derived = State.Data, State.Derived
		if not data then
			return
		end
		for name, page in pages do
			page.Visible = name == tab
			Lib.SetButton(tabButtons[name], nil, if name == tab then C.Gold else C.Gray)
		end
		for key, button in passButtons do
			if State.HasPass(key) then
				Lib.SetButton(button, "✅ OWNED", C.Gray)
			else
				Lib.SetButton(button, "R$ " .. Lib.Price("Pass", key), C.Green)
			end
		end
		for key, button in itemButtons do
			Lib.SetButton(button, "R$ " .. Lib.Price("Product", key), C.Green)
		end
		local starterOpen = not data.Flags.StarterPack and State.Now() < data.FirstJoin + Config.StarterPack.OfferHours * 3600
		itemCards.StarterPack.Visible = starterOpen and not derived.PaidRandomRestricted
		-- where paid random items are restricted, Robux can't buy egg currencies
		for key, frame in itemCards do
			local product = Config.Products[key]
			if product and (product.Kind == "Gems" or product.Kind == "CoinPack") then
				frame.Visible = not derived.PaidRandomRestricted
			end
		end
		Lib.SetButton(
			clubButton,
			if derived.Subscribed then "✅ MEMBER" else T("Join %s", sub.PriceText),
			if derived.Subscribed then C.Gray else C.Cyan
		)
		premiumCard.Visible = not derived.Premium
		adCard.Visible = derived.AdsEnabled == true
		local remaining = Config.RewardedAds.CooldownSeconds - (State.Now() - (data.LastAdTime or 0))
		Lib.SetButton(adButton, if remaining > 0 and data.LastAdTime > 0 then Util.FormatTime(remaining) else "📺 Watch", C.Green)
		goldenButton.Visible = not derived.PaidRandomRestricted
	end

	return {
		OnOpen = function(arg)
			if arg == "Passes" or arg == "Items" or arg == "Club" then
				tab = arg
			end
		end,
		Refresh = refresh,
		Tick = refresh,
	}
end

return Store
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="76">
              <Properties>
                <string name="Name">Teleport</string>
                <string name="Source"><![CDATA[-- Zone list: teleport to unlocked zones, unlock the next one
local Teleport = { Title = "🌀 ZONES", Color = Color3.fromRGB(60, 200, 220) }

function Teleport.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C = Lib.New, Lib.Colors
	local T = Lib.T

	local scroll = Lib.Scroll({ Parent = content })
	Lib.List(Enum.FillDirection.Vertical, 8).Parent = scroll
	Lib.Padding(4).Parent = scroll

	local rows = {}
	local entries = { { Index = 0, Name = "🏠 Hub (shops, eggs, sell, meteor)", Color = C.Gold } }
	for index, zone in Config.Zones do
		table.insert(
			entries,
			{ Index = index, Name = T(zone.Name) .. (if zone.PvP then "  ⚔️ PVP" else ""), Color = zone.Accent, Zone = zone }
		)
	end
	for order, entry in entries do
		local row = New("Frame", { BackgroundColor3 = C.Card, Size = UDim2.new(1, -12, 0, 60), LayoutOrder = order, Parent = scroll }, {
			Lib.Corner(12),
			Lib.Stroke(entry.Color, 2, 0.2),
		})
		Lib.Text({
			Text = entry.Name,
			TextColor3 = entry.Color,
			Size = UDim2.new(0.6, 0, 0, 30),
			Position = UDim2.fromOffset(14, 15),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 24,
			Parent = row,
		})
		local button = Lib.Button({
			Size = UDim2.fromOffset(200, 44),
			Position = UDim2.new(1, -210, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Parent = row,
			OnClick = function()
				local data = State.Data
				if not data then
					return
				end
				if entry.Index == 0 or entry.Index <= data.ZoneLevel then
					Net.Fire("Teleport", entry.Index)
					ctx.Panels.Close()
				elseif entry.Index == data.ZoneLevel + 1 then
					Net.Fire("UnlockZone", entry.Index)
				end
			end,
		})
		rows[entry.Index] = { Button = button, Entry = entry }
	end

	local function refresh()
		local data = State.Data
		if not data then
			return
		end
		for index, row in rows do
			if index == 0 or index <= data.ZoneLevel then
				Lib.SetButton(row.Button, "🌀 Teleport", C.Blue)
			elseif index == data.ZoneLevel + 1 then
				local cost = row.Entry.Zone.Cost
				Lib.SetButton(row.Button, T("🔓 Unlock 💰%s", Util.Format(cost)), if data.Coins >= cost then C.Green else C.Red)
			else
				Lib.SetButton(row.Button, "🔒 " .. Util.Format(row.Entry.Zone.Cost), Color3.fromRGB(70, 72, 92))
			end
		end
	end

	return { Refresh = refresh }
end

return Teleport
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="77">
              <Properties>
                <string name="Name">Titles</string>
                <string name="Source"><![CDATA[--[[
	Titles: earned by playing, shown above your head for everyone to see.
	Pick one to wear, or "Auto" to always wear your best one.
]]
local Titles = { Title = "👑 TITLES", Color = Color3.fromRGB(230, 170, 40) }

function Titles.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C, T = Lib.New, Lib.Colors, Lib.T

	local header = Lib.Text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		Parent = content,
	})
	local list = Lib.Scroll({ Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 1, -32), Parent = content })
	Lib.List(Enum.FillDirection.Vertical, 8).Parent = list
	Lib.Padding(4).Parent = list

	local function countOf(t): number
		local n = 0
		for _ in t or {} do
			n += 1
		end
		return n
	end

	-- requirement text + progress ("3/10")
	local function requirement(title, data): (string, string)
		local need = title.Need or {}
		local stats = data.Stats or {}
		if need.Level then
			return T("Reach level %d", need.Level), string.format("%d/%d", math.min(data.Level, need.Level), need.Level)
		elseif need.Index then
			local have = countOf(data.PetIndex)
			return T("Discover %d different pets", need.Index), string.format("%d/%d", math.min(have, need.Index), need.Index)
		elseif need.Steals then
			local have = stats.ShardsStolen or 0
			return T("Steal %d pets", need.Steals), string.format("%d/%d", math.min(have, need.Steals), need.Steals)
		elseif need.Catches then
			local have = stats.ThievesCaught or 0
			return T("Stop %d thieves (bonk or trap)", need.Catches), string.format("%d/%d", math.min(have, need.Catches), need.Catches)
		elseif need.HouseLevel then
			local have = Util.HouseLevel(Config, data)
			return T("Grow your house to level %d", need.HouseLevel),
				string.format("%d/%d", math.min(have, need.HouseLevel), need.HouseLevel)
		elseif need.Likes then
			local have = data.Base and data.Base.Likes or 0
			return T("Get %d likes on your house", need.Likes), string.format("%d/%d", math.min(have, need.Likes), need.Likes)
		elseif need.Rebirths then
			return T("Rebirth %d times", need.Rebirths), string.format("%d/%d", math.min(data.Rebirths or 0, need.Rebirths), need.Rebirths)
		elseif need.Huge then
			return T("Find a HUGE pet"), string.format("%d/%d", math.min(stats.HugesFound or 0, need.Huge), need.Huge)
		elseif need.LifetimeCoins then
			return T("Earn %s coins in total", Util.Format(need.LifetimeCoins)), ""
		elseif need.Titanic then
			return T("Find a TITANIC pet"), string.format("%d/%d", math.min(stats.TitanicsFound or 0, need.Titanic), need.Titanic)
		elseif need.Pranks then
			local have = stats.Pranks or 0
			return T("Prank %d thieves with a 🎭 Prank Pet", need.Pranks),
				string.format("%d/%d", math.min(have, need.Pranks), need.Pranks)
		elseif need.Lucky then
			local have = stats.LuckyBlocks or 0
			return T("Open %d lucky blocks", need.Lucky), string.format("%d/%d", math.min(have, need.Lucky), need.Lucky)
		elseif need.Meteors then
			local have = stats.MeteorJoins or 0
			return T("Help smash %d meteors", need.Meteors), string.format("%d/%d", math.min(have, need.Meteors), need.Meteors)
		elseif need.Delivered then
			local have = stats.ShardsDelivered or 0
			return T("Bring %d star eggs home", need.Delivered), string.format("%d/%d", math.min(have, need.Delivered), need.Delivered)
		elseif need.MeteorPets then
			local have = stats.MeteorPets or 0
			return T("Hatch %d ☄️ meteor pet", need.MeteorPets),
				string.format("%d/%d", math.min(have, need.MeteorPets), need.MeteorPets)
		elseif need.Evolved then
			local have = stats.Evolved or 0
			return T("⭐ Evolve %d pets", need.Evolved), string.format("%d/%d", math.min(have, need.Evolved), need.Evolved)
		elseif need.Pass then
			return T("Own the VIP pass"), ""
		end
		return T("Everyone starts here"), ""
	end

	local signature = ""
	local function refresh()
		local data = State.Data
		if not data then
			return
		end
		local current = Util.CurrentTitle(Config, data, State.HasPass)
		local unlocked = {}
		local parts = { data.Title or "", current and current.Id or "" }
		local count = 0
		for _, title in Config.Titles do
			local ok = Util.TitleUnlocked(Config, title, data, State.HasPass)
			unlocked[title.Id] = ok
			if ok then
				count += 1
			end
			local _, progress = requirement(title, data)
			table.insert(parts, title.Id .. tostring(ok) .. progress)
		end
		header.Text = T("👑 %d/%d titles unlocked  •  everyone sees the one you wear", count, #Config.Titles)
		local sig = table.concat(parts, ",")
		if sig == signature then
			return
		end
		signature = sig
		Lib.Clear(list)

		-- auto: always wear the best one
		local auto = New("Frame", { BackgroundColor3 = C.Card, Size = UDim2.new(1, -12, 0, 54), LayoutOrder = 0, Parent = list }, {
			Lib.Corner(12),
		})
		Lib.Text({
			Text = "✨ " .. T("Auto: always wear my best title"),
			Size = UDim2.new(1, -190, 1, -10),
			Position = UDim2.fromOffset(12, 5),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 18,
			Parent = auto,
		})
		Lib.Button({
			Text = if (data.Title or "") == "" then "✅" else "Wear",
			Color = if (data.Title or "") == "" then C.Green else C.Blue,
			Size = UDim2.fromOffset(150, 42),
			Position = UDim2.new(1, -160, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			TextSize = 18,
			Parent = auto,
			OnClick = function()
				Net.Fire("SetTitle", "")
			end,
		})

		for order, title in Config.Titles do
			local ok = unlocked[title.Id]
			local wearing = current and current.Id == title.Id and (data.Title or "") ~= ""
			local row = New("Frame", {
				BackgroundColor3 = if ok then C.Card else Color3.fromRGB(40, 40, 52),
				Size = UDim2.new(1, -12, 0, 62),
				LayoutOrder = order,
				Parent = list,
			}, { Lib.Corner(12), Lib.Stroke(if ok then title.Color else Color3.new(0, 0, 0), 2, if ok then 0.1 else 0.6) })
			Lib.Text({
				Text = (if ok then "" else "🔒 ") .. T(title.Name),
				TextColor3 = if ok then title.Color else C.Sub,
				Size = UDim2.new(1, -190, 0, 28),
				Position = UDim2.fromOffset(12, 4),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 21,
				Parent = row,
			})
			local text, progress = requirement(title, data)
			Lib.Text({
				Text = text .. (if progress ~= "" and not ok then "  (" .. progress .. ")" else ""),
				Font = Lib.BodyFont,
				TextColor3 = C.Sub,
				Size = UDim2.new(1, -190, 0, 20),
				Position = UDim2.fromOffset(12, 36),
				TextXAlignment = Enum.TextXAlignment.Left,
				MaxTextSize = 14,
				Parent = row,
			})
			if ok then
				Lib.Button({
					Text = if wearing then "✅" else "Wear",
					Color = if wearing then C.Green else C.Blue,
					Size = UDim2.fromOffset(150, 42),
					Position = UDim2.new(1, -160, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					TextSize = 18,
					Parent = row,
					OnClick = function()
						Lib.PlaySound("UI")
						Net.Fire("SetTitle", title.Id)
					end,
				})
			end
		end
	end

	return {
		Refresh = refresh,
		OnOpen = function()
			signature = ""
			refresh()
		end,
	}
end

return Titles
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="78">
              <Properties>
                <string name="Name">Trade</string>
                <string name="Source"><![CDATA[--[[
	Trade panel.
	* Not trading yet: pick a player in this server to send a request.
	* Trading: tap your pets below to offer up to 4, check what you get,
	  press READY. When both are ready a 3 second countdown swaps the pets.
	  Any change resets READY for both (so nobody can switch at the last second).
]]
local Players = game:GetService("Players")

local Trade = { Title = "🤝 TRADE", Color = Color3.fromRGB(60, 190, 220) }

function Trade.Build(content, ctx)
	local Lib, State, Net, Config, Util = ctx.Lib, ctx.State, ctx.Net, ctx.Config, ctx.Util
	local New, C, T = Lib.New, Lib.Colors, Lib.T
	local player = Players.LocalPlayer

	local status = Lib.Text({
		Text = "",
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 20,
		Parent = content,
	})

	-- picking a partner -------------------------------------------------------
	local pickList = Lib.Scroll({ Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), Parent = content })
	Lib.List(Enum.FillDirection.Vertical, 8).Parent = pickList
	Lib.Padding(4).Parent = pickList

	-- trading ----------------------------------------------------------------
	local tradeView = New("Frame", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 1, -34),
		Visible = false,
		Parent = content,
	})
	local function offerRow(y: number, title: string)
		Lib.Text({
			Text = title,
			Size = UDim2.new(0, 130, 0, 30),
			Position = UDim2.fromOffset(0, y + 14),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 18,
			Parent = tradeView,
		})
		local row = New("Frame", {
			BackgroundColor3 = C.PanelLight,
			Size = UDim2.new(1, -140, 0, 56),
			Position = UDim2.fromOffset(136, y),
			Parent = tradeView,
		}, {
			Lib.Corner(12),
			Lib.Padding(6),
			Lib.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center),
		})
		return row
	end
	local myRow = offerRow(0, "You give")
	local theirRow = offerRow(64, "You get")
	local readyButton = Lib.Button({
		Text = "✅ READY",
		Color = C.Green,
		Size = UDim2.fromOffset(170, 46),
		Position = UDim2.fromOffset(136, 128),
		TextSize = 20,
		Parent = tradeView,
	})
	Lib.Button({
		Text = "X Cancel",
		Color = C.Red,
		Size = UDim2.fromOffset(150, 46),
		Position = UDim2.fromOffset(316, 128),
		TextSize = 20,
		Parent = tradeView,
		OnClick = function()
			Net.Fire("TradeCancel")
		end,
	})
	local inventory = Lib.Scroll({ Position = UDim2.fromOffset(0, 184), Size = UDim2.new(1, 0, 1, -184), Parent = tradeView })
	Lib.Grid(UDim2.fromOffset(118, 64), 6).Parent = inventory
	Lib.Padding(4).Parent = inventory

	local myReady = false
	readyButton.Activated:Connect(function()
		Net.Fire("TradeReady", not myReady)
	end)

	local function chip(parent: Instance, pet, order: number)
		local info = Config.Pets[pet.Name]
		local rarity = info and Config.Rarities[info.Rarity] or Config.Rarities.Common
		local frame = New("Frame", {
			BackgroundColor3 = C.Card,
			Size = UDim2.fromOffset(110, 44),
			LayoutOrder = order,
			Parent = parent,
		}, { Lib.Corner(10), Lib.Stroke(rarity.Color, 2.5, 0) })
		Lib.Text({
			Text = (if pet.Variant then T(pet.Variant) .. " " else "") .. T(pet.Name) .. (if pet.Serial
				then " #" .. tostring(pet.Serial)
				else ""),
			Size = UDim2.new(1, -8, 0, 22),
			Position = UDim2.fromOffset(4, 2),
			MaxTextSize = 14,
			Parent = frame,
		})
		Lib.Text({
			Text = Util.PetBadge(Config, pet) .. "  💰" .. Util.Format(Util.PetIncomeOf(Config, pet)) .. "/s",
			TextColor3 = C.Coins,
			Size = UDim2.new(1, -8, 0, 16),
			Position = UDim2.fromOffset(4, 24),
			MaxTextSize = 12,
			Parent = frame,
		})
		return frame
	end

	local signature = ""
	local function refresh()
		local data = State.Data
		local state = ctx.TradeUI and ctx.TradeUI.State
		if not data then
			return
		end
		-- only rebuild when something on screen changes (no lost taps mid-press)
		local parts = {}
		if state then
			for _, list in { state.Mine, state.Theirs } do
				for _, pet in list do
					table.insert(parts, tostring(pet.Id))
				end
				table.insert(parts, "|")
			end
			table.insert(parts, tostring(state.MyReady) .. tostring(state.TheirReady) .. tostring(state.Countdown))
			if state.Countdown then
				table.insert(parts, tostring(math.ceil(state.Countdown - State.Now())))
			end
			for _, pet in data.Pets do
				table.insert(parts, pet.Id .. (if pet.Away then "!" else ""))
			end
		else
			for _, other in Players:GetPlayers() do
				table.insert(parts, tostring(other.UserId))
			end
		end
		local sig = (if state then "T" else "P") .. table.concat(parts, ",")
		if sig == signature then
			return
		end
		signature = sig
		if not state then
			-- choose someone
			pickList.Visible = true
			tradeView.Visible = false
			status.Text = T("Pick a player in this server to trade pets with")
			Lib.Clear(pickList)
			local count = 0
			for _, other in Players:GetPlayers() do
				if other ~= player then
					count += 1
					local row = New("Frame", {
						BackgroundColor3 = C.Card,
						Size = UDim2.new(1, -12, 0, 54),
						LayoutOrder = count,
						Parent = pickList,
					}, { Lib.Corner(12) })
					Lib.Text({
						Text = other.DisplayName,
						Size = UDim2.new(1, -190, 1, -10),
						Position = UDim2.fromOffset(14, 5),
						TextXAlignment = Enum.TextXAlignment.Left,
						MaxTextSize = 22,
						Parent = row,
					})
					Lib.Button({
						Text = "🤝 Trade",
						Color = C.Cyan,
						Size = UDim2.fromOffset(150, 42),
						Position = UDim2.new(1, -160, 0.5, 0),
						AnchorPoint = Vector2.new(0, 0.5),
						TextSize = 20,
						Parent = row,
						OnClick = function()
							Net.Fire("TradeRequest", other.UserId)
						end,
					})
				end
			end
			if count == 0 then
				status.Text = T("Nobody else is in this server yet")
			end
			return
		end

		pickList.Visible = false
		tradeView.Visible = true
		myReady = state.MyReady == true
		local text = T("Trading with %s", state.Partner)
		if state.Countdown then
			local left = math.max(0, math.ceil(state.Countdown - State.Now()))
			text ..= "  •  " .. T("Swapping in %ds...", left)
		elseif state.TheirReady then
			text ..= "  •  " .. T("They are READY")
		end
		status.Text = text
		Lib.SetButton(readyButton, if myReady then T("✅ READY!") else T("Press READY"), if myReady then C.Green else C.Gray)

		for _, row in { myRow, theirRow } do
			for _, child in row:GetChildren() do
				if child:IsA("Frame") then
					child:Destroy()
				end
			end
		end
		local offered = {}
		for i, pet in state.Mine do
			offered[pet.Id] = true
			chip(myRow, pet, i)
		end
		for i, pet in state.Theirs do
			chip(theirRow, pet, i)
		end

		-- my pets: tap to add / remove from the offer
		Lib.Clear(inventory)
		local pets = table.clone(data.Pets)
		table.sort(pets, function(a, b)
			return Util.PetIncomeOf(Config, a) > Util.PetIncomeOf(Config, b)
		end)
		for order, pet in pets do
			if not pet.Away and Config.Pets[pet.Name] then
				local card = chip(inventory, pet, order)
				if offered[pet.Id] then
					card.BackgroundColor3 = Color3.fromRGB(40, 90, 60)
				end
				local button = New("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = card })
				button.Activated:Connect(function()
					local ids = {}
					for _, mine in state.Mine do
						if mine.Id ~= pet.Id then
							table.insert(ids, mine.Id)
						end
					end
					if not offered[pet.Id] then
						if #ids >= 4 then
							ctx.Toast(T("You can offer up to 4 pets"), C.Red)
							return
						end
						table.insert(ids, pet.Id)
					end
					Net.Fire("TradeSetOffer", ids)
				end)
			end
		end
	end

	-- keep the partner list fresh while the panel is open
	Players.PlayerAdded:Connect(function()
		refresh()
	end)
	Players.PlayerRemoving:Connect(function()
		task.defer(refresh)
	end)

	return {
		Refresh = refresh,
		Tick = function()
			local state = ctx.TradeUI and ctx.TradeUI.State
			if state and state.Countdown then
				refresh()
			end
		end,
		OnOpen = function()
			refresh()
		end,
	}
end

return Trade
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Root</string>
              <string name="Source"><![CDATA[--[[
	Root ScreenGui + screen "clusters" anchored to corners. Each cluster has
	its own UIScale so the UI fits phones, tablets and PCs.
]]
local Players = game:GetService("Players")

local Lib = require(script.Parent.Lib)

local player = Players.LocalPlayer
local Root = {}

Root.Gui = Lib.New("ScreenGui", {
	Name = "MeteorMinersUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
	DisplayOrder = 5,
	Parent = player:WaitForChild("PlayerGui"),
})

-- panels (shop, pets ...) sit above the HUD with a dim backdrop
Root.PanelGui = Lib.New("ScreenGui", {
	Name = "MeteorMinersPanels",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = true,
	DisplayOrder = 12,
	Parent = player:WaitForChild("PlayerGui"),
})

Root.Overlay = Lib.New("ScreenGui", {
	Name = "MeteorMinersOverlay",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = true,
	DisplayOrder = 20,
	Parent = player:WaitForChild("PlayerGui"),
})

local scales = {}

function Root.Scale(): number
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 760)
	return math.clamp(math.min(size.X / 1280, size.Y / 760), 0.55, 1.15)
end

local function applyScales()
	local s = Root.Scale()
	for _, scale in scales do
		scale.Scale = s
	end
end

function Root.Cluster(name: string, anchor: Vector2, position: UDim2, size: UDim2, parent: Instance?)
	local frame = Lib.New("Frame", {
		Name = name,
		AnchorPoint = anchor,
		Position = position,
		Size = size,
		BackgroundTransparency = 1,
		Parent = parent or Root.Gui,
	})
	local scale = Lib.New("UIScale", { Parent = frame })
	table.insert(scales, scale)
	applyScales()
	return frame
end

local function hookCamera()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(applyScales)
	end
	applyScales()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)
hookCamera()

return Root
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">Upsell</string>
              <string name="Source"><![CDATA[--[[
	Contextual upsell popup ("Want to mine while AFK? Get Auto Mine!"). Shown at the
	exact moment a pass would help - far better conversion than a store page.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Lib = require(script.Parent.Lib)
local Root = require(script.Parent.Root)
local Net = require(script.Parent.Parent.Net)
local State = require(script.Parent.Parent.State)

local New, C = Lib.New, Lib.Colors
local Upsell = {}

-- above panels (upsells often open from a panel)
local cluster = Root.Cluster("Upsell", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(420, 300), Root.Overlay)
cluster.ZIndex = 50
local frame = New("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = C.Panel,
	Visible = false,
	ZIndex = 50,
	Parent = cluster,
}, { Lib.Corner(20), Lib.Stroke(C.Gold, 3, 0) })
local icon = Lib.Text({
	Text = "⭐",
	Size = UDim2.fromOffset(80, 80),
	Position = UDim2.new(0.5, -40, 0, 12),
	MaxTextSize = 70,
	ZIndex = 51,
	Parent = frame,
})
local title = Lib.Text({
	Text = "",
	Size = UDim2.new(1, -30, 0, 34),
	Position = UDim2.fromOffset(15, 96),
	MaxTextSize = 30,
	ZIndex = 51,
	Parent = frame,
})
local description = Lib.Text({
	Text = "",
	Font = Lib.BodyFont,
	TextColor3 = C.Sub,
	Size = UDim2.new(1, -40, 0, 60),
	Position = UDim2.fromOffset(20, 134),
	TextWrapped = true,
	MaxTextSize = 18,
	ZIndex = 51,
	Parent = frame,
})
local current = nil

local buy = Lib.Button({
	Size = UDim2.fromOffset(200, 54),
	Position = UDim2.new(0.5, -205, 1, -70),
	ZIndex = 52,
	TextSize = 26,
	Parent = frame,
	OnClick = function()
		if current then
			Net.Fire(if current.Kind == "Pass" then "BuyPass" else "BuyProduct", current.Key)
		end
		frame.Visible = false
	end,
})
Lib.Button({
	Text = "No thanks",
	Color = C.Gray,
	Size = UDim2.fromOffset(180, 54),
	Position = UDim2.new(0.5, 15, 1, -70),
	ZIndex = 52,
	Parent = frame,
	OnClick = function()
		frame.Visible = false
	end,
})

local lastShown = {}
-- force = the player tapped a button themselves (never throttled)
local function show(kind: string, key: string, entry, force: boolean?)
	if not entry then
		return
	end
	-- don't nag: same offer at most once per 90 seconds
	local id = kind .. key
	if not force and lastShown[id] and os.clock() - lastShown[id] < 90 then
		return
	end
	lastShown[id] = os.clock()
	current = { Kind = kind, Key = key }
	icon.Text = entry.Icon or "⭐"
	title.Text = Lib.T(entry.Name)
	description.Text = Lib.T(entry.Description or "")
	Lib.SetButton(buy, "R$ " .. Lib.Price(kind, key), C.Green)
	frame.Visible = true
	Lib.Pop(frame)
end

function Upsell.Pass(key: string, force: boolean?)
	if State.HasPass(key) then
		return
	end
	show("Pass", key, Config.GamePasses[key], force)
end

function Upsell.Product(key: string, force: boolean?)
	show("Product", key, Config.Products[key], force)
end

function Upsell.Hide()
	frame.Visible = false
end

-- server-pushed offers are throttled
Net.On("Upsell", function(key)
	Upsell.Pass(key)
end)
Net.On("UpsellProduct", function(key)
	Upsell.Product(key)
end)

return Upsell
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
