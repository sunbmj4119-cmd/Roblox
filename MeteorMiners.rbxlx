  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server entry point. Services are initialised in dependency order:
	Init() wires references, Start() connects events and starts loops.
]]
local servicesFolder = script.Parent:WaitForChild("Services")

local ORDER = {
	"DataService",
	"StatsService",
	"MonetizationService",
	"BoostService",
	"WorldService",
	"CharacterService",
	"EconomyService",
	"PetService",
	"MiningService",
	"MeteorService",
	"ProgressionService",
	"LeaderboardService",
	"DevService",
}

local Services = {}
for _, name in ORDER do
	Services[name] = require(servicesFolder:WaitForChild(name))
end

for _, name in ORDER do
	local service = Services[name]
	if service.Init then
		service:Init(Services)
	end
end

-- Start everything except DataService first, so every OnLoaded/PlayerAdded hook
-- is registered before players' data begins loading.
for _, name in ORDER do
	local service = Services[name]
	if name ~= "DataService" and service.Start then
		local ok, err = pcall(service.Start, service)
		if not ok then
			warn(string.format("[Main] %s failed to start: %s", name, tostring(err)))
		end
	end
end
Services.DataService:Start()

print("[Meteor Miners] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="9">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">BoostService</string>
            <string name="Source"><![CDATA[--[[
	BoostService: personal timed boosts (tick only while online, stack time)
	and server-wide boosts bought by one player for everyone (Server Luck).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Boosts = {}
local Data

local serverBoosts = {} -- [key] = unix end time

function Boosts:IsActive(player: Player, key: string): boolean
	local data = Data:Get(player)
	return data ~= nil and (data.Boosts[key] or 0) > 0
end

function Boosts:Add(player: Player, key: string, seconds: number)
	local data = Data:Get(player)
	if not data then
		return
	end
	data.Boosts[key] = (data.Boosts[key] or 0) + seconds
	Net:Notify(player, string.format("⏫ %s boost +%s!", Util.BoostNames[key] or key, Util.FormatTime(seconds)), Color3.fromRGB(120, 255, 170))
	Data:MarkDirty(player)
end

function Boosts:ServerActive(key: string): boolean
	return (serverBoosts[key] or 0) > os.time()
end

function Boosts:AddServer(key: string, seconds: number, buyer: Player?)
	local now = os.time()
	serverBoosts[key] = math.max(serverBoosts[key] or 0, now) + seconds
	workspace:SetAttribute("Server_" .. key, serverBoosts[key])
	if buyer then
		Net:Announce(
			string.format("🌟 %s activated SERVER LUCK for everyone! (+%d min)", buyer.DisplayName, math.floor(seconds / 60)),
			Color3.fromRGB(255, 230, 90)
		)
	end
	for _, player in Players:GetPlayers() do
		Data:MarkDirty(player)
	end
end

function Boosts:Init(services)
	Data = services.DataService
end

function Boosts:Start()
	task.spawn(function()
		local tick = 0
		local function step()
			tick += 1
			for _, player in Data:LoadedPlayers() do
				local data = Data:Get(player)
				if data then
					local changed = false
					for key, remaining in data.Boosts do
						if remaining > 0 then
							data.Boosts[key] = math.max(0, remaining - 1)
							if data.Boosts[key] == 0 then
								changed = true
								Net:Notify(player, (Util.BoostNames[key] or key) .. " boost ended")
							end
						end
					end
					if changed or tick % 15 == 0 then
						Data:MarkDirty(player)
					end
				end
			end
			for key, endTime in serverBoosts do
				if endTime > 0 and endTime <= os.time() then
					serverBoosts[key] = 0
					workspace:SetAttribute("Server_" .. key, 0)
					for _, player in Players:GetPlayers() do
						Data:MarkDirty(player)
					end
				end
			end
		end
		while true do
			task.wait(1)
			local ok, err = pcall(step)
			if not ok then
				warn("[Boosts] tick error: " .. tostring(err))
			end
		end
	end)
end

return Boosts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[--[[
	CharacterService: gives the pickaxe tool, walk speed perks and the
	overhead tag (weekly rank, VIP / Club / leaderboard titles) that shows off
	status to everyone - a key driver of competition and pass sales.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local CharacterService = {}
local Services
local Data

local function buildPickaxe(tier: number): Tool
	local info = Config.Pickaxes[tier] or Config.Pickaxes[1]
	local tool = Instance.new("Tool")
	tool.Name = "Pickaxe"
	tool.ToolTip = info.Name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Tier", tier)
	tool.Grip = CFrame.new(0, -1.1, 0)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.35, 3.4, 0.35)
	handle.Color = Color3.fromRGB(110, 75, 45)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(2.8, 0.5, 0.5)
	head.Color = info.Color
	head.Material = if tier >= 7 then Enum.Material.Neon else Enum.Material.Metal
	head.CanCollide = false
	head.Massless = true
	head.CFrame = handle.CFrame * CFrame.new(0, 1.5, 0)
	head.Parent = tool

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = handle

	if tier >= 7 then
		local light = Instance.new("PointLight")
		light.Color = info.Color
		light.Range = 8
		light.Parent = head
	end
	return tool
end

function CharacterService:GivePickaxe(player: Player)
	local data = Data:Get(player)
	if not data then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	local wasEquipped = false
	for _, container in { backpack, character } do
		if container then
			local existing = container:FindFirstChild("Pickaxe")
			if existing then
				if container == character then
					wasEquipped = true
				end
				existing:Destroy()
			end
		end
	end
	local tool = buildPickaxe(data.PickaxeTier)
	if wasEquipped and character then
		tool.Parent = character
	elseif backpack then
		tool.Parent = backpack
	end
end

function CharacterService:ApplyWalkSpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local speed = 18
		if Services.MonetizationService:HasPass(player, "Speed") then
			speed *= 1.5
		end
		humanoid.WalkSpeed = speed
	end
end

function CharacterService:RefreshOverhead(player: Player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local data = Data:Get(player)
	if not head or not data then
		return
	end
	local gui = head:FindFirstChild("Overhead") :: BillboardGui
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "Overhead"
		gui.Size = UDim2.fromOffset(220, 52)
		gui.StudsOffset = Vector3.new(0, 3.1, 0)
		gui.MaxDistance = 90
		gui.LightInfluence = 0

		local layout = Instance.new("UIListLayout")
		layout.FillDirection = Enum.FillDirection.Vertical
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = gui

		for i, name in { "Tags", "Rank" } do
			local label = Instance.new("TextLabel")
			label.Name = name
			label.LayoutOrder = i
			label.BackgroundTransparency = 1
			label.Size = UDim2.new(1, 0, 0, if name == "Rank" then 24 else 22)
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.RichText = true
			label.TextColor3 = Color3.new(1, 1, 1)
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 2
			stroke.Parent = label
			label.Parent = gui
		end
		gui.Parent = head
	end

	local rank = Util.RankFor(Config, data.Weekly.Points)
	local rankLabel = gui:FindFirstChild("Rank") :: TextLabel
	rankLabel.Text = string.format("%s  •  ♻️%d", string.upper(rank.Name), data.Rebirths)
	rankLabel.TextColor3 = rank.Color

	local tags = {}
	local title = player:GetAttribute("Title")
	if type(title) == "string" and title ~= "" then
		table.insert(tags, "<font color='#FFD84A'>" .. title .. "</font>")
	end
	if Services.MonetizationService:HasPass(player, "VIP") then
		table.insert(tags, "<font color='#FFC93C'>[VIP]</font>")
	end
	if Services.MonetizationService:IsSubscribed(player) then
		table.insert(tags, "<font color='#5CF2FF'>[CLUB]</font>")
	end
	local tagLabel = gui:FindFirstChild("Tags") :: TextLabel
	tagLabel.Text = table.concat(tags, " ")
	tagLabel.Visible = #tags > 0
end

local function onCharacter(player: Player, character: Model)
	local data = Data:WaitFor(player, 30)
	if not data or player.Character ~= character then
		return
	end
	character:WaitForChild("Humanoid", 10)
	character:WaitForChild("Head", 10)
	CharacterService:GivePickaxe(player)
	CharacterService:ApplyWalkSpeed(player)
	CharacterService:RefreshOverhead(player)
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	player:GetAttributeChangedSignal("Title"):Connect(function()
		CharacterService:RefreshOverhead(player)
	end)
end

function CharacterService:Init(services)
	Services = services
	Data = services.DataService
end

function CharacterService:Start()
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService: loads/saves player data with a lightweight session lock so a
	player who server-hops quickly can't duplicate purchases or items.

	* UpdateAsync + _lock { JobId, Time } on load, refreshed on every save.
	* Saves are serialized per player, autosaved, and flushed on BindToClose.
	* In Studio without "Enable Studio Access to API Services" the game still
	  runs with temporary data (never saved) so you can test immediately.
]]
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local DataService = {}

local LOCK_EXPIRE = 300
local AUTOSAVE_SECONDS = 120
local SYNC_INTERVAL = 0.2
local MAX_RECEIPTS = 100

local TEMPLATE = {
	Version = 1,
	Coins = 0,
	Gems = 0,
	Stardust = 0,
	Backpack = 0,
	PickaxeTier = 1,
	BackpackTier = 1,
	ZoneLevel = 1,
	Rebirths = 0,
	Pets = {}, -- { { Id = 1, Name = "Bunny" }, ... }
	Equipped = {}, -- { petId, ... }
	NextPetUid = 1,
	PetIndex = {}, -- [petName] = true
	Boosts = { Coins2x = 0, Luck2x = 0, Power2x = 0 }, -- remaining seconds
	Stats = {
		BlocksMined = 0,
		LifetimeCoins = 0,
		EggsHatched = 0,
		MeteorWins = 0,
		MeteorJoins = 0,
		Bonks = 0,
		PlaySeconds = 0,
		Purchases = 0,
	},
	Daily = { Day = 0, Quests = {}, Streak = 0, LastClaimDay = 0, VipChestDay = 0, ClubDay = 0 },
	Season = { Id = 0, XP = 0, Premium = false, ClaimedFree = {}, ClaimedPremium = {} },
	Weekly = { Week = 0, Points = 0 },
	Flags = { StarterPack = false, GroupReward = false },
	Receipts = {},
	FirstJoin = 0,
	LastAdTime = 0,
}
DataService.Template = TEMPLATE

local profiles = {} -- [player] = { Data, CanSave, Dirty, Saving }
local loadedCallbacks = {}
local leavingCallbacks = {}
local store = nil

do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if not ok then
		warn("[DataService] DataStore unavailable: " .. tostring(err))
	end
end

local function keyFor(userId: number): string
	return "Player_" .. userId
end

local function isAccessError(err): boolean
	local text = tostring(err)
	return string.find(text, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(text, "403", 1, true) ~= nil
		or string.find(text, "not allowed", 1, true) ~= nil
end

-- returns data, canSave, fatal
local function loadAsync(player: Player, sessionId: string)
	if not store then
		return nil, false, false
	end
	local key = keyFor(player.UserId)
	for attempt = 1, 8 do
		local locked = false
		local result = nil
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				local data = if type(old) == "table" then old else {}
				local lock = data._lock
				if
					type(lock) == "table"
					and lock.Session ~= sessionId
					and os.time() - (tonumber(lock.Time) or 0) < LOCK_EXPIRE
					and attempt < 6
				then
					locked = true
					return nil -- cancel, another server still owns this session
				end
				data._lock = { Session = sessionId, JobId = game.JobId, Time = os.time() }
				result = data
				return data
			end)
		end)
		if ok and result then
			return result, true, false
		end
		if not ok then
			warn(string.format("[DataService] load attempt %d for %s failed: %s", attempt, player.Name, tostring(err)))
			if isAccessError(err) then
				return nil, false, false
			end
		end
		if not player.Parent then
			return nil, false, true
		end
		task.wait(if locked then 5 else 1.5 * attempt)
	end
	return nil, false, true
end

-- returns true only when the data was actually written (or saving is disabled)
local function saveAsync(player: Player, release: boolean): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return true
	end
	if profile.Released then
		return false -- the leave save already released the session; never re-take the lock
	end
	while profile.Saving do
		task.wait(0.1)
	end
	if profile.Released then
		return false
	end
	if release then
		profile.Released = true
	end
	profile.Saving = true
	local data = profile.Data
	local sessionId = profile.SessionId
	local wrote = false
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player.UserId), function(old)
			if type(old) == "table" and type(old._lock) == "table" and old._lock.Session ~= sessionId then
				wrote = false
				return nil -- session was taken over by another server; never overwrite it
			end
			data._lock = if release then nil else { Session = sessionId, JobId = game.JobId, Time = os.time() }
			wrote = true
			return data
		end)
	end)
	profile.Saving = false
	if not ok then
		warn(string.format("[DataService] save for %s failed: %s", player.Name, tostring(err)))
	elseif not wrote then
		warn(string.format("[DataService] save for %s skipped: session owned elsewhere", player.Name))
	end
	return ok and wrote
end

local function setupLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder
	local coins = Instance.new("StringValue")
	coins.Name = "Coins"
	coins.Parent = folder
	local rank = Instance.new("StringValue")
	rank.Name = "Rank"
	rank.Parent = folder
	folder.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local rebirths = folder:FindFirstChild("Rebirths") :: IntValue
	local coins = folder:FindFirstChild("Coins") :: StringValue
	local rank = folder:FindFirstChild("Rank") :: StringValue
	if rebirths then
		rebirths.Value = data.Rebirths
	end
	if coins then
		coins.Value = Util.Format(data.Coins)
	end
	if rank then
		local r = Util.RankFor(Config, data.Weekly.Points)
		rank.Value = r.Name
	end
end

local function snapshot(player: Player, profile)
	local out = {}
	for k, v in profile.Data do
		if k ~= "Receipts" and k ~= "_lock" then
			out[k] = v
		end
	end
	local derived = {}
	if DataService.BuildDerived then
		local ok, result = pcall(DataService.BuildDerived, player)
		if ok then
			derived = result
		else
			warn("[DataService] BuildDerived failed: " .. tostring(result))
		end
	end
	derived.CanSave = profile.CanSave
	return { Data = out, Derived = derived }
end

local function onPlayerAdded(player: Player)
	local sessionId = HttpService:GenerateGUID(false)
	local data, canSave, fatal = loadAsync(player, sessionId)
	if not player.Parent then
		-- left while loading: release the session lock we just took
		if data and canSave and store then
			pcall(function()
				store:UpdateAsync(keyFor(player.UserId), function(old)
					if type(old) == "table" and type(old._lock) == "table" and old._lock.Session == sessionId then
						old._lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return
	end
	if fatal then
		player:Kick("Your data could not be loaded. Please rejoin in a moment!")
		return
	end
	if not data then
		data = {}
		canSave = false
		task.delay(6, function()
			Net:Notify(player, "⚠ Data is not saving (Studio API access is off).", Color3.fromRGB(255, 170, 60))
		end)
	end
	data._lock = nil
	Util.Reconcile(data, TEMPLATE)
	if data.FirstJoin == 0 then
		data.FirstJoin = os.time()
	end

	profiles[player] = { Data = data, CanSave = canSave, Dirty = true, Saving = false, Released = false, SessionId = sessionId }
	setupLeaderstats(player)
	updateLeaderstats(player, data)
	player:SetAttribute("DataLoaded", true)

	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	for _, callback in leavingCallbacks do
		local ok, err = pcall(callback, player, profile.Data)
		if not ok then
			warn("[DataService] leaving callback failed: " .. tostring(err))
		end
	end
	saveAsync(player, true)
	profiles[player] = nil
end

-- PUBLIC API ---------------------------------------------------------------

function DataService:Get(player: Player)
	local profile = profiles[player]
	return profile and profile.Data
end

function DataService:WaitFor(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 30)
	while player.Parent and not profiles[player] and os.clock() < deadline do
		task.wait(0.1)
	end
	return self:Get(player)
end

function DataService:OnLoaded(callback)
	table.insert(loadedCallbacks, callback)
	for player, profile in profiles do
		task.spawn(callback, player, profile.Data)
	end
end

function DataService:OnLeaving(callback)
	table.insert(leavingCallbacks, callback)
end

function DataService:MarkDirty(player: Player)
	local profile = profiles[player]
	if profile then
		profile.Dirty = true
	end
end

function DataService:Save(player: Player)
	return saveAsync(player, false)
end

function DataService:LoadedPlayers()
	local list = {}
	for player in profiles do
		table.insert(list, player)
	end
	return list
end

function DataService:HasReceipt(player: Player, purchaseId: string): boolean
	local data = self:Get(player)
	if not data then
		return false
	end
	return table.find(data.Receipts, purchaseId) ~= nil
end

function DataService:AddReceipt(player: Player, purchaseId: string)
	local data = self:Get(player)
	if not data then
		return
	end
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
end

function DataService:Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	Net:On("Sync", 2, function(player)
		self:MarkDirty(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- push state to clients
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < SYNC_INTERVAL then
			return
		end
		accumulator = 0
		for player, profile in profiles do
			if profile.Dirty then
				profile.Dirty = false
				updateLeaderstats(player, profile.Data)
				Net:Send(player, "Data", snapshot(player, profile))
			end
		end
	end)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player in profiles do
				task.spawn(saveAsync, player, false)
				task.wait(0.5)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				saveAsync(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--[[
	DevService: test cheats. Allowed in Studio, and for the game owner in live
	servers while Config.OwnerTestMode is true (see Util.CanTest).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage.Shared.Util)

local Net = require(script.Parent.Net)

local Dev = {}
local Services

function Dev:Init(services)
	Services = services
end

function Dev:Start()
	local Data = Services.DataService
	Net:On("Dev", 0.2, function(player, command)
		if not Util.CanTest(Config, player) then
			return
		end
		local data = Data:Get(player)
		if not data then
			return
		end
		if command == "Coins" then
			local amount = math.max(1000000, data.Coins * 10)
			data.Coins += amount
			data.Stats.LifetimeCoins += amount
		elseif command == "Gems" then
			data.Gems += 10000
		elseif command == "Stardust" then
			data.Stardust += 5000
		elseif command == "Points" then
			Services.ProgressionService:AddPoints(player, 2500)
		elseif command == "XP" then
			Services.ProgressionService:AddSeasonXP(player, 5 * 2000)
		elseif command == "Meteor" then
			Services.MeteorService:Summon(player)
		elseif command == "Fill" then
			data.Backpack = Services.StatsService:Capacity(player, data)
		elseif command == "Reset" then
			local fresh = Util.DeepCopy(Data.Template)
			fresh.FirstJoin = os.time()
			for key in data do
				data[key] = nil
			end
			for key, value in fresh do
				data[key] = value
			end
			Services.CharacterService:GivePickaxe(player)
			Services.PetService:RefreshEquipped(player)
		end
		Net:Notify(player, "[DEV] " .. tostring(command))
		Data:MarkDirty(player)
	end)
end

return Dev
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	EconomyService: selling ore, pickaxe/backpack upgrades, zone unlocks,
	rebirths and teleports. All prices are validated on the server.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Economy = {}
local Services
local Data

local RED = Color3.fromRGB(255, 110, 110)
local REBIRTH_ANNOUNCE = { [1] = true, [5] = true, [10] = true, [25] = true, [50] = true, [100] = true }

local function notEnough(player: Player, need: number, have: number, currency: string)
	Net:Notify(player, string.format("Not enough %s! Need %s more.", currency, Util.Format(need - have)), RED)
end

function Economy:Sell(player: Player, silent: boolean?): number
	local data = Data:Get(player)
	if not data then
		return 0
	end
	if data.Backpack <= 0 then
		if not silent then
			Net:Notify(player, "Your backpack is empty - go mine some ore!")
		end
		return 0
	end
	local coins = math.floor(data.Backpack * Services.StatsService:CoinMultiplier(player, data))
	data.Coins += coins
	data.Stats.LifetimeCoins += coins
	data.Backpack = 0
	Services.ProgressionService:AddQuest(player, "Sell", 1)
	Net:Send(player, "Sold", coins)
	Data:MarkDirty(player)
	return coins
end

function Economy:UnlockZone(player: Player, index: number)
	local data = Data:Get(player)
	local zone = Config.Zones[index]
	if not data or not zone then
		return
	end
	if data.ZoneLevel >= index then
		return
	end
	if data.ZoneLevel + 1 < index then
		Net:Notify(player, "Unlock " .. Config.Zones[data.ZoneLevel + 1].Name .. " first!", RED)
		return
	end
	if data.Coins < zone.Cost then
		notEnough(player, zone.Cost, data.Coins, "coins")
		return
	end
	data.Coins -= zone.Cost
	data.ZoneLevel = index
	Net:Send(player, "ZoneUnlocked", index)
	Net:Notify(player, "🔓 " .. zone.Name .. " unlocked!", Color3.fromRGB(120, 255, 170))
	if zone.PvP then
		Net:Announce("⚔️ " .. player.DisplayName .. " entered the Star Crater!", Color3.fromRGB(255, 90, 120))
	end
	Services.ProgressionService:AddQuest(player, "Upgrade", 1)
	Data:MarkDirty(player)
end

local function buyUpgrade(player: Player, listName: string, field: string)
	local data = Data:Get(player)
	if not data then
		return
	end
	local list = Config[listName]
	local nextTier = data[field] + 1
	local item = list[nextTier]
	if not item then
		Net:Notify(player, "You already own the best one!")
		return
	end
	if data.Coins < item.Cost then
		notEnough(player, item.Cost, data.Coins, "coins")
		return
	end
	data.Coins -= item.Cost
	data[field] = nextTier
	if field == "PickaxeTier" then
		Services.CharacterService:GivePickaxe(player)
	end
	Services.ProgressionService:AddQuest(player, "Upgrade", 1)
	Net:Notify(player, "✅ Bought " .. item.Name .. "!", Color3.fromRGB(120, 255, 170))
	Data:MarkDirty(player)
end

function Economy:Rebirth(player: Player)
	local data = Data:Get(player)
	if not data then
		return
	end
	local cost = Util.RebirthCost(Config, data.Rebirths)
	if data.Coins < cost then
		notEnough(player, cost, data.Coins, "coins")
		return
	end
	data.Rebirths += 1
	data.Coins = 0
	data.Backpack = 0
	data.PickaxeTier = 1
	data.BackpackTier = 1
	local gems = Config.Rebirth.GemsPer * data.Rebirths
	data.Gems += gems
	Services.CharacterService:GivePickaxe(player)
	Services.CharacterService:RefreshOverhead(player)
	Services.PetService:RefreshEquipped(player)
	Net:Send(player, "Rebirthed", data.Rebirths, gems)
	if REBIRTH_ANNOUNCE[data.Rebirths] then
		Net:Announce(string.format("♻️ %s reached Rebirth %d!", player.DisplayName, data.Rebirths), Color3.fromRGB(200, 130, 255))
	end
	Data:MarkDirty(player)
end

function Economy:Init(services)
	Services = services
	Data = services.DataService
end

function Economy:Start()
	local world = Services.WorldService

	-- sell pad
	local debounce = {}
	world.SellPad.Touched:Connect(function(hit)
		local character = hit:FindFirstAncestorOfClass("Model")
		local player = character and Players:GetPlayerFromCharacter(character)
		if not player then
			return
		end
		local now = os.clock()
		if debounce[player] and now - debounce[player] < 1 then
			return
		end
		debounce[player] = now
		self:Sell(player, true)
	end)
	Players.PlayerRemoving:Connect(function(player)
		debounce[player] = nil
	end)

	Net:On("SellAnywhere", 0.5, function(player)
		if Services.MonetizationService:HasPass(player, "AutoSell") then
			self:Sell(player)
		else
			Net:Send(player, "Upsell", "AutoSell")
		end
	end)
	Net:On("BuyPickaxe", 0.25, function(player)
		buyUpgrade(player, "Pickaxes", "PickaxeTier")
	end)
	Net:On("BuyBackpack", 0.25, function(player)
		buyUpgrade(player, "Backpacks", "BackpackTier")
	end)
	Net:On("UnlockZone", 0.5, function(player, index)
		if type(index) == "number" then
			self:UnlockZone(player, math.floor(index))
		end
	end)
	Net:On("Rebirth", 1, function(player)
		self:Rebirth(player)
	end)
	Net:On("Teleport", 1, function(player, index)
		local data = Data:Get(player)
		local character = player.Character
		if not data or not character or type(index) ~= "number" then
			return
		end
		index = math.floor(index)
		if index ~= 0 and (index < 1 or index > data.ZoneLevel) then
			Net:Notify(player, "Unlock that zone first!", RED)
			return
		end
		character:PivotTo(world:SpawnFor(index))
	end)
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardService: global OrderedDataStore boards rendered on giant
	signs in the hub (Weekly ranked / Richest / Most rebirths).
	The weekly board resets every Monday (new store key per week); the global
	top 10 get gem rewards and in-server crown titles.
]]
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Leaderboards = {}
local Services
local Data

local MAX_VALUE = 2 ^ 53
local nameCache = {}
local storeCache = {}
local placementCache = {} -- [week] = { [userId] = place }
local currentTop = {} -- [boardKey] = entries

local function getStore(name: string)
	if storeCache[name] == nil then
		local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, Config.LeaderboardPrefix .. name)
		storeCache[name] = if ok then store else false
	end
	return storeCache[name] or nil
end

local function storeFor(board, week: number?)
	if board.Weekly then
		return getStore("Weekly_" .. (week or Util.WeekNumber()))
	end
	return getStore(board.Key)
end

local function valueFor(key: string, data): number
	if key == "Weekly" then
		return data.Weekly.Points
	elseif key == "LifetimeCoins" then
		return data.Stats.LifetimeCoins
	elseif key == "Rebirths" then
		return data.Rebirths
	end
	return 0
end

local function formatValue(key: string, value: number): string
	if key == "Weekly" then
		return Util.Comma(value) .. " pts"
	end
	return Util.Format(value)
end

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.Name
		return player.Name
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	if ok and name then
		nameCache[userId] = name
		return name
	end
	return "Player"
end

local function buildBoardGui(part: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = part

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Color3.fromRGB(20, 20, 32)
	root.BorderSizePixel = 0
	root.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.PaddingTop = UDim.new(0, 10)
	padding.Parent = root

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0.13, 0)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 215, 80)
	title.Text = part:GetAttribute("Title") or "LEADERBOARD"
	title.Parent = root

	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0, 0.13)
	sub.Size = UDim2.new(1, 0, 0.06, 0)
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(180, 180, 200)
	sub.Text = ""
	sub.Parent = root

	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0, 0.21)
	list.Size = UDim2.fromScale(1, 0.77)
	list.Parent = root
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 3)
	layout.Parent = list

	for i = 1, 10 do
		local row = Instance.new("Frame")
		row.Name = "Row" .. i
		row.LayoutOrder = i
		row.Size = UDim2.new(1, 0, 0.097, 0)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(32, 32, 48) else Color3.fromRGB(40, 40, 60)
		row.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = row
		local color = if i == 1
			then Color3.fromRGB(255, 215, 60)
			elseif i == 2 then Color3.fromRGB(210, 220, 235)
			elseif i == 3 then Color3.fromRGB(230, 150, 80)
			else Color3.new(1, 1, 1)
		for _, spec in {
			{ "PlaceLabel", 0, 0.12, Enum.TextXAlignment.Center },
			{ "NameLabel", 0.13, 0.55, Enum.TextXAlignment.Left },
			{ "ValueLabel", 0.68, 0.31, Enum.TextXAlignment.Right },
		} do
			local label = Instance.new("TextLabel")
			label.Name = spec[1]
			label.BackgroundTransparency = 1
			label.Position = UDim2.fromScale(spec[2], 0.1)
			label.Size = UDim2.fromScale(spec[3], 0.8)
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextXAlignment = spec[4]
			label.TextColor3 = color
			label.Text = if spec[1] == "PlaceLabel" then "#" .. i else "-"
			label.Parent = row
		end
		row.Parent = list
	end
	return gui
end

local function render(board, entries)
	local part = Services.WorldService.Boards[board.Key]
	if not part then
		return
	end
	local gui = part:FindFirstChild("Board") or buildBoardGui(part)
	local root = gui:FindFirstChild("Root")
	local list = root:FindFirstChild("List")
	for i = 1, 10 do
		local row = list:FindFirstChild("Row" .. i)
		local entry = entries[i]
		local nameLabel = row:FindFirstChild("NameLabel") :: TextLabel
		local valueLabel = row:FindFirstChild("ValueLabel") :: TextLabel
		nameLabel.Text = if entry then nameFor(entry.UserId) else "-"
		valueLabel.Text = if entry then formatValue(board.Key, entry.Value) else ""
	end
	local sub = root:FindFirstChild("Sub") :: TextLabel
	if board.Weekly then
		sub.Text = "Resets in " .. Util.FormatTime(Util.SecondsUntilNextWeek()) .. " • Top 10 win gems!"
	else
		sub.Text = "All-time • Global"
	end
end

local function localEntries(key: string)
	local entries = {}
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		if data then
			table.insert(entries, { UserId = player.UserId, Value = math.floor(valueFor(key, data)) })
		end
	end
	table.sort(entries, function(a, b)
		return a.Value > b.Value
	end)
	return entries
end

local function fetchTop(store)
	local ok, pages = pcall(store.GetSortedAsync, store, false, 10)
	if not ok then
		return nil
	end
	local entries = {}
	for _, item in pages:GetCurrentPage() do
		table.insert(entries, { UserId = tonumber(item.key) or 0, Value = item.value })
	end
	return entries
end

local function updateTitles()
	local weekly = currentTop.Weekly or {}
	local titles = {}
	for place, entry in weekly do
		if place <= 3 then
			titles[entry.UserId] = ({ "👑 #1 WEEKLY", "🥈 #2 WEEKLY", "🥉 #3 WEEKLY" })[place]
		elseif place <= 10 then
			titles[entry.UserId] = "⭐ TOP 10"
		end
	end
	for _, player in Players:GetPlayers() do
		local title = titles[player.UserId] or ""
		if player:GetAttribute("Title") ~= title then
			player:SetAttribute("Title", title)
		end
	end
end

local function refresh()
	-- push scores of everyone in this server
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		-- owner test mode: DEV-panel coins must not pollute the global boards
		local skip = Config.OwnerTestMode and Util.IsOwner(player)
		if data and not skip then
			for _, board in Config.Leaderboards.Boards do
				-- weekly points always go to the week they were earned in, so a
				-- refresh right after Monday 00:00 can't leak last week's points
				local store = if board.Weekly
					then (if data.Weekly.Week ~= 0 then storeFor(board, data.Weekly.Week) else nil)
					else storeFor(board)
				local value = math.floor(math.min(valueFor(board.Key, data), MAX_VALUE))
				if store and value > 0 then
					pcall(store.SetAsync, store, tostring(player.UserId), value)
				end
			end
		end
		task.wait(0.1)
	end
	-- pull global tops
	for _, board in Config.Leaderboards.Boards do
		local store = storeFor(board)
		local entries = store and fetchTop(store)
		if not entries then
			entries = localEntries(board.Key)
		end
		currentTop[board.Key] = entries
		render(board, entries)
	end
	updateTitles()
end

-- Returns the final placement (1-10) of a user in a past week, or nil.
function Leaderboards:GetWeeklyPlacement(week: number, userId: number): number?
	if not placementCache[week] then
		local weeklyBoard
		for _, board in Config.Leaderboards.Boards do
			if board.Weekly then
				weeklyBoard = board
			end
		end
		local store = weeklyBoard and storeFor(weeklyBoard, week)
		local entries = store and fetchTop(store)
		local map = {}
		for place, entry in entries or {} do
			map[entry.UserId] = place
		end
		placementCache[week] = map
	end
	return placementCache[week][userId]
end

function Leaderboards:Init(services)
	Services = services
	Data = services.DataService
end

function Leaderboards:Start()
	for _, board in Config.Leaderboards.Boards do
		local part = Services.WorldService.Boards[board.Key]
		if part then
			buildBoardGui(part)
		end
	end
	task.spawn(function()
		task.wait(10)
		while true do
			local ok, err = pcall(refresh)
			if not ok then
				warn("[Leaderboards] refresh failed: " .. tostring(err))
			end
			task.wait(Config.Leaderboards.RefreshSeconds)
		end
	end)
end

return Leaderboards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">MeteorService</string>
            <string name="Source"><![CDATA[--[[
	MeteorService: the server-wide competitive event.
	Every few minutes (or when someone buys "Summon Meteor") a meteor crashes
	into the hub crater. Everyone races to hit it; score per hit is
	1 + log10(damage) so new players can still compete with veterans.
	Top 3 get big stardust/gem rewards + weekly ranked points, everyone who
	participates gets a share. Stardust buys the exclusive Cosmic Egg.
]]
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(script.Parent.Net)

local Meteor = {}
local Services
local Data

local settings = Config.Meteor
local state = "Idle" -- Idle | Warning | Falling | Active | Ending
local nextAt = os.time() + math.min(150, settings.IntervalSeconds)
local warnEnd = 0
local endsAt = 0
local hp, maxHp = 0, 0
local scores = {} -- [player] = score
local meteorPart: BasePart? = nil
local summoner: Player? = nil
local summonQueue = {}

local function setAttributes()
	workspace:SetAttribute("MeteorState", state)
	workspace:SetAttribute("MeteorNext", nextAt)
	workspace:SetAttribute("MeteorWarnEnd", warnEnd)
	workspace:SetAttribute("MeteorEnd", endsAt)
	workspace:SetAttribute("MeteorHP", hp)
	workspace:SetAttribute("MeteorMaxHP", maxHp)
end

function Meteor:IsActive(): boolean
	return state == "Active"
end

function Meteor:InRange(position: Vector3): boolean
	if not meteorPart then
		return false
	end
	return (position - meteorPart.Position).Magnitude <= settings.Radius + Config.World.Reach + 2
end

local function ranking()
	local list = {}
	for player, score in scores do
		if player.Parent then
			table.insert(list, { Player = player, Score = score })
		end
	end
	table.sort(list, function(a, b)
		return a.Score > b.Score
	end)
	return list
end

local function buildMeteor(): BasePart
	local part = Instance.new("Part")
	part.Name = "Meteor"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one * settings.Radius * 2
	part.Material = Enum.Material.Basalt
	part.Color = Color3.fromRGB(70, 50, 45)
	part.Anchored = true
	part.CanCollide = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth

	local core = Instance.new("Part")
	core.Name = "Core"
	core.Shape = Enum.PartType.Ball
	core.Size = part.Size * 0.85
	core.Material = Enum.Material.Neon
	core.Color = Color3.fromRGB(255, 120, 40)
	core.Transparency = 0.35
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.Parent = part

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 140, 60)
	light.Range = 40
	light.Brightness = 3
	light.Parent = part

	local fire = Instance.new("Fire")
	fire.Size = settings.Radius * 1.6
	fire.Heat = 12
	fire.Color = Color3.fromRGB(255, 120, 40)
	fire.SecondaryColor = Color3.fromRGB(255, 220, 80)
	fire.Parent = part

	local gui = Instance.new("BillboardGui")
	gui.Name = "HPBar"
	gui.Size = UDim2.fromOffset(300, 34)
	gui.StudsOffsetWorldSpace = Vector3.new(0, settings.Radius + 5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
	back.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(255, 120, 40)
	fill.BorderSizePixel = 0
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill
	fill.Parent = back
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.Text = "☄️ METEOR"
	text.ZIndex = 2
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = text
	text.Parent = back
	back.Parent = gui
	gui.Parent = part
	return part
end

local function updateBar()
	if not meteorPart then
		return
	end
	local gui = meteorPart:FindFirstChild("HPBar")
	local back = gui and gui:FindFirstChildOfClass("Frame")
	if back then
		local ratio = if maxHp > 0 then math.clamp(hp / maxHp, 0, 1) else 0
		(back :: any).Fill.Size = UDim2.fromScale(ratio, 1);
		(back :: any).Text.Text = string.format("☄️ METEOR  %d%%", math.ceil(ratio * 100))
	end
end

local function shatter(position: Vector3)
	local folder = Services.WorldService:Folder("Drops")
	for _ = 1, 14 do
		local chunk = Instance.new("Part")
		chunk.Name = "MeteorChunk"
		chunk.Size = Vector3.one * math.random(15, 35) / 10
		chunk.Material = Enum.Material.Basalt
		chunk.Color = Color3.fromRGB(80, 55, 45)
		chunk.CanCollide = false
		chunk.CanQuery = false
		chunk.Position = position + Vector3.new(math.random(-4, 4), math.random(0, 4), math.random(-4, 4))
		chunk.AssemblyLinearVelocity = Vector3.new(math.random(-40, 40), math.random(40, 80), math.random(-40, 40))
		chunk.Parent = folder
		Debris:AddItem(chunk, 3)
	end
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastPressure = 0
	explosion.BlastRadius = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.Parent = workspace
end

local function finish(destroyed: boolean)
	if state ~= "Active" then
		return
	end
	state = "Ending"
	local list = ranking()
	local total = 0
	for _, entry in list do
		total += entry.Score
	end
	local mult = if destroyed then 1 else settings.FailedMultiplier
	local progression = Services.ProgressionService
	local topNames = {}

	for place, entry in list do
		local player = entry.Player
		local data = Data:Get(player)
		if data then
			local share = if total > 0 then entry.Score / total else 0
			local stardust = settings.ParticipationStardust + math.floor(share * settings.ShareStardust)
			local gems = 0
			local points = settings.ParticipationPoints
			local placeReward = settings.PlaceRewards[place]
			if placeReward then
				stardust += placeReward.Stardust
				gems += placeReward.Gems
				points = placeReward.Points
				table.insert(topNames, player.DisplayName)
			end
			stardust = math.floor(stardust * mult)
			gems = math.floor(gems * mult)
			if player == summoner then
				stardust *= 2
			end
			data.Stardust += stardust
			data.Gems += gems
			data.Stats.MeteorJoins += 1
			if place == 1 and destroyed then
				data.Stats.MeteorWins += 1
			end
			progression:AddQuest(player, "MeteorJoin", 1)
			if place <= 3 then
				progression:AddQuest(player, "MeteorTop3", 1)
			end
			progression:AddPoints(player, points)
			progression:AddSeasonXP(player, settings.PassXP)
			Net:Send(player, "MeteorResult", {
				Place = place,
				Total = #list,
				Stardust = stardust,
				Gems = gems,
				Points = points,
				Destroyed = destroyed,
			})
			Data:MarkDirty(player)
		end
	end

	local medals = { "🥇", "🥈", "🥉" }
	local parts = {}
	for i, name in topNames do
		table.insert(parts, medals[i] .. " " .. name)
	end
	local headline = if destroyed then "☄️ Meteor destroyed! " else "☄️ The meteor escaped! "
	Net:Announce(headline .. table.concat(parts, "  "), Color3.fromRGB(255, 170, 80))

	if meteorPart then
		local position = meteorPart.Position
		meteorPart:Destroy()
		meteorPart = nil
		shatter(position)
	end
	scores = {}
	summoner = nil
	hp, maxHp = 0, 0
	state = "Idle"
	nextAt = os.time() + settings.IntervalSeconds
	setAttributes()
	Net:Broadcast("MeteorRank", {})
end

-- back to a clean idle state so a failure never stops future events
local function resetToIdle()
	if meteorPart then
		meteorPart:Destroy()
		meteorPart = nil
	end
	scores = {}
	summoner = nil
	hp, maxHp = 0, 0
	state = "Idle"
	nextAt = os.time() + settings.IntervalSeconds
	setAttributes()
	Net:Broadcast("MeteorRank", {})
end

local function safeFinish(destroyed: boolean)
	local ok, err = pcall(finish, destroyed)
	if not ok then
		warn("[Meteor] finish failed: " .. tostring(err))
		resetToIdle()
	end
end

-- cooldown is the attacker's swing cooldown, used to size the meteor so the
-- event lasts about SecondsPerParticipant no matter how strong players are
function Meteor:Hit(player: Player, damage: number, cooldown: number?)
	if state ~= "Active" then
		return
	end
	local score = 1 + math.log10(math.max(1, damage))
	if not scores[player] then
		-- each new participant makes the meteor tougher by ~N seconds of their own hitting
		local extra = settings.SecondsPerParticipant * score / math.max(0.2, cooldown or 0.5)
		maxHp += extra
		hp += extra
		workspace:SetAttribute("MeteorMaxHP", maxHp)
	end
	scores[player] = (scores[player] or 0) + score
	hp = math.max(0, hp - score)
	workspace:SetAttribute("MeteorHP", hp)
	updateBar()
	Net:Send(player, "MeteorHit", score)
	if hp <= 0 then
		safeFinish(true)
	end
end

function Meteor:Summon(player: Player)
	table.insert(summonQueue, player)
	if state == "Idle" then
		Net:Notify(player, "☄️ Your meteor is on its way!", Color3.fromRGB(255, 170, 80))
	else
		Net:Notify(player, "☄️ Your meteor will fall right after the current one!", Color3.fromRGB(255, 170, 80))
	end
end

local function startWarning()
	local summoned = table.remove(summonQueue, 1)
	if summoned and not summoned.Parent then
		summoned = nil
	end
	summoner = summoned
	state = "Warning"
	warnEnd = os.time() + (if summoned then settings.SummonWarningSeconds else settings.WarningSeconds)
	setAttributes()
	if summoned then
		Net:Announce(
			string.format("☄️ %s SUMMONED A METEOR! Get to the crater! (%ds)", summoned.DisplayName, warnEnd - os.time()),
			Color3.fromRGB(255, 150, 60)
		)
	else
		Net:Announce(string.format("☄️ A METEOR is about to crash into the crater! (%ds)", warnEnd - os.time()), Color3.fromRGB(255, 150, 60))
	end
end

local function startFalling()
	state = "Falling"
	setAttributes()
	local final = settings.Position + Vector3.new(0, settings.Radius * 0.6, 0)
	local part = buildMeteor()
	part.Position = final + Vector3.new(60, 320, 40)
	part.Parent = Services.WorldService:Folder("Drops")
	meteorPart = part
	local core = part:FindFirstChild("Core") :: BasePart
	core.Position = part.Position
	local info = TweenInfo.new(2.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(part, info, { Position = final }):Play()
	TweenService:Create(core, info, { Position = final }):Play()
	task.wait(2.25)
	local explosion = Instance.new("Explosion")
	explosion.Position = final
	explosion.BlastPressure = 0
	explosion.BlastRadius = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.Parent = workspace
	Net:Broadcast("MeteorImpact", final)

	maxHp = settings.BaseHP
	hp = maxHp
	scores = {}
	endsAt = os.time() + settings.DurationSeconds
	state = "Active"
	setAttributes()
	updateBar()
end

function Meteor:Init(services)
	Services = services
	Data = services.DataService
end

function Meteor:Start()
	setAttributes()
	task.spawn(function()
		local lastRankPush = 0
		local function step()
			local now = os.time()
			if state == "Idle" then
				if now >= nextAt or #summonQueue > 0 then
					startWarning()
				end
			elseif state == "Warning" then
				if now >= warnEnd then
					startFalling()
				end
			elseif state == "Active" then
				if now >= endsAt then
					safeFinish(false)
				elseif os.clock() - lastRankPush >= 1 then
					lastRankPush = os.clock()
					local list = ranking()
					local top = {}
					for i = 1, math.min(5, #list) do
						table.insert(top, { Name = list[i].Player.DisplayName, Score = math.floor(list[i].Score) })
					end
					for place, entry in list do
						Net:Send(entry.Player, "MeteorRank", top, place, math.floor(entry.Score))
					end
					for _, player in Players:GetPlayers() do
						if not scores[player] then
							Net:Send(player, "MeteorRank", top, nil, 0)
						end
					end
				end
			end
		end
		while true do
			task.wait(0.25)
			local ok, err = pcall(step)
			if not ok then
				warn("[Meteor] loop error: " .. tostring(err))
				resetToIdle()
			elseif state == "Ending" then
				-- finish() never got back to Idle: recover
				resetToIdle()
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		scores[player] = nil
	end)

	Net:On("GoToMeteor", 2, function(player)
		local character = player.Character
		if character and (state == "Warning" or state == "Falling" or state == "Active") then
			character:PivotTo(CFrame.new(settings.Position + Vector3.new(0, 4, -18)))
		end
	end)
end

return Meteor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">MiningService</string>
            <string name="Source"><![CDATA[--[[
	MiningService: ore blocks (spawn / damage / respawn), the pickaxe swing
	handler (server-authoritative range + cooldown checks), backpack filling,
	and Star Crater PvP: bonk a player to knock 25% of their ore onto the
	ground as orbs anyone can grab.
]]
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Mining = {}
local Services
local Data
local World

local blockInfo = {} -- [part] = { Slot, Ore, HP, Zone }
local zoneBlocks = {} -- [zone] = { [part] = true }
local lastSwing = {} -- [player] = os.clock()
local immunity = {} -- [player] = os.clock() until
local oreFolder: Folder
local dropFolder: Folder

local oreRng = Random.new()

local function pickOre(zoneIndex: number): string
	return Util.WeightedPick(Config.Zones[zoneIndex].Ores, nil, oreRng)
end

local function spawnBlock(slot)
	if slot.Part and slot.Part.Parent then
		return
	end
	local oreId = pickOre(slot.Zone)
	local ore = Config.Ores[oreId]
	local size = Config.World.OreSize
	local part = Instance.new("Part")
	part.Name = oreId
	part.Size = Vector3.new(size, size, size)
	part.Anchored = true
	part.Material = ore.Material
	part.Color = ore.Color
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = CFrame.new(slot.Position) * CFrame.Angles(0, math.rad(oreRng:NextInteger(0, 3) * 90), 0)
	part:SetAttribute("Ore", oreId)
	part:SetAttribute("HP", ore.HP)
	part:SetAttribute("MaxHP", ore.HP)
	part:SetAttribute("Zone", slot.Zone)
	if ore.Glow then
		local light = Instance.new("PointLight")
		light.Color = ore.Color
		light.Range = 10
		light.Brightness = 1.4
		light.Parent = part
	end
	part.Parent = oreFolder
	slot.Part = part
	blockInfo[part] = { Slot = slot, Ore = oreId, HP = ore.HP, Zone = slot.Zone }
	zoneBlocks[slot.Zone][part] = true
end

local function removeBlock(part: BasePart, info)
	blockInfo[part] = nil
	zoneBlocks[info.Zone][part] = nil
	info.Slot.Part = nil
	part:Destroy()
	task.delay(Config.World.OreRespawnSeconds, spawnBlock, info.Slot)
end

local function withinReach(root: BasePart, part: BasePart, extra: number?): boolean
	local reach = Config.World.Reach + (extra or 0) + part.Size.Magnitude / 2
	return (root.Position - part.Position).Magnitude <= reach
end

local function nearestBlock(root: BasePart): BasePart?
	local zone = World:ZoneAt(root.Position)
	if not zone or zone == 0 then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for part in zoneBlocks[zone] do
		local distance = (part.Position - root.Position).Magnitude
		if distance < bestDistance then
			best, bestDistance = part, distance
		end
	end
	if best and withinReach(root, best) then
		return best
	end
	return nil
end

local function mineBlock(player: Player, data, part: BasePart)
	local info = blockInfo[part]
	if not info then
		return
	end
	if info.Zone > data.ZoneLevel then
		Net:Notify(player, "Unlock " .. Config.Zones[info.Zone].Name .. " to mine here!", Color3.fromRGB(255, 110, 110))
		return
	end
	local stats = Services.StatsService
	local monetization = Services.MonetizationService
	local capacity = stats:Capacity(player, data)
	if data.Backpack >= capacity then
		if monetization:HasPass(player, "AutoSell") then
			Services.EconomyService:Sell(player, true)
		else
			Net:Send(player, "BackpackFull")
			return
		end
	end

	local ore = Config.Ores[info.Ore]
	info.HP -= stats:Damage(player, data)
	if info.HP > 0 then
		part:SetAttribute("HP", info.HP)
		Net:Send(player, "MineHit", part, info.HP / ore.HP)
		return
	end

	local gained = math.min(ore.Value, capacity - data.Backpack)
	data.Backpack += gained
	data.Stats.BlocksMined += 1
	local extra = {}
	if ore.GemChance and math.random() < ore.GemChance then
		data.Gems += ore.Gems
		extra.Gems = ore.Gems
	end
	if ore.Stardust then
		data.Stardust += ore.Stardust
		extra.Stardust = ore.Stardust
	end
	local position = part.Position
	removeBlock(part, info)
	Services.ProgressionService:OnBlockMined(player, info.Zone)
	Net:Send(player, "MineBreak", position, info.Ore, gained, extra)

	if data.Backpack >= capacity and monetization:HasPass(player, "AutoSell") then
		Services.EconomyService:Sell(player, true)
	end
	Data:MarkDirty(player)
end

---------------------------------------------------------------------------
-- PvP
---------------------------------------------------------------------------
local function spawnOrbs(origin: Vector3, total: number)
	local count = math.clamp(total, 1, 6)
	local each = math.floor(total / count)
	local remainder = total - each * count
	for i = 1, count do
		local value = each + (if i == 1 then remainder else 0)
		local angle = (i / count) * math.pi * 2
		local orb = Instance.new("Part")
		orb.Name = "OreOrb"
		orb.Shape = Enum.PartType.Ball
		orb.Size = Vector3.one * 1.8
		orb.Material = Enum.Material.Neon
		orb.Color = Color3.fromRGB(255, 120, 230)
		orb.Anchored = true
		orb.CanCollide = false
		orb.Position = Vector3.new(origin.X + math.cos(angle) * 6, 1.6, origin.Z + math.sin(angle) * 6)
		orb:SetAttribute("Value", value)
		local light = Instance.new("PointLight")
		light.Color = orb.Color
		light.Range = 8
		light.Parent = orb

		local taken = false
		orb.Touched:Connect(function(hit)
			if taken then
				return
			end
			local character = hit:FindFirstAncestorOfClass("Model")
			local player = character and Players:GetPlayerFromCharacter(character)
			local data = player and Data:Get(player)
			if not data then
				return
			end
			local capacity = Services.StatsService:Capacity(player, data)
			if data.Backpack >= capacity then
				return
			end
			taken = true
			local added = math.min(value, capacity - data.Backpack)
			data.Backpack += added
			Net:Notify(player, "✨ +" .. Util.Format(added) .. " stolen ore!", Color3.fromRGB(255, 140, 230))
			Data:MarkDirty(player)
			orb:Destroy()
		end)
		orb.Parent = dropFolder
		Debris:AddItem(orb, Config.PvP.OrbLifetime)
	end
end

local function tryBonk(attacker: Player, victim: Player)
	local aRoot = attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart") :: BasePart
	local vRoot = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") :: BasePart
	local aData, vData = Data:Get(attacker), Data:Get(victim)
	if not aRoot or not vRoot or not aData or not vData then
		return
	end
	if (aRoot.Position - vRoot.Position).Magnitude > Config.PvP.BonkRange then
		return
	end
	local pvpZone = World.PvPZone
	if World:ZoneAt(aRoot.Position) ~= pvpZone or World:ZoneAt(vRoot.Position) ~= pvpZone then
		Net:Notify(attacker, "⚔️ You can only bonk players inside the Star Crater!")
		return
	end
	local now = os.clock()
	if (immunity[victim] or 0) > now then
		return
	end
	immunity[victim] = now + Config.PvP.ImmunitySeconds

	local drop = math.floor(vData.Backpack * Config.PvP.DropPercent)
	if drop > 0 then
		vData.Backpack -= drop
		spawnOrbs(vRoot.Position, drop)
	end
	aData.Stats.Bonks += 1
	local progression = Services.ProgressionService
	progression:AddQuest(attacker, "Bonk", 1)
	progression:AddPoints(attacker, Config.PvP.PointsPerBonk)

	local direction = (vRoot.Position - aRoot.Position) * Vector3.new(1, 0, 1)
	direction = if direction.Magnitude > 0.01 then direction.Unit else Vector3.zAxis
	Net:Send(victim, "Knockback", direction * Config.PvP.Knockback + Vector3.new(0, 35, 0))
	Net:Send(victim, "Bonked", attacker.DisplayName, drop)
	Net:Notify(attacker, string.format("💥 Bonked %s! %s ore dropped", victim.DisplayName, Util.Format(drop)), Color3.fromRGB(255, 140, 90))
	Data:MarkDirty(attacker)
	Data:MarkDirty(victim)
end

---------------------------------------------------------------------------
local function onSwing(player: Player, hint)
	local data = Data:Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if not character:FindFirstChild("Pickaxe") then
		return
	end
	local now = os.clock()
	local cooldown = Services.StatsService:SwingCooldown(player, data)
	if lastSwing[player] and now - lastSwing[player] < cooldown * 0.8 then
		return
	end
	lastSwing[player] = now

	local hintPart = if typeof(hint) == "Instance" and hint:IsA("BasePart") then hint else nil
	local meteor = Services.MeteorService

	-- 1) explicit target: another player (PvP) or a block
	if hintPart then
		local model = hintPart:FindFirstAncestorOfClass("Model")
		local victim = model and Players:GetPlayerFromCharacter(model)
		if victim and victim ~= player then
			tryBonk(player, victim)
			return
		end
		if blockInfo[hintPart] and withinReach(root, hintPart) then
			mineBlock(player, data, hintPart)
			return
		end
	end

	-- 2) meteor event
	if meteor:IsActive() and meteor:InRange(root.Position) then
		meteor:Hit(player, Services.StatsService:Damage(player, data), cooldown)
		return
	end

	-- 3) auto target the closest block (mobile friendly + auto mine pass)
	local target = nearestBlock(root)
	if target then
		mineBlock(player, data, target)
	end
end

function Mining:Init(services)
	Services = services
	Data = services.DataService
	World = services.WorldService
end

function Mining:Start()
	oreFolder = World:Folder("Ores")
	dropFolder = World:Folder("Drops")
	for zone, slots in World.OreSlots do
		zoneBlocks[zone] = {}
		for _, slot in slots do
			spawnBlock(slot)
		end
	end

	Net:On("Swing", 0.08, onSwing)

	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
		immunity[player] = nil
	end)
end

return Mining
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--[[
	MonetizationService
	  * Game passes (ownership cache + purchase prompts + instant effects)
	  * Developer products via ProcessReceipt (idempotent: PurchaseId stored in data)
	  * Experience subscription (Miner Club)
	  * Roblox Premium upsell
	  * Native rewarded video ads (AdService) - disabled until you enable it
	  * PolicyService compliance: paid random items (Golden Egg) are hidden for
	    players where they are restricted, and odds are always shown before buying.

	Studio testing: any pass/product whose Id is 0 is granted instantly in
	Studio ("[TEST]") so the full flow can be tested before IDs exist.
]]
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Monetization = {}
local Services
local Data

local owned = {} -- [player] = { [passKey] = true }
local subscribed = {} -- [player] = bool
local passById = {}
local productById = {}

for key, pass in Config.GamePasses do
	if pass.Id ~= 0 then
		passById[pass.Id] = key
	end
end
for key, product in Config.Products do
	if product.Id ~= 0 then
		productById[product.Id] = key
	end
end

local GOLD = Color3.fromRGB(255, 210, 70)

function Monetization:HasPass(player: Player, key: string): boolean
	local list = owned[player]
	return list ~= nil and list[key] == true
end

function Monetization:OwnedPasses(player: Player)
	return owned[player] or {}
end

function Monetization:IsSubscribed(player: Player): boolean
	return subscribed[player] == true
end

local function applyPass(player: Player, key: string, isNewPurchase: boolean)
	local list = owned[player]
	if not list then
		list = {}
		owned[player] = list
	end
	if list[key] then
		return
	end
	list[key] = true
	player:SetAttribute("Pass_" .. key, true)
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
	local character = Services.CharacterService
	if key == "Speed" then
		character:ApplyWalkSpeed(player)
	end
	character:RefreshOverhead(player)
	Services.PetService:RefreshEquipped(player)
	Data:MarkDirty(player)

	if isNewPurchase then
		local pass = Config.GamePasses[key]
		Net:Notify(player, "🎉 Unlocked " .. pass.Name .. "!", GOLD)
		-- social proof: everyone sees supporters
		Net:Announce(string.format("%s %s just got %s!", pass.Icon or "⭐", player.DisplayName, pass.Name), GOLD)
	end
end

local function refreshSubscription(player: Player)
	local sub = Config.Subscription
	if sub.Id == "" then
		return
	end
	local ok, status = pcall(function()
		return MarketplaceService:GetUserSubscriptionStatusAsync(player, sub.Id)
	end)
	if ok and type(status) == "table" and player.Parent then
		local wasSubscribed = subscribed[player] == true
		subscribed[player] = status.IsSubscribed == true
		player:SetAttribute("Club", subscribed[player])
		if subscribed[player] and not wasSubscribed then
			Services.ProgressionService:CheckClubDaily(player)
		end
		Services.CharacterService:RefreshOverhead(player)
		Data:MarkDirty(player)
	end
end

local function checkPolicy(player: Player)
	for _ = 1, 3 do
		local ok, policy = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
		if ok and type(policy) == "table" then
			player:SetAttribute("PaidRandomRestricted", policy.ArePaidRandomItemsRestricted == true)
			Data:MarkDirty(player)
			return
		end
		task.wait(2)
	end
	-- unknown policy: be safe and treat paid random items as restricted
	player:SetAttribute("PaidRandomRestricted", true)
	Data:MarkDirty(player)
end

local function onPlayerAdded(player: Player)
	owned[player] = owned[player] or {}
	for key, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			task.spawn(function()
				local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
				if ok and result and player.Parent then
					applyPass(player, key, false)
				end
			end)
		end
	end
	task.spawn(checkPolicy, player)
	task.spawn(refreshSubscription, player)
end

---------------------------------------------------------------------------
-- product granting
---------------------------------------------------------------------------
local function canBuy(player: Player, key: string, data): (boolean, string?)
	local product = Config.Products[key]
	if product.Kind == "StarterPack" and data.Flags.StarterPack then
		return false, "You already own the Starter Pack!"
	end
	if product.Kind == "SeasonPremium" and data.Season.Premium then
		return false, "You already own the Premium Pass!"
	end
	if product.Kind == "PaidEgg" then
		if player:GetAttribute("PaidRandomRestricted") ~= false then
			return false, "This item isn't available in your region."
		end
		if #data.Pets + product.Count > Config.MaxPets then
			return false, "Your pet inventory is full!"
		end
	end
	if key == "AdReward" then
		return false, "Watch an ad to get this reward."
	end
	return true
end

local function grantProduct(player: Player, key: string, data)
	local product = Config.Products[key]
	local kind = product.Kind
	local stats = Services.StatsService

	if kind == "Gems" then
		data.Gems += product.Amount
		Net:Notify(player, string.format("💎 +%d Gems! Thank you!", product.Amount), GOLD)
	elseif kind == "CoinPack" then
		local amount = math.max(2500, math.floor(stats:Capacity(player, data) * 15 * stats:CoinMultiplier(player, data)))
		data.Coins += amount
		data.Stats.LifetimeCoins += amount
		Net:Send(player, "Sold", amount)
	elseif kind == "Boost" then
		Services.BoostService:Add(player, product.Boost, product.Seconds)
	elseif kind == "ServerBoost" then
		Services.BoostService:AddServer(product.Boost, product.Seconds, player)
	elseif kind == "SummonMeteor" then
		Services.MeteorService:Summon(player)
	elseif kind == "SeasonPremium" then
		data.Season.Premium = true
		Net:Notify(player, "🎫 Premium Pass unlocked! Claim your rewards.", GOLD)
		Net:Announce("🎫 " .. player.DisplayName .. " unlocked the Premium Season Pass!", GOLD)
	elseif kind == "SkipTiers" then
		Services.ProgressionService:AddSeasonXP(player, Config.Season.XPPerTier * product.Amount)
	elseif kind == "StarterPack" then
		data.Flags.StarterPack = true
		Services.ProgressionService:GrantReward(player, Config.StarterPack.Reward, "Starter Pack")
	elseif kind == "PaidEgg" then
		Services.PetService:PaidHatch(player, product.Egg, product.Count)
	else
		error("Unknown product kind " .. tostring(kind))
	end
	data.Stats.Purchases += 1
	Data:MarkDirty(player)
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Data:WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if Data:HasReceipt(player, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productById[receipt.ProductId]
	if not key then
		warn("[Monetization] unknown product id " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, err = pcall(grantProduct, player, key, data)
	if not ok then
		warn("[Monetization] grant failed: " .. tostring(err))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Data:AddReceipt(player, purchaseId)
	if not Data:Save(player) then
		-- granted in memory but not persisted: let Roblox retry. The stored
		-- PurchaseId prevents a double grant if this session is still alive.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------------------
-- rewarded video ads (native Roblox AdService)
---------------------------------------------------------------------------
local function watchAd(player: Player)
	local settings = Config.RewardedAds
	if not settings.Enabled then
		return false, "Ads are not available."
	end
	local data = Data:Get(player)
	if not data then
		return false, "Loading..."
	end
	local remaining = settings.CooldownSeconds - (os.time() - data.LastAdTime)
	if remaining > 0 then
		return false, string.format("Next free reward in %d min", math.ceil(remaining / 60))
	end
	local product = Config.Products.AdReward
	if product.Id == 0 then
		if Util.CanTest(Config, player) then
			data.LastAdTime = os.time()
			grantProduct(player, "AdReward", data)
			return true, "[TEST] Ad reward granted"
		end
		return false, "Ad reward is not configured."
	end
	-- NOTE: verify method names against the current AdService docs before enabling.
	local ok, result = pcall(function()
		local AdService = game:GetService("AdService")
		local availability = AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
		if availability.AdAvailabilityResult ~= Enum.AdAvailabilityResult.IsAvailable then
			return "unavailable"
		end
		local reward = AdService:CreateAdRewardFromDevProductId(product.Id)
		AdService:ShowRewardedVideoAdAsync(player, reward)
		return "shown"
	end)
	if not ok then
		warn("[Monetization] ad failed: " .. tostring(result))
		return false, "No ad available right now."
	end
	if result ~= "shown" then
		return false, "No ad available right now."
	end
	-- the reward itself arrives through ProcessReceipt
	data.LastAdTime = os.time()
	Data:MarkDirty(player)
	return true, "Thanks for watching!"
end

---------------------------------------------------------------------------
function Monetization:Init(services)
	Services = services
	Data = services.DataService
end

function Monetization:Start()
	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		subscribed[player] = nil
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			local key = passById[passId]
			if key then
				applyPass(player, key, true)
			end
		end
	end)

	pcall(function()
		(Players :: any).UserSubscriptionStatusChanged:Connect(function(player, subscriptionId)
			if subscriptionId == Config.Subscription.Id then
				refreshSubscription(player)
			end
		end)
	end)

	Net:On("BuyPass", 0.5, function(player, key)
		local pass = type(key) == "string" and Config.GamePasses[key]
		if not pass then
			return
		end
		if self:HasPass(player, key) then
			Net:Notify(player, "You already own " .. pass.Name .. "!")
			return
		end
		if pass.Id == 0 then
			if Util.CanTest(Config, player) then
				applyPass(player, key, true)
				Net:Notify(player, "[TEST] Simulated purchase (no Robux charged): " .. pass.Name)
			else
				Net:Notify(player, "Coming soon!")
			end
			return
		end
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	end)

	Net:On("BuyProduct", 0.5, function(player, key)
		local product = type(key) == "string" and Config.Products[key]
		local data = Data:Get(player)
		if not product or not data then
			return
		end
		local ok, reason = canBuy(player, key, data)
		if not ok then
			Net:Notify(player, reason or "Not available")
			return
		end
		if product.Id == 0 then
			if Util.CanTest(Config, player) then
				grantProduct(player, key, data)
				Net:Notify(player, "[TEST] Simulated purchase (no Robux charged): " .. product.Name)
			else
				Net:Notify(player, "Coming soon!")
			end
			return
		end
		MarketplaceService:PromptProductPurchase(player, product.Id)
	end)

	Net:On("BuySubscription", 1, function(player)
		local sub = Config.Subscription
		if self:IsSubscribed(player) then
			Net:Notify(player, "You're already in the " .. sub.Name .. "!")
			return
		end
		if sub.Id == "" then
			if Util.CanTest(Config, player) then
				subscribed[player] = true
				player:SetAttribute("Club", true)
				Services.ProgressionService:CheckClubDaily(player)
				Services.CharacterService:RefreshOverhead(player)
				Data:MarkDirty(player)
				Net:Notify(player, "[TEST] Simulated subscription: " .. sub.Name)
			else
				Net:Notify(player, "Coming soon!")
			end
			return
		end
		local ok, err = pcall(function()
			MarketplaceService:PromptSubscriptionPurchase(player, sub.Id)
		end)
		if not ok then
			warn("[Monetization] subscription prompt failed: " .. tostring(err))
		end
	end)

	Net:On("BuyPremium", 1, function(player)
		if player.MembershipType ~= Enum.MembershipType.Premium then
			pcall(MarketplaceService.PromptPremiumPurchase, MarketplaceService, player)
		end
	end)

	Net:OnRequest("WatchAd", 2, function(player)
		return watchAd(player)
	end)
end

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--[[
	Networking: one RemoteEvent for client->server actions, one RemoteFunction
	for requests that need a reply, one RemoteEvent for server->client messages.
	Every action is rate limited per player and wrapped in pcall.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local actionRemote = Instance.new("RemoteEvent")
actionRemote.Name = "Action"
actionRemote.Parent = folder

local requestRemote = Instance.new("RemoteFunction")
requestRemote.Name = "Request"
requestRemote.Parent = folder

local messageRemote = Instance.new("RemoteEvent")
messageRemote.Name = "Message"
messageRemote.Parent = folder

folder.Parent = ReplicatedStorage

local actionHandlers = {}
local requestHandlers = {}
local lastCall = {} -- [player] = { [name] = os.clock() }

local function allowed(player, name, minInterval)
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	local now = os.clock()
	local last = calls[name]
	if last and now - last < minInterval then
		return false
	end
	calls[name] = now
	return true
end

function Net:On(name: string, minInterval: number, handler)
	actionHandlers[name] = { Interval = minInterval, Fn = handler }
end

function Net:OnRequest(name: string, minInterval: number, handler)
	requestHandlers[name] = { Interval = minInterval, Fn = handler }
end

function Net:Send(player: Player, kind: string, ...)
	if player and player.Parent then
		messageRemote:FireClient(player, kind, ...)
	end
end

function Net:Broadcast(kind: string, ...)
	messageRemote:FireAllClients(kind, ...)
end

function Net:Notify(player: Player, text: string, color: Color3?)
	self:Send(player, "Notify", text, color)
end

function Net:Announce(text: string, color: Color3?)
	self:Broadcast("Announce", text, color)
end

actionRemote.OnServerEvent:Connect(function(player, name, ...)
	if type(name) ~= "string" then
		return
	end
	local handler = actionHandlers[name]
	if not handler or not allowed(player, name, handler.Interval) then
		return
	end
	local ok, err = pcall(handler.Fn, player, ...)
	if not ok then
		warn(string.format("[Net] action %s from %s failed: %s", name, player.Name, tostring(err)))
	end
end)

requestRemote.OnServerInvoke = function(player, name, ...)
	if type(name) ~= "string" then
		return nil
	end
	local handler = requestHandlers[name]
	if not handler or not allowed(player, "req_" .. name, handler.Interval) then
		return nil
	end
	local results = table.pack(pcall(handler.Fn, player, ...))
	if not results[1] then
		warn(string.format("[Net] request %s from %s failed: %s", name, player.Name, tostring(results[2])))
		return nil
	end
	return table.unpack(results, 2, results.n)
end

Players.PlayerRemoving:Connect(function(player)
	lastCall[player] = nil
end)

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--[[
	PetService: eggs (coins / gems / stardust / Robux), luck, inventory,
	equip/unequip, and server-wide hatch announcements for rare pets.
	Equipped pet names are replicated through a player attribute so every
	client can render everyone's pets locally (cheap on the server).
]]
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local PetService = {}
local Services
local Data

local CURRENCY_NAMES = { Coins = "coins", Gems = "gems", Stardust = "stardust" }

local function luckFn(luck: number)
	return function(name: string, weight: number): number
		local info = Config.Pets[name]
		local rarity = info and Config.Rarities[info.Rarity]
		if rarity and rarity.Order >= Config.LuckAffectsFromRarity then
			return weight * luck
		end
		return weight
	end
end
PetService.LuckFn = luckFn

local function power(name: string): number
	local info = Config.Pets[name]
	return if info then info.Power else 0
end

function PetService:RefreshEquipped(player: Player)
	local data = Data:Get(player)
	if not data then
		return
	end
	local byId = {}
	for _, pet in data.Pets do
		byId[pet.Id] = pet
	end
	local slots = Services.StatsService:PetSlots(player, data)
	local valid, names = {}, {}
	for _, id in data.Equipped do
		if byId[id] and not table.find(valid, id) and #valid < slots then
			table.insert(valid, id)
			table.insert(names, byId[id].Name)
		end
	end
	data.Equipped = valid
	player:SetAttribute("Pets", HttpService:JSONEncode(names))
	Data:MarkDirty(player)
end

local function addPet(player: Player, data, name: string)
	local pet = { Id = data.NextPetUid, Name = name }
	data.NextPetUid += 1
	table.insert(data.Pets, pet)
	data.PetIndex[name] = true
	if #data.Equipped < Services.StatsService:PetSlots(player, data) then
		table.insert(data.Equipped, pet.Id)
	end
	return pet
end

local function announceIfRare(player: Player, name: string, eggName: string)
	local info = Config.Pets[name]
	local rarity = info and Config.Rarities[info.Rarity]
	if rarity and rarity.Order >= Config.AnnounceRarity then
		Net:Announce(
			string.format("🥚 %s hatched a %s %s from the %s!", player.DisplayName, string.upper(info.Rarity), name, eggName),
			rarity.Color
		)
	end
end

local function roll(player: Player, data, eggId: string, count: number)
	local egg = Config.Eggs[eggId]
	local luck = Services.StatsService:Luck(player, data)
	local fn = luckFn(luck)
	local results = {}
	for _ = 1, count do
		local name = Util.WeightedPick(egg.Pets, fn)
		addPet(player, data, name)
		table.insert(results, name)
		announceIfRare(player, name, egg.Name)
	end
	data.Stats.EggsHatched += count
	Services.ProgressionService:AddQuest(player, "Hatch", count)
	Services.ProgressionService:AddSeasonXP(player, 25 * count)
	PetService:RefreshEquipped(player)
	return results
end

function PetService:GrantPet(player: Player, name: string)
	local data = Data:Get(player)
	if not data or not Config.Pets[name] then
		return
	end
	addPet(player, data, name)
	self:RefreshEquipped(player)
	Net:Send(player, "HatchResult", { name }, nil)
end

function PetService:PaidHatch(player: Player, eggId: string, count: number)
	local data = Data:Get(player)
	if not data or not Config.Eggs[eggId] then
		error("invalid paid hatch")
	end
	local results = roll(player, data, eggId, count)
	Net:Send(player, "HatchResult", results, eggId)
end

local function hatch(player: Player, eggId, count)
	local data = Data:Get(player)
	local egg = type(eggId) == "string" and Config.Eggs[eggId]
	if not data or not egg or egg.Currency == "Robux" then
		return { Error = "Invalid egg" }
	end
	count = if count == 3 then 3 else 1
	if count == 3 and not Services.MonetizationService:HasPass(player, "TripleHatch") then
		return { Error = "Triple Hatch requires the gamepass!", Upsell = "TripleHatch" }
	end
	if data.ZoneLevel < egg.Zone then
		return { Error = "Unlock " .. Config.Zones[egg.Zone].Name .. " first!" }
	end
	if #data.Pets + count > Config.MaxPets then
		return { Error = "Pet inventory full! Delete some pets first." }
	end
	local cost = egg.Price * count
	local balance = data[egg.Currency] or 0
	if balance < cost then
		return { Error = string.format("Not enough %s! Need %s more.", CURRENCY_NAMES[egg.Currency], Util.Format(cost - balance)) }
	end
	data[egg.Currency] -= cost
	local results = roll(player, data, eggId, count)
	return { Pets = results, Egg = eggId }
end

local function findPet(data, petId)
	for index, pet in data.Pets do
		if pet.Id == petId then
			return pet, index
		end
	end
	return nil, nil
end

function PetService:Init(services)
	Services = services
	Data = services.DataService
end

function PetService:Start()
	Data:OnLoaded(function(player)
		self:RefreshEquipped(player)
	end)

	Net:OnRequest("Hatch", 0.35, hatch)

	Net:On("EquipPet", 0.1, function(player, petId)
		local data = Data:Get(player)
		if not data or type(petId) ~= "number" or not findPet(data, petId) or table.find(data.Equipped, petId) then
			return
		end
		if #data.Equipped >= Services.StatsService:PetSlots(player, data) then
			Net:Notify(player, "All pet slots are full! Unequip one or get more slots.")
			Net:Send(player, "Upsell", "ExtraPets")
			return
		end
		table.insert(data.Equipped, petId)
		self:RefreshEquipped(player)
	end)

	Net:On("UnequipPet", 0.1, function(player, petId)
		local data = Data:Get(player)
		if not data then
			return
		end
		local index = table.find(data.Equipped, petId)
		if index then
			table.remove(data.Equipped, index)
			self:RefreshEquipped(player)
		end
	end)

	Net:On("EquipBest", 0.5, function(player)
		local data = Data:Get(player)
		if not data then
			return
		end
		local sorted = table.clone(data.Pets)
		table.sort(sorted, function(a, b)
			return power(a.Name) > power(b.Name)
		end)
		local slots = Services.StatsService:PetSlots(player, data)
		data.Equipped = {}
		for i = 1, math.min(slots, #sorted) do
			table.insert(data.Equipped, sorted[i].Id)
		end
		self:RefreshEquipped(player)
	end)

	Net:On("DeletePet", 0.1, function(player, petId)
		local data = Data:Get(player)
		if not data then
			return
		end
		local _, index = findPet(data, petId)
		if index then
			table.remove(data.Pets, index)
			local equippedIndex = table.find(data.Equipped, petId)
			if equippedIndex then
				table.remove(data.Equipped, equippedIndex)
			end
			self:RefreshEquipped(player)
		end
	end)

	-- quick cleanup: delete every unequipped pet of a low rarity
	Net:On("DeleteRarity", 1, function(player, rarity)
		local data = Data:Get(player)
		if not data or (rarity ~= "Common" and rarity ~= "Uncommon") then
			return
		end
		local kept = {}
		local removed = 0
		for _, pet in data.Pets do
			local info = Config.Pets[pet.Name]
			if info and info.Rarity == rarity and not table.find(data.Equipped, pet.Id) then
				removed += 1
			else
				table.insert(kept, pet)
			end
		end
		data.Pets = kept
		self:RefreshEquipped(player)
		Net:Notify(player, string.format("Deleted %d %s pets", removed, rarity))
	end)
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--[[
	ProgressionService: everything that brings players back every day/week.
	  * Daily login streak (7-day calendar, streak breaks if you miss a day)
	  * 3 random daily quests
	  * Playtime gifts (10+ min sessions -> Creator Rewards daily engagement)
	  * Weekly ranked points + tier rewards on week rollover (+ global top 10)
	  * Season pass (free + premium track)
	  * VIP daily chest, Miner Club daily gems, one-time group reward
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Progression = {}
local Services
local Data

local sessionStart = {} -- [player] = unix time
local giftsClaimed = {} -- [player] = { [index] = true }
local questById = {}
for _, quest in Config.Quests do
	questById[quest.Id] = quest
end

local GREEN = Color3.fromRGB(120, 255, 170)
local GOLD = Color3.fromRGB(255, 210, 70)

local function tierOf(xp: number): number
	return math.min(#Config.SeasonTiers, math.floor(xp / Config.Season.XPPerTier))
end
Progression.TierOf = tierOf

function Progression:SessionStart(player: Player): number
	return sessionStart[player] or os.time()
end

function Progression:GiftsClaimed(player: Player)
	local list = {}
	for index in giftsClaimed[player] or {} do
		table.insert(list, index)
	end
	return list
end

function Progression:GrantReward(player: Player, reward, source: string?)
	local data = Data:Get(player)
	if not data or not reward then
		return
	end
	if reward.Gems then
		data.Gems += reward.Gems
	end
	if reward.Coins then
		data.Coins += reward.Coins
		data.Stats.LifetimeCoins += reward.Coins
	end
	if reward.Stardust then
		data.Stardust += reward.Stardust
	end
	if reward.Boost then
		Services.BoostService:Add(player, reward.Boost[1], reward.Boost[2])
	end
	if reward.Pet then
		Services.PetService:GrantPet(player, reward.Pet)
	end
	Data:MarkDirty(player)
	Net:Send(player, "Reward", Util.RewardText(reward), source)
end

function Progression:AddQuest(player: Player, questType: string, amount: number)
	local data = Data:Get(player)
	if not data then
		return
	end
	for _, quest in data.Daily.Quests do
		local def = questById[quest.Id]
		if def and def.Type == questType and not quest.Claimed and quest.Progress < def.Target then
			quest.Progress = math.min(def.Target, quest.Progress + amount)
			if quest.Progress >= def.Target then
				Net:Notify(player, "✅ Quest complete: " .. def.Text .. " - claim it!", GREEN)
			end
			Data:MarkDirty(player)
		end
	end
end

function Progression:AddPoints(player: Player, amount: number)
	local data = Data:Get(player)
	if not data then
		return
	end
	local _, before = Util.RankFor(Config, data.Weekly.Points)
	data.Weekly.Points += amount
	local rank, after = Util.RankFor(Config, data.Weekly.Points)
	if after > before then
		Net:Notify(player, "🏅 RANK UP! You are now " .. string.upper(rank.Name) .. "!", rank.Color)
		if after >= 5 then
			Net:Announce(string.format("🏅 %s reached %s rank this week!", player.DisplayName, string.upper(rank.Name)), rank.Color)
		end
		Services.CharacterService:RefreshOverhead(player)
	end
	Data:MarkDirty(player)
end

function Progression:AddSeasonXP(player: Player, amount: number)
	local data = Data:Get(player)
	if not data then
		return
	end
	local before = tierOf(data.Season.XP)
	data.Season.XP += amount
	local after = tierOf(data.Season.XP)
	if after > before then
		Net:Notify(player, "🎫 Season Pass tier " .. after .. " reached! Claim your rewards.", GOLD)
	end
	Data:MarkDirty(player)
end

function Progression:OnBlockMined(player: Player, zone: number)
	self:AddQuest(player, "MineBlocks", 1)
	self:AddSeasonXP(player, Config.Season.XPPerBlock * zone)
	self:AddPoints(player, Config.PointsPerBlock[zone] or 1)
end

function Progression:CheckClubDaily(player: Player)
	local data = Data:Get(player)
	if not data or not Services.MonetizationService:IsSubscribed(player) then
		return
	end
	local today = Util.DayNumber()
	if data.Daily.ClubDay ~= today then
		data.Daily.ClubDay = today
		self:GrantReward(player, { Gems = Config.Subscription.DailyGems }, Config.Subscription.Name .. " daily gems")
	end
end

local function rollQuests(data)
	local indices = {}
	for i = 1, #Config.Quests do
		indices[i] = i
	end
	for i = #indices, 2, -1 do
		local j = math.random(1, i)
		indices[i], indices[j] = indices[j], indices[i]
	end
	data.Daily.Quests = {}
	for i = 1, math.min(Config.DailyQuestCount, #indices) do
		local def = Config.Quests[indices[i]]
		table.insert(data.Daily.Quests, { Id = def.Id, Progress = 0, Claimed = false })
	end
end

local function checkRollovers(player: Player, data, isLoad: boolean)
	-- daily
	local today = Util.DayNumber()
	if data.Daily.Day ~= today then
		data.Daily.Day = today
		rollQuests(data)
		if not isLoad then
			Net:Notify(player, "📜 New daily quests are available!", GREEN)
		end
	end
	-- season
	if data.Season.Id ~= Config.Season.Id then
		data.Season = { Id = Config.Season.Id, XP = 0, Premium = false, ClaimedFree = {}, ClaimedPremium = {} }
	end
	-- weekly ranked
	local week = Util.WeekNumber()
	if data.Weekly.Week ~= week then
		local lastWeek, lastPoints = data.Weekly.Week, data.Weekly.Points
		data.Weekly.Week = week
		data.Weekly.Points = 0
		if lastWeek ~= 0 and lastPoints > 0 then
			local rank = Util.RankFor(Config, lastPoints)
			local gems = rank.RewardGems
			task.spawn(function()
				local placement = Services.LeaderboardService:GetWeeklyPlacement(lastWeek, player.UserId)
				local topReward = placement and Config.Leaderboards.WeeklyTopReward[placement] or 0
				local total = gems + topReward
				if total > 0 and player.Parent then
					local text = string.format("Last week: %s rank", string.upper(rank.Name))
					if placement then
						text ..= string.format(" + GLOBAL #%d", placement)
					end
					Progression:GrantReward(player, { Gems = total }, text)
				end
			end)
		end
		Services.CharacterService:RefreshOverhead(player)
	end
	Progression:CheckClubDaily(player)
	Data:MarkDirty(player)
end

function Progression:Init(services)
	Services = services
	Data = services.DataService
end

function Progression:Start()
	Data:OnLoaded(function(player, data)
		sessionStart[player] = os.time()
		giftsClaimed[player] = {}
		checkRollovers(player, data, true)
		-- daily reward reminder
		if data.Daily.LastClaimDay ~= Util.DayNumber() then
			task.delay(4, function()
				Net:Send(player, "OpenPanel", "Daily")
			end)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		sessionStart[player] = nil
		giftsClaimed[player] = nil
	end)

	-- minute ticker: play-time quests, rollovers
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Data:LoadedPlayers() do
				local data = Data:Get(player)
				if data then
					local ok, err = pcall(function()
						data.Stats.PlaySeconds += 60
						self:AddQuest(player, "PlayMinutes", 1)
						checkRollovers(player, data, false)
					end)
					if not ok then
						warn("[Progression] tick error: " .. tostring(err))
					end
				end
			end
		end
	end)

	Net:On("ClaimDaily", 1, function(player)
		local data = Data:Get(player)
		if not data then
			return
		end
		local today = Util.DayNumber()
		if data.Daily.LastClaimDay == today then
			Net:Notify(player, "Come back tomorrow for your next reward!")
			return
		end
		if data.Daily.LastClaimDay == today - 1 then
			data.Daily.Streak += 1
		else
			data.Daily.Streak = 1
		end
		data.Daily.LastClaimDay = today
		local index = ((data.Daily.Streak - 1) % #Config.DailyRewards) + 1
		self:GrantReward(player, Config.DailyRewards[index], "Day " .. index .. " login reward")
	end)

	Net:On("ClaimQuest", 0.3, function(player, index)
		local data = Data:Get(player)
		local quest = data and type(index) == "number" and data.Daily.Quests[index]
		local def = quest and questById[quest.Id]
		if not def or quest.Claimed or quest.Progress < def.Target then
			return
		end
		quest.Claimed = true
		self:GrantReward(player, def.Reward, "Quest: " .. def.Text)
		self:AddSeasonXP(player, def.XP)
		self:AddPoints(player, def.Points)
	end)

	Net:On("ClaimGift", 0.3, function(player, index)
		local gift = type(index) == "number" and Config.PlaytimeGifts[index]
		local claimed = giftsClaimed[player]
		if not gift or not claimed or claimed[index] then
			return
		end
		if os.time() - (sessionStart[player] or os.time()) < gift.Minutes * 60 then
			return
		end
		claimed[index] = true
		self:GrantReward(player, gift.Reward, "Playtime gift")
	end)

	local function claimTier(player: Player, data, tier: number, track: string): boolean
		local tierDef = Config.SeasonTiers[tier]
		if not tierDef or tierOf(data.Season.XP) < tier then
			return false
		end
		local key = tostring(tier)
		local claimed = if track == "Premium" then data.Season.ClaimedPremium else data.Season.ClaimedFree
		if claimed[key] then
			return false
		end
		if track == "Premium" and not data.Season.Premium then
			return false
		end
		claimed[key] = true
		self:GrantReward(player, tierDef[track], "Season tier " .. tier)
		return true
	end

	Net:On("ClaimTier", 0.15, function(player, tier, track)
		local data = Data:Get(player)
		if not data or type(tier) ~= "number" or (track ~= "Free" and track ~= "Premium") then
			return
		end
		if track == "Premium" and not data.Season.Premium then
			Net:Send(player, "UpsellProduct", "SeasonPremium")
			return
		end
		claimTier(player, data, math.floor(tier), track)
	end)

	Net:On("ClaimAllTiers", 1, function(player)
		local data = Data:Get(player)
		if not data then
			return
		end
		for tier = 1, tierOf(data.Season.XP) do
			claimTier(player, data, tier, "Free")
			if data.Season.Premium then
				claimTier(player, data, tier, "Premium")
			end
		end
	end)

	Net:On("ClaimVip", 1, function(player)
		local data = Data:Get(player)
		if not data then
			return
		end
		if not Services.MonetizationService:HasPass(player, "VIP") then
			Net:Send(player, "Upsell", "VIP")
			return
		end
		local today = Util.DayNumber()
		if data.Daily.VipChestDay == today then
			Net:Notify(player, "VIP chest already claimed today!")
			return
		end
		data.Daily.VipChestDay = today
		self:GrantReward(player, { Gems = Config.Social.VipDailyGems }, "VIP daily chest")
	end)

	Net:On("ClaimGroup", 2, function(player)
		local data = Data:Get(player)
		if not data or Config.GroupId == 0 or data.Flags.GroupReward then
			return
		end
		local ok, inGroup = pcall(player.IsInGroup, player, Config.GroupId)
		if ok and inGroup then
			data.Flags.GroupReward = true
			player:SetAttribute("InGroup", true)
			self:GrantReward(player, { Gems = Config.Social.GroupJoinGems }, "Thanks for joining the group!")
		else
			Net:Notify(player, "Join our Roblox group first, then claim again!")
		end
	end)
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">StatsService</string>
            <string name="Source"><![CDATA[--[[
	StatsService: single source of truth for every multiplier
	(damage, coins, luck, capacity, pet slots) + social bonuses.
	Also builds the "Derived" block that is synced to the client UI.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Stats = {}
local Services
local Data

local friendCache = {} -- ["a:b"] = bool

local function has(player, key)
	return Services.MonetizationService:HasPass(player, key)
end

local function boost(player, key)
	return Services.BoostService:IsActive(player, key)
end

function Stats:PetPower(_player, data): number
	local equipped = {}
	for _, id in data.Equipped do
		equipped[id] = true
	end
	local total = 0
	for _, pet in data.Pets do
		if equipped[pet.Id] then
			local info = Config.Pets[pet.Name]
			if info then
				total += info.Power
			end
		end
	end
	return total
end

function Stats:PetSlots(player, data): number
	local slots = Config.BasePetSlots + math.floor(data.Rebirths / Config.Rebirth.ExtraPetSlotEvery)
	if has(player, "ExtraPets") then
		slots += 3
	end
	if has(player, "VIP") then
		slots += 1
	end
	return math.min(slots, Config.MaxPetSlots)
end

function Stats:Damage(player, data): number
	local pickaxe = Config.Pickaxes[data.PickaxeTier] or Config.Pickaxes[1]
	local mult = 1 + self:PetPower(player, data)
	if has(player, "MegaPower") then
		mult *= 2
	end
	if boost(player, "Power2x") then
		mult *= 2
	end
	return pickaxe.Power * mult
end

function Stats:SwingCooldown(_player, data): number
	local pickaxe = Config.Pickaxes[data.PickaxeTier] or Config.Pickaxes[1]
	return pickaxe.Cooldown
end

function Stats:SocialBonus(player): (number, number, boolean, boolean)
	local friends = player:GetAttribute("FriendsInServer") or 0
	local friendBonus = math.min(Config.Social.FriendBonusMax, friends * Config.Social.FriendBonusPer)
	local inGroup = player:GetAttribute("InGroup") == true
	local premium = player.MembershipType == Enum.MembershipType.Premium
	local bonus = friendBonus
	if inGroup then
		bonus += Config.Social.GroupBonus
	end
	if premium then
		bonus += Config.Social.PremiumBonus
	end
	return bonus, friendBonus, inGroup, premium
end

function Stats:CoinMultiplier(player, data): number
	local mult = 1 + data.Rebirths * Config.Rebirth.CoinBonusPer
	if has(player, "DoubleCoins") then
		mult *= 2
	end
	if boost(player, "Coins2x") then
		mult *= 2
	end
	local bonus = self:SocialBonus(player)
	if has(player, "VIP") then
		bonus += Config.Social.VipCoinBonus
	end
	if Services.MonetizationService:IsSubscribed(player) then
		bonus += Config.Subscription.CoinBonus
	end
	return mult * (1 + bonus)
end

function Stats:Luck(player, _data): number
	local luck = 1
	if has(player, "Lucky") then
		luck *= 1.5
	end
	if boost(player, "Luck2x") then
		luck *= 2
	end
	if Services.BoostService:ServerActive("ServerLuck") then
		luck *= 2
	end
	return luck
end

function Stats:Capacity(player, data): number
	local backpack = Config.Backpacks[data.BackpackTier] or Config.Backpacks[1]
	local cap = backpack.Capacity
	if has(player, "BigBackpack") then
		cap *= 2
	end
	return cap
end

function Stats:BuildDerived(player)
	local data = Data:Get(player)
	if not data then
		return {}
	end
	local bonus, friendBonus, inGroup, premium = self:SocialBonus(player)
	local rank, rankIndex = Util.RankFor(Config, data.Weekly.Points)
	local progression = Services.ProgressionService
	return {
		Damage = self:Damage(player, data),
		CoinMult = self:CoinMultiplier(player, data),
		Luck = self:Luck(player, data),
		Capacity = self:Capacity(player, data),
		Cooldown = self:SwingCooldown(player, data),
		PetSlots = self:PetSlots(player, data),
		PetPower = self:PetPower(player, data),
		Passes = Services.MonetizationService:OwnedPasses(player),
		Subscribed = Services.MonetizationService:IsSubscribed(player),
		RebirthCost = Util.RebirthCost(Config, data.Rebirths),
		SocialBonus = bonus,
		FriendBonus = friendBonus,
		InGroup = inGroup,
		Premium = premium,
		Rank = rank.Name,
		RankIndex = rankIndex,
		Week = Util.WeekNumber(),
		Today = Util.DayNumber(),
		SessionStart = progression and progression:SessionStart(player) or os.time(),
		GiftsClaimed = progression and progression:GiftsClaimed(player) or {},
		PaidRandomRestricted = player:GetAttribute("PaidRandomRestricted") == true,
		AdsEnabled = Config.RewardedAds.Enabled,
		ServerTime = os.time(),
	}
end

-- social -------------------------------------------------------------------
local function areFriends(a: Player, b: Player): boolean
	local low, high = math.min(a.UserId, b.UserId), math.max(a.UserId, b.UserId)
	local key = low .. ":" .. high
	if friendCache[key] == nil then
		local ok, result = pcall(a.IsFriendsWith, a, b.UserId)
		friendCache[key] = ok and result == true
	end
	return friendCache[key]
end

local function recountFriends()
	local players = Players:GetPlayers()
	for _, player in players do
		local count = 0
		for _, other in players do
			if other ~= player and areFriends(player, other) then
				count += 1
			end
		end
		if player:GetAttribute("FriendsInServer") ~= count then
			player:SetAttribute("FriendsInServer", count)
			Data:MarkDirty(player)
		end
	end
end

function Stats:Init(services)
	Services = services
	Data = services.DataService
	Data.BuildDerived = function(player)
		return Stats:BuildDerived(player)
	end
end

function Stats:Start()
	local function onPlayer(player: Player)
		if Config.GroupId ~= 0 then
			task.spawn(function()
				local ok, inGroup = pcall(player.IsInGroup, player, Config.GroupId)
				player:SetAttribute("InGroup", ok and inGroup == true)
				Data:MarkDirty(player)
			end)
		end
		task.spawn(recountFriends)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function()
		task.defer(recountFriends)
	end)
	Players.PlayerMembershipChanged:Connect(function(player)
		Data:MarkDirty(player)
	end)
	task.spawn(recountFriends)
end

return Stats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	WorldService: builds the whole map procedurally (no assets required):
	hub plaza, shops, egg stands, sell pad, meteor crater, leaderboards and
	five mining zones separated by gates. Swap any part for a real model later.
]]
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local World = {}
local Services

local HUB_HALF = 80
local ZONE_W = 100
local ZONE_L = 100
local GAP = 10
local FIRST_Z = 90
local CORRIDOR_W = 24
local WALL_H = 16

World.Zones = {}
World.OreSlots = {}
World.Boards = {}
World.PvPZone = 0
World.HubSpawn = CFrame.new(0, 4, -60)

local map = Instance.new("Folder")
map.Name = "Map"

local function folder(name: string, parent: Instance)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function newPart(props, parent: Instance?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent or map
	return p
end

local function billboard(adornee: BasePart, text: string, color: Color3, offsetY: number, width: number?, height: number?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(width or 260, height or 70)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 160
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	label.RichText = true
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = adornee
	return gui, label
end

local function prompt(parent: BasePart, actionText: string, objectText: string, handler)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = actionText
	p.ObjectText = objectText
	p.HoldDuration = 0
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.Parent = parent
	p.Triggered:Connect(function(player)
		local ok, err = pcall(handler, player)
		if not ok then
			warn("[World] prompt failed: " .. tostring(err))
		end
	end)
	return p
end

local function openPanel(panel: string, arg: any?)
	return function(player)
		Net:Send(player, "OpenPanel", panel, arg)
	end
end

function World.ZoneStart(index: number): number
	return FIRST_Z + (index - 1) * (ZONE_L + GAP)
end

-- 0 = hub, 1..n = zone index, nil = outside
function World:ZoneAt(position: Vector3): number?
	if math.abs(position.X) <= HUB_HALF and math.abs(position.Z) <= HUB_HALF then
		return 0
	end
	if math.abs(position.X) > ZONE_W / 2 + 1 then
		return nil
	end
	for index, zone in self.Zones do
		if position.Z >= zone.ZStart and position.Z <= zone.ZEnd then
			return index
		end
	end
	return nil
end

function World:SpawnFor(index: number): CFrame
	if index == 0 or not self.Zones[index] then
		return self.HubSpawn
	end
	return self.Zones[index].Spawn
end

---------------------------------------------------------------------------
-- builders
---------------------------------------------------------------------------
local function wall(cf: CFrame, size: Vector3, color: Color3, parent)
	return newPart({
		Name = "Wall",
		CFrame = cf,
		Size = size,
		Color = color,
		Material = Enum.Material.Rock,
	}, parent)
end

local function tree(position: Vector3, parent)
	newPart({
		Name = "Trunk",
		Size = Vector3.new(2, 8, 2),
		CFrame = CFrame.new(position + Vector3.new(0, 4, 0)),
		Color = Color3.fromRGB(110, 75, 45),
		Material = Enum.Material.Wood,
	}, parent)
	newPart({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 9,
		CFrame = CFrame.new(position + Vector3.new(0, 10, 0)),
		Color = Color3.fromRGB(70, 160, 70),
		Material = Enum.Material.LeafyGrass,
	}, parent)
end

local function lamp(position: Vector3, color: Color3, parent)
	newPart({
		Name = "LampPost",
		Size = Vector3.new(0.8, 10, 0.8),
		CFrame = CFrame.new(position + Vector3.new(0, 5, 0)),
		Color = Color3.fromRGB(40, 40, 45),
		Material = Enum.Material.Metal,
	}, parent)
	local bulb = newPart({
		Name = "Bulb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2,
		CFrame = CFrame.new(position + Vector3.new(0, 10.5, 0)),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, parent)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 22
	light.Brightness = 1.2
	light.Parent = bulb
end

local function booth(position: Vector3, title: string, color: Color3, parent)
	local base = newPart({
		Name = "BoothBase",
		Size = Vector3.new(14, 1, 14),
		CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)),
		Color = Color3.fromRGB(60, 60, 70),
		Material = Enum.Material.WoodPlanks,
	}, parent)
	for _, offset in { Vector3.new(-6, 0, -6), Vector3.new(6, 0, -6), Vector3.new(-6, 0, 6), Vector3.new(6, 0, 6) } do
		newPart({
			Name = "Pillar",
			Size = Vector3.new(1, 9, 1),
			CFrame = CFrame.new(position + offset + Vector3.new(0, 5.5, 0)),
			Color = Color3.fromRGB(240, 240, 240),
			Material = Enum.Material.SmoothPlastic,
		}, parent)
	end
	newPart({
		Name = "Roof",
		Size = Vector3.new(16, 1.2, 16),
		CFrame = CFrame.new(position + Vector3.new(0, 10.6, 0)),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	local counter = newPart({
		Name = "Counter",
		Size = Vector3.new(8, 3.5, 3),
		CFrame = CFrame.new(position + Vector3.new(0, 2.75, 0)),
		Color = color:Lerp(Color3.new(1, 1, 1), 0.25),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	billboard(base, title, Color3.new(1, 1, 1), 13, 300, 70)
	return counter
end

local function eggStand(position: Vector3, eggId: string, parent)
	local egg = Config.Eggs[eggId]
	newPart({
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 10, 10),
		CFrame = CFrame.new(position + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(235, 235, 240),
		Material = Enum.Material.Marble,
	}, parent)
	local eggPart = newPart({
		Name = eggId .. "Egg",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(6, 6, 6),
		CFrame = CFrame.new(position + Vector3.new(0, 5.5, 0)),
		Color = egg.Color,
		Material = if egg.Currency == "Robux" then Enum.Material.Foil else Enum.Material.SmoothPlastic,
	}, parent)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.3, 1)
	mesh.Parent = eggPart
	local light = Instance.new("PointLight")
	light.Color = egg.Color
	light.Range = 12
	light.Parent = eggPart

	local priceText
	if egg.Currency == "Robux" then
		priceText = "<font color='#7CFF8A'>R$ " .. tostring(Config.Products[egg.ProductSingle].Price) .. "</font>"
	else
		local icon = if egg.Currency == "Gems" then "💎" elseif egg.Currency == "Stardust" then "✨" else "🪙"
		priceText = icon .. " " .. Util.Format(egg.Price)
	end
	billboard(eggPart, egg.Name .. "\n" .. priceText, Color3.new(1, 1, 1), 6, 220, 80)
	prompt(eggPart, "Open", egg.Name, openPanel("Egg", eggId))
	eggPart:SetAttribute("EggId", eggId)
	return eggPart
end

local function leaderboard(cf: CFrame, size: Vector3, key: string, title: string, parent)
	local board = newPart({
		Name = "Leaderboard_" .. key,
		Size = size,
		CFrame = cf,
		Color = Color3.fromRGB(25, 25, 35),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	local frame = newPart({
		Name = "Frame",
		Size = size + Vector3.new(1, 1, -0.4),
		CFrame = cf * CFrame.new(0, 0, 0.4),
		Color = Color3.fromRGB(255, 200, 60),
		Material = Enum.Material.Neon,
	}, parent)
	frame.CanCollide = false
	board:SetAttribute("Title", title)
	World.Boards[key] = board
	return board
end

---------------------------------------------------------------------------
-- hub
---------------------------------------------------------------------------
local function buildHub()
	local hub = folder("Hub", map)

	newPart({
		Name = "Floor",
		Size = Vector3.new(HUB_HALF * 2, 4, HUB_HALF * 2),
		CFrame = CFrame.new(0, -2, 0),
		Color = Color3.fromRGB(110, 175, 90),
		Material = Enum.Material.Grass,
	}, hub)
	newPart({
		Name = "Path",
		Size = Vector3.new(18, 0.2, HUB_HALF * 2),
		CFrame = CFrame.new(0, 0.05, 0),
		Color = Color3.fromRGB(215, 200, 170),
		Material = Enum.Material.Cobblestone,
	}, hub)
	newPart({
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 46, 46),
		CFrame = CFrame.new(0, 0.08, -25) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(225, 215, 190),
		Material = Enum.Material.Cobblestone,
	}, hub)

	local wallColor = Color3.fromRGB(120, 115, 110)
	local half = HUB_HALF
	wall(CFrame.new(-half - 1, WALL_H / 2, 0), Vector3.new(2, WALL_H, half * 2 + 4), wallColor, hub)
	wall(CFrame.new(half + 1, WALL_H / 2, 0), Vector3.new(2, WALL_H, half * 2 + 4), wallColor, hub)
	wall(CFrame.new(0, WALL_H / 2, -half - 1), Vector3.new(half * 2 + 4, WALL_H, 2), wallColor, hub)
	local segment = half - CORRIDOR_W / 2
	wall(CFrame.new(-(CORRIDOR_W / 2 + segment / 2), WALL_H / 2, half + 1), Vector3.new(segment + 2, WALL_H, 2), wallColor, hub)
	wall(CFrame.new(CORRIDOR_W / 2 + segment / 2, WALL_H / 2, half + 1), Vector3.new(segment + 2, WALL_H, 2), wallColor, hub)

	-- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.5, -60)
	spawn.Color = Color3.fromRGB(255, 220, 120)
	spawn.Material = Enum.Material.Neon
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = hub
	billboard(spawn, Config.GameName, Color3.fromRGB(255, 230, 120), 14, 360, 80)

	-- sell pad
	local sell = newPart({
		Name = "SellPad",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 16, 16),
		CFrame = CFrame.new(0, 0.2, -25) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(60, 255, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, hub)
	billboard(sell, "💰 SELL ORE", Color3.fromRGB(120, 255, 150), 6, 260, 70)
	World.SellPad = sell

	-- meteor crater
	local crater = newPart({
		Name = "MeteorCrater",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 44, 44),
		CFrame = CFrame.new(Config.Meteor.Position + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(60, 45, 40),
		Material = Enum.Material.CrackedLava,
	}, hub)
	billboard(crater, "☄️ METEOR CRATER", Color3.fromRGB(255, 150, 80), 4, 300, 60)
	local rng = Random.new(7)
	for i = 1, 14 do
		local angle = (i / 14) * math.pi * 2
		local r = 23 + rng:NextNumber(-1, 1)
		local size = rng:NextNumber(2.5, 5)
		newPart({
			Name = "CraterRock",
			Size = Vector3.new(size, size * 0.8, size),
			CFrame = CFrame.new(Config.Meteor.Position + Vector3.new(math.cos(angle) * r, size * 0.3, math.sin(angle) * r))
				* CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), rng:NextNumber(0, 1)),
			Color = Color3.fromRGB(90, 80, 75),
			Material = Enum.Material.Basalt,
		}, hub)
	end

	-- shops (east)
	local shops = folder("Shops", hub)
	local pick = booth(Vector3.new(56, 0, -45), "⛏️ PICKAXES", Color3.fromRGB(255, 170, 60), shops)
	prompt(pick, "Open", "Pickaxe Shop", openPanel("Shop", "Pickaxes"))
	local bag = booth(Vector3.new(56, 0, -20), "🎒 BACKPACKS", Color3.fromRGB(80, 170, 255), shops)
	prompt(bag, "Open", "Backpack Shop", openPanel("Shop", "Backpacks"))
	local rebirth = booth(Vector3.new(56, 0, 5), "♻️ REBIRTH", Color3.fromRGB(190, 90, 255), shops)
	prompt(rebirth, "Open", "Rebirth Altar", openPanel("Rebirth"))
	local store = booth(Vector3.new(56, 0, 30), "🛒 STORE", Color3.fromRGB(80, 220, 120), shops)
	prompt(store, "Open", "Store", openPanel("Store"))

	-- eggs (west)
	local eggs = folder("Eggs", hub)
	eggStand(Vector3.new(-56, 0, -45), "Meadow", eggs)
	eggStand(Vector3.new(-56, 0, -20), "Gem", eggs)
	eggStand(Vector3.new(-56, 0, 5), "Cosmic", eggs)
	eggStand(Vector3.new(-56, 0, 30), "Golden", eggs)

	-- leaderboards (facing the spawn)
	local boards = folder("Leaderboards", hub)
	local defs = Config.Leaderboards.Boards
	if defs[1] then
		leaderboard(CFrame.new(0, 27, HUB_HALF - 1), Vector3.new(30, 20, 1), defs[1].Key, defs[1].Title, boards)
	end
	if defs[2] then
		leaderboard(CFrame.new(-50, 11, HUB_HALF - 2), Vector3.new(24, 18, 1), defs[2].Key, defs[2].Title, boards)
	end
	if defs[3] then
		leaderboard(CFrame.new(50, 11, HUB_HALF - 2), Vector3.new(24, 18, 1), defs[3].Key, defs[3].Title, boards)
	end

	-- decor
	for _, pos in { Vector3.new(-70, 0, -70), Vector3.new(70, 0, -70), Vector3.new(-72, 0, 62), Vector3.new(72, 0, 62), Vector3.new(-30, 0, -72), Vector3.new(30, 0, -72) } do
		tree(pos, hub)
	end
	for z = -60, 60, 30 do
		lamp(Vector3.new(-11, 0, z), Color3.fromRGB(255, 220, 160), hub)
		lamp(Vector3.new(11, 0, z), Color3.fromRGB(255, 220, 160), hub)
	end
end

---------------------------------------------------------------------------
-- zones
---------------------------------------------------------------------------
local function buildZones()
	local zonesFolder = folder("Zones", map)
	local gates = folder("Gates", map)
	local wallColor = Color3.fromRGB(95, 90, 90)

	-- corridor from the hub into zone 1
	newPart({
		Name = "Corridor",
		Size = Vector3.new(CORRIDOR_W, 4, GAP + 2),
		CFrame = CFrame.new(0, -2, HUB_HALF + GAP / 2),
		Color = Color3.fromRGB(150, 140, 130),
		Material = Enum.Material.Cobblestone,
	}, zonesFolder)
	for _, side in { -1, 1 } do
		wall(CFrame.new(side * (CORRIDOR_W / 2 + 1), WALL_H / 2, HUB_HALF + GAP / 2), Vector3.new(2, WALL_H, GAP + 2), wallColor, zonesFolder)
	end

	for index, zone in Config.Zones do
		local zStart = World.ZoneStart(index)
		local zEnd = zStart + ZONE_L
		local zf = folder(string.format("%d_%s", index, zone.Name), zonesFolder)
		local isLast = index == #Config.Zones

		newPart({
			Name = "Floor",
			Size = Vector3.new(ZONE_W, 4, ZONE_L),
			CFrame = CFrame.new(0, -2, zStart + ZONE_L / 2),
			Color = zone.FloorColor,
			Material = zone.Floor,
		}, zf)

		local color = wallColor:Lerp(zone.Accent, 0.25)
		wall(CFrame.new(-ZONE_W / 2 - 1, WALL_H / 2, zStart + ZONE_L / 2), Vector3.new(2, WALL_H, ZONE_L + 2), color, zf)
		wall(CFrame.new(ZONE_W / 2 + 1, WALL_H / 2, zStart + ZONE_L / 2), Vector3.new(2, WALL_H, ZONE_L + 2), color, zf)
		local seg = ZONE_W / 2 - CORRIDOR_W / 2
		for _, side in { -1, 1 } do
			wall(CFrame.new(side * (CORRIDOR_W / 2 + seg / 2), WALL_H / 2, zStart - 1), Vector3.new(seg + 2, WALL_H, 2), color, zf)
			if not isLast then
				wall(CFrame.new(side * (CORRIDOR_W / 2 + seg / 2), WALL_H / 2, zEnd + 1), Vector3.new(seg + 2, WALL_H, 2), color, zf)
			end
		end
		if isLast then
			wall(CFrame.new(0, WALL_H / 2, zEnd + 1), Vector3.new(ZONE_W + 4, WALL_H, 2), color, zf)
		else
			newPart({
				Name = "Corridor",
				Size = Vector3.new(CORRIDOR_W, 4, GAP + 2),
				CFrame = CFrame.new(0, -2, zEnd + GAP / 2),
				Color = Color3.fromRGB(120, 115, 110),
				Material = Enum.Material.Cobblestone,
			}, zf)
			for _, side in { -1, 1 } do
				wall(CFrame.new(side * (CORRIDOR_W / 2 + 1), WALL_H / 2, zEnd + GAP / 2), Vector3.new(2, WALL_H, GAP + 2), color, zf)
			end
		end

		-- accent lights in the corners
		for _, pos in { Vector3.new(-44, 0, zStart + 6), Vector3.new(44, 0, zStart + 6), Vector3.new(-44, 0, zEnd - 6), Vector3.new(44, 0, zEnd - 6) } do
			lamp(pos, zone.Accent, zf)
		end

		-- floating zone title
		local titleAnchor = newPart({
			Name = "TitleAnchor",
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.new(0, 20, zStart + 4),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
		}, zf)
		local subtitle = if zone.PvP then "\n<font color='#FF5A7A'>⚔️ PVP ZONE - bonk players to steal ore!</font>" else ""
		billboard(titleAnchor, string.upper(zone.Name) .. subtitle, zone.Accent, 0, 520, if zone.PvP then 110 else 70)

		World.Zones[index] = {
			ZStart = zStart,
			ZEnd = zEnd,
			Spawn = CFrame.new(0, 4, zStart + 6),
			Name = zone.Name,
		}
		if zone.PvP then
			World.PvPZone = index
		end

		-- gate (zone 2+)
		if index > 1 then
			local gate = newPart({
				Name = "Gate_" .. index,
				Size = Vector3.new(CORRIDOR_W, WALL_H, 1),
				CFrame = CFrame.new(0, WALL_H / 2, zStart - GAP / 2),
				Color = zone.Accent,
				Material = Enum.Material.ForceField,
				Transparency = 0.1,
			}, gates)
			gate:SetAttribute("ZoneIndex", index)
			local gateLabel = billboard(gate, "🔒 " .. zone.Name .. "\n🪙 " .. Util.Format(zone.Cost), Color3.new(1, 1, 1), -1, 300, 90)
			gateLabel.StudsOffsetWorldSpace = Vector3.new(0, -1, -2) -- in front of the forcefield, facing the approach
			prompt(gate, "Unlock", zone.Name .. " (" .. Util.Format(zone.Cost) .. ")", function(player)
				Services.EconomyService:UnlockZone(player, index)
			end).MaxActivationDistance = 14
			World.Zones[index].Gate = gate
		end

		-- zone egg
		for eggId, egg in Config.Eggs do
			if egg.Zone == index and index > 1 then
				eggStand(Vector3.new(-28, 0, zStart + 6), eggId, zf)
			end
		end

		-- ore slots
		local slots = {}
		local rng = Random.new(1000 + index)
		local spacing = Config.World.OreSpacing
		local half = Config.World.OreSize / 2
		for x = -42, 42, spacing do
			if math.abs(x) > 4 then
				for z = zStart + 14, zEnd - 8, spacing do
					if rng:NextNumber() > 0.12 then
						table.insert(slots, {
							Zone = index,
							Position = Vector3.new(x, half, z),
						})
					end
				end
			end
		end
		World.OreSlots[index] = slots
	end
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.GlobalShadows = true
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 150)
	Lighting.Ambient = Color3.fromRGB(70, 70, 80)

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Haze = 1
	atmosphere.Color = Color3.fromRGB(200, 215, 255)
	atmosphere.Decay = Color3.fromRGB(120, 110, 160)
	atmosphere.Parent = Lighting

	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 1.2
	bloom.Parent = Lighting

	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.15
	cc.Contrast = 0.05
	cc.Parent = Lighting
end

function World:Init(services)
	Services = services
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	buildHub()
	buildZones()
	folder("Ores", map)
	folder("Drops", map)
	map.Parent = workspace
	setupLighting()
end

function World:Folder(name: string): Folder
	return map:FindFirstChild(name) :: Folder
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="24">
