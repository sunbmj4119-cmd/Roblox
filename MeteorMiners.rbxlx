-- parts recolored by 🎨 paint (by part name)
local PAINT = {
	Pedestal = { "Ring" },
	Decoy = { "Ring" },
	Vault = { "Ring", "Lock" },
	Tree = { "Leaves", "Leaves2" },
	Pine = { "Needles" },
	Bush = { "Bush" },
	Hedge = { "Hedge" },
	Flowers = { "Flower" },
	Rock = { "Rock" },
	Mushroom = { "Cap" },
	Pond = { "Water" },
	Bench = { "Seat", "Back" },
	Table = { "Top" },
	Chair = { "Seat", "Back" },
	Sofa = { "Seat", "Back", "Arm" },
	Fence = { "Post", "Rail" },
	Lantern = { "Lamp" },
	LampPost = { "Bulb" },
	Crystal = { "Crystal" },
	Statue = { "Star", "Star2" },
	Fountain = { "Water", "Spout" },
	Trophy = { "Cup", "Stem" },
	Flag = { "Cloth" },
	Gnome = { "Hat", "HatTip", "Body" },
	Campfire = { "Flame" },
	Swing = { "Seat" },
	Windmill = { "Blade", "Roof" },
	WoodFloor = { "Tile" },
	StoneFloor = { "Tile" },
	GrassFloor = { "Tile" },
	Carpet = { "Tile" },
	Throne = { "Seat", "Back" },
	NeonArch = { "Pillar", "Top" },
}

function DecorModel.CanPaint(id: string): boolean
	return PAINT[id] ~= nil
end

function DecorModel.Has(id: string): boolean
	return BUILDERS[id] ~= nil
end

-- footprint in studs for a rotation (R odd swaps width/depth)
function DecorModel.Footprint(config, id: string, rotation: number): (number, number)
	local def = config.Decor[id]
	local cell = config.Base.Cell
	local w, d = def.Size[1] * cell, def.Size[2] * cell
	if rotation % 2 == 1 then
		return d, w
	end
	return w, d
end

---------------------------------------------------------------------------
-- placement rules (shared by the server and the build-mode preview)
---------------------------------------------------------------------------
-- snap a center to the grid so the footprint lines up with cells
function DecorModel.Snap(config, id: string, x: number, z: number, rotation: number): (number, number)
	local cell = config.Base.Cell
	local w, d = DecorModel.Footprint(config, id, rotation)
	local function snap(value: number, size: number)
		return math.floor((value - size / 2) / cell + 0.5) * cell + size / 2
	end
	return snap(x, w), snap(z, d)
end

local function rect(config, id: string, x: number, z: number, rotation: number)
	local w, d = DecorModel.Footprint(config, id, rotation)
	return x - w / 2, x + w / 2, z - d / 2, z + d / 2
end

local function layerOf(config, id: string): string
	local def = config.Decor[id]
	return def and def.Layer or "Object"
end

function DecorModel.Count(items, id: string): number
	local count = 0
	for _, item in items do
		if item.Id == id then
			count += 1
		end
	end
	return count
end

-- currency, amount (pedestals get pricier the more you own)
function DecorModel.Price(config, id: string, items): (string, number)
	local def = config.Decor[id]
	if def.Function == "Pedestal" then
		local costs = config.Base.PedestalCosts
		return "Coins", costs[DecorModel.Count(items, id) + 1] or math.huge
	end
	if def.Function == "Vault" then
		local costs = config.Base.VaultCosts
		return "Coins", costs[DecorModel.Count(items, id) + 1] or math.huge
	end
	if def.Gems then
		return "Gems", def.Gems
	end
	return "Coins", def.Price or 0
end

-- the buildable area of a house level (plot space)
function DecorModel.Bounds(config, level: number?)
	local levels = config.Base.Levels
	return levels[math.clamp(level or 1, 1, #levels)].Build
end

-- ok, reason (English text key) - ignoreUid lets an item be moved onto itself.
-- opts = { Level = house level, Vaults = vault pedestals allowed }
function DecorModel.Validate(
	config,
	items,
	id: string,
	x: number,
	z: number,
	rotation: number,
	ignoreUid: number?,
	opts: { Level: number?, Vaults: number? }?
): (boolean, string?)
	local def = config.Decor[id]
	if not def then
		return false, "Unknown item"
	end
	local level = opts and opts.Level or 1
	local house = config.Base.Levels[math.clamp(level, 1, #config.Base.Levels)]
	local bounds = house.Build
	local minX, maxX, minZ, maxZ = rect(config, id, x, z, rotation)
	local eps = 0.01
	if minX < bounds.MinX - eps or maxX > bounds.MaxX + eps or minZ < bounds.MinZ - eps or maxZ > bounds.MaxZ + eps then
		return false, "Out of bounds - expand your house for more room!"
	end
	local layer = layerOf(config, id)
	for _, other in items do
		if other.Uid ~= ignoreUid and config.Decor[other.Id] and layerOf(config, other.Id) == layer then
			local oMinX, oMaxX, oMinZ, oMaxZ = rect(config, other.Id, other.X, other.Z, other.R)
			if minX < oMaxX - eps and maxX > oMinX + eps and minZ < oMaxZ - eps and maxZ > oMinZ + eps then
				return false, "Something is already there"
			end
		end
	end
	if not ignoreUid then
		if def.MinLevel and level < def.MinLevel then
			return false, "Upgrade your house to unlock this item!"
		end
		if #items >= house.MaxItems then
			return false, "Your base is full - expand your house for more!"
		end
		local count = DecorModel.Count(items, id)
		local limit = def.Limit
		if def.Function == "Pedestal" then
			limit = config.Base.MaxPedestals
		elseif def.Function == "Vault" then
			limit = math.min(opts and opts.Vaults or house.Vaults, #config.Base.VaultCosts)
		end
		if limit and count >= limit then
			return false, "Limit reached for this item"
		end
	end
	return true, nil
end

function DecorModel.Build(config, id: string, paint: number?): Model
	local model = Instance.new("Model")
	model.Name = id
	local cell = config.Base.Cell
	local def = config.Decor[id]
	local footprint = Instance.new("Part")
	footprint.Name = "Footprint"
	footprint.Anchored = true
	footprint.CanCollide = false
	footprint.CanTouch = false
	footprint.Transparency = 1
	footprint.Size = Vector3.new(def.Size[1] * cell, 0.2, def.Size[2] * cell)
	footprint.CFrame = CFrame.new(0, 0.1, 0)
	footprint.Parent = model
	model.PrimaryPart = footprint
	local builder = BUILDERS[id]
	if builder then
		builder(model)
	end
	local color = paint and config.Paint[paint]
	local names = PAINT[id]
	if color and names then
		for _, child in model:GetChildren() do
			if child:IsA("BasePart") and table.find(names, child.Name) then
				child.Color = color
				local glow = child:FindFirstChildOfClass("PointLight")
				if glow then
					glow.Color = color
				end
			end
		end
	end
	return model
end

return DecorModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Lang</string>
          <string name="Source"><![CDATA[--[[
	Lang: tiny localization layer (English source text -> translations).

	* Every player-facing string is written in English and passed through
	  Lang.F(locale, text, ...) (server) or Lang.T(text, ...) (client).
	* Korean comes from LangKO. Missing entries fall back to English, so the
	  game never breaks - tests/LangCheck.luau reports anything untranslated.
	* String format arguments are translated too (zone names, rarities ...).
	* A player can force a language (data.Settings.Lang -> attribute "Lang"),
	  otherwise their Roblox language (LocaleId) decides.
]]
local KO = require(script.Parent.LangKO)

local Lang = {}
Lang.Locale = "en" -- client-side current locale

local function isKorean(locale): boolean
	return type(locale) == "string" and string.lower(string.sub(locale, 1, 2)) == "ko"
end
Lang.IsKorean = isKorean

function Lang.Translate(locale, text)
	if type(text) ~= "string" then
		return text
	end
	if isKorean(locale) then
		return KO[text] or text
	end
	return text
end

-- format + translate; string args are translated as well
function Lang.F(locale, text, ...)
	local fmt = Lang.Translate(locale, text)
	local count = select("#", ...)
	if count == 0 then
		return fmt
	end
	local args = table.pack(...)
	for i = 1, count do
		if type(args[i]) == "string" then
			args[i] = Lang.Translate(locale, args[i])
		elseif args[i] == nil then
			args[i] = ""
		end
	end
	local ok, result = pcall(string.format, fmt, table.unpack(args, 1, count))
	return if ok then result else fmt
end

-- client convenience (uses Lang.Locale)
function Lang.T(text, ...)
	return Lang.F(Lang.Locale, text, ...)
end

function Lang.SetLocale(locale)
	Lang.Locale = if isKorean(locale) then "ko" else "en"
end

-- the locale the server should use for a player
function Lang.LocaleOf(player): string
	local forced = player:GetAttribute("Lang")
	if forced == "ko" or forced == "en" then
		return forced
	end
	local ok, locale = pcall(function()
		return player.LocaleId
	end)
	return if ok and isKorean(locale) then "ko" else "en"
end

return Lang
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">LangKO</string>
          <string name="Source"><![CDATA[--[[
	Korean translations. Key = the exact English source text used in code.
	Keep %s / %d placeholders in the SAME ORDER as the English text.
	Check coverage with: python3 tests/lang_keys.py
]]
return {
	-- placeholders / neutral
	["%s"] = "%s",
	["%dm"] = "%d분",
	["Lv."] = "Lv.",
	["Lv.1"] = "Lv.1",
	["MeadowEgg"] = "MeadowEgg",
	["Product"] = "Product",
	["SeasonPremium"] = "SeasonPremium",
	["SkipTiers"] = "SkipTiers",

	-- currencies & boosts
	["coins"] = "코인",
	["gems"] = "젬",
	["stardust"] = "별가루",
	["2x Coins"] = "코인 2배",
	["2x Luck"] = "행운 2배",
	["2x Power"] = "파워 2배",

	-- rarities, variants, ranks
	["Common"] = "일반",
	["Uncommon"] = "고급",
	["Rare"] = "희귀",
	["Epic"] = "영웅",
