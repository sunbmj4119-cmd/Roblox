	["💔 %s stole your %s! Get it back from their house - revenge for 5 minutes!"] = "💔 %s이(가) 내 %s을(를) 훔쳐 갔어요! 그 집에서 되찾아요 - 5분간 복수 가능!",
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">PetModel</string>
          <string name="Source"><![CDATA[--[[
	PetModel: cute, characterful pets built from primitive parts (no assets).
	Round "mochi" body, big shiny eyes, blushing cheeks, and features picked
	from the species name / flags: bunny ears, cat ears, fox tail, floppy
	puppy ears, owl beak + tufts, dragon horns, bat wings, slime shine,
	penguin belly, crowns for kings ... Mutations change the look:
	Golden (gold foil), Rainbow (colour cycle on clients), Galaxy (cosmic),
	Frozen (ice), Molten (lava cracks + embers).

	PetModel.Build(petName, variant) -> anchored Model, front faces -Z,
	pivot = PrimaryPart "Body". A custom model named after the pet inside
	ReplicatedStorage.PetModels replaces the generated one.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)

local PetModel = {}

local function part(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- ellipsoid: a ball squashed / stretched with a sphere mesh
local function blob(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?)
	local p = part(model, name, size, cf, color, material, Enum.PartType.Block)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	return p
end

local function wedge(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?)
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = model
	return p
end

local function has(name: string, ...): boolean
	local lower = string.lower(name)
	for _, word in { ... } do
		if string.find(lower, word, 1, true) then
			return true
		end
	end
	return false
end

local function sparkles(parent: BasePart, color: Color3, rate: number, size: number?)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sparkles"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.Size = NumberSequence.new(size or 0.35, 0)
	emitter.Lifetime = NumberRange.new(0.5, 1)
	emitter.Rate = rate
	emitter.Speed = NumberRange.new(0.5, 1.5)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.LightEmission = 1
	emitter.Parent = parent
	return emitter
end

local function custom(petName: string): Model?
	local folder = ReplicatedStorage:FindFirstChild("PetModels")
	local source = folder and folder:FindFirstChild(petName)
	if not source then
		return nil
	end
	local clone = source:Clone()
	if not clone:IsA("Model") or not clone.PrimaryPart then
		return nil
	end
	for _, d in clone:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	return clone
end

-- uniform scale (ScaleTo, with a manual fallback)
local function scaleModel(model: Model, factor: number)
	if math.abs(factor - 1) < 0.001 then
		return
	end
	local ok = pcall(function()
		model:ScaleTo(model:GetScale() * factor)
	end)
	if not ok then
		local origin = model:GetPivot().Position
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Size *= factor
				local offset = d.Position - origin
				d.CFrame = CFrame.new(origin + offset * factor) * (d.CFrame - d.Position)
			end
		end
	end
end

-- 🌱 growth: babies are small, legends big; ★ evolved pets get a star halo
local function applyGrowth(model: Model, growth)
	local body = model.PrimaryPart
	if not growth or not body then
		return
	end
	local level = math.max(1, tonumber(growth.Level) or 1)
	local stars = math.max(0, tonumber(growth.Stars) or 0)
	local stage = Util.PetStage(Config, level)
	local _, size = model:GetBoundingBox()
	local top = body.Position.Y - body.Size.Y / 2 + size.Y
	if stage.Id == "Legend" then
		-- a little golden crown
		local crownY = top + 0.15
		for i = 1, 5 do
			local angle = i / 5 * math.pi * 2
			part(
				model,
				"Crown",
				Vector3.new(0.22, 0.45, 0.22),
				CFrame.new(body.Position.X + math.cos(angle) * 0.42, crownY, body.Position.Z + math.sin(angle) * 0.42),
				Color3.fromRGB(255, 205, 60),
				Enum.Material.SmoothPlastic
			)
		end
	end
	if stars > 0 then
		local color = Config.Growth.StarColors[math.clamp(stars, 1, #Config.Growth.StarColors)]
		local halo = part(
			model,
			"StarHalo",
			Vector3.new(0.14, 1.5 + stars * 0.25, 1.5 + stars * 0.25),
			CFrame.new(body.Position.X, top + 0.7, body.Position.Z) * CFrame.Angles(0, 0, math.rad(90)),
			color,
			Enum.Material.Neon,
			Enum.PartType.Cylinder
		)
		halo.Transparency = 0.25
		sparkles(body, color, 4 + stars * 4, 0.3 + stars * 0.05)
	end
	scaleModel(model, stage.Scale * (1 + Config.Growth.Evolve.StarScale * stars))
end

-- ☄️ meteor pets: a glowing crack + a little comet tail
local function applyMeteorLook(model: Model, info)
	local body = model.PrimaryPart
	if not info.Meteor or not body then
		return
	end
	local glow = info.Color:Lerp(Color3.fromRGB(255, 200, 80), 0.5)
	for i = 1, 3 do
		local crack = part(
			model,
			"MeteorCrack",
			Vector3.new(0.12, body.Size.Y * 0.5, 0.12),
			body.CFrame * CFrame.new((i - 2) * body.Size.X * 0.22, 0, body.Size.Z * 0.49) * CFrame.Angles(0, 0, math.rad((i - 2) * 25)),
			glow,
			Enum.Material.Neon
		)
		crack.CanQuery = false
	end
	local tail = Instance.new("ParticleEmitter")
	tail.Texture = "rbxasset://textures/particles/fire_main.dds"
	tail.Color = ColorSequence.new(glow, info.Color)
	tail.Size = NumberSequence.new(0.5, 0)
	tail.Lifetime = NumberRange.new(0.3, 0.6)
	tail.Rate = 8
	tail.Speed = NumberRange.new(0.5, 1.5)
	tail.LightEmission = 0.6
	tail.Parent = body
end

function PetModel.Build(petName: string, variant: string?, growth): Model
	local customModel = custom(petName)
	if customModel then
		return customModel
	end

	local info = Config.Pets[petName] or { Rarity = "Common", Color = Color3.new(1, 1, 1), Shape = "Ball" }
	local rarity = Config.Rarities[info.Rarity] or Config.Rarities.Common
	local s = 1.9 + rarity.Order * 0.16 -- rarer pets are a bit bigger
	local color = info.Color
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.35)
	local light = color:Lerp(Color3.new(1, 1, 1), 0.45)

	local model = Instance.new("Model")
	model.Name = petName

	-- body: a round, slightly squashed mochi (taller for "Block" species)
	local tall = info.Shape == "Block"
	local bodySize = Vector3.new(s, s * (if tall then 1.05 else 0.92), s * 0.95)
	local body = blob(model, "Body", bodySize, CFrame.new(0, bodySize.Y / 2, 0), color)
	model.PrimaryPart = body
	local top = bodySize.Y
	local front = -bodySize.Z / 2

	local slime = has(petName, "slime")
	if slime then
		body.Material = Enum.Material.Glass
		body.Transparency = 0.15
		blob(model, "Shine", Vector3.new(s * 0.25, s * 0.18, s * 0.1), CFrame.new(-s * 0.22, top * 0.78, front * 0.8), Color3.new(1, 1, 1))
	end

	-- belly patch (penguins, owls, bears ...)
	if has(petName, "penguin", "owl", "bear", "yeti", "pup", "dog") then
		blob(model, "Belly", Vector3.new(s * 0.62, s * 0.55, s * 0.2), CFrame.new(0, top * 0.36, front * 0.86), light)
	end

	-- big shiny eyes
	local eyeY = top * 0.6
	local eyeSize = s * (if has(petName, "owl") then 0.36 else 0.28)
	for _, side in { -1, 1 } do
		local x = side * s * 0.21
		blob(model, "Eye", Vector3.new(eyeSize, eyeSize * 1.15, eyeSize * 0.4), CFrame.new(x, eyeY, front * 0.88), Color3.new(1, 1, 1))
		blob(
			model,
			"Pupil",
			Vector3.new(eyeSize * 0.66, eyeSize * 0.8, eyeSize * 0.3),
			CFrame.new(x, eyeY - eyeSize * 0.05, front * 0.96),
			Color3.fromRGB(25, 20, 35)
		)
		blob(
			model,
			"Shine",
			Vector3.new(eyeSize * 0.24, eyeSize * 0.24, eyeSize * 0.12),
			CFrame.new(x + side * eyeSize * 0.12, eyeY + eyeSize * 0.18, front * 1.02),
			Color3.new(1, 1, 1)
		)
		-- blush
		local cheek = blob(
			model,
			"Blush",
			Vector3.new(s * 0.16, s * 0.08, s * 0.05),
			CFrame.new(side * s * 0.34, top * 0.42, front * 0.82),
			Color3.fromRGB(255, 130, 150)
		)
		cheek.Transparency = 0.25
	end

	-- mouth / beak
	if has(petName, "owl", "chick", "phoenix", "penguin", "griffin", "duck") then
		wedge(
			model,
			"Beak",
			Vector3.new(s * 0.16, s * 0.14, s * 0.18),
			CFrame.new(0, top * 0.44, front * 1.02) * CFrame.Angles(math.rad(-90), 0, 0),
			Color3.fromRGB(255, 170, 40)
		)
	else
		blob(model, "Mouth", Vector3.new(s * 0.12, s * 0.06, s * 0.05), CFrame.new(0, top * 0.43, front * 0.96), Color3.fromRGB(60, 30, 40))
	end

	-- ears
	if has(petName, "bunny") then
		for _, side in { -1, 1 } do
			blob(
				model,
				"Ear",
				Vector3.new(s * 0.2, s * 0.7, s * 0.14),
				CFrame.new(side * s * 0.2, top + s * 0.25, 0) * CFrame.Angles(0, 0, math.rad(-side * 10)),
				color
			)
			blob(
				model,
				"EarInner",
				Vector3.new(s * 0.1, s * 0.5, s * 0.05),
				CFrame.new(side * s * 0.2, top + s * 0.25, -s * 0.07) * CFrame.Angles(0, 0, math.rad(-side * 10)),
				Color3.fromRGB(255, 170, 190)
			)
		end
	elseif has(petName, "pup", "dog") then
		for _, side in { -1, 1 } do
			blob(
				model,
				"Ear",
				Vector3.new(s * 0.18, s * 0.42, s * 0.12),
				CFrame.new(side * s * 0.46, top * 0.72, 0) * CFrame.Angles(0, 0, math.rad(side * 25)),
				dark
			)
		end
	elseif has(petName, "bear", "yeti", "golem", "titan") then
		for _, side in { -1, 1 } do
			blob(model, "Ear", Vector3.new(s * 0.24, s * 0.24, s * 0.14), CFrame.new(side * s * 0.33, top * 0.95, 0), dark)
		end
	elseif info.Ears or has(petName, "cat", "kitty", "fox", "wolf") then
		local tallEars = has(petName, "fox", "wolf")
		for _, side in { -1, 1 } do
			wedge(
				model,
				"Ear",
				Vector3.new(s * 0.08, s * (if tallEars then 0.42 else 0.3), s * 0.3),
				CFrame.new(side * s * 0.28, top * 0.92 + s * 0.12, 0) * CFrame.Angles(0, math.rad(90), math.rad(-side * 12)),
				color
			)
		end
	end

	-- owl tufts / phoenix crest
	if has(petName, "owl") then
		for _, side in { -1, 1 } do
			wedge(
				model,
				"Tuft",
				Vector3.new(s * 0.06, s * 0.22, s * 0.16),
				CFrame.new(side * s * 0.3, top * 0.98, 0) * CFrame.Angles(0, math.rad(90), math.rad(-side * 25)),
				dark
			)
		end
	elseif has(petName, "phoenix", "chick") then
		for i = -1, 1 do
			blob(
				model,
				"Crest",
				Vector3.new(s * 0.1, s * 0.3, s * 0.1),
				CFrame.new(i * s * 0.09, top + s * 0.08, 0) * CFrame.Angles(0, 0, math.rad(-i * 20)),
				if has(petName, "phoenix") then Color3.fromRGB(255, 200, 40) else color
			)
		end
	end

	-- horns
	if info.Horns or has(petName, "dragon", "dino", "serpent") then
		for _, side in { -1, 1 } do
			wedge(
				model,
				"Horn",
				Vector3.new(s * 0.08, s * 0.3, s * 0.16),
				CFrame.new(side * s * 0.22, top + s * 0.06, s * 0.05) * CFrame.Angles(math.rad(-15), math.rad(90), math.rad(-side * 15)),
				Color3.fromRGB(250, 240, 210)
			)
		end
	end

	-- wings
	if info.Wings then
		local bat = has(petName, "bat")
		for _, side in { -1, 1 } do
			local wing = blob(
				model,
				"Wing",
				Vector3.new(s * 0.18, s * (if bat then 0.55 else 0.45), s * 0.55),
				CFrame.new(side * s * 0.55, top * 0.55, s * 0.08) * CFrame.Angles(0, 0, math.rad(side * (if bat then 40 else 25))),
				if bat then dark else light
			)
			if rarity.Order >= 5 then
				wing.Material = Enum.Material.Neon
				wing.Transparency = 0.2
			end
		end
	end

	-- tails
	if has(petName, "fox", "wolf", "cat", "kitty", "dragon", "dino", "serpent") then
		local fluffy = has(petName, "fox", "wolf")
		local tail = blob(
			model,
			"Tail",
			Vector3.new(s * (if fluffy then 0.3 else 0.16), s * (if fluffy then 0.3 else 0.16), s * (if fluffy then 0.62 else 0.55)),
			CFrame.new(s * 0.12, top * 0.3, -front * 1.05) * CFrame.Angles(math.rad(35), 0, 0),
			color
		)
		if fluffy then
			blob(model, "TailTip", Vector3.new(s * 0.24, s * 0.24, s * 0.22), tail.CFrame * CFrame.new(0, 0, s * 0.26), Color3.new(1, 1, 1))
		end
	end

	-- royalty
	if has(petName, "king", "emperor", "midas", "titan") then
		local gold = Color3.fromRGB(255, 205, 50)
		part(
			model,
			"Crown",
			Vector3.new(s * 0.16, s * 0.5, s * 0.5),
			CFrame.new(0, top + s * 0.06, 0) * CFrame.Angles(0, 0, math.rad(90)),
			gold,
			Enum.Material.Foil,
			Enum.PartType.Cylinder
		)
		for i = 0, 3 do
			local angle = i * math.pi / 2
			wedge(
				model,
				"CrownSpike",
				Vector3.new(s * 0.06, s * 0.16, s * 0.12),
				CFrame.new(math.cos(angle) * s * 0.2, top + s * 0.2, math.sin(angle) * s * 0.2) * CFrame.Angles(0, -angle, 0),
				gold,
				Enum.Material.Foil
			)
		end
	end

	-- little feet
	for _, side in { -1, 1 } do
		blob(model, "Foot", Vector3.new(s * 0.26, s * 0.14, s * 0.3), CFrame.new(side * s * 0.24, s * 0.05, front * 0.55), dark)
	end

	-- rarity flair
	if rarity.Order >= 5 then
		sparkles(body, rarity.Color, 4 + (rarity.Order - 5) * 4, 0.3)
	end
	if rarity.Order >= 6 then
		local halo = part(
			model,
			"Halo",
			Vector3.new(0.12, s * 0.7, s * 0.7),
			CFrame.new(0, top + s * 0.45, 0) * CFrame.Angles(0, 0, math.rad(90)),
			rarity.Color,
			Enum.Material.Neon,
			Enum.PartType.Cylinder
		)
		halo.Transparency = 0.3
	end

	-- mutations
	if variant then
		model:SetAttribute("Variant", variant)
		local keep = { Eye = true, Pupil = true, Shine = true, Blush = true, Mouth = true, EarInner = true, Halo = true }
		local tint, material, glow
		if variant == "Golden" then
			tint, material, glow = Color3.fromRGB(255, 205, 50), Enum.Material.Foil, Color3.fromRGB(255, 230, 120)
		elseif variant == "Rainbow" then
			tint, material, glow = Color3.fromRGB(255, 90, 210), Enum.Material.SmoothPlastic, Color3.fromRGB(255, 200, 245)
		elseif variant == "Galaxy" then
			tint, material, glow = Color3.fromRGB(70, 30, 140), Enum.Material.Glass, Color3.fromRGB(190, 140, 255)
		elseif variant == "Frozen" then
			tint, material, glow = Color3.fromRGB(170, 225, 255), Enum.Material.Ice, Color3.fromRGB(220, 245, 255)
		elseif variant == "Molten" then
			tint, material, glow = Color3.fromRGB(255, 110, 30), Enum.Material.CrackedLava, Color3.fromRGB(255, 160, 60)
		end
		if tint then
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") and not keep[d.Name] then
					d.Color = if variant == "Golden" then d.Color:Lerp(tint, 0.75) else tint
					d.Material = material
				end
			end
			local light = Instance.new("PointLight")
			light.Color = glow
			light.Range = 7
			light.Brightness = 0.7 -- (soft: a brighter light washed out the pedestals)
			light.Parent = body
			sparkles(body, glow, if variant == "Galaxy" then 14 else 8, if variant == "Galaxy" then 0.45 else 0.35)
			if variant == "Molten" then
				local fire = Instance.new("ParticleEmitter")
				fire.Texture = "rbxasset://textures/particles/fire_main.dds"
				fire.Color = ColorSequence.new(Color3.fromRGB(255, 180, 60), Color3.fromRGB(255, 60, 20))
				fire.Size = NumberSequence.new(0.6, 0)
				fire.Lifetime = NumberRange.new(0.3, 0.6)
				fire.Rate = 10
				fire.Speed = NumberRange.new(1, 3)
				fire.LightEmission = 1
				fire.Parent = body
			end
		end
		-- HUGE: same colours, twice the size, a golden shimmer
		local def = Util.VariantDef(Config, variant)
		if def and def.Scale and def.Scale ~= 1 then
			sparkles(body, Color3.fromRGB(255, 225, 120), 10, 0.5)
			local ok = pcall(function()
				model:ScaleTo(def.Scale)
			end)
			if not ok then
				for _, d in model:GetDescendants() do
					if d:IsA("BasePart") then
						d.Size *= def.Scale
						d.CFrame = CFrame.new(d.Position * def.Scale) * (d.CFrame - d.Position)
					end
				end
			end
		end
	end

	applyMeteorLook(model, info)
	applyGrowth(model, growth)
	return model
end

return PetModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ShardModel</string>
          <string name="Source"><![CDATA[--[[
	ShardModel: procedural STAR EGG (no assets needed). Falling stars and
	meteors drop these; carried home they hatch into a pet.
	ShardModel.Build(config, rarityId, scale) -> Model with PrimaryPart "Core".
	Parts are welded to Core; the caller decides Anchored / where to weld it.
]]
local ShardModel = {}

local function piece(name: string, size: Vector3, color: Color3, material: Enum.Material, parent: Instance): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

function ShardModel.Build(config, rarityId: string, scale: number?): Model
	local def = config.Shards.Rarities[rarityId] or config.Shards.Rarities.Common
	local s = (scale or 1) * 1.15
	local index = table.find(config.Shards.Order, rarityId) or 1
	local model = Instance.new("Model")
	model.Name = "StarEgg_" .. rarityId
	model:SetAttribute("Rarity", rarityId)

	-- the egg: a stretched sphere, glowing in the star's colour
	local secret = rarityId == "Secret"
	local core = piece(
		"Core",
		Vector3.new(2.2, 2.8, 2.2) * s,
		if secret then Color3.fromRGB(25, 12, 45) else def.Color:Lerp(Color3.new(1, 1, 1), 0.35),
		if secret then Enum.Material.Glass else Enum.Material.SmoothPlastic,
		model
	)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = core
	model.PrimaryPart = core

	-- glowing zig-zag band around the middle
	local band = piece("Band", Vector3.new(0.35 * s, 2.25 * s, 2.25 * s), def.Color, Enum.Material.Neon, model)
	band.Shape = Enum.PartType.Cylinder
	band.CFrame = core.CFrame * CFrame.Angles(0, 0, math.rad(90))
	weld(core, band)

	-- little stars stuck to the shell (more for rarer eggs)
	for i = 1, math.min(2 + index, 7) do
		local angle = (i / math.min(2 + index, 7)) * math.pi * 2
		local y = if i % 2 == 0 then 0.55 else -0.45
		local star = piece("Star", Vector3.new(0.4, 0.4, 0.4) * s, Color3.fromRGB(255, 245, 190), Enum.Material.Neon, model)
		star.CFrame = core.CFrame
			* CFrame.new(math.cos(angle) * 1.02 * s, y * s, math.sin(angle) * 1.02 * s)
			* CFrame.Angles(0, -angle, math.rad(45))
		weld(core, star)
	end

	-- legendary+ eggs get a halo
	if index >= 4 then
		local ring = piece("Ring", Vector3.new(0.18, 3.4 * s, 3.4 * s), def.Color, Enum.Material.Neon, model)
		ring.Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.35
		ring.CFrame = core.CFrame * CFrame.new(0, 1.9 * s, 0) * CFrame.Angles(0, 0, math.rad(90))
		weld(core, ring)
	end

	local light = Instance.new("PointLight")
	light.Color = def.Color
	light.Range = 8 + index * 2
	light.Brightness = 1.5 + index * 0.3
	light.Parent = core

	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "Sparkles"
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Color = ColorSequence.new(def.Color)
	sparkles.LightEmission = 1
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45 * s), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Lifetime = NumberRange.new(0.6, 1.1)
	sparkles.Speed = NumberRange.new(1, 3)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.Rate = 4 + index * 3
	sparkles.Parent = core

	return model
end

-- every part anchored (displays / ground drops) or not (carried)
function ShardModel.SetAnchored(model: Model, anchored: boolean)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = anchored
		end
	end
end

return ShardModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- 1234567 -> "1.23M"
function Util.Format(n: number?): string
	local value = tonumber(n) or 0
	local negative = value < 0
	value = math.abs(value)
	local text
	if value < 1000 then
		if value == math.floor(value) then
			text = tostring(math.floor(value))
		else
			text = string.format("%.1f", value)
		end
	else
		local index = 1
		while value >= 1000 and index < #SUFFIXES do
			value /= 1000
			index += 1
		end
		local pattern = if value >= 100 then "%.0f%s" elseif value >= 10 then "%.1f%s" else "%.2f%s"
		text = string.format(pattern, value, SUFFIXES[index])
	end
	return if negative then "-" .. text else text
end

-- 1234567 -> "1,234,567"
function Util.Comma(n: number?): string
	local s = tostring(math.floor(tonumber(n) or 0))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	return formatted
end

-- 3725 -> "1h 02m", 125 -> "2:05"
function Util.FormatTime(seconds: number?): string
	local s = math.max(0, math.floor(tonumber(seconds) or 0))
	local days = math.floor(s / 86400)
	local hours = math.floor((s % 86400) / 3600)
	local minutes = math.floor((s % 3600) / 60)
	local secs = s % 60
	if days > 0 then
		return string.format("%dd %02dh", days, hours)
	elseif hours > 0 then
		return string.format("%dh %02dm", hours, minutes)
	end
	return string.format("%d:%02d", minutes, secs)
end

function Util.DeepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = Util.DeepCopy(v)
	end
	return copy
end

-- Fills keys missing from target with copies of template values (in place).
function Util.Reconcile(target, template)
	for key, value in template do
		if target[key] == nil then
			target[key] = Util.DeepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil then
			-- only recurse into dictionaries that define structure
			if #value == 0 then
				Util.Reconcile(target[key], value)
			end
		end
	end
	return target
end

-- entries = { {key, weight}, ... }; weightFn(key, weight) can modify weights (luck)
function Util.WeightedPick(entries, weightFn, rng)
	local total = 0
	local weights = table.create(#entries)
	for i, entry in entries do
		local w = entry[2]
		if weightFn then
			w = weightFn(entry[1], w)
		end
		weights[i] = w
		total += w
	end
	local roll = (if rng then rng:NextNumber() else math.random()) * total
	for i, entry in entries do
		roll -= weights[i]
		if roll <= 0 then
			return entry[1]
		end
	end
	return entries[#entries][1]
end

-- Returns { [key] = percent } for display, after luck is applied.
function Util.Odds(entries, weightFn)
	local total = 0
	local weights = {}
	for i, entry in entries do
		local w = entry[2]
		if weightFn then
			w = weightFn(entry[1], w)
		end
		weights[i] = w
		total += w
	end
	local odds = {}
	for i, entry in entries do
		odds[entry[1]] = if total > 0 then weights[i] / total * 100 else 0
	end
	return odds
end

function Util.FormatPercent(p: number): string
	if p >= 10 then
		return string.format("%.0f%%", p)
	elseif p >= 1 then
		return string.format("%.1f%%", p)
	elseif p >= 0.1 then
		return string.format("%.2f%%", p)
	end
	return string.format("%.3f%%", p)
end

-- Day / week numbers (UTC). Weeks start on Monday 00:00 UTC.
local WEEK_OFFSET = 4 * 86400 -- 1970-01-01 was a Thursday
function Util.DayNumber(t: number?): number
	return math.floor((t or os.time()) / 86400)
end

function Util.WeekNumber(t: number?): number
	return math.floor(((t or os.time()) - WEEK_OFFSET) / 604800)
end

function Util.SecondsUntilNextDay(t: number?): number
	local now = t or os.time()
	return (Util.DayNumber(now) + 1) * 86400 - now
end

function Util.SecondsUntilNextWeek(t: number?): number
	local now = t or os.time()
	return (Util.WeekNumber(now) + 1) * 604800 + WEEK_OFFSET - now
end

-- Human readable reward text: { Gems = 10, Boost = {"Coins2x", 600} } -> "10 💎 + 2x💰 10m"
-- tr(text, ...) is an optional translator (server: Net:L for the player)
local BOOST_NAMES = {
	Coins2x = "2x Coins",
	Luck2x = "2x Luck",
	Power2x = "2x Power",
}
Util.BoostNames = BOOST_NAMES
local BOOST_ICONS = { Coins2x = "2x💰", Luck2x = "2x🍀", Power2x = "2x💥" }
Util.BoostIcons = BOOST_ICONS

function Util.RewardText(reward, tr): string
	if not reward then
		return ""
	end
	local translate = tr or function(text, ...)
		if select("#", ...) > 0 then
			return string.format(text, ...)
		end
		return text
	end
	local parts = {}
	if reward.Gems then
		table.insert(parts, Util.Format(reward.Gems) .. " 💎")
	end
	if reward.Coins then
		table.insert(parts, Util.Format(reward.Coins) .. " 💰")
	end
	if reward.Stardust then
		table.insert(parts, Util.Format(reward.Stardust) .. " ✨")
	end
	if reward.Boost then
		local icon = BOOST_ICONS[reward.Boost[1]] or reward.Boost[1]
		table.insert(parts, icon .. " " .. translate("%dm", math.floor(reward.Boost[2] / 60)))
	end
	if reward.Pet then
		table.insert(parts, "🐾 " .. translate(reward.Pet))
	end
	return table.concat(parts, " + ")
end

function Util.RebirthCost(config, rebirths: number): number
	return math.floor(config.Rebirth.BaseCost * (rebirths + 1) ^ config.Rebirth.Exponent)
end

function Util.RankFor(config, points: number)
	local index = 1
	for i, rank in config.Ranks do
		if points >= rank.Min then
			index = i
		end
	end
	return config.Ranks[index], index
end

-- true for the experience owner (user-owned) or the group owner (rank 255)
function Util.IsOwner(player: Player): boolean
	if game.CreatorId == 0 then
		return false
	end
	if game.CreatorType == Enum.CreatorType.User then
		return player.UserId == game.CreatorId
	elseif game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		return ok and rank == 255
	end
	return false
end

-- test features (DEV panel, simulated purchases) are allowed in Studio, or
-- for the owner in live servers while Config.OwnerTestMode is on
function Util.CanTest(config, player: Player): boolean
	if game:GetService("RunService"):IsStudio() then
		return true
	end
	return config.OwnerTestMode == true and Util.IsOwner(player)
end

-- XP needed to go from `level` to `level + 1`
function Util.XPForLevel(config, level: number): number
	return math.max(1, math.floor(config.Levels.XPBase * level ^ config.Levels.XPExponent))
end

function Util.VariantDef(config, variant: string?)
	if not variant then
		return nil
	end
	for _, def in config.PetVariants do
		if def.Id == variant then
			return def
		end
	end
	return nil
end

-- coins per second a pet earns on a pedestal (mutation included, before boosts)
function Util.PetIncome(config, petName: string, variant: string?): number
	local info = config.Pets[petName]
	if not info then
		return 0
	end
	local def = Util.VariantDef(config, variant)
	return (info.Income or 0) * (if def then def.IncomeMult or 1 else 1)
end

---------------------------------------------------------------------------
-- 🌱 pet growth: level 1..MaxLevel, ★ stars from evolving (Config.Growth)
---------------------------------------------------------------------------
function Util.PetLevel(pet): number
	return math.max(1, math.floor(tonumber(pet and pet.Level) or 1))
end

function Util.PetStars(pet): number
	return math.max(0, math.floor(tonumber(pet and pet.Stars) or 0))
end

-- income / power multiplier from level + stars
function Util.PetGrowthMult(config, pet): number
	local growth = config.Growth
	if not growth or not pet then
		return 1
	end
	local level = math.min(Util.PetLevel(pet), growth.MaxLevel)
	return (1 + growth.LevelBonus * (level - 1)) * growth.Evolve.StarMult ^ Util.PetStars(pet)
end

-- a pet's real income per second (species x mutation x growth)
function Util.PetIncomeOf(config, pet): number
	return Util.PetIncome(config, pet.Name, pet.Variant) * Util.PetGrowthMult(config, pet)
end

function Util.PetPowerOf(config, pet): number
	return Util.PetPower(config, pet.Name, pet.Variant) * Util.PetGrowthMult(config, pet)
end

-- xp needed to go from the pet's level to the next (rarer pets take longer)
function Util.PetXPNeed(config, pet): number
	local growth = config.Growth
	local info = config.Pets[pet.Name]
	local rarity = info and config.Rarities[info.Rarity]
	local order = if rarity then rarity.Order else 1
	local level = Util.PetLevel(pet)
	return math.floor(growth.XPBase * level ^ growth.XPPow * (1 + growth.XPRarity * (order - 1)))
end

function Util.PetStage(config, level: number)
	local stages = config.Growth.Stages
	local best = stages[1]
	for _, stage in stages do
		if level >= stage.Min then
			best = stage
		end
	end
	return best
end

-- "👑10 ★★" / "🍼3" (shown on cards, pedestals and follow pets)
function Util.PetBadge(config, pet): string
	local level = Util.PetLevel(pet)
	local stage = Util.PetStage(config, level)
	local stars = Util.PetStars(pet)
	return stage.Icon .. level .. (if stars > 0 then " " .. string.rep("★", stars) else "")
end

-- the copies an evolve may use: same species, plain (no mutation), not more
-- evolved than the pet itself, not numbered / exclusive / away. Least grown first.
function Util.EvolveCopies(config, data, pet)
	local list = {}
	local stars = Util.PetStars(pet)
	for _, other in data.Pets do
		if
			other ~= pet
			and other.Name == pet.Name
			and not other.Away
			and not other.Serial
			and not other.SerialPending
			and not other.Variant
			and Util.PetStars(other) <= stars
			and not Util.IsExclusive(config, other)
		then
			table.insert(list, other)
		end
	end
	table.sort(list, function(a, b)
		local ga, gb = Util.PetGrowthMult(config, a), Util.PetGrowthMult(config, b)
		if ga ~= gb then
			return ga < gb
		end
		return a.Id < b.Id
	end)
	return list
end

-- stardust cost of one feed, and the xp it gives
function Util.PetFeed(config, pet): (number, number)
	local growth = config.Growth
	local xp = math.max(5, math.floor(Util.PetXPNeed(config, pet) * growth.FeedShare))
	return math.ceil(xp * growth.FeedCost), xp
end

---------------------------------------------------------------------------
-- 📖 collection index (Config.Index)
---------------------------------------------------------------------------
function Util.IndexCount(data): number
	local n = 0
	for _ in data.PetIndex or {} do
		n += 1
	end
	return n
end

-- egg sets: every pet of the egg discovered (Robux / reward-only eggs don't count)
function Util.IndexSets(config, data)
	local sets = {}
	for _, eggId in config.EggOrder do
		local egg = config.Eggs[eggId]
		if egg and egg.Pets and egg.Currency ~= "Robux" then
			local have, total = 0, 0
			for _, entry in egg.Pets do
				local name = entry[1]
				total += 1
				if data.PetIndex and data.PetIndex[name] then
					have += 1
				end
			end
			table.insert(sets, { Egg = eggId, Have = have, Total = total, Done = total > 0 and have >= total })
		end
	end
	-- ☄️ meteor pets are a set of their own
	local meteor = config.Meteor and config.Meteor.MeteorPets
	if meteor then
		local have = 0
		for _, name in meteor do
			if data.PetIndex and data.PetIndex[name] then
				have += 1
			end
		end
		table.insert(sets, { Egg = "Meteor", Have = have, Total = #meteor, Done = have >= #meteor })
	end
	return sets
end

-- permanent home income bonus from claimed milestones + completed sets
function Util.IndexBonus(config, data): number
	local index = config.Index
	if not index then
		return 0
	end
	local bonus = 0
	local claimed = data.IndexClaimed or {}
	for i, milestone in index.Milestones do
		if claimed[tostring(i)] and milestone.Bonus then
			bonus += milestone.Bonus
		end
	end
	for _, set in Util.IndexSets(config, data) do
		if set.Done then
			bonus += index.SetBonus
		end
	end
	return bonus
end

-- the egg shop restocks every RestockSeconds; slot = which restock we're in
function Util.ShopSlot(config, serverTime: number): number
	return math.floor(serverTime / config.Shop.RestockSeconds)
end

-- seconds until the next restock
function Util.ShopRestockIn(config, serverTime: number): number
	local period = config.Shop.RestockSeconds
	return period - (serverTime % period)
end

-- how many of an egg are in stock this slot (same in every server: seeded).
-- nil = not a restocking egg (always available)
function Util.EggStock(config, eggId: string, slot: number): number?
	local egg = config.Eggs[eggId]
	local rule = egg and egg.Stock
	if not rule then
		return nil
	end
	-- small deterministic hash of (slot, eggId) -> 0..1. Every product stays
	-- below 2^53 so it's exact on every machine (server and phones agree).
	local m = 4294967296
	local h = (slot % 1000003) * 2654435761 % m
	for i = 1, #eggId do
		h = (h * 31 + string.byte(eggId, i)) % m
	end
	for _ = 1, 3 do
		h = (h * 69069 + 1) % m
	end
	local roll = h / m
	if roll >= rule.Chance then
		return 0
	end
	local span = rule.Max - rule.Min + 1
	local pick = math.floor((roll / rule.Chance) * span)
	return rule.Min + math.min(pick, span - 1)
end

-- pet power including Golden / Rainbow multiplier
function Util.PetPower(config, petName: string, variant: string?): number
	local info = config.Pets[petName]
	if not info then
		return 0
	end
	local def = Util.VariantDef(config, variant)
	return info.Power * (if def then def.PowerMult else 1)
end

function Util.PetDisplayName(petName: string, variant: string?): string
	return if variant then variant .. " " .. petName else petName
end

-- 0 = hub, 1..n = zone index, nil = outside (mirrors WorldService layout)
-- the base district (south of the hub) counts as hub (zone 0)
function Util.InBases(config, position: Vector3): boolean
	local bases = config.World.Bases
	return math.abs(position.X) <= bases.HalfX and position.Z <= bases.ZStart + 8 and position.Z >= bases.ZEnd
end

-- weighted shard rarity roll; luck > 1 shifts weight toward rarer shards
function Util.RollShard(config, luck: number?, rng: Random?, minIndex: number?): string
	local order = config.Shards.Order
	local entries = {}
	for index, id in order do
		if index >= (minIndex or 1) then
			table.insert(entries, { id, config.Shards.Rarities[id].Weight * (luck or 1) ^ ((index - 1) / 2) })
		end
	end
	return Util.WeightedPick(entries, nil, rng)
end

function Util.ShardIndex(config, id: string): number
	return table.find(config.Shards.Order, id) or 1
end

-- coins per second of one shard for an owner at this zone level (before coin multiplier)
function Util.ShardIncome(config, id: string, zoneLevel: number): number
	local def = config.Shards.Rarities[id]
	if not def then
		return 0
	end
	local mult = config.Shards.ZoneMult
	return def.Income * (mult[math.clamp(zoneLevel, 1, #mult)] or 1)
end

function Util.ZoneAt(config, position: Vector3): number?
	local layout = config.World.Layout
	if math.abs(position.X) <= layout.HubHalf and math.abs(position.Z) <= layout.HubHalf then
		return 0
	end
	if Util.InBases(config, position) then
		return 0
	end
	if math.abs(position.X) > layout.ZoneWidth / 2 + 1 then
		return nil
	end
	for index = 1, #config.Zones do
		local zStart = layout.FirstZ + (index - 1) * (layout.ZoneLength + layout.Gap)
		if position.Z >= zStart and position.Z <= zStart + layout.ZoneLength then
			return index
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- houses (shared by the server, the build mode and the panels)
---------------------------------------------------------------------------
-- territory centers: two rows facing a central avenue (local -Z faces the avenue)
function Util.PlotLayout(config): { { Center: Vector3, Facing: Vector3 } }
	local base = config.Base
	local layout = base.Layout
	local half = base.PlotSize / 2
	local bases = config.World.Bases
	local rows = { -- north row (next to the hub gate) faces south, the far row faces north
		{ Z = bases.ZStart - layout.Margin - half, Facing = Vector3.new(0, 0, -1) },
		{ Z = bases.ZStart - layout.Margin - half * 2 - layout.Avenue - half, Facing = Vector3.new(0, 0, 1) },
	}
	local columns = {}
	local x = layout.EntranceGap / 2 + half
	for _ = 1, layout.Columns / 2 do
		table.insert(columns, -x)
		table.insert(columns, x)
		x += half * 2 + layout.Gap
	end
	table.sort(columns, function(a, b)
		-- nearest to the entrance first
		if math.abs(a) == math.abs(b) then
			return a < b
		end
		return math.abs(a) < math.abs(b)
	end)
	local list = {}
	for _, row in rows do
		for _, cx in columns do
			if #list < base.Plots then
				table.insert(list, { Center = Vector3.new(cx, 0, row.Z), Facing = row.Facing })
			end
		end
	end
	return list
end

-- z of the avenue center line
function Util.AvenueZ(config): number
	local layout = config.Base.Layout
	return config.World.Bases.ZStart - layout.Margin - config.Base.PlotSize - layout.Avenue / 2
end

function Util.HouseLevel(config, data): number
	local level = data and data.Base and tonumber(data.Base.Level) or 1
	return math.clamp(math.floor(level), 1, #config.Base.Levels)
end

function Util.HouseDef(config, level: number)
	return config.Base.Levels[math.clamp(level, 1, #config.Base.Levels)]
end

-- how many vault pedestals this player may own
function Util.VaultLimit(config, data, hasVip: boolean?): number
	return Util.HouseDef(config, Util.HouseLevel(config, data)).Vaults + (if hasVip then config.Base.VipVaults else 0)
end

-- the wall style of a house: its skin, or the style of its level
function Util.HouseStyle(config, data): (string, any)
	local skin = data and data.Base and data.Base.Skin
	if type(skin) == "string" and skin ~= "Auto" and config.HouseStyles[skin] then
		return skin, config.HouseStyles[skin]
	end
	local style = Util.HouseDef(config, Util.HouseLevel(config, data)).Style
	return style, config.HouseStyles[style]
end

function Util.IsExclusive(config, pet): boolean
	local info = pet and config.Pets[pet.Name]
	return info ~= nil and info.Exclusive == true
end

-- pets carry a serial number when they're huge or exclusive
function Util.WantsSerial(config, name: string, variant: string?): boolean
	local info = config.Pets[name]
	local def = Util.VariantDef(config, variant)
	return (info ~= nil and info.Exclusive == true) or (def ~= nil and def.Serial == true)
end

-- total income of every pet you own (used by the fair-stealing rule)
function Util.PetWorth(config, data): number
	local total = 0
	for _, pet in data.Pets do
		total += Util.PetIncomeOf(config, pet)
	end
	return total
end

-- pedestal + vault items, oldest first (stable order)
function Util.Pedestals(config, items)
	local display, vault = {}, {}
	for _, item in items do
		local def = config.Decor[item.Id]
		if def and def.Function == "Pedestal" then
			table.insert(display, item)
		elseif def and def.Function == "Vault" then
			table.insert(vault, item)
		end
	end
	local function byUid(a, b)
		return a.Uid < b.Uid
	end
	table.sort(display, byUid)
	table.sort(vault, byUid)
	return display, vault
end

-- who stands where. Vaults get your BEST pets (safe by default) unless you
-- marked a pet "show off" (pet.Show = true). Exclusive pets can't be stolen
-- anyway, so they skip the vault and earn full income on display.
-- returns vaultPets, displayPets (same order as the pedestal items)
function Util.ArrangePets(config, data)
	local displayItems, vaultItems = Util.Pedestals(config, data.Base.Items)
	local list = {}
	for _, pet in data.Pets do
		if not pet.Away and config.Pets[pet.Name] then
			table.insert(list, pet)
		end
	end
	table.sort(list, function(a, b)
		local ia = Util.PetIncomeOf(config, a)
		local ib = Util.PetIncomeOf(config, b)
		if ia == ib then
			return a.Id < b.Id
		end
		return ia > ib
	end)
	local vault, display, used = {}, {}, {}
	for _, pet in list do
		if #vault >= #vaultItems then
			break
		end
		-- freshly stolen pets ("hot") can't hide in a vault yet
		local hot = type(pet.HotUntil) == "number" and pet.HotUntil > os.time()
		if not pet.Show and not hot and not Util.IsExclusive(config, pet) then
			table.insert(vault, pet)
			used[pet] = true
		end
	end
	for _, pet in list do
		if #display >= #displayItems then
			break
		end
		if not used[pet] then
			table.insert(display, pet)
		end
	end
	return vault, display
end

-- decoration sets: total income bonus + which sets are complete
function Util.SetBonus(config, items): (number, { [string]: boolean })
	local have = {}
	for _, item in items do
		have[item.Id] = true
	end
	local total, done = 0, {}
	for _, set in config.DecorSets do
		local complete = true
		for _, id in set.Items do
			if not have[id] then
				complete = false
				break
			end
		end
		if complete then
			total += set.Bonus
			done[set.Id] = true
		end
	end
	return total, done
end

-- probability of hatching this exact pet (+ mutation) from an egg, base luck
function Util.HatchChance(config, eggId: string, petName: string, variant: string?): number?
	local egg = config.Eggs[eggId]
	if not egg then
		return nil
	end
	local total, weight = 0, 0
	for _, entry in egg.Pets do
		total += entry[2]
		if entry[1] == petName then
			weight = entry[2]
		end
	end
	if total <= 0 or weight <= 0 then
		return nil
	end
	local chance = weight / total
	local def = Util.VariantDef(config, variant)
	if def and (def.Chance or 0) > 0 then
		chance *= def.Chance
	end
	return chance
end

-- titles: which ones a player has unlocked
function Util.TitleUnlocked(config, title, data, hasPass): boolean
	local need = title.Need or {}
	local stats = data.Stats or {}
	local function count(t)
		local n = 0
		for _ in t or {} do
			n += 1
		end
		return n
	end
	if need.Level and (data.Level or 1) < need.Level then
		return false
	end
	if need.Index and count(data.PetIndex) < need.Index then
		return false
	end
	if need.Steals and (stats.ShardsStolen or 0) < need.Steals then
		return false
	end
	if need.Catches and (stats.ThievesCaught or 0) < need.Catches then
		return false
	end
	if need.HouseLevel and Util.HouseLevel(config, data) < need.HouseLevel then
		return false
	end
	if need.Likes and (data.Base and data.Base.Likes or 0) < need.Likes then
		return false
	end
	if need.Rebirths and (data.Rebirths or 0) < need.Rebirths then
		return false
	end
	if need.Huge and (stats.HugesFound or 0) < need.Huge then
		return false
	end
	if need.LifetimeCoins and (stats.LifetimeCoins or 0) < need.LifetimeCoins then
		return false
	end
	if need.Meteors and (stats.MeteorJoins or 0) < need.Meteors then
		return false
	end
	if need.MeteorPets and (stats.MeteorPets or 0) < need.MeteorPets then
		return false
	end
	if need.Evolved and (stats.Evolved or 0) < need.Evolved then
		return false
	end
	if need.Delivered and (stats.ShardsDelivered or 0) < need.Delivered then
		return false
	end
	if need.Titanic and (stats.TitanicsFound or 0) < need.Titanic then
		return false
	end
	if need.Pranks and (stats.Pranks or 0) < need.Pranks then
		return false
	end
	if need.Lucky and (stats.LuckyBlocks or 0) < need.Lucky then
		return false
	end
	if need.Pass and not (hasPass and hasPass(need.Pass)) then
		return false
	end
	return true
end

-- the title a player wears: their pick if unlocked, else the best unlocked one
function Util.CurrentTitle(config, data, hasPass)
	local best = config.Titles[1]
	for _, title in config.Titles do
		if Util.TitleUnlocked(config, title, data, hasPass) then
			best = title
			if data.Title == title.Id then
				return title
			end
		end
	end
	-- nothing picked (or the pick isn't unlocked any more): the best one
	return best
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Server entry point. Services are initialised in dependency order:
	Init() wires references, Start() connects events and starts loops.
]]
local servicesFolder = script.Parent:WaitForChild("Services")

local ORDER = {
	"Analytics",
	"DataService",
	"StatsService",
	"MonetizationService",
	"BoostService",
	"EventService",
	"WorldService",
	"CharacterService",
	"EconomyService",
	"PetService",
	"MiningService",
	"BaseService",
	"ShardService",
	"TradeService",
	"MeteorService",
	"LuckyService",
	"RivalService",
	"RivalHomes",
	"ProgressionService",
	"LeaderboardService",
	"DevService",
}

local Services = {}
for _, name in ORDER do
	Services[name] = require(servicesFolder:WaitForChild(name))
end

for _, name in ORDER do
	local service = Services[name]
	if service.Init then
		service:Init(Services)
	end
end

-- Start everything except DataService first, so every OnLoaded/PlayerAdded hook
-- is registered before players' data begins loading.
for _, name in ORDER do
	local service = Services[name]
	if name ~= "DataService" and service.Start then
		local ok, err = pcall(service.Start, service)
		if not ok then
			warn(string.format("[Main] %s failed to start: %s", name, tostring(err)))
		end
	end
end
Services.DataService:Start()

print("[Meteor Rush] server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="14">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Analytics</string>
            <string name="Source"><![CDATA[--[[
	Analytics: thin, crash-proof wrapper around Roblox AnalyticsService.
	Shows up in Creator Dashboard -> Analytics:
	  * Onboarding funnel: where new players drop out of the tutorial
	  * Economy: what coins / gems are earned and spent on
	  * Custom events: steals, star eggs, trades ...
	Every call is pcall'd so analytics can never break gameplay.
]]
local AnalyticsService = game:GetService("AnalyticsService")

local Analytics = {}

function Analytics:Funnel(player: Player, step: number, stepName: string)
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
end

-- flow: "Source" (earned) | "Sink" (spent)
function Analytics:Economy(
	player: Player,
	flow: string,
	currency: string,
	amount: number,
	balance: number,
	transaction: string,
	sku: string?
)
	if amount <= 0 then
		return
	end
	pcall(function()
		AnalyticsService:LogEconomyEvent(
			player,
			if flow == "Sink" then Enum.AnalyticsEconomyFlowType.Sink else Enum.AnalyticsEconomyFlowType.Source,
			currency,
			math.floor(amount),
			math.floor(balance),
			transaction,
			sku
		)
	end)
end

function Analytics:Custom(player: Player, eventName: string, value: number?)
	pcall(function()
		AnalyticsService:LogCustomEvent(player, eventName, value or 1)
	end)
end

return Analytics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">BaseService</string>
            <string name="Source"><![CDATA[--[[
	BaseService: every player owns a walled territory in the base district.

	* YOUR HOUSE: a 72x72 lot with its own fence, gate and name sign. The
	  house LEVEL (🏗️ expand) grows the buildable land, the decoration limit
	  and the number of vaults, and upgrades the walls (wood -> stone -> gold
	  -> crystal -> galaxy). Skins (Sakura, Candy, Royal VIP, Neon, Galaxy)
	  change the look. Name your house (filtered by Roblox).
	* DECORATE: buy anything from the build menu and place it on the grid;
	  🎨 paint it in 12 colours. Removing refunds 100%. Complete a decor SET
	  for bonus income.
	* PEDESTALS: your pets stand on them and earn coins every second into the
	  bank (green pad), even offline (50%, 2h).
	  - 🔒 VAULT pedestals hold your best pets: they can NEVER be stolen but
	    earn 50%. Mark a pet "show off" to keep it out of the vault.
	  - display pedestals earn 100% and can be robbed.
	  - 💎 exclusive pets can never be stolen.
	* FAIR STEALING (you never lose everything):
	  - nobody can rob you while you're offline; your base starts locked
	  - newbie shield for the first 20 minutes (stealing yourself ends it)
	  - one theft at a time, then a 3 minute shield
	  - you can't rob a base worth less than 1/3 of yours
	  - the victim gets 5 minutes of REVENGE (locks don't stop them)
	  - serial thieves get a 💰 bounty: bonk them to claim it
	* SHOW OFF: visitors ❤️ like your house (gems + ranked points), every
	  house is in the 🏘️ Houses list with a visit button.

	data.Base.Items = { { Uid, Id, X, Z, R, Paid, Cur, Paint? }, ... } (plot space)
	data.Pets entries get Away = true while a thief carries them
]]
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local PetModel = require(Shared.PetModel)
local DecorModel = require(Shared.DecorModel)
local Net = require(script.Parent.Net)

local Base = {}
local Services
local Data
local World

local SETTINGS = Config.Base
local PLOT_HALF = SETTINGS.PlotSize / 2
local WALL_HEIGHT = 5.5 -- (a low garden wall: the camera never hides behind it)
local FLOOR_Y = 0.42 -- top of the plot floor
local GATE_HALF = 6 -- the entrance is 12 studs wide

local plots = {} -- [index] = plot record
local plotOf = {} -- [player] = plot record
local waiting = {} -- players without a plot yet (server fuller than Plots)
local touchDebounce = {} -- ["userId:what"] = os.clock()
local trapReady = {} -- [trap model] = os.clock() when it can fire again
local revenge = {} -- [victim] = { Target = thief, Until = server time }
local thefts = {} -- [thief] = { { Victim = userId, Time, Value }, ... } (bounty)
local houseNames = {} -- [player] = filtered custom house name

---------------------------------------------------------------------------
-- helpers
---------------------------------------------------------------------------
local function part(props, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(p :: any)[key] = value
	end
	p.Parent = parent
	return p
end

local function billboard(adornee: BasePart, width: number, height: number, offsetY: number, color: Color3, maxDistance: number?): TextLabel
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.new(width, 0, height, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or 140
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.RichText = true
	label.TextColor3 = color
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = adornee
	return label
end

local function now(): number
	return workspace:GetServerTimeNow()
end

local function playerFromHit(hit: BasePart): Player?
	local model = hit:FindFirstAncestorOfClass("Model")
	return model and Players:GetPlayerFromCharacter(model)
end

local function debounced(player: Player, what: string, seconds: number): boolean
	local key = player.UserId .. ":" .. what
	local last = touchDebounce[key]
	if last and os.clock() - last < seconds then
		return true
	end
	touchDebounce[key] = os.clock()
	return false
end

local function setPrompt(parent: BasePart, action: string, object: string, role: string, hold: number, handler, distance: number?)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = distance or 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	-- the client shows Owner prompts only to the owner, Thief/Visitor ones to others
	prompt:SetAttribute("Role", role)
	prompt.Parent = parent
	prompt.Triggered:Connect(function(player)
		local ok, err = pcall(handler, player)
		if not ok then
			warn("[Base] prompt failed: " .. tostring(err))
		end
	end)
	return prompt
end

local function material(name: string?): Enum.Material
	local ok, value = pcall(function()
		return (Enum.Material :: any)[name or "SmoothPlastic"]
	end)
	return if ok and value then value else Enum.Material.SmoothPlastic
end

local function hasVip(player: Player): boolean
	return Services.MonetizationService:HasPass(player, "VIP")
end

local function houseLevel(data): number
	return Util.HouseLevel(Config, data)
end

local function validateOpts(player: Player, data)
	return { Level = houseLevel(data), Vaults = Util.VaultLimit(Config, data, hasVip(player)) }
end

---------------------------------------------------------------------------
-- building the plots (static parts once, styled walls per owner)
---------------------------------------------------------------------------
local tryLike -- forward declaration

local function buildPlot(index: number, center: Vector3, facing: Vector3): any
	-- local -Z (LookVector) faces the avenue
	local cf = CFrame.lookAt(center, center + facing)
	local model = Instance.new("Model")
	model.Name = "Plot_" .. index
	model:SetAttribute("OwnerId", 0)
	model:SetAttribute("LockedUntil", 0)
	model:SetAttribute("ShieldUntil", 0)
	model:SetAttribute("Protection", "")
	model:SetAttribute("HouseName", "")
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("HouseLevel", 1)
	model:SetAttribute("Likes", 0)
	model:SetAttribute("Rate", 0)

	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end

	local floor = part({
		Name = "Floor",
		Size = Vector3.new(PLOT_HALF * 2, 0.4, PLOT_HALF * 2),
		CFrame = at(0, 0.2, 0),
		Color = Color3.fromRGB(90, 150, 80),
		Material = Enum.Material.Grass,
	}, model)
	-- the land you can build on (grows with the house level)
	local buildArea = part({
		Name = "BuildArea",
		Size = Vector3.new(32, 0.42, 36),
		CFrame = at(0, 0.21, 0),
		Color = Color3.fromRGB(110, 170, 95),
		Material = Enum.Material.Grass,
		CanCollide = false,
	}, model)

	local shell = Instance.new("Folder")
	shell.Name = "Shell"
	shell.Parent = model

	-- lock forcefield in the entrance (only blocks while locked)
	local shield = part({
		Name = "Shield",
		Size = Vector3.new(GATE_HALF * 2, WALL_HEIGHT, 0.6),
		CFrame = at(0, WALL_HEIGHT / 2, -PLOT_HALF),
		Color = Color3.fromRGB(255, 80, 90),
		Material = Enum.Material.ForceField,
		Transparency = 1,
		CanCollide = false,
	}, model)

	-- nameplate on the front wall: owner's avatar + house name, facing the
	-- avenue (a real sign, so it never covers the owner's own screen)
	local signBoard = part({
		Name = "SignBoard",
		Size = Vector3.new(17, 7, 0.6),
		CFrame = at(-GATE_HALF - 11, 5.2, -PLOT_HALF - 0.9),
		Color = Color3.fromRGB(30, 32, 46),
		Material = Enum.Material.SmoothPlastic,
	}, model)
	local signGui = Instance.new("SurfaceGui")
	signGui.Name = "Sign"
	signGui.Face = Enum.NormalId.Front
	signGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	signGui.PixelsPerStud = 30
	signGui.LightInfluence = 0
	signGui.MaxDistance = 220
	local avatar = Instance.new("ImageLabel")
	avatar.Name = "Avatar"
	avatar.BackgroundColor3 = Color3.fromRGB(60, 64, 90)
	avatar.Size = UDim2.new(0, 170, 0, 170)
	avatar.Position = UDim2.new(0, 20, 0.5, 0)
	avatar.AnchorPoint = Vector2.new(0, 0.5)
	avatar.Image = ""
	local avatarCorner = Instance.new("UICorner")
	avatarCorner.CornerRadius = UDim.new(0.5, 0)
	avatarCorner.Parent = avatar
	avatar.Parent = signGui
	local sign = Instance.new("TextLabel")
	sign.Name = "Text"
	sign.BackgroundTransparency = 1
	sign.Size = UDim2.new(1, -220, 1, -20)
	sign.Position = UDim2.fromOffset(205, 10)
	sign.Font = Enum.Font.FredokaOne
	sign.TextScaled = true
	sign.RichText = true
	sign.TextColor3 = Color3.new(1, 1, 1)
	sign.TextXAlignment = Enum.TextXAlignment.Left
	local signStroke = Instance.new("UIStroke")
	signStroke.Thickness = 2
	signStroke.Parent = sign
	sign.Parent = signGui
	signGui.Parent = signBoard
	for _, x in { -GATE_HALF - 18.5, -GATE_HALF - 3.5 } do
		part({
			Name = "SignPost",
			Size = Vector3.new(0.6, 8.6, 0.6),
			CFrame = at(x, 4.3, -PLOT_HALF - 1.1),
			Color = Color3.fromRGB(70, 72, 92),
			Material = Enum.Material.Metal,
		}, model)
	end

	-- 👑 floating crown over the gate of the most liked house in the server
	local crown = Instance.new("Model")
	crown.Name = "Crown"
	local crownBase = part({
		Name = "CrownBase",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, 6, 6),
		CFrame = at(0, 24, -PLOT_HALF) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(255, 205, 60),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanQuery = false,
		Transparency = 1,
	}, crown)
	for i = 1, 5 do
		local angle = i / 5 * math.pi * 2
		part({
			Name = "CrownSpike",
			Size = Vector3.new(1, 2.4, 1),
			CFrame = at(math.cos(angle) * 2.5, 25.6, -PLOT_HALF + math.sin(angle) * 2.5) * CFrame.Angles(0, angle, 0),
			Color = Color3.fromRGB(255, 205, 60),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
			Transparency = 1,
		}, crown)
	end
	crown.PrimaryPart = crownBase
	crown.Parent = model

	-- like post on the avenue side of the gate
	local heart = part({
		Name = "LikeHeart",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 2.2,
		CFrame = at(GATE_HALF + 4, 4.4, -PLOT_HALF - 1.6),
		Color = Color3.fromRGB(255, 80, 120),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, model)
	part({
		Name = "LikePost",
		Size = Vector3.new(0.4, 3.4, 0.4),
		CFrame = at(GATE_HALF + 4, 1.7, -PLOT_HALF - 1.6),
		Color = Color3.fromRGB(240, 240, 245),
		Material = Enum.Material.Metal,
		CanCollide = false,
	}, model)
	setPrompt(heart, "❤️ Like", "House", "Visitor", 0, function(visitor)
		tryLike(visitor, index)
	end, 12)

	-- pads: collect (green) and lock (red), just inside the gate
	local collect = part({
		Name = "CollectPad",
		Size = Vector3.new(7, 0.4, 7),
		CFrame = at(-14, 0.45, -PLOT_HALF + 5),
		Color = Color3.fromRGB(70, 255, 130),
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
	}, model)
	local bankLabel = billboard(collect, 6.5, 2.2, 3, Color3.fromRGB(140, 255, 170), 40)
	local lockPad = part({
		Name = "LockPad",
		Size = Vector3.new(7, 0.4, 7),
		CFrame = at(14, 0.45, -PLOT_HALF + 5),
		Color = Color3.fromRGB(255, 80, 90),
		Material = Enum.Material.Neon,
		Transparency = 0.35,
		CanCollide = false,
	}, model)
	local lockLabel = billboard(lockPad, 6.5, 1.8, 2.8, Color3.fromRGB(255, 150, 150), 35)

	-- expand board (owner only): grow the house
	local board = part({
		Name = "ExpandBoard",
		Size = Vector3.new(5, 3.4, 0.4),
		CFrame = at(26, 3.2, -PLOT_HALF + 3),
		Color = Color3.fromRGB(120, 85, 55),
		Material = Enum.Material.WoodPlanks,
	}, model)
	part({
		Name = "ExpandPost",
		Size = Vector3.new(0.4, 1.6, 0.4),
		CFrame = at(26, 0.8, -PLOT_HALF + 3),
		Color = Color3.fromRGB(100, 70, 45),
		Material = Enum.Material.Wood,
	}, model)
	local expandLabel = billboard(board, 6, 2.2, 3, Color3.fromRGB(255, 220, 120), 30)

	model.Parent = World:Folder("Bases")
	local items = Instance.new("Folder")
	items.Name = "Items"
	items.Parent = model
	local displays = Instance.new("Folder")
	displays.Name = "Displays"
	displays.Parent = model

	return {
		Index = index,
		Model = model,
		CFrame = cf,
		Owner = nil,
		Floor = floor,
		BuildArea = buildArea,
		Shell = shell,
		Sign = sign,
		Avatar = avatar,
		Crown = crown,
		BankLabel = bankLabel,
		LockLabel = lockLabel,
		ExpandBoard = board,
		ExpandLabel = expandLabel,
		Shield = shield,
		CollectPad = collect,
		LockPad = lockPad,
		Items = items,
		Displays = displays,
		ItemModels = {}, -- [uid] = Model
		LockedUntil = 0,
		LockReadyAt = 0,
		ShieldUntil = 0,
		LastLabel = "",
		StyleKey = "",
	}
end

local HOUSE_PARTS = {
	House = true,
	Roof = true,
	Door = true,
	DoorKnob = true,
	Window = true,
	HouseTower = true,
	TowerRoof = true,
	Chimney = true,
	FlagPole = true,
	Flag = true,
}

-- walls, gate, border and aura in the owner's style
local function applyStyle(plot, data)
	local styleId, style = Util.HouseStyle(Config, data)
	local level = houseLevel(data)
	local roofIndex = tonumber(data.Base.Roof) or 0
	local key = styleId .. ":" .. level .. ":" .. roofIndex
	if plot.StyleKey == key then
		return
	end
	plot.StyleKey = key
	local shell = plot.Shell
	shell:ClearAllChildren()
	local cf = plot.CFrame
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end

	plot.Floor.Color = style.Ground
	plot.Floor.Material = material(style.GroundMaterial)
	local bounds = DecorModel.Bounds(Config, level)
	local w, d = bounds.MaxX - bounds.MinX, bounds.MaxZ - bounds.MinZ
	plot.BuildArea.Size = Vector3.new(w, 0.42, d)
	plot.BuildArea.CFrame = at((bounds.MinX + bounds.MaxX) / 2, 0.21, (bounds.MinZ + bounds.MaxZ) / 2)
	plot.BuildArea.Color = style.Ground:Lerp(Color3.new(1, 1, 1), 0.12)
	plot.BuildArea.Material = material(style.GroundMaterial)

	-- walls with a gap for the gate
	local wallMaterial = material(style.WallMaterial)
	local function wallSegment(x: number, z: number, sizeX: number, sizeZ: number)
		part({
			Name = "Wall",
			Size = Vector3.new(sizeX, WALL_HEIGHT, sizeZ),
			CFrame = at(x, WALL_HEIGHT / 2, z),
			Color = style.Wall,
			Material = wallMaterial,
			Transparency = style.WallTransparency or 0,
		}, shell)
		part({
			Name = "WallTrim",
			Size = Vector3.new(sizeX + 0.3, 0.6, sizeZ + 0.3),
			CFrame = at(x, WALL_HEIGHT + 0.3, z),
			Color = style.Trim,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		}, shell)
		if style.Stripes then
			part({
				Name = "Stripe",
				Size = Vector3.new(sizeX + 0.1, 1.2, sizeZ + 0.1),
				CFrame = at(x, WALL_HEIGHT * 0.55, z),
				Color = style.Stripes,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			}, shell)
		end
	end
	local side = PLOT_HALF - GATE_HALF
	wallSegment(0, PLOT_HALF, PLOT_HALF * 2, 1) -- back
	wallSegment(-PLOT_HALF, 0, 1, PLOT_HALF * 2) -- sides
	wallSegment(PLOT_HALF, 0, 1, PLOT_HALF * 2)
	wallSegment(-(GATE_HALF + side / 2), -PLOT_HALF, side, 1) -- front, gate in the middle
	wallSegment(GATE_HALF + side / 2, -PLOT_HALF, side, 1)

	-- corner towers + gate pillars and arch (taller with every level)
	local towerHeight = WALL_HEIGHT + 1.5 + level * 0.8
	for _, corner in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		part({
			Name = "Tower",
			Size = Vector3.new(2, towerHeight, 2),
			CFrame = at(corner[1] * PLOT_HALF, towerHeight / 2, corner[2] * PLOT_HALF),
			Color = style.Pillar,
			Material = wallMaterial,
		}, shell)
		part({
			Name = "TowerCap",
			Size = Vector3.new(3, 0.8, 3),
			CFrame = at(corner[1] * PLOT_HALF, towerHeight + 0.4, corner[2] * PLOT_HALF),
			Color = style.Trim,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		}, shell)
	end
	local gateHeight = WALL_HEIGHT + 4 + level
	for _, x in { -GATE_HALF - 0.9, GATE_HALF + 0.9 } do
		part({
			Name = "GatePillar",
			Size = Vector3.new(1.8, gateHeight, 1.8),
			CFrame = at(x, gateHeight / 2, -PLOT_HALF),
			Color = style.Pillar,
			Material = wallMaterial,
		}, shell)
	end
	part({
		Name = "GateArch",
		Size = Vector3.new(GATE_HALF * 2 + 3.6, 1.2, 1.4),
		CFrame = at(0, gateHeight - 0.6, -PLOT_HALF),
		Color = style.Trim,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	}, shell)

	-- the house itself at the back of the land (grows with the level)
	local roofColor = Config.Paint[roofIndex] or style.Trim
	local width = 13 + level * 3
	local depth = 10
	local height = if level >= 4 then 12 else 7.5
	local cz = PLOT_HALF - 1.5 - depth / 2
	local houseMaterial = if (style.WallTransparency or 0) > 0.2 then Enum.Material.SmoothPlastic else wallMaterial
	part({
		Name = "House",
		Size = Vector3.new(width, height, depth),
		CFrame = at(0, height / 2, cz),
		Color = style.Wall,
		Material = houseMaterial,
	}, shell)
	for i = 0, 3 do -- stepped roof in your colour
		part({
			Name = "Roof",
			Size = Vector3.new(width + 1.6 - i * 0.8, 1, depth + 1.6 - i * 2.8),
			CFrame = at(0, height + 0.5 + i, cz),
			Color = roofColor,
			Material = Enum.Material.SmoothPlastic,
		}, shell)
	end
	local front = cz - depth / 2 - 0.15
	part({
		Name = "Door",
		Size = Vector3.new(3.4, 5.6, 0.3),
		CFrame = at(0, 2.8, front),
		Color = Color3.fromRGB(110, 70, 45),
		Material = Enum.Material.WoodPlanks,
	}, shell)
	part({
		Name = "DoorKnob",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 0.45,
		CFrame = at(1.1, 2.8, front - 0.25),
		Color = Color3.fromRGB(255, 210, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, shell)
	local floors = if level >= 4 then { 3.8, 8.8 } else { 3.8 }
	for _, y in floors do
		for _, x in { -width / 2 + 3, width / 2 - 3, -width / 4 - 0.5, width / 4 + 0.5 } do
			if math.abs(x) > 3 or y > 5 then
				part({
					Name = "Window",
					Size = Vector3.new(2.4, 2.2, 0.3),
					CFrame = at(x, y, front),
					Color = Color3.fromRGB(255, 225, 150),
					Material = Enum.Material.Neon,
					Transparency = 0.15,
					CanCollide = false,
				}, shell)
			end
		end
	end
	if level >= 4 then
		-- castle towers
		for _, side in { -1, 1 } do
			local towerH = height + 5
			part({
				Name = "HouseTower",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(towerH, 4.4, 4.4),
				CFrame = at(side * (width / 2 + 1.6), towerH / 2, cz) * CFrame.Angles(0, 0, math.rad(90)),
				Color = style.Pillar,
				Material = houseMaterial,
			}, shell)
			for i = 0, 2 do
				part({
					Name = "TowerRoof",
					Size = Vector3.new(4.6 - i * 1.4, 1.2, 4.6 - i * 1.4),
					CFrame = at(side * (width / 2 + 1.6), towerH + 0.6 + i * 1.2, cz) * CFrame.Angles(0, math.rad(45), 0),
					Color = roofColor,
					Material = Enum.Material.SmoothPlastic,
				}, shell)
			end
		end
	else
		part({
			Name = "Chimney",
			Size = Vector3.new(1.6, 3.2, 1.6),
			CFrame = at(width / 2 - 3, height + 2.6, cz + 2),
			Color = style.Pillar,
			Material = houseMaterial,
		}, shell)
	end
	-- a flag in your roof colour on top
	part({
		Name = "FlagPole",
		Size = Vector3.new(0.3, 5, 0.3),
		CFrame = at(0, height + 6.5, cz),
		Color = Color3.fromRGB(235, 235, 240),
		Material = Enum.Material.Metal,
		CanCollide = false,
	}, shell)
	part({
		Name = "Flag",
		Size = Vector3.new(2.8, 1.6, 0.15),
		CFrame = at(1.5, height + 8, cz),
		Color = roofColor,
		Material = Enum.Material.Fabric,
		CanCollide = false,
	}, shell)

	-- the house can't be tapped through in build mode (taps reach the yard)
	for _, child in shell:GetChildren() do
		if child:IsA("BasePart") and HOUSE_PARTS[child.Name] then
			child.CanQuery = false
		end
	end

	-- border of the buildable land
	local edge = Color3.new(1, 1, 1):Lerp(style.Trim, 0.5)
	for _, strip in
		{
			{ (bounds.MinX + bounds.MaxX) / 2, bounds.MinZ, w, 0.3 },
			{ (bounds.MinX + bounds.MaxX) / 2, bounds.MaxZ, w, 0.3 },
			{ bounds.MinX, (bounds.MinZ + bounds.MaxZ) / 2, 0.3, d },
			{ bounds.MaxX, (bounds.MinZ + bounds.MaxZ) / 2, 0.3, d },
		}
	do
		part({
			Name = "Border",
			Size = Vector3.new(strip[3], 0.1, strip[4]),
			CFrame = at(strip[1], FLOOR_Y + 0.02, strip[2]),
			Color = edge,
			Material = Enum.Material.Neon,
			Transparency = 0.6,
			CanCollide = false,
			CanQuery = false,
		}, shell)
	end

	-- aura: fancy houses sparkle
	if style.Aura then
		local auraPart = part({
			Name = "Aura",
			Size = Vector3.new(PLOT_HALF * 2, 1, PLOT_HALF * 2),
			CFrame = at(0, WALL_HEIGHT + 3, 0),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
		}, shell)
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(style.Aura)
		emitter.LightEmission = 1
		emitter.Size = NumberSequence.new(0.45)
		emitter.Lifetime = NumberRange.new(2, 4)
		emitter.Rate = 4 + level * 3
		emitter.Speed = NumberRange.new(0.5, 1.5)
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Parent = auraPart
	end
end

---------------------------------------------------------------------------
-- pets on pedestals
---------------------------------------------------------------------------
local function arrange(data)
	return Util.ArrangePets(Config, data)
end

-- pets on display pedestals (the ones thieves can try to take)
function Base.DisplayedPets(data)
	local _, display = arrange(data)
	return display
end

function Base.VaultPets(data)
	local vault = arrange(data)
	return vault
end

-- coins per second of one pet for its owner (boosts included)
function Base:PetRate(player: Player, data, pet, inVault: boolean?): number
	local rate = Util.PetIncomeOf(Config, pet) * Services.StatsService:CoinMultiplier(player, data)
	if Services.MonetizationService:HasPass(player, "DoubleBase") then
		rate *= 2
	end
	rate *= 1 + Util.SetBonus(Config, data.Base.Items)
	rate *= 1 + Util.IndexBonus(Config, data) -- 📖 collection milestones + egg sets
	if inVault then
		rate *= SETTINGS.VaultIncome
	end
	return rate
end

function Base:IncomeRate(player: Player, data): number
	local total = 0
	local vault, display = arrange(data)
	for _, pet in vault do
		total += self:PetRate(player, data, pet, true)
	end
	for _, pet in display do
		total += self:PetRate(player, data, pet, false)
	end
	return total
end

---------------------------------------------------------------------------
-- rendering
---------------------------------------------------------------------------
local function itemCFrame(plot, item): CFrame
	return plot.CFrame * CFrame.new(item.X, FLOOR_Y + 0.1, item.Z) * CFrame.Angles(0, (item.R or 0) * math.pi / 2, 0)
end

local onTrap, onJump -- forward declarations

local function renderItem(plot, item)
	local existing = plot.ItemModels[item.Uid]
	if existing then
		existing:Destroy()
	end
	local model = DecorModel.Build(Config, item.Id, item.Paint)
	model:PivotTo(itemCFrame(plot, item))
	model:SetAttribute("Uid", item.Uid)
	model:SetAttribute("DecorId", item.Id)
	model.Parent = plot.Items
	plot.ItemModels[item.Uid] = model
	local def = Config.Decor[item.Id]
	local trigger = model:FindFirstChild("Trigger")
	if trigger and trigger:IsA("BasePart") and def then
		trigger.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if not player then
				return
			end
			if def.Function == "Trap" then
				onTrap(plot, model, player)
			elseif def.Function == "Jump" then
				onJump(player, model)
			end
		end)
	end
end

-- level-ups: new numbers on the pedestal labels, no re-render (a re-render
-- would also cancel steals in progress)
function Base:RefreshPetLabels(player: Player)
	local plot = plotOf[player]
	local data = Data:Get(player)
	if not plot or not data then
		return
	end
	for _, petModel in plot.Displays:GetChildren() do
		local id = petModel:GetAttribute("PetId")
		local pet = type(id) == "number" and id > 0 and Services.PetService.FindPet(data, id)
		local anchor = petModel:IsA("Model") and petModel.PrimaryPart
		local gui = anchor and anchor:FindFirstChildOfClass("BillboardGui")
		local label = gui and gui:FindFirstChildOfClass("TextLabel")
		if pet and label then
			local inVault = petModel:GetAttribute("Vault") == true
			local info = Config.Pets[pet.Name]
			local icon = if inVault then "🔒" elseif info and info.Exclusive then "💎" else "🌠"
			local serial = if pet.Serial then " #" .. tostring(pet.Serial) else ""
			local rate = Util.Format(self:PetRate(player, data, pet, inVault))
			local badge = Util.PetBadge(Config, pet)
			if pet.Variant then
				World.SetText(label, "%s %s %s%s\n%s  💰 %s/s", icon, pet.Variant, pet.Name, serial, badge, rate)
			else
				World.SetText(label, "%s %s%s\n%s  💰 %s/s", icon, pet.Name, serial, badge, rate)
			end
		end
	end
	self:RefreshLabels(player)
end

function Base:RenderDisplays(player: Player)
	local plot = plotOf[player]
	local data = Data:Get(player)
	if not plot or not data then
		return
	end
	plot.Displays:ClearAllChildren()
	local vault, display = arrange(data)
	local displayItems, vaultItems = Util.Pedestals(Config, data.Base.Items)
	local function put(pedestal, pet, inVault: boolean)
		local model = plot.ItemModels[pedestal.Uid]
		local top = model and model:FindFirstChild("Top")
		if not top or not top:IsA("BasePart") or not pet then
			return
		end
		local info = Config.Pets[pet.Name]
		local rarity = Config.Rarities[info.Rarity] or Config.Rarities.Common
		local exclusive = info.Exclusive == true
		local petModel = PetModel.Build(pet.Name, pet.Variant, { Level = Util.PetLevel(pet), Stars = Util.PetStars(pet) })
		petModel.Name = "Pet_" .. pet.Id
		petModel:PivotTo(CFrame.new(top.Position + Vector3.new(0, 1.6, 0)) * (top.CFrame - top.Position))
		-- big (huge) pets stand on the pedestal instead of sinking into it
		local boxCFrame, boxSize = petModel:GetBoundingBox()
		local lift = (top.Position.Y + 0.2) - (boxCFrame.Position.Y - boxSize.Y / 2)
		if lift > 0 then
			petModel:PivotTo(petModel:GetPivot() + Vector3.new(0, lift, 0))
		end
		petModel:SetAttribute("Spin", true)
		petModel:SetAttribute("PetId", pet.Id)
		petModel:SetAttribute("Vault", inVault)
		petModel.Parent = plot.Displays
		local anchor = petModel.PrimaryPart :: BasePart
		local _, size = petModel:GetBoundingBox()
		local label = billboard(anchor, 5.5, 1.7, size.Y + 1, rarity.Color, 40)
		local rate = Util.Format(self:PetRate(player, data, pet, inVault))
		local icon = if inVault then "🔒" elseif exclusive then "💎" else "🌠"
		local serial = if pet.Serial then " #" .. tostring(pet.Serial) else ""
		local badge = Util.PetBadge(Config, pet)
		if pet.Variant then
			World.SetText(label, "%s %s %s%s\n%s  💰 %s/s", icon, pet.Variant, pet.Name, serial, badge, rate)
		else
			World.SetText(label, "%s %s%s\n%s  💰 %s/s", icon, pet.Name, serial, badge, rate)
		end
		local petId = pet.Id
		if not inVault and not exclusive then
			setPrompt(anchor, "Steal", pet.Name, "Thief", SETTINGS.StealHold, function(thief)
				Base:TrySteal(thief, player, petId)
			end)
		end
		setPrompt(anchor, "Sell", pet.Name, "Owner", 0.6, function(who)
			if who == player then
				Base:SellPet(player, petId)
			end
		end)
	end
	for slot, pedestal in vaultItems do
		put(pedestal, vault[slot], true)
	end
	for slot, pedestal in displayItems do
		put(pedestal, display[slot], false)
	end
	-- 🎭 prank pets: they look like a jackpot, but grabbing one is a trap
	for _, item in data.Base.Items do
		local def = Config.Decor[item.Id]
		local model = def and def.Function == "Decoy" and plot.ItemModels[item.Uid]
		local top = model and model:FindFirstChild("Top")
		if top and top:IsA("BasePart") then
			local fake = def.Fake
			-- (looks grown like real pets: no giveaway)
			local fakeGrowth = { Level = 4 + item.Uid % 7, Stars = if item.Uid % 3 == 0 then 1 else 0 }
			local petModel = PetModel.Build(fake.Name, fake.Variant, fakeGrowth)
			petModel.Name = "Decoy_" .. item.Uid
			petModel:PivotTo(CFrame.new(top.Position + Vector3.new(0, 1.6, 0)) * (top.CFrame - top.Position))
			local boxCFrame, boxSize = petModel:GetBoundingBox()
			local lift = (top.Position.Y + 0.2) - (boxCFrame.Position.Y - boxSize.Y / 2)
			if lift > 0 then
				petModel:PivotTo(petModel:GetPivot() + Vector3.new(0, lift, 0))
			end
			petModel:SetAttribute("Spin", true)
			petModel:SetAttribute("PetId", -item.Uid) -- bounces like a real pet (no giveaway)
			petModel.Parent = plot.Displays
			local anchor = petModel.PrimaryPart :: BasePart
			local info = Config.Pets[fake.Name]
			local rarity = Config.Rarities[info.Rarity] or Config.Rarities.Common
			local label = billboard(anchor, 5.5, 1.7, boxSize.Y + 1, rarity.Color, 40)
			local fakePet = { Name = fake.Name, Variant = fake.Variant, Level = fakeGrowth.Level, Stars = fakeGrowth.Stars }
			local fakeRate = Util.Format(Util.PetIncomeOf(Config, fakePet))
			World.SetText(label, "%s %s %s%s\n%s  💰 %s/s", "🌠", fake.Variant, fake.Name, "", Util.PetBadge(Config, fakePet), fakeRate)
			local decoyModel = model
			setPrompt(anchor, "Steal", fake.Name, "Thief", SETTINGS.StealHold, function(thief)
				Base:SpringDecoy(player, thief, decoyModel)
			end)
		end
	end
	-- pets in storage walk around the yard (clients render them, see YardPets)
	local yard, shown = {}, {}
	for _, pet in vault do
		shown[pet] = true
	end
	for _, pet in display do
		shown[pet] = true
	end
	local storage = {}
	for _, pet in data.Pets do
		if not shown[pet] and not pet.Away and Config.Pets[pet.Name] then
			table.insert(storage, pet)
		end
	end
	table.sort(storage, function(a, b)
		return Util.PetIncomeOf(Config, a) > Util.PetIncomeOf(Config, b)
	end)
	for i = 1, math.min(SETTINGS.YardPets, #storage) do
		table.insert(yard, (storage[i].Variant or "") .. "|" .. storage[i].Name)
	end
	plot.Model:SetAttribute("Yard", HttpService:JSONEncode(yard))
	self:RefreshLabels(player, true)
end

-- a thief grabbed a prank pet: confetti, a launch, a short stun, a laugh
local decoyReady = {} -- [model] = os.clock()
local prankCounted = {} -- ["thief:owner"] = os.clock() (one counted prank per pair per 5 min)
function Base:SpringDecoy(owner: Player, thief: Player, model: Model)
	if thief == owner or not owner.Parent or not model.Parent then
		return
	end
	-- same rules as a real steal: protected houses can't be "robbed" at all
	if not plotOf[thief] or Services.ShardService:IsCarrying(thief) or self:Protection(owner) ~= nil then
		return
	end
	if (decoyReady[model] or 0) > os.clock() then
		return
	end
	decoyReady[model] = os.clock() + 6
	model.AncestryChanged:Once(function()
		decoyReady[model] = nil
	end)
	Services.CharacterService:Stun(thief, 2)
	Net:Send(thief, "Stunned", 2)
	Net:Send(thief, "Launch", Vector3.new(0, 120, 0))
	Net:Broadcast("Confetti", model:GetPivot().Position)
	Net:Notify(thief, "🎭 It was a PRANK PET! 😂", Color3.fromRGB(255, 170, 90))
	Net:Notify(owner, "😂 %s fell for your prank pet!", Color3.fromRGB(255, 200, 90), thief.DisplayName)
	local key = thief.UserId .. ":" .. owner.UserId
	if os.clock() - (prankCounted[key] or -1e9) < 300 then
		return
	end
	prankCounted[key] = os.clock()
	local data = Data:Get(owner)
	if data then
		data.Stats.Pranks = (data.Stats.Pranks or 0) + 1
		Data:MarkDirty(owner)
	end
	Net:Announce("🎭 %s got pranked by %s's fake pet!", Color3.fromRGB(255, 190, 90), thief.DisplayName, owner.DisplayName)
end

function Base:Render(player: Player)
	local plot = plotOf[player]
	local data = Data:Get(player)
	if not plot or not data then
		return
	end
	applyStyle(plot, data)
	for _, model in plot.ItemModels do
		model:Destroy()
	end
	plot.ItemModels = {}
	for _, item in data.Base.Items do
		if Config.Decor[item.Id] then
			renderItem(plot, item)
		end
	end
	self:RenderDisplays(player)
end

---------------------------------------------------------------------------
-- protection
---------------------------------------------------------------------------
-- seconds of newbie shield left (0 = none)
function Base:NewbieShield(player: Player, data): number
	data = data or Data:Get(player)
	if not data or data.Flags.NewbieOff then
		return 0
	end
	return math.max(0, SETTINGS.NewbieShieldSeconds - (data.Stats.PlaySeconds or 0))
end

local function beingRobbed(data): boolean
	for _, pet in data.Pets do
		if pet.Away then
			return true
		end
	end
	return false
end

-- why this base can't be robbed right now (nil = it can)
function Base:Protection(owner: Player): string?
	local plot = plotOf[owner]
	local data = Data:Get(owner)
	if not plot or not data then
		return "none"
	end
	local t = now()
	if beingRobbed(data) then
		return "robbing"
	end
	-- 🏠 homes are safe - raids only happen on 🌙 Thief Night
	-- (a thief's own home stays open to their victim's revenge for a while)
	local events = Services.EventService
	if not (events and events:RaidActive()) then
		for _, entry in revenge do
			if entry.Target == owner and entry.Until > t then
				return "revenge"
			end
		end
		return "safe"
	end
	if plot.LockedUntil > t then
		return "locked"
	end
	if self:NewbieShield(owner, data) > 0 then
		return "newbie"
	end
	if plot.ShieldUntil > t then
		return "shield"
	end
	return nil
end

function Base:IsLocked(owner: Player): boolean
	local plot = plotOf[owner]
	return plot ~= nil and plot.LockedUntil > now()
end

function Base:LockSeconds(player: Player, data): number
	local bonus = math.min((data.Rebirths or 0) * SETTINGS.LockPerRebirth, SETTINGS.LockMaxBonus)
	if hasVip(player) then
		bonus += SETTINGS.LockVipBonus
	end
	return SETTINGS.LockSeconds + bonus
end

-- active revenge of `victim` against `target`?
function Base:HasRevenge(victim: Player, target: Player): boolean
	local entry = revenge[victim]
	return entry ~= nil and entry.Target == target and entry.Until > now()
end

-- current bounty on a thief (coins), pruning old thefts
function Base:Bounty(thief: Player): number
	local log = thefts[thief]
	if not log then
		return 0
	end
	local t = now()
	local kept, victims, value = {}, {}, 0
	for _, entry in log do
		if t - entry.Time <= SETTINGS.Bounty.WindowSeconds then
			table.insert(kept, entry)
			victims[entry.Victim] = true
			value += entry.Value
		end
	end
	thefts[thief] = if #kept > 0 then kept else nil
	local distinct = 0
	for _ in victims do
		distinct += 1
	end
	return if distinct >= SETTINGS.Bounty.MinVictims then math.floor(value) else 0
end

local STATUS_TEXT = {
	safe = "🏠 SAFE",
	revenge = "🎯 REVENGE TARGET",
	locked = "🔒 LOCKED",
	newbie = "🛡️ NEWBIE SHIELD",
	shield = "🛡️ THEFT SHIELD",
	robbing = "🚨 BEING ROBBED!",
}

function Base:RefreshLabels(player: Player, force: boolean?)
	local plot = plotOf[player]
	local data = Data:Get(player)
	if not plot or not data then
		return
	end
	local rate = self:IncomeRate(player, data)
	local vault, display = arrange(data)
	local stored = math.max(0, #data.Pets - #vault - #display)
	local level = houseLevel(data)
	local protection = self:Protection(player)
	local status = STATUS_TEXT[protection or ""] or "🔓 OPEN"
	local customName = houseNames[player]
	local signText = table.concat({ Util.Format(rate), data.Base.Likes, level, status, customName or "" }, "|")
	if force or signText ~= plot.LastLabel then
		plot.LastLabel = signText
		local _, style = Util.HouseStyle(Config, data)
		plot.Sign.TextColor3 = Color3.new(1, 1, 1):Lerp(style.Trim, 0.35)
		if customName and customName ~= "" then
			World.SetText(
				plot.Sign,
				"🏠 %s\n💰 %s/s  ❤️ %s  ⭐ Lv.%s\n%s",
				customName,
				Util.Format(rate),
				tostring(data.Base.Likes),
				tostring(level),
				status
			)
		else
			World.SetText(
				plot.Sign,
				"🏠 %s's HOUSE\n💰 %s/s  ❤️ %s  ⭐ Lv.%s\n%s",
				player.DisplayName,
				Util.Format(rate),
				tostring(data.Base.Likes),
				tostring(level),
				status
			)
		end
		local nextLevel = SETTINGS.Levels[level + 1]
		if nextLevel then
			World.SetText(plot.ExpandLabel, "🏗️ EXPAND\nLv.%s 💰%s", tostring(level + 1), Util.Format(nextLevel.Cost))
		else
			World.SetText(plot.ExpandLabel, "🏰 MAX LEVEL")
		end
		local model = plot.Model
		model:SetAttribute("HouseName", customName or "")
		model:SetAttribute("OwnerName", player.DisplayName)
		model:SetAttribute("HouseLevel", level)
		model:SetAttribute("Likes", data.Base.Likes)
		model:SetAttribute("Rate", math.floor(rate))
	end
	World.SetText(plot.BankLabel, "💰 %s\nSTEP TO COLLECT", Util.Format(math.floor(data.Base.Bank)))
	local t = now()
	if plot.LockedUntil > t then
		World.SetText(plot.LockLabel, "🔒 LOCKED %ds", math.ceil(plot.LockedUntil - t))
	elseif plot.LockReadyAt > t then
		World.SetText(plot.LockLabel, "⏳ %ds", math.ceil(plot.LockReadyAt - t))
	else
		World.SetText(plot.LockLabel, "🔒 LOCK BASE")
	end
	-- shield bubble: red = locked (blocks the gate), blue = protected
	if protection == "locked" then
		plot.Shield.Color = Color3.fromRGB(255, 80, 90)
		plot.Shield.Transparency = 0.3
		plot.Shield.CanCollide = true -- the owner's client turns this off locally
	elseif protection == "newbie" or protection == "shield" then
		plot.Shield.Color = Color3.fromRGB(90, 190, 255)
		plot.Shield.Transparency = 0.55
		plot.Shield.CanCollide = false
	else
		plot.Shield.Transparency = 1
		plot.Shield.CanCollide = false
	end
	plot.Model:SetAttribute("Protection", protection or "")
	plot.Model:SetAttribute("Robbing", beingRobbed(data))
	player:SetAttribute("BaseRate", rate)
	player:SetAttribute("BaseBank", math.floor(data.Base.Bank))
	player:SetAttribute("BaseStored", stored)
	player:SetAttribute("BaseProtection", protection or "")
	player:SetAttribute("NewbieShield", self:NewbieShield(player, data))
	player:SetAttribute("ShieldUntil", plot.ShieldUntil)
	player:SetAttribute("LockedUntil", plot.LockedUntil)
	local bounty = self:Bounty(player)
	if (player:GetAttribute("Bounty") or 0) ~= bounty then
		player:SetAttribute("Bounty", if bounty > 0 then bounty else nil)
	end
end

local function clearPlot(plot)
	plot.Owner = nil
	plot.Avatar.Image = ""
	plot.Model:SetAttribute("Yard", "[]")
	plot.Model:SetAttribute("BestHouse", false)
	for _, crownPart in plot.Crown:GetChildren() do
		if crownPart:IsA("BasePart") then
			crownPart.Transparency = 1
		end
	end
	for _, model in plot.ItemModels do
		model:Destroy()
	end
	plot.ItemModels = {}
	plot.Displays:ClearAllChildren()
	plot.Shell:ClearAllChildren()
	plot.StyleKey = ""
	local model = plot.Model
	model:SetAttribute("OwnerId", 0)
	model:SetAttribute("LockedUntil", 0)
	model:SetAttribute("ShieldUntil", 0)
	model:SetAttribute("Protection", "")
	model:SetAttribute("HouseName", "")
	model:SetAttribute("OwnerName", "")
	model:SetAttribute("Likes", 0)
	model:SetAttribute("Rate", 0)
	plot.LockedUntil = 0
	plot.LockReadyAt = 0
	plot.ShieldUntil = 0
	plot.Shield.Transparency = 1
	plot.Shield.CanCollide = false
	plot.LastLabel = ""
	plot.Floor.Color = Color3.fromRGB(90, 150, 80)
	plot.Floor.Material = Enum.Material.Grass
	World.SetText(plot.Sign, "🏠 FREE LAND")
	World.SetText(plot.BankLabel, "")
	World.SetText(plot.LockLabel, "")
	World.SetText(plot.ExpandLabel, "")
end

---------------------------------------------------------------------------
-- public API (used by ShardService / MiningService / UI)
---------------------------------------------------------------------------
function Base:PlotOf(player: Player)
	return plotOf[player]
end

-- (RivalHomes builds rival players' homes with the same parts)
Base.Internal = {
	Plots = plots,
	ApplyStyle = applyStyle,
	SetPrompt = setPrompt,
	Billboard = billboard,
	ClearPlot = clearPlot,
	PlotHalf = PLOT_HALF,
}

function Base:HasBase(player: Player): boolean
	return plotOf[player] ~= nil
end

-- is this position inside the player's own territory?
function Base:InOwnPlot(player: Player, position: Vector3): boolean
	local plot = plotOf[player]
	if not plot then
		return false
	end
	local localPos = plot.CFrame:PointToObjectSpace(position)
	return math.abs(localPos.X) <= PLOT_HALF and math.abs(localPos.Z) <= PLOT_HALF + 1
end

function Base:HomeCFrame(player: Player): CFrame?
	local plot = plotOf[player]
	return plot and (plot.CFrame * CFrame.new(0, 3, -PLOT_HALF + 5))
end

-- just outside the gate, looking in (for visitors)
function Base:GateCFrame(owner: Player): CFrame?
	local plot = plotOf[owner]
	if not plot then
		return nil
	end
	local spot = plot.CFrame * CFrame.new(0, 3, -PLOT_HALF - 8)
	return CFrame.lookAt(spot.Position, (plot.CFrame * CFrame.new(0, 3, 0)).Position)
end

-- a pet is being carried away by a thief (or came back)
function Base:SetAway(owner: Player, petId: number, away: boolean)
	local data = Data:Get(owner)
	local pet = data and Services.PetService.FindPet(data, petId)
	if not pet then
		return
	end
	pet.Away = if away then true else nil
	if owner.Parent then
		Services.PetService:Changed(owner)
	end
end

function Base:SellPet(player: Player, petId: number)
	local data = Data:Get(player)
	local pet, index = nil, nil
	if data then
		pet, index = Services.PetService.FindPet(data, petId)
	end
	if not pet or pet.Away or pet.SerialPending then
		return
	end
	local coins = Services.PetService:SellValueOf(pet)
	table.remove(data.Pets, index)
	data.Coins += coins
	data.Stats.LifetimeCoins += coins
	Net:Notify(player, "Sold %s for 💰%s", Color3.fromRGB(255, 220, 120), pet.Name, Util.Format(coins))
	Services.PetService:Changed(player)
end

local PROTECTION_MESSAGES = {
	safe = "🏠 Homes are safe! Raids only happen on 🌙 Thief Night.",
	revenge = "🏠 Homes are safe! Raids only happen on 🌙 Thief Night.",
	locked = "🔒 This base is locked!",
	newbie = "🛡️ This player is new - their base is protected for now.",
	shield = "🛡️ This base was just robbed - it's protected for a few minutes.",
	robbing = "Someone is already stealing from this base!",
	none = "You can't steal here.",
}

function Base:TrySteal(thief: Player, owner: Player, petId: number)
	if thief == owner or not owner.Parent then
		return
	end
	local shards = Services.ShardService
	if shards:IsCarrying(thief) then
		Net:Notify(thief, "Your hands are full!")
		return
	end
	if not plotOf[thief] then
		Net:Notify(thief, "You need a base to steal pets!")
		return
	end
	local data = Data:Get(owner)
	local thiefData = Data:Get(thief)
	local pet = data and Services.PetService.FindPet(data, petId)
	if not pet or pet.Away or not thiefData then
		return
	end
	local isRevenge = self:HasRevenge(thief, owner)
	-- one theft at a time, always (revenge too)
	if beingRobbed(data) then
		Net:Notify(thief, PROTECTION_MESSAGES.robbing)
		return
	end
	-- revenge ignores locks and shields
	local protection = self:Protection(owner)
	if protection and not (isRevenge and protection ~= "none") then
		Net:Notify(thief, PROTECTION_MESSAGES[protection] or PROTECTION_MESSAGES.none)
		return
	end
	if pet.SerialPending then
		return -- (numbering a brand-new pet takes a second)
	end
	if Util.IsExclusive(Config, pet) then
		Net:Notify(thief, "💎 Exclusive pets can't be stolen!")
		return
	end
	local onDisplay = false
	for _, shown in self.DisplayedPets(data) do
		if shown.Id == petId then
			onDisplay = true
		end
	end
	if not onDisplay then
		Net:Notify(thief, "🔒 Pets in a vault can't be stolen!")
		return
	end
	-- fair play: big players can't farm tiny bases
	if not isRevenge then
		local thiefWorth = Util.PetWorth(Config, thiefData)
		local victimWorth = Util.PetWorth(Config, data)
		if thiefWorth >= SETTINGS.StealGapMinWorth and thiefWorth > victimWorth * SETTINGS.StealGap then
			Net:Notify(thief, "This base is too small for you - pick on someone your size!")
			return
		end
	end
	self:SetAway(owner, petId, true)
	local item = { Kind = "Pet", Name = pet.Name, Variant = pet.Variant, Serial = pet.Serial }
	local meta = {
		From = owner,
		PetId = petId,
		Thief = thief,
		Revenge = isRevenge,
		-- nobody can hold a stolen pet forever (that would block the base)
		Deadline = os.clock() + SETTINGS.StolenCarrySeconds,
	}
	if not shards:StartCarry(thief, item, meta) then
		self:SetAway(owner, petId, false)
		return
	end
	-- stealing ends your own newbie shield
	if self:NewbieShield(thief, thiefData) > 0 then
		thiefData.Flags.NewbieOff = true
		Net:Notify(thief, "🛡️ You stole - your newbie shield is now off.", Color3.fromRGB(150, 200, 255))
	end
	local display = pet.Name
	Net:Send(owner, "BaseAlarm", thief.DisplayName, display)
	Net:Notify(owner, "🚨 %s is stealing your %s! Bonk them!", Color3.fromRGB(255, 80, 80), thief.DisplayName, display)
	Net:Notify(thief, "🏃 You stole a %s! Run to your base!", Color3.fromRGB(255, 170, 80), display)
	self:RefreshLabels(owner, true)
end

-- a stolen pet reached the thief's base (called by ShardService)
function Base:StealDelivered(owner: Player, thief: Player, meta, pet)
	local plot = plotOf[owner]
	if plot then
		plot.ShieldUntil = now() + SETTINGS.TheftShieldSeconds
		plot.Model:SetAttribute("ShieldUntil", plot.ShieldUntil)
	end
	if meta and meta.Revenge and meta.Thief == thief then
		revenge[thief] = nil
		thief:SetAttribute("RevengeTarget", nil)
		thief:SetAttribute("RevengeUntil", nil)
		Net:Notify(thief, "🎯 Revenge complete!", Color3.fromRGB(255, 210, 90))
	else
		-- the victim may strike back
		if owner.Parent then
			revenge[owner] = { Target = thief, Until = now() + SETTINGS.RevengeSeconds }
			owner:SetAttribute("RevengeTarget", thief.UserId)
			owner:SetAttribute("RevengeUntil", now() + SETTINGS.RevengeSeconds)
			Net:Send(owner, "Revenge", thief.UserId, thief.DisplayName, now() + SETTINGS.RevengeSeconds)
			Net:Notify(
				owner,
				"🎯 REVENGE! For 5 minutes you can raid %s's base - locks can't stop you!",
				Color3.fromRGB(255, 210, 90),
				thief.DisplayName
			)
		end
		-- serial thieves get a bounty
		local before = self:Bounty(thief)
		thefts[thief] = thefts[thief] or {}
		local value = Util.PetIncomeOf(Config, pet) * SETTINGS.Bounty.IncomeSeconds
		table.insert(thefts[thief], { Victim = owner.UserId, Time = now(), Value = value })
		local after = self:Bounty(thief)
		if after > 0 then
			thief:SetAttribute("Bounty", after)
			if before == 0 then
				Net:Announce(
					"💰 BOUNTY! %s robbed too many houses - bonk them while they carry a pet to win 💰%s!",
					Color3.fromRGB(255, 200, 60),
					thief.DisplayName,
					Util.Format(after)
				)
			end
		end
	end
	if owner.Parent then
		self:RefreshLabels(owner, true)
	end
end

-- someone stopped a thief (bonk or trap): count it + pay the bounty
function Base:ThiefCaught(hunter: Player, thief: Player, count: boolean?)
	if hunter == thief then
		return
	end
	local data = Data:Get(hunter)
	if not data then
		return
	end
	if count ~= false then
		data.Stats.ThievesCaught = (data.Stats.ThievesCaught or 0) + 1
	end
	local bounty = self:Bounty(thief)
	if bounty > 0 then
		thefts[thief] = nil
		thief:SetAttribute("Bounty", nil)
		data.Coins += bounty
		data.Stats.LifetimeCoins += bounty
		Services.Analytics:Economy(hunter, "Source", "Coins", bounty, data.Coins, "Gameplay", "Bounty")
		Net:Send(hunter, "Sold", bounty)
		Net:Announce(
			"💰 %s caught %s and won the 💰%s bounty!",
			Color3.fromRGB(255, 200, 60),
			hunter.DisplayName,
			thief.DisplayName,
			Util.Format(bounty)
		)
	end
	Data:MarkDirty(hunter)
end

function Base:Collect(player: Player)
	local data = Data:Get(player)
	if not data then
		return
	end
	local amount = math.floor(data.Base.Bank)
	if amount <= 0 then
		return
	end
	data.Base.Bank -= amount
	data.Coins += amount
	data.Stats.LifetimeCoins += amount
	Services.ProgressionService:AddQuest(player, "Collect", 1)
	Services.Analytics:Economy(player, "Source", "Coins", amount, data.Coins, "Gameplay", "BaseCollect")
	Net:Send(player, "BaseCollected", amount)
	Data:MarkDirty(player)
	self:RefreshLabels(player)
end

local function lockFor(plot, seconds: number)
	plot.LockedUntil = now() + seconds
	plot.LockReadyAt = plot.LockedUntil
	plot.Model:SetAttribute("LockedUntil", plot.LockedUntil)
end

function Base:Lock(player: Player)
	local plot = plotOf[player]
	local data = Data:Get(player)
	if not plot or not data then
		return
	end
	local t = now()
	if plot.LockedUntil > t or plot.LockReadyAt > t then
		return
	end
	local events = Services.EventService
	if not (events and events:RaidActive()) then
		-- (don't waste the lock: homes can only be raided on Thief Night)
		if debounced(player, "lockhint", 8) then
			return
		end
		Net:Notify(player, "🏠 Your home is safe right now - save the lock for 🌙 Thief Night!", Color3.fromRGB(150, 230, 160))
		return
	end
	local seconds = self:LockSeconds(player, data)
	lockFor(plot, seconds)
	plot.LockReadyAt = plot.LockedUntil + SETTINGS.LockCooldown
	Net:Notify(player, "🔒 Base locked for %ds!", Color3.fromRGB(255, 150, 150), seconds)
	self:RefreshLabels(player, true)
end

---------------------------------------------------------------------------
-- decorating
---------------------------------------------------------------------------
local function findItem(data, uid)
	for index, item in data.Base.Items do
		if item.Uid == uid then
			return item, index
		end
	end
	return nil, nil
end

local function finite(value): boolean
	return type(value) == "number" and value == value and math.abs(value) < 1e6
end

local function cleanTransform(x, z, r): (number?, number?, number?)
	-- NaN / inf would end up in the save (DataStores can't store them)
	if not finite(x) or not finite(z) or not finite(r) then
		return nil, nil, nil
	end
	local rotation = math.floor(r) % 4
	if rotation ~= rotation then
		return nil, nil, nil
	end
	return x, z, rotation
end

local function isPedestal(id: string): boolean
	local def = Config.Decor[id]
	return def ~= nil and (def.Function == "Pedestal" or def.Function == "Vault" or def.Function == "Decoy")
end

-- returns ok, message
function Base:Place(player: Player, id, x, z, r): (boolean, string?)
	local data = Data:Get(player)
	local plot = plotOf[player]
	local def = type(id) == "string" and Config.Decor[id]
	x, z, r = cleanTransform(x, z, r)
	if not data or not plot or not def or not x then
		return false, "Can't place that here"
	end
	x, z = DecorModel.Snap(Config, id, x, z, r)
	local items = data.Base.Items
	local ok, reason = DecorModel.Validate(Config, items, id, x, z, r, nil, validateOpts(player, data))
	if not ok then
		return false, reason
	end
	local currency, price = DecorModel.Price(Config, id, items)
	local have = if currency == "Gems" then data.Gems else data.Coins
	if have < price then
		return false, if currency == "Gems" then "Not enough gems!" else "Not enough coins!"
	end
	if currency == "Gems" then
		data.Gems -= price
	else
		data.Coins -= price
	end
	local item = { Uid = data.Base.NextUid, Id = id, X = x, Z = z, R = r, Paid = price, Cur = currency }
	data.Base.NextUid += 1
	table.insert(items, item)
	renderItem(plot, item)
	if isPedestal(id) then
		self:RenderDisplays(player)
	end
	Services.ProgressionService:AddQuest(player, "Decorate", 1)
	Data:MarkDirty(player)
	self:RefreshLabels(player, true)
	return true, nil
end

function Base:Move(player: Player, uid, x, z, r): (boolean, string?)
	local data = Data:Get(player)
	local plot = plotOf[player]
	local item = data and type(uid) == "number" and findItem(data, uid)
	x, z, r = cleanTransform(x, z, r)
	if not item or not plot or not x then
		return false, "Can't move that"
	end
	x, z = DecorModel.Snap(Config, item.Id, x, z, r)
	local ok, reason = DecorModel.Validate(Config, data.Base.Items, item.Id, x, z, r, item.Uid, validateOpts(player, data))
	if not ok then
		return false, reason
	end
	item.X, item.Z, item.R = x, z, r
	renderItem(plot, item)
	if isPedestal(item.Id) then
		self:RenderDisplays(player)
	end
	Data:MarkDirty(player)
	return true, nil
end

function Base:Remove(player: Player, uid): (boolean, string?)
	local data = Data:Get(player)
	local plot = plotOf[player]
	local item, index = nil, nil
	if data and type(uid) == "number" then
		item, index = findItem(data, uid)
	end
	if not item or not plot then
		return false, "Can't remove that"
	end
	local def = Config.Decor[item.Id]
	if def and def.Function == "Pedestal" and DecorModel.Count(data.Base.Items, "Pedestal") <= 1 then
		return false, "Keep at least one pedestal!"
	end
	table.remove(data.Base.Items, index)
	local refund = math.max(0, math.floor(item.Paid or 0))
	if item.Cur == "Gems" then
		data.Gems += refund
	else
		data.Coins += refund
	end
	local model = plot.ItemModels[item.Uid]
	plot.ItemModels[item.Uid] = nil
	if model then
		model:Destroy()
	end
	if isPedestal(item.Id) then
		self:RenderDisplays(player)
	end
	Data:MarkDirty(player)
	self:RefreshLabels(player, true)
	return true, nil
end

-- 🎨 paint: 0 = original colours, 1..#Config.Paint = palette colour (free)
function Base:Paint(player: Player, uid, color): (boolean, string?)
	local data = Data:Get(player)
	local plot = plotOf[player]
	local item = data and type(uid) == "number" and findItem(data, uid)
	if not item or not plot or not finite(color) then
		return false, "Can't paint that"
	end
	color = math.floor(color)
	if color < 0 or color > #Config.Paint or not DecorModel.CanPaint(item.Id) then
		return false, "Can't paint that"
	end
	item.Paint = if color == 0 then nil else color
	renderItem(plot, item)
	if isPedestal(item.Id) then
		self:RenderDisplays(player)
	end
	Data:MarkDirty(player)
	return true, nil
end

-- 🐾 tidy up: all pedestals line up in neat rows (vaults at the back near the
-- house, display pedestals in front). Nothing else moves; all or nothing.
function Base:ArrangePedestals(player: Player): (boolean, string?)
	local data = Data:Get(player)
	local plot = plotOf[player]
	if not data or not plot then
		return false, "You need a base first!"
	end
	local items = data.Base.Items
	local others, peds = {}, {}
	for _, item in items do
		local def = Config.Decor[item.Id]
		if def and (def.Function == "Pedestal" or def.Function == "Vault" or def.Function == "Decoy") then
			table.insert(peds, item)
		else
			table.insert(others, item)
		end
	end
	-- (decoys mix in with the real display pedestals: no giveaway)
	local order = { Vault = 1, Pedestal = 2, Decoy = 2 }
	table.sort(peds, function(a, b)
		local oa, ob = order[Config.Decor[a.Id].Function], order[Config.Decor[b.Id].Function]
		if oa ~= ob then
			return oa < ob
		end
		return a.Uid < b.Uid
	end)
	local level = houseLevel(data)
	local bounds = DecorModel.Bounds(Config, level)
	local opts = validateOpts(player, data)
	local spacing = 6
	local width = bounds.MaxX - bounds.MinX
	local columns = math.max(1, math.floor(width / spacing))
	local startX = bounds.MinX + (width - (columns - 1) * spacing) / 2
	local saved = {}
	for _, item in peds do
		saved[item] = { item.X, item.Z, item.R }
	end
	local placed = table.clone(others)
	local index = 1
	local z = bounds.MaxZ - 3
	while index <= #peds and z - 2 >= bounds.MinZ do
		for column = 0, columns - 1 do
			local item = peds[index]
			if not item then
				break
			end
			local x, sz = DecorModel.Snap(Config, item.Id, startX + column * spacing, z, 0)
			if DecorModel.Validate(Config, placed, item.Id, x, sz, 0, item.Uid, opts) then
				item.X, item.Z, item.R = x, sz, 0
				table.insert(placed, item)
				index += 1
			end
		end
		z -= spacing
	end
	if index <= #peds then
		for item, transform in saved do
			item.X, item.Z, item.R = transform[1], transform[2], transform[3]
		end
		return false, "Not enough free room - move some decorations first!"
	end
	for _, item in peds do
		renderItem(plot, item)
	end
	self:RenderDisplays(player)
	Data:MarkDirty(player)
	return true, nil
end

-- 🎨 roof + flag colour (0 = the style's colour)
function Base:SetRoof(player: Player, color): (boolean, string?)
	local data = Data:Get(player)
	local plot = plotOf[player]
	if not data or not plot or not finite(color) then
		return false, "Can't paint that"
	end
	color = math.floor(color)
	if color < 0 or color > #Config.Paint then
		return false, "Can't paint that"
	end
	data.Base.Roof = color
	local styleId, style = Util.HouseStyle(Config, data)
	local prefix = styleId .. ":" .. houseLevel(data) .. ":"
	if string.sub(plot.StyleKey, 1, #prefix) == prefix then
		-- same house: just repaint (no rebuild)
		plot.StyleKey = prefix .. color
		local roofColor = Config.Paint[color] or style.Trim
		for _, child in plot.Shell:GetChildren() do
			if child:IsA("BasePart") and (child.Name == "Roof" or child.Name == "TowerRoof" or child.Name == "Flag") then
				child.Color = roofColor
			end
		end
	else
		applyStyle(plot, data)
	end
	Data:MarkDirty(player)
	return true, nil
end

---------------------------------------------------------------------------
-- house: level, name, skin
---------------------------------------------------------------------------
function Base:Upgrade(player: Player): (boolean, string?)
	local data = Data:Get(player)
	local plot = plotOf[player]
	if not data or not plot then
		return false, "You need a base first!"
	end
	local level = houseLevel(data)
	local nextDef = SETTINGS.Levels[level + 1]
	if not nextDef then
		return false, "Your house is already max level!"
	end
	if data.Coins < nextDef.Cost then
		return false, "Not enough coins!"
	end
	data.Coins -= nextDef.Cost
	data.Base.Level = level + 1
	Services.Analytics:Economy(player, "Sink", "Coins", nextDef.Cost, data.Coins, "Upgrade", "House" .. (level + 1))
	Services.Analytics:Custom(player, "HouseLevel", level + 1)
	applyStyle(plot, data)
	self:RefreshLabels(player, true)
	Net:Notify(player, "🏗️ Your house grew into a %s!", Color3.fromRGB(255, 220, 120), nextDef.Name)
	Net:Send(player, "HouseUpgraded", level + 1)
	if level + 1 >= 4 then
		Net:Announce("🏰 %s upgraded their house to a %s!", Color3.fromRGB(210, 150, 255), player.DisplayName, nextDef.Name)
	end
	Data:MarkDirty(player)
	return true, nil
end

local function filterName(player: Player, text: string): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(text, player.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if ok and type(result) == "string" then
		return result
	end
	return nil
end

function Base:SetName(player: Player, text): (boolean, string?)
	local data = Data:Get(player)
	if not data or type(text) ~= "string" then
		return false, "Invalid name"
	end
	-- cap first: pattern matching a huge string would stall the server
	if #text > SETTINGS.NameMax * 4 then
		return false, "That name is too long!"
	end
	text = string.gsub(text, "[%c]", "")
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	local length = utf8.len(text)
	if not length or length > SETTINGS.NameMax then
		return false, "That name is too long!"
	end
	if length == 0 then
		data.Base.Name = ""
		houseNames[player] = nil
		self:RefreshLabels(player, true)
		Data:MarkDirty(player)
		return true, nil
	end
	local filtered = filterName(player, text)
	if not filtered then
		return false, "Couldn't check that name - try again later."
	end
	data.Base.Name = text -- the raw text is re-filtered every time it's shown again
	houseNames[player] = filtered
	self:RefreshLabels(player, true)
	Data:MarkDirty(player)
	return true, nil
end

local function skinDef(id)
	for _, def in Config.HouseSkins do
		if def.Id == id then
			return def
		end
	end
	return nil
end

function Base:GrantSkin(player: Player, id: string)
	local data = Data:Get(player)
	if not data or not skinDef(id) then
		return
	end
	data.Base.Skins[id] = true
	data.Base.Skin = id
	local plot = plotOf[player]
	if plot then
		applyStyle(plot, data)
		self:RefreshLabels(player, true)
	end
	Net:Notify(player, "🎨 New house skin: %s!", Color3.fromRGB(255, 200, 120), skinDef(id).Name)
	Data:MarkDirty(player)
end

function Base:SetSkin(player: Player, id): (boolean, string?)
	local data = Data:Get(player)
	local def = type(id) == "string" and skinDef(id)
	if not data or not def then
		return false, "Unknown skin"
	end
	local base = data.Base
	if def.Id ~= "Auto" and not base.Skins[def.Id] then
		if def.Pass then
			if not Services.MonetizationService:HasPass(player, def.Pass) then
				return false, "VIP only! 👑"
			end
		elseif def.Level then
			if houseLevel(data) < def.Level then
				return false, Net:L(player, "Reach house level %d first!", def.Level)
			end
		elseif def.Gems then
			if data.Gems < def.Gems then
				return false, "Not enough gems!"
			end
			data.Gems -= def.Gems
			base.Skins[def.Id] = true
			Services.Analytics:Economy(player, "Sink", "Gems", def.Gems, data.Gems, "Cosmetic", "Skin" .. def.Id)
		elseif def.Product then
			return false, "Buy this skin in the store!"
		end
	end
	base.Skin = def.Id
	local plot = plotOf[player]
	if plot then
		applyStyle(plot, data)
		self:RefreshLabels(player, true)
	end
	Data:MarkDirty(player)
	return true, nil
end

-- traps: freeze intruders; a stolen pet from this base goes straight home
onTrap = function(plot, model: Model, player: Player)
	local owner = plot.Owner
	if not owner or owner == player then
		return
	end
	local ready = trapReady[model] or 0
	if os.clock() < ready then
		return
	end
	trapReady[model] = os.clock() + SETTINGS.TrapCooldown
	model.AncestryChanged:Once(function()
		trapReady[model] = nil
	end)
	Services.CharacterService:Stun(player, SETTINGS.TrapStun)
	local recovered = Services.ShardService:Confiscate(player, owner)
	Net:Send(player, "Stunned", SETTINGS.TrapStun)
	Net:Notify(player, "⚡ You stepped on a trap!", Color3.fromRGB(255, 230, 80))
	if recovered then
		Net:Notify(owner, "⚡ Your trap caught %s - pet saved!", Color3.fromRGB(255, 230, 80), player.DisplayName)
		Base:ThiefCaught(owner, player)
	else
		Net:Notify(owner, "⚡ Your trap stunned %s!", Color3.fromRGB(255, 230, 80), player.DisplayName)
	end
end

onJump = function(player: Player, model: Model)
	if debounced(player, "jump", 0.8) then
		return
	end
	local look = model:GetPivot().LookVector * Vector3.new(1, 0, 1)
	Net:Send(player, "Launch", Vector3.new(0, 95, 0) + look * 25)
end

---------------------------------------------------------------------------
-- likes
---------------------------------------------------------------------------
tryLike = function(visitor: Player, plotIndex: number)
	local plot = plots[plotIndex]
	local owner = plot and plot.Owner
	if not owner or owner == visitor then
		return
	end
	local data = Data:Get(owner)
	if not data then
		return
	end
	local base = data.Base
	local key = tostring(visitor.UserId)
	local today = Util.DayNumber()
	if base.LikedBy[key] == today then
		Net:Notify(visitor, "You already liked this base today ❤️")
		return
	end
	base.LikedBy[key] = today
	base.Likes += 1
	local week = Util.WeekNumber()
	if base.LikeWeek ~= week then
		base.LikeWeek = week
		base.WeeklyLikes = 0
	end
	base.WeeklyLikes += 1
	-- a few gems for the owner (capped per day): decorating pays off
	if base.LikeGemsDay ~= today then
		base.LikeGemsDay = today
		base.LikeGemsToday = 0
	end
	local gems = math.min(SETTINGS.LikeGems, SETTINGS.LikeGemsDaily - base.LikeGemsToday)
	if gems > 0 then
		base.LikeGemsToday += gems
		data.Gems += gems
	end
	Services.ProgressionService:AddPoints(owner, SETTINGS.LikePoints)
	Services.ProgressionService:AddQuest(visitor, "Like", 1)
	if gems > 0 then
		Net:Notify(owner, "❤️ %s liked your house! +💎%d", Color3.fromRGB(255, 120, 160), visitor.DisplayName, gems)
	else
		Net:Notify(owner, "❤️ %s liked your base!", Color3.fromRGB(255, 120, 160), visitor.DisplayName)
	end
	Net:Notify(visitor, "❤️ You liked %s's base!", Color3.fromRGB(255, 120, 160), owner.DisplayName)
	Net:Send(owner, "BaseLiked", visitor.DisplayName)
	Data:MarkDirty(owner)
	Base:RefreshLabels(owner, true)
end

---------------------------------------------------------------------------
-- plot assignment
---------------------------------------------------------------------------
local function addItem(base, id: string, x: number, z: number, r: number, level: number): boolean
	x, z = DecorModel.Snap(Config, id, x, z, r)
	if DecorModel.Validate(Config, base.Items, id, x, z, r, nil, { Level = level, Vaults = 99 }) then
		table.insert(base.Items, { Uid = base.NextUid, Id = id, X = x, Z = z, R = r, Paid = 0, Cur = "Coins" })
		base.NextUid += 1
		return true
	end
	return false
end

-- first visit: starter layout. Older saves move into the new territories.
-- items outside the buildable land (layouts from older versions) move to a
-- free spot inside it, or are refunded if there is no room
local function rehome(data)
	local base = data.Base
	local level = houseLevel(data)
	local bounds = DecorModel.Bounds(Config, level)
	local opts = { Level = level, Vaults = 99 }
	local kept = {}
	local outside = {}
	for _, item in base.Items do
		local def = Config.Decor[item.Id]
		if def then
			local w, d = DecorModel.Footprint(Config, item.Id, item.R or 0)
			local inside = item.X - w / 2 >= bounds.MinX - 0.01
				and item.X + w / 2 <= bounds.MaxX + 0.01
				and item.Z - d / 2 >= bounds.MinZ - 0.01
				and item.Z + d / 2 <= bounds.MaxZ + 0.01
			table.insert(if inside then kept else outside, item)
		end
	end
	for _, item in outside do
		local placed = false
		local z = bounds.MaxZ - 2
		while not placed and z >= bounds.MinZ + 1 do
			local x = bounds.MinX + 2
			while not placed and x <= bounds.MaxX - 1 do
				local sx, sz = DecorModel.Snap(Config, item.Id, x, z, 0)
				if DecorModel.Validate(Config, kept, item.Id, sx, sz, 0, item.Uid, opts) then
					item.X, item.Z, item.R = sx, sz, 0
					table.insert(kept, item)
					placed = true
				end
				x += 2
			end
			z -= 2
		end
		if not placed then
			local refund = math.max(0, math.floor(item.Paid or 0))
			if item.Cur == "Gems" then
				data.Gems += refund
			else
				data.Coins += refund
			end
		end
	end
	base.Items = kept
end

local function seed(data)
	local base = data.Base
	if not base.Seeded then
		base.Seeded = true
		base.LayoutV = 3
		for _, entry in Config.StarterBase do
			addItem(base, entry.Id, entry.X, entry.Z, entry.R, 1)
		end
		-- pedestals bought before decorating existed are kept
		local extra = math.max(0, (base.Pedestals or 0) - SETTINGS.StartPedestals)
		for i = 1, extra do
			addItem(base, "Pedestal", -12 + ((i - 1) % 5) * 6, -6 - math.floor((i - 1) / 5) * 6, 0, 1)
		end
		return
	end
	if (base.LayoutV or 0) < 2 then
		-- saves from the 44x44 bases: their layout fits house level 2
		base.LayoutV = 2
		-- big enough for everything they already placed
		local level = math.max(houseLevel(data), 2)
		while level < #SETTINGS.Levels and SETTINGS.Levels[level].MaxItems <= #base.Items do
			level += 1
		end
		base.Level = level
		if DecorModel.Count(base.Items, "Vault") == 0 then
			for _, spot in { { 0, 14 }, { -10, 14 }, { 10, 14 }, { 0, -16 }, { -16, -16 }, { 16, -16 } } do
				if addItem(base, "Vault", spot[1], spot[2], 0, base.Level) then
					break
				end
			end
		end
	end
	if (base.LayoutV or 0) < 3 then
		-- v16: the house stands behind z = 22 now
		base.LayoutV = 3
		rehome(data)
	end
end

local function sendHome(player: Player)
	local home = Base:HomeCFrame(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if home and root and not Services.ShardService:IsCarrying(player) then
		character:PivotTo(home)
	end
end

local function assign(player: Player, data)
	if plotOf[player] then
		return
	end
	local plot = nil
	for _, candidate in plots do
		if not candidate.Owner and not candidate.Rival then
			plot = candidate
			break
		end
	end
	if not plot then
		-- a rival player lives here: they move out for a real player
		for _, candidate in plots do
			if not candidate.Owner and candidate.Rival and Services.RivalHomes then
				Services.RivalHomes:EvictFor(candidate)
				plot = candidate
				break
			end
		end
	end
	if not plot then
		if not table.find(waiting, player) then
			table.insert(waiting, player)
		end
		Net:Notify(player, "All bases are taken - you'll get one when someone leaves.")
		return
	end
	plot.Owner = player
	plotOf[player] = plot
	plot.Model:SetAttribute("OwnerId", player.UserId)
	plot.Avatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(player.UserId) .. "&w=150&h=150"
	player:SetAttribute("BaseIndex", plot.Index)
	-- nobody can rob you the moment you arrive
	lockFor(plot, SETTINGS.JoinLockSeconds)

	-- offline earnings (lower rate, capped)
	local base = data.Base
	if base.LastOnline > 0 then
		local away = math.clamp(os.time() - base.LastOnline, 0, SETTINGS.OfflineMaxSeconds)
		local earned = math.floor(Base:IncomeRate(player, data) * away * SETTINGS.OfflineRate)
		if earned > 0 and away >= 60 then
			base.Bank += earned
			task.delay(6, function()
				if player.Parent then
					Net:Send(player, "OfflineEarnings", earned, away)
				end
			end)
		end
	end
	base.LastOnline = os.time()
	Base:Render(player)
	-- your custom house name (filtered again every session)
	if type(base.Name) == "string" and base.Name ~= "" then
		task.spawn(function()
			local filtered = filterName(player, base.Name)
			if filtered and plotOf[player] == plot then
				houseNames[player] = filtered
				Base:RefreshLabels(player, true)
			end
		end)
	end
	-- returning players start at home (like Adopt Me / Steal a Brainrot)
	if data.Tutorial.Done then
		task.delay(1.5, function()
			if plotOf[player] == plot and player.Parent then
				sendHome(player)
			end
		end)
	end
end

local function release(player: Player)
	local plot = plotOf[player]
	plotOf[player] = nil
	houseNames[player] = nil
	revenge[player] = nil
	thefts[player] = nil
	for victim, entry in revenge do
		if entry.Target == player then
			revenge[victim] = nil
			victim:SetAttribute("RevengeTarget", nil)
			victim:SetAttribute("RevengeUntil", nil)
		end
	end
	local index = table.find(waiting, player)
	if index then
		table.remove(waiting, index)
	end
	if not plot then
		return
	end
	clearPlot(plot)
	-- give the plot to someone who's waiting
	while #waiting > 0 do
		local nextPlayer = table.remove(waiting, 1)
		local data = nextPlayer.Parent and Data:Get(nextPlayer)
		if data then
			assign(nextPlayer, data)
			break
		end
	end
end

---------------------------------------------------------------------------
function Base:Init(services)
	Services = services
	Data = services.DataService
	World = services.WorldService
end

function Base:Start()
	for index, spot in Util.PlotLayout(Config) do
		local plot = buildPlot(index, spot.Center, spot.Facing)
		plots[index] = plot
		clearPlot(plot)
		plot.CollectPad.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player and plot.Owner == player and not debounced(player, "collect", 0.6) then
				Base:Collect(player)
			end
		end)
		plot.LockPad.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player and plot.Owner == player and not debounced(player, "lock", 0.6) then
				Base:Lock(player)
			end
		end)
		setPrompt(plot.ExpandBoard, "Expand", "House", "Owner", 0.4, function(player)
			if plot.Owner == player then
				local ok, message = Base:Upgrade(player)
				if not ok and message then
					Net:Notify(player, message, Color3.fromRGB(255, 120, 120))
				end
			end
		end, 12)
	end

	Data:OnLoaded(function(player, data)
		local base = data.Base
		-- forget likes older than yesterday (keeps the save small)
		local today = Util.DayNumber()
		for key, day in base.LikedBy do
			if type(day) ~= "number" or day < today - 1 then
				base.LikedBy[key] = nil
			end
		end
		seed(data)
		assign(player, data)
	end)
	Data:OnLeaving(function(_player, data)
		data.Base.LastOnline = os.time()
		for _, pet in data.Pets do
			pet.Away = nil
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		release(player)
		for key in touchDebounce do
			if string.sub(key, 1, #tostring(player.UserId) + 1) == player.UserId .. ":" then
				touchDebounce[key] = nil
			end
		end
	end)
	-- respawning puts you back home (only real players have characters that respawn)
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			local data = Data:Get(player)
			if data and data.Tutorial.Done and plotOf[player] then
				task.wait(0.5)
				sendHome(player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end

	-- 👑 the most liked house in the server wears a crown
	local function updateCrown()
		local best, bestLikes = nil, 0
		for owner, plot in plotOf do
			local data = Data:Get(owner)
			local likes = data and data.Base.Likes or 0
			if likes > bestLikes then
				best, bestLikes = plot, likes
			end
		end
		for _, plot in plots do
			local isBest = plot == best
			plot.Model:SetAttribute("BestHouse", isBest)
			for _, crownPart in plot.Crown:GetChildren() do
				if crownPart:IsA("BasePart") then
					crownPart.Transparency = if isBest then 0 else 1
				end
			end
		end
	end

	-- someone walks onto your land: you get a heads-up (once a minute per visitor)
	local visiting = {} -- [visitor] = plot index they're standing in
	local visitNotified = {} -- ["visitor:owner"] = os.clock()
	local function checkVisitors()
		for _, visitor in Players:GetPlayers() do
			local root = visitor.Character and visitor.Character:FindFirstChild("HumanoidRootPart")
			local inside = nil
			if root and root:IsA("BasePart") then
				for _, plot in plots do
					local owner = plot.Owner
					if owner and owner ~= visitor then
						local p = plot.CFrame:PointToObjectSpace(root.Position)
						if math.abs(p.X) <= PLOT_HALF and math.abs(p.Z) <= PLOT_HALF then
							inside = plot
						end
					end
				end
			end
			local index = inside and inside.Index or nil
			if index ~= visiting[visitor] then
				visiting[visitor] = index
				if inside and inside.Owner then
					local key = visitor.UserId .. ":" .. inside.Owner.UserId
					if os.clock() - (visitNotified[key] or -999) > 60 then
						visitNotified[key] = os.clock()
						Net:Notify(inside.Owner, "👀 %s walked onto your land!", Color3.fromRGB(150, 220, 255), visitor.DisplayName)
					end
				end
			end
		end
		for visitor in visiting do
			if not visitor.Parent then
				visiting[visitor] = nil
			end
		end
	end

	-- income tick
	task.spawn(function()
		local ticks = 0
		while true do
			task.wait(1)
			ticks += 1
			pcall(checkVisitors)
			if ticks % 5 == 0 then
				pcall(updateCrown)
			end
			for player, plot in plotOf do
				local data = Data:Get(player)
				if data and player.Parent then
					data.Base.Bank += self:IncomeRate(player, data)
					data.Base.LastOnline = os.time()
					if plot.LockedUntil > 0 and plot.LockedUntil <= now() then
						plot.LockedUntil = 0
						plot.Model:SetAttribute("LockedUntil", 0)
					end
					local entry = revenge[player]
					if entry and entry.Until <= now() then
						revenge[player] = nil
						player:SetAttribute("RevengeTarget", nil)
						player:SetAttribute("RevengeUntil", nil)
					end
					local ok, err = pcall(self.RefreshLabels, self, player)
					if not ok then
						warn("[Base] label refresh failed: " .. tostring(err))
					end
				end
			end
		end
	end)

	Net:On("GoBase", 1, function(player)
		if Services.ShardService:IsCarrying(player) then
			Net:Notify(player, "Run! You can't teleport while carrying a shard.")
			return
		end
		sendHome(player)
	end)

	-- visit someone's house (you arrive outside their gate)
	Net:On("VisitBase", 1, function(player, userId)
		local target = type(userId) == "number" and Players:GetPlayerByUserId(userId)
		if not target and type(userId) == "number" and userId < 0 then
			-- a rival's house
			for _, plot in plots do
				if plot.Rival and plot.Model:GetAttribute("OwnerId") == userId then
					local character = player.Character
					if character and not Services.ShardService:IsCarrying(player) then
						character:PivotTo(plot.CFrame * CFrame.new(0, 3, -PLOT_HALF - 6) * CFrame.Angles(0, math.pi, 0))
					end
				end
			end
			return
		end
		if not target or target == player then
			return
		end
		if Services.ShardService:IsCarrying(player) then
			Net:Notify(player, "Run! You can't teleport while carrying a shard.")
			return
		end
		local gate = self:GateCFrame(target)
		local character = player.Character
		if gate and character and character:FindFirstChild("HumanoidRootPart") then
			character:PivotTo(gate)
			Net:Notify(
				player,
				"🏘️ Welcome to %s's house! Tap ❤️ if you like it.",
				Color3.fromRGB(255, 160, 200),
				target.DisplayName
			)
		end
	end)

	-- build mode requests answer with ok, translated message
	local function reply(player: Player, ok: boolean, message: string?)
		return ok, if message then Net:L(player, message) else nil
	end
	Net:OnRequest("BasePlace", 0.15, function(player, id, x, z, r)
		return reply(player, self:Place(player, id, x, z, r))
	end)
	Net:OnRequest("BaseMove", 0.15, function(player, uid, x, z, r)
		return reply(player, self:Move(player, uid, x, z, r))
	end)
	Net:OnRequest("BaseRemove", 0.15, function(player, uid)
		return reply(player, self:Remove(player, uid))
	end)
	Net:OnRequest("BasePaint", 0.1, function(player, uid, color)
		return reply(player, self:Paint(player, uid, color))
	end)
	Net:OnRequest("BaseArrange", 1, function(player)
		return reply(player, self:ArrangePedestals(player))
	end)
	Net:OnRequest("HouseRoof", 0.5, function(player, color)
		return reply(player, self:SetRoof(player, color))
	end)
	Net:OnRequest("HouseUpgrade", 0.5, function(player)
		return reply(player, self:Upgrade(player))
	end)
	Net:OnRequest("HouseName", 5, function(player, text)
		return reply(player, self:SetName(player, text))
	end)
	Net:OnRequest("HouseSkin", 0.5, function(player, id)
		return reply(player, self:SetSkin(player, id))
	end)
	-- choose which pets may go into the vault ("show off" keeps a pet on display)
	Net:On("PetShow", 0.15, function(player, petId, show)
		local data = Data:Get(player)
		local pet = data and type(petId) == "number" and Services.PetService.FindPet(data, petId)
		if not pet then
			return
		end
		pet.Show = if show == true then true else nil
		Services.PetService:Changed(player)
	end)
end

return Base
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">BoostService</string>
            <string name="Source"><![CDATA[--[[
	BoostService: personal timed boosts (tick only while online, stack time)
	and server-wide boosts bought by one player for everyone (Server Luck).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Boosts = {}
local Data

local serverBoosts = {} -- [key] = unix end time

function Boosts:IsActive(player: Player, key: string): boolean
	local data = Data:Get(player)
	return data ~= nil and (data.Boosts[key] or 0) > 0
end

function Boosts:Add(player: Player, key: string, seconds: number)
	local data = Data:Get(player)
	if not data then
		return
	end
	data.Boosts[key] = (data.Boosts[key] or 0) + seconds
	Net:Notify(player, "⏫ %s boost +%s!", Color3.fromRGB(120, 255, 170), Util.BoostNames[key] or key, Util.FormatTime(seconds))
	Data:MarkDirty(player)
end

function Boosts:ServerActive(key: string): boolean
	return (serverBoosts[key] or 0) > os.time()
end

function Boosts:AddServer(key: string, seconds: number, buyer: Player?)
	local now = os.time()
	serverBoosts[key] = math.max(serverBoosts[key] or 0, now) + seconds
	workspace:SetAttribute("Server_" .. key, serverBoosts[key])
	if buyer then
		Net:Announce(
			"🌟 %s activated SERVER LUCK for everyone! (+%d min)",
			Color3.fromRGB(255, 230, 90),
			buyer.DisplayName,
			math.floor(seconds / 60)
		)
	end
	for _, player in Players:GetPlayers() do
		Data:MarkDirty(player)
	end
end

function Boosts:Init(services)
	Data = services.DataService
end

function Boosts:Start()
	task.spawn(function()
		local tick = 0
		local function step()
			tick += 1
			for _, player in Data:LoadedPlayers() do
				local data = Data:Get(player)
				if data then
					local changed = false
					for key, remaining in data.Boosts do
						if remaining > 0 then
							data.Boosts[key] = math.max(0, remaining - 1)
							if data.Boosts[key] == 0 then
								changed = true
								Net:Notify(player, "%s boost ended", nil, Util.BoostNames[key] or key)
							end
						end
					end
					if changed or tick % 15 == 0 then
						Data:MarkDirty(player)
					end
				end
			end
			for key, endTime in serverBoosts do
				if endTime > 0 and endTime <= os.time() then
					serverBoosts[key] = 0
					workspace:SetAttribute("Server_" .. key, 0)
					for _, player in Players:GetPlayers() do
						Data:MarkDirty(player)
					end
				end
			end
		end
		while true do
			task.wait(1)
			local ok, err = pcall(step)
			if not ok then
				warn("[Boosts] tick error: " .. tostring(err))
			end
		end
	end)
end

return Boosts
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">CharacterService</string>
            <string name="Source"><![CDATA[--[[
	CharacterService: gives the pickaxe tool, walk speed perks and the
	overhead tag (weekly rank, VIP / Club / leaderboard titles) that shows off
	status to everyone - a key driver of competition and pass sales.
]]
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Net = require(script.Parent.Net)

local CharacterService = {}
local Services
local Data
local unlockedTitles = {} -- [player] = number of titles unlocked (for "new title!" toasts)

local function buildPickaxe(tier: number): Tool
	local info = Config.Pickaxes[tier] or Config.Pickaxes[1]
	local tool = Instance.new("Tool")
	tool.Name = "Pickaxe"
	tool.ToolTip = info.Name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Tier", tier)
	tool.Grip = CFrame.new(0, -1.1, 0)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.35, 3.4, 0.35)
	handle.Color = Color3.fromRGB(110, 75, 45)
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(2.8, 0.5, 0.5)
	head.Color = info.Color
	head.Material = if tier >= 7 then Enum.Material.Neon else Enum.Material.Metal
	head.CanCollide = false
	head.Massless = true
	head.CFrame = handle.CFrame * CFrame.new(0, 1.5, 0)
	head.Parent = tool

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = head
	weld.Parent = handle

	if tier >= 7 then
		local light = Instance.new("PointLight")
		light.Color = info.Color
		light.Range = 8
		light.Parent = head
	end
	-- swing trail from tier 4: upgrades you can SEE are upgrades people buy
	if tier >= 4 then
		local a0 = Instance.new("Attachment")
		a0.Position = Vector3.new(-1.3, 0, 0)
		a0.Parent = head
		local a1 = Instance.new("Attachment")
		a1.Position = Vector3.new(1.3, 0, 0)
		a1.Parent = head
		local trail = Instance.new("Trail")
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(info.Color)
		trail.LightEmission = if tier >= 7 then 1 else 0.4
		trail.Lifetime = 0.18
		trail.Transparency = NumberSequence.new(0.2, 1)
		trail.FaceCamera = true
		trail.Parent = head
	end
	return tool
end

function CharacterService:GivePickaxe(player: Player)
	local data = Data:Get(player)
	local tier = if data then data.PickaxeTier else 1 -- a basic pickaxe before data loads
	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	for _, container in { backpack, character } do
		if container then
			local existing = container:FindFirstChild("Pickaxe")
			if existing then
				existing:Destroy()
			end
		end
	end
	local tool = buildPickaxe(tier)
	-- always in hand: the hotbar is hidden, so an unequipped pickaxe = can't mine
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		for _, other in character:GetChildren() do
			if other:IsA("Tool") and other ~= tool then
				other.Parent = backpack
			end
		end
		tool.Parent = character
	elseif backpack then
		tool.Parent = backpack
	end
end

CharacterService.BuildPickaxe = buildPickaxe -- (rival players hold one too)

local padUntil = {} -- [player] = os.clock() when the dash pad boost ends
local stunnedUntil = {} -- [player] = os.clock() when a trap/guardian stun ends
local DEFAULT_JUMP = 7.2

function CharacterService:ApplyWalkSpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		if (stunnedUntil[player] or 0) > os.clock() then
			humanoid.WalkSpeed = 0
			humanoid.JumpHeight = 0
			return
		end
		humanoid.JumpHeight = DEFAULT_JUMP
		local speed = Config.World.WalkSpeed
		local data = Data:Get(player)
		local boots = data and Config.Boots[data.SpeedTier or 1]
		if boots then
			speed *= 1 + boots.Bonus
		end
		if Services.MonetizationService:HasPass(player, "Speed") then
			speed *= 1.5
		end
		local shards = Services.ShardService
		if shards then
			speed *= shards:SpeedMult(player)
		end
		local mining = Services.MiningService
		if mining and mining:IsFever(player) then
			speed *= Config.Fever.SpeedMult
		end
		if (padUntil[player] or 0) > os.clock() then
			speed *= Config.SpeedPads.Mult
		end
		humanoid.WalkSpeed = speed
	end
end

-- freeze a player for a moment (stun traps, guardians)
function CharacterService:Stun(player: Player, seconds: number)
	stunnedUntil[player] = os.clock() + seconds
	self:ApplyWalkSpeed(player)
	task.delay(seconds + 0.05, function()
		if player.Parent and (stunnedUntil[player] or 0) <= os.clock() then
			stunnedUntil[player] = nil
			self:ApplyWalkSpeed(player)
		end
	end)
end

function CharacterService:SpeedPad(player: Player)
	padUntil[player] = os.clock() + Config.SpeedPads.Seconds
	self:ApplyWalkSpeed(player)
	task.delay(Config.SpeedPads.Seconds + 0.05, function()
		if player.Parent and (padUntil[player] or 0) <= os.clock() then
			self:ApplyWalkSpeed(player)
		end
	end)
end

-- overhead tag: title, name (gold for VIP), level/rank/rebirths, bounty
function CharacterService:RefreshOverhead(player: Player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local data = Data:Get(player)
	if not head or not data then
		return
	end
	local gui = head:FindFirstChild("Overhead") :: BillboardGui
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "Overhead"
		gui.Size = UDim2.new(7, 0, 2.6, 0) -- studs: small up close, readable nearby
		gui.StudsOffset = Vector3.new(0, 3.4, 0)
		gui.MaxDistance = 90
		gui.LightInfluence = 0

		local layout = Instance.new("UIListLayout")
		layout.FillDirection = Enum.FillDirection.Vertical
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = gui

		for i, name in { "Bounty", "Title", "Tags", "Name", "Rank" } do
			local label = Instance.new("TextLabel")
			label.Name = name
			label.LayoutOrder = i
			label.BackgroundTransparency = 1
			label.Size = UDim2.new(1, 0, if name == "Name" then 0.26 else 0.18, 0)
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.RichText = true
			label.TextColor3 = Color3.new(1, 1, 1)
			local stroke = Instance.new("UIStroke")
			stroke.Thickness = 2
			stroke.Parent = label
			label.Parent = gui
		end
		gui.Parent = head
		-- our tag shows the name (so VIPs can have a gold one)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end
	local monetization = Services.MonetizationService
	local vip = monetization:HasPass(player, "VIP")

	local rank = Util.RankFor(Config, data.Weekly.Points)
	local rankLabel = gui:FindFirstChild("Rank") :: TextLabel
	rankLabel.Text = if data.Rebirths > 0
		then string.format("Lv.%d %s ♻️%d", data.Level, rank.Icon or "", data.Rebirths)
		else string.format("Lv.%d %s", data.Level, rank.Icon or "")
	rankLabel.TextColor3 = rank.Color

	local nameLabel = gui:FindFirstChild("Name") :: TextLabel
	nameLabel.Text = (if vip then "👑 " else "") .. player.DisplayName
	nameLabel.TextColor3 = if vip then Color3.fromRGB(255, 210, 70) else Color3.new(1, 1, 1)

	-- earned title (each viewer reads it in their own language, see WorldFX)
	local title = Util.CurrentTitle(Config, data, function(key)
		return monetization:HasPass(player, key)
	end)
	local titleLabel = gui:FindFirstChild("Title") :: TextLabel
	titleLabel.Visible = title ~= nil and title.Id ~= "Newcomer"
	if title then
		titleLabel.Text = title.Name
		titleLabel.TextColor3 = title.Color
		titleLabel:SetAttribute("LangFmt", "%s")
		titleLabel:SetAttribute("LangArgs", HttpService:JSONEncode({ title.Name }))
	end
	-- leaderboard place + VIP / CLUB tags
	local tags = {}
	local place = player:GetAttribute("Title")
	if type(place) == "string" and place ~= "" then
		table.insert(tags, "<font color='#FFD84A'>" .. place .. "</font>")
	end
	if vip then
		table.insert(tags, "<font color='#FFC93C'>[VIP]</font>")
	end
	if monetization:IsSubscribed(player) then
		table.insert(tags, "<font color='#5CF2FF'>[CLUB]</font>")
	end
	local tagLabel = gui:FindFirstChild("Tags") :: TextLabel
	tagLabel.Text = table.concat(tags, " ")
	tagLabel.Visible = #tags > 0
	player:SetAttribute("TitleName", if title then title.Name else "")

	local bountyLabel = gui:FindFirstChild("Bounty") :: TextLabel
	local bounty = player:GetAttribute("Bounty")
	bountyLabel.Visible = type(bounty) == "number" and bounty > 0
	if bountyLabel.Visible then
		bountyLabel.Text = "💰 BOUNTY " .. Util.Format(bounty)
		bountyLabel.TextColor3 = Color3.fromRGB(255, 90, 70)
	end
end

local function onCharacter(player: Player, character: Model)
	character:WaitForChild("Humanoid", 10)
	-- pickaxe in hand right away, even while the save is still loading
	if not Data:Get(player) then
		CharacterService:GivePickaxe(player)
		CharacterService:ApplyWalkSpeed(player)
	end
	local data = Data:WaitFor(player, 30)
	if not data or player.Character ~= character then
		return
	end
	character:WaitForChild("Head", 10)
	CharacterService:GivePickaxe(player)
	CharacterService:ApplyWalkSpeed(player)
	CharacterService:RefreshOverhead(player)
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
	for _, attribute in { "Title", "Bounty" } do
		player:GetAttributeChangedSignal(attribute):Connect(function()
			CharacterService:RefreshOverhead(player)
		end)
	end
end

function CharacterService:Init(services)
	Services = services
	Data = services.DataService
end

function CharacterService:Start()
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		padUntil[player] = nil
		stunnedUntil[player] = nil
		unlockedTitles[player] = nil
	end)

	-- new titles: tell the player + update the tag
	task.spawn(function()
		while true do
			task.wait(15)
			for _, player in Data:LoadedPlayers() do
				local data = Data:Get(player)
				if data then
					local hasPass = function(key)
						return Services.MonetizationService:HasPass(player, key)
					end
					local count, newest = 0, nil
					for _, title in Config.Titles do
						if Util.TitleUnlocked(Config, title, data, hasPass) then
							count += 1
							newest = title
						end
					end
					local before = unlockedTitles[player]
					unlockedTitles[player] = count
					if before and count > before and newest then
						Net:Notify(player, "🏅 New title unlocked: %s! (👑 Titles)", newest.Color, newest.Name)
						self:RefreshOverhead(player)
					elseif player:GetAttribute("TitleName") ~= Util.CurrentTitle(Config, data, hasPass).Name then
						self:RefreshOverhead(player)
					end
				end
			end
		end
	end)

	-- dash pads
	local net = Net
	for _, pad in Services.WorldService.SpeedPads do
		pad.Touched:Connect(function(hit)
			local model = hit:FindFirstAncestorOfClass("Model")
			local player = model and Players:GetPlayerFromCharacter(model)
			if player and (padUntil[player] or 0) - os.clock() < Config.SpeedPads.Seconds - 0.4 then
				self:SpeedPad(player)
				net:Send(player, "SpeedPad")
			end
		end)
	end
end

return CharacterService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService: loads/saves player data with a lightweight session lock so a
	player who server-hops quickly can't duplicate purchases or items.

	* UpdateAsync + _lock { JobId, Time } on load, refreshed on every save.
	* Saves are serialized per player, autosaved, and flushed on BindToClose.
	* In Studio without "Enable Studio Access to API Services" the game still
	  runs with temporary data (never saved) so you can test immediately.
]]
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local DataService = {}

local LOCK_EXPIRE = 300
local AUTOSAVE_SECONDS = 120
local SYNC_INTERVAL = 0.2
local MAX_RECEIPTS = 100

local TEMPLATE = {
	Version = 1,
	Coins = 0,
	Gems = 0,
	Stardust = 0,
	Backpack = 0,
	PickaxeTier = 1,
	BackpackTier = 1,
	ZoneLevel = 1,
	Rebirths = 0,
	Level = 1,
	XP = 0,
	FreeSpinAt = 0, -- unix time when the next free spin is ready
	Codes = {}, -- [CODE] = true
	Tutorial = { Step = 1, Progress = 0, Done = false, Version = 0 },
	MeteorIndex = {}, -- [meteor kind index] = meteors cracked
	Settings = { Lang = "auto", Sfx = true, Music = true }, -- Lang: "auto" | "ko" | "en"
	-- star-shard base: Shards = { { Id = rarityId }, ... } in pedestal order
	-- Items = placed decorations { Uid, Id, X, Z, R, Paid, Cur } in plot space
	Base = {
		Pedestals = 3, -- legacy (pre-decorating saves)
		Shards = {},
		Bank = 0,
		LastOnline = 0,
		Items = {},
		NextUid = 1,
		Seeded = false,
		Likes = 0,
		WeeklyLikes = 0,
		LikeWeek = 0,
		LikedBy = {}, -- ["userId"] = day number
		Level = 1, -- house level (land size, vaults, wall style)
		LayoutV = 0, -- 2 = territory layout (older saves get migrated)
		Name = "", -- custom house name (raw text, filtered whenever shown)
		Skin = "Auto",
		Roof = 0, -- roof / flag colour (Config.Paint index, 0 = style colour)
		Skins = {}, -- [skinId] = true
		LikeGemsDay = 0,
		LikeGemsToday = 0,
	},
	SpeedTier = 1,
	Shop = { Slot = 0, Bought = {} }, -- egg restock purchases (per 5-min restock)
	-- { { Id = 1, Name = "Bunny", Variant = "Golden"?, Serial = 12?, Show = true? }, ... }
	Pets = {},
	Equipped = {}, -- { petId, ... }
	NextPetUid = 1,
	PetIndex = {}, -- [petName] = true
	IndexClaimed = {}, -- ["milestone index"] = true (📖 collection rewards)
	Boosts = { Coins2x = 0, Luck2x = 0, Power2x = 0 }, -- remaining seconds
	Stats = {
		Evolved = 0, -- ⭐ pets evolved
		MeteorPets = 0, -- ☄️ meteor pets hatched
		BlocksMined = 0,
		LifetimeCoins = 0,
		EggsHatched = 0,
		MeteorWins = 0,
		MeteorJoins = 0,
		Bonks = 0,
		PlaySeconds = 0,
		Purchases = 0,
		LuckyOres = 0,
		Crits = 0,
		BestCombo = 0,
		ShardsDelivered = 0,
		ShardsStolen = 0,
		ThievesCaught = 0,
		HugesFound = 0,
		TitanicsFound = 0,
		Pranks = 0,
		LuckyBlocks = 0,
		Fevers = 0,
	},
	Daily = { Day = 0, Quests = {}, Streak = 0, LastClaimDay = 0, VipChestDay = 0, ClubDay = 0 },
	Season = { Id = 0, XP = 0, Premium = false, ClaimedFree = {}, ClaimedPremium = {} },
	Weekly = { Week = 0, Points = 0 },
	Flags = { StarterPack = false, GroupReward = false, HowToSeen = false, HowToRush = false, NewbieOff = false },
	Title = "", -- chosen title id ("" = best unlocked)
	Receipts = {},
	FirstJoin = 0,
	LastAdTime = 0,
}
DataService.Template = TEMPLATE

local profiles = {} -- [player] = { Data, CanSave, Dirty, Saving }
local loadedCallbacks = {}
local leavingCallbacks = {}
local store = nil

do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if not ok then
		warn("[DataService] DataStore unavailable: " .. tostring(err))
	end
end

local function keyFor(userId: number): string
	return "Player_" .. userId
end

local function isAccessError(err): boolean
	local text = tostring(err)
	return string.find(text, "StudioAccessToApisNotAllowed", 1, true) ~= nil
		or string.find(text, "403", 1, true) ~= nil
		or string.find(text, "not allowed", 1, true) ~= nil
end

-- returns data, canSave, fatal
local function loadAsync(player: Player, sessionId: string)
	if not store then
		return nil, false, false
	end
	local key = keyFor(player.UserId)
	for attempt = 1, 8 do
		local locked = false
		local result = nil
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(old)
				local data = if type(old) == "table" then old else {}
				local lock = data._lock
				if
					type(lock) == "table"
					and lock.Session ~= sessionId
					and os.time() - (tonumber(lock.Time) or 0) < LOCK_EXPIRE
					and attempt < 6
				then
					locked = true
					return nil -- cancel, another server still owns this session
				end
				data._lock = { Session = sessionId, JobId = game.JobId, Time = os.time() }
				result = data
				return data
			end)
		end)
		if ok and result then
			return result, true, false
		end
		if not ok then
			warn(string.format("[DataService] load attempt %d for %s failed: %s", attempt, player.Name, tostring(err)))
			if isAccessError(err) then
				return nil, false, false
			end
		end
		if not player.Parent then
			return nil, false, true
		end
		task.wait(if locked then 5 else 1.5 * attempt)
	end
	return nil, false, true
end

-- returns true only when the data was actually written (or saving is disabled)
local function saveAsync(player: Player, release: boolean): boolean
	local profile = profiles[player]
	if not profile or not profile.CanSave or not store then
		return true
	end
	if profile.Released then
		return false -- the leave save already released the session; never re-take the lock
	end
	while profile.Saving do
		task.wait(0.1)
	end
	if profile.Released then
		return false
	end
	if release then
		profile.Released = true
	end
	profile.Saving = true
	local data = profile.Data
	local sessionId = profile.SessionId
	local wrote = false
	local ok, err = pcall(function()
		store:UpdateAsync(keyFor(player.UserId), function(old)
			if type(old) == "table" and type(old._lock) == "table" and old._lock.Session ~= sessionId then
				wrote = false
				return nil -- session was taken over by another server; never overwrite it
			end
			data._lock = if release then nil else { Session = sessionId, JobId = game.JobId, Time = os.time() }
			wrote = true
			return data
		end)
	end)
	profile.Saving = false
	if not ok then
		warn(string.format("[DataService] save for %s failed: %s", player.Name, tostring(err)))
	elseif not wrote then
		warn(string.format("[DataService] save for %s skipped: session owned elsewhere", player.Name))
	end
	return ok and wrote
end

local function setupLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder
	local coins = Instance.new("StringValue")
	coins.Name = "Coins"
	coins.Parent = folder
	local rank = Instance.new("StringValue")
	rank.Name = "Rank"
	rank.Parent = folder
	folder.Parent = player
end

local function updateLeaderstats(player: Player, data)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		return
	end
	local rebirths = folder:FindFirstChild("Rebirths") :: IntValue
	local coins = folder:FindFirstChild("Coins") :: StringValue
	local rank = folder:FindFirstChild("Rank") :: StringValue
	if rebirths then
		rebirths.Value = data.Rebirths
	end
	if coins then
		coins.Value = Util.Format(data.Coins)
	end
	if rank then
		local r = Util.RankFor(Config, data.Weekly.Points)
		rank.Value = r.Name
	end
end

local function snapshot(player: Player, profile)
	local out = {}
	for k, v in profile.Data do
		if k ~= "Receipts" and k ~= "_lock" then
			out[k] = v
		end
	end
	local derived = {}
	if DataService.BuildDerived then
		local ok, result = pcall(DataService.BuildDerived, player)
		if ok then
			derived = result
		else
			warn("[DataService] BuildDerived failed: " .. tostring(result))
		end
	end
	derived.CanSave = profile.CanSave
	return { Data = out, Derived = derived }
end

local function onPlayerAdded(player: Player)
	local sessionId = HttpService:GenerateGUID(false)
	local data, canSave, fatal = loadAsync(player, sessionId)
	if not player.Parent then
		-- left while loading: release the session lock we just took
		if data and canSave and store then
			pcall(function()
				store:UpdateAsync(keyFor(player.UserId), function(old)
					if type(old) == "table" and type(old._lock) == "table" and old._lock.Session == sessionId then
						old._lock = nil
						return old
					end
					return nil
				end)
			end)
		end
		return
	end
	if fatal then
		player:Kick("Your data could not be loaded. Please rejoin in a moment!")
		return
	end
	if not data then
		data = {}
		canSave = false
		task.delay(6, function()
			Net:Notify(player, "⚠ Data is not saving (Studio API access is off).", Color3.fromRGB(255, 170, 60))
		end)
	end
	data._lock = nil
	Util.Reconcile(data, TEMPLATE)
	if data.FirstJoin == 0 then
		data.FirstJoin = os.time()
	end

	profiles[player] = { Data = data, CanSave = canSave, Dirty = true, Saving = false, Released = false, SessionId = sessionId }
	setupLeaderstats(player)
	updateLeaderstats(player, data)
	player:SetAttribute("DataLoaded", true)

	for _, callback in loadedCallbacks do
		task.spawn(callback, player, data)
	end
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	for _, callback in leavingCallbacks do
		local ok, err = pcall(callback, player, profile.Data)
		if not ok then
			warn("[DataService] leaving callback failed: " .. tostring(err))
		end
	end
	saveAsync(player, true)
	profiles[player] = nil
end

-- PUBLIC API ---------------------------------------------------------------

function DataService:Get(player: Player)
	local profile = profiles[player]
	return profile and profile.Data
end

function DataService:WaitFor(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 30)
	while player.Parent and not profiles[player] and os.clock() < deadline do
		task.wait(0.1)
	end
	return self:Get(player)
end

function DataService:OnLoaded(callback)
	table.insert(loadedCallbacks, callback)
	for player, profile in profiles do
		task.spawn(callback, player, profile.Data)
	end
end

-- cloud tests only: load a stand-in player's data (no DataStore, never on live servers)
function DataService:InjectForTest(player: any, data)
	assert(not RunService:IsRunning(), "test hook used on a live server")
	Util.Reconcile(data, TEMPLATE)
	profiles[player] = { Data = data, CanSave = false, Dirty = true, Saving = false, Released = false, SessionId = "test" }
	local errors = {}
	for _, callback in loadedCallbacks do
		local ok, err = pcall(callback, player, data)
		if not ok then
			table.insert(errors, tostring(err))
		end
	end
	return errors
end

function DataService:OnLeaving(callback)
	table.insert(leavingCallbacks, callback)
end

function DataService:MarkDirty(player: Player)
	local profile = profiles[player]
	if profile then
		profile.Dirty = true
	end
end

function DataService:Save(player: Player)
	return saveAsync(player, false)
end

function DataService:LoadedPlayers()
	local list = {}
	for player in profiles do
		table.insert(list, player)
	end
	return list
end

function DataService:HasReceipt(player: Player, purchaseId: string): boolean
	local data = self:Get(player)
	if not data then
		return false
	end
	return table.find(data.Receipts, purchaseId) ~= nil
end

function DataService:AddReceipt(player: Player, purchaseId: string)
	local data = self:Get(player)
	if not data then
		return
	end
	table.insert(data.Receipts, purchaseId)
	while #data.Receipts > MAX_RECEIPTS do
		table.remove(data.Receipts, 1)
	end
end

function DataService:Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	Net:On("Sync", 2, function(player)
		self:MarkDirty(player)
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	-- push state to clients
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < SYNC_INTERVAL then
			return
		end
		accumulator = 0
		for player, profile in profiles do
			if profile.Dirty then
				profile.Dirty = false
				updateLeaderstats(player, profile.Data)
				Net:Send(player, "Data", snapshot(player, profile))
			end
		end
	end)

	-- autosave
	task.spawn(function()
		while true do
			task.wait(AUTOSAVE_SECONDS)
			for player in profiles do
				task.spawn(saveAsync, player, false)
				task.wait(0.5)
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				saveAsync(player, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[--[[
	DevService: test cheats. Allowed in Studio, and for the game owner in live
	servers while Config.OwnerTestMode is true (see Util.CanTest).
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage.Shared.Util)

local Net = require(script.Parent.Net)

local Dev = {}
local Services

function Dev:Init(services)
	Services = services
end

function Dev:Start()
	local Data = Services.DataService
	Net:On("Dev", 0.2, function(player, command)
		if not Util.CanTest(Config, player) then
			return
		end
		local data = Data:Get(player)
		if not data then
			return
		end
		if command == "Coins" then
			local amount = math.max(1000000, data.Coins * 10)
			data.Coins += amount
			data.Stats.LifetimeCoins += amount
		elseif command == "Gems" then
			data.Gems += 10000
		elseif command == "Stardust" then
			data.Stardust += 5000
		elseif command == "Points" then
			Services.ProgressionService:AddPoints(player, 2500)
		elseif command == "XP" then
			Services.ProgressionService:AddSeasonXP(player, 5 * 2000)
		elseif command == "Meteor" then
			Services.MeteorService:Summon(player)
		elseif command == "Golden" then
			-- the next meteor is a GIANT GOLDEN one (falls next to you)
			Services.MeteorService:QueueSpecial("Giant", true)
			Services.MeteorService:Summon(player)
		elseif command == "Raid" then
			Services.EventService:Trigger("ThiefNight")
		elseif command == "Level" then
			Services.ProgressionService:AddXP(player, 2000)
		elseif command == "Event" then
			Services.EventService:Trigger()
		elseif command == "Rainbow" then
			Services.MiningService:DevRainbow(player)
		elseif command == "Spin" then
			data.FreeSpinAt = 0
		elseif command == "Star" then
			-- a falling star in the zone you're standing in (hub if outside the mines)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart
			local zone = root and Services.WorldService:ZoneAt(root.Position) or 0
			Services.ShardService:FallingStar(math.min(zone, data.ZoneLevel))
		elseif command == "Shard" then
			local id = Util.RollShard(Config, 4)
			Services.ShardService:StartCarry(player, { Kind = "Egg", Rarity = id, Egg = "Meadow" }, nil)
		elseif command == "Huge" then
			-- a random huge pet from your best unlocked coin egg
			local zoneEgg = Config.Shards.ZoneEggs[math.clamp(data.ZoneLevel, 1, #Config.Shards.ZoneEggs)] or "Meadow"
			local pick = Util.WeightedPick(Config.Eggs[zoneEgg].Pets)
			Services.PetService:GrantPet(player, pick, "Huge")
		elseif command == "House" then
			-- free house level up (test the land / wall styles)
			data.Coins += (Config.Base.Levels[Util.HouseLevel(Config, data) + 1] or { Cost = 0 }).Cost
			Services.BaseService:Upgrade(player)
		elseif command == "Lucky" then
			Services.LuckyService:Rain(6)
		elseif command == "Party" then
			-- "admin event": a 10 minute party in EVERY server
			Services.EventService:GlobalParty(10)
		elseif command == "Titanic" then
			local zoneEgg = Config.Shards.ZoneEggs[math.clamp(data.ZoneLevel, 1, #Config.Shards.ZoneEggs)] or "Meadow"
			Services.PetService:GrantPet(player, Util.WeightedPick(Config.Eggs[zoneEgg].Pets), "Titanic")
		elseif command == "Reset" then
			local fresh = Util.DeepCopy(Data.Template)
			fresh.FirstJoin = os.time()
			for key in data do
				data[key] = nil
			end
			for key, value in fresh do
				data[key] = value
			end
			Services.CharacterService:GivePickaxe(player)
			Services.PetService:RefreshEquipped(player)
		end
		Net:Notify(player, "[DEV] " .. tostring(command))
		Data:MarkDirty(player)
	end)
end

return Dev
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--[[
	EconomyService: pickaxe upgrades, zone unlocks, rebirths and teleports.
	(Ore pays coins the moment it breaks - see MiningService.)
	All prices are validated on the server.
]]
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Economy = {}
local Services
local Data

local RED = Color3.fromRGB(255, 110, 110)
local REBIRTH_ANNOUNCE = { [1] = true, [5] = true, [10] = true, [25] = true, [50] = true, [100] = true }

local function notEnough(player: Player, need: number, have: number, currency: string)
	Net:Notify(player, "Not enough %s! Need %s more.", RED, currency, Util.Format(need - have))
end

function Economy:UnlockZone(player: Player, index: number)
	local data = Data:Get(player)
	local zone = Config.Zones[index]
	if not data or not zone then
		return
	end
	if data.ZoneLevel >= index then
		return
	end
	if data.ZoneLevel + 1 < index then
		Net:Notify(player, "Unlock %s first!", RED, Config.Zones[data.ZoneLevel + 1].Name)
		return
	end
	if data.Coins < zone.Cost then
		notEnough(player, zone.Cost, data.Coins, "coins")
		return
	end
	data.Coins -= zone.Cost
	data.ZoneLevel = index
	Net:Send(player, "ZoneUnlocked", index)
	Net:Notify(player, "🔓 %s unlocked!", Color3.fromRGB(120, 255, 170), zone.Name)
	if zone.PvP then
		Net:Announce("⚔️ %s entered the Star Crater!", Color3.fromRGB(255, 90, 120), player.DisplayName)
	end
	Services.ProgressionService:AddQuest(player, "Upgrade", 1)
	Data:MarkDirty(player)
end

local function buyUpgrade(player: Player, listName: string, field: string)
	local data = Data:Get(player)
	if not data then
		return
	end
	local list = Config[listName]
	local nextTier = data[field] + 1
	local item = list[nextTier]
	if not item then
		Net:Notify(player, "You already own the best one!")
		return
	end
	if data.Coins < item.Cost then
		notEnough(player, item.Cost, data.Coins, "coins")
		return
	end
	data.Coins -= item.Cost
	data[field] = nextTier
	if field == "PickaxeTier" then
		Services.CharacterService:GivePickaxe(player)
		Services.ProgressionService:TutorialEvent(player, "Pickaxe", 1)
	end
	Services.ProgressionService:AddQuest(player, "Upgrade", 1)
	Net:Notify(player, "✅ Bought %s!", Color3.fromRGB(120, 255, 170), item.Name)
	Data:MarkDirty(player)
end

function Economy:Rebirth(player: Player)
	local data = Data:Get(player)
	if not data then
		return
	end
	local cost = Util.RebirthCost(Config, data.Rebirths)
	if data.Coins < cost then
		notEnough(player, cost, data.Coins, "coins")
		return
	end
	data.Rebirths += 1
	data.Coins = 0
	data.PickaxeTier = 1
	local gems = Config.Rebirth.GemsPer * data.Rebirths
	data.Gems += gems
	Services.CharacterService:GivePickaxe(player)
	Services.CharacterService:RefreshOverhead(player)
	Services.PetService:RefreshEquipped(player)
	Net:Send(player, "Rebirthed", data.Rebirths, gems)
	if REBIRTH_ANNOUNCE[data.Rebirths] then
		Net:Announce("♻️ %s reached Rebirth %d!", Color3.fromRGB(200, 130, 255), player.DisplayName, data.Rebirths)
	end
	Data:MarkDirty(player)
end

function Economy:Init(services)
	Services = services
	Data = services.DataService
end

function Economy:Start()
	local world = Services.WorldService

	Net:On("BuyPickaxe", 0.25, function(player)
		buyUpgrade(player, "Pickaxes", "PickaxeTier")
	end)
	Net:On("BuyBoots", 0.25, function(player)
		buyUpgrade(player, "Boots", "SpeedTier")
		Services.CharacterService:ApplyWalkSpeed(player)
	end)
	Net:On("UnlockZone", 0.5, function(player, index)
		if type(index) == "number" then
			self:UnlockZone(player, math.floor(index))
		end
	end)
	Net:On("Rebirth", 1, function(player)
		self:Rebirth(player)
	end)
	Net:On("Teleport", 1, function(player, index)
		local data = Data:Get(player)
		local character = player.Character
		if not data or not character or type(index) ~= "number" then
			return
		end
		index = math.floor(index)
		if index ~= 0 and (index < 1 or index > data.ZoneLevel) then
			Net:Notify(player, "Unlock that zone first!", RED)
			return
		end
		character:PivotTo(world:SpawnFor(index))
	end)
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--[[
	EventService: short random server events between meteors
	(Ore Frenzy, Lucky Rush, Gem Storm, Double Ore, Lucky Block Rain ...).
	Every few minutes there is something new happening -> players stay longer
	and talk about it.
	Every RaidEvery-th event is 🌙 THIEF NIGHT (announced 20s early): the
	only time other players' homes can be raided. Homes are safe otherwise.
	Other services read multipliers with Events:Get(key, default).

	Also:
	  * 🎉 weekly PARTY (Config.WeeklyParty): lucky block rain + starfall +
	    2x luck in every server at the same time, like the big games' weekly
	    admin events. The owner can start one everywhere from the DEV panel.
	  * global announcements (MessagingService): a TITANIC hatch is shouted
	    in every server.
]]
local MessagingService = game:GetService("MessagingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(script.Parent.Net)

local Events = {}
local Services

local TOPIC = "MeteorMiners_Global"
local settings = Config.Events
local PARTY = Config.WeeklyParty
local listeners = {}
local partyEnds = 0
local lastPartyDay = -1
local warnedDay = -1
local current = nil
local endsAt = 0
local nextAt = os.time() + 90 -- first event shortly after the server starts
local lastId = nil
local eventCount = 0
local raidAt = 0 -- 🌙 a raid was announced and starts at this time

local function setAttributes()
	workspace:SetAttribute("EventId", if current then current.Id else "")
	workspace:SetAttribute("EventEnd", endsAt)
	workspace:SetAttribute("RaidActive", current ~= nil and current.Raid == true)
	workspace:SetAttribute("RaidAt", raidAt)
end

local function find(id: string?)
	for _, candidate in settings.List do
		if candidate.Id == id then
			return candidate
		end
	end
	return nil
end

function Events:Active()
	return current
end

-- 🏠 homes are safe - except during a raid event (🌙 Thief Night)
function Events:RaidActive(): boolean
	return current ~= nil and current.Raid == true
end

function Events:Get(key: string, default: number): number
	if current and type(current[key]) == "number" then
		return current[key]
	end
	return default
end

-- start a specific event (id) or a random one different from the last
-- (random picks never choose NoRandom events: raids come every RaidEvery-th time)
function Events:Trigger(id: string?)
	local def = find(id)
	-- an announced or running 🌙 raid is never replaced (party / DEV events wait)
	if (raidAt > 0 or (current ~= nil and current.Raid)) and not (def and def.Raid) then
		return
	end
	if not def then
		local pool = {}
		for _, candidate in settings.List do
			if candidate.Id ~= lastId and not candidate.NoRandom then
				table.insert(pool, candidate)
			end
		end
		if #pool == 0 then
			return
		end
		def = pool[math.random(1, #pool)]
	end
	current = def
	lastId = def.Id
	raidAt = 0
	local duration = def.Duration or settings.DurationSeconds
	endsAt = os.time() + duration
	setAttributes()
	Net:Announce("%s! %s (%ds)", def.Color, def.Name, def.Description, duration)
	Net:Broadcast("EventStarted", def.Id)
	for _, listener in listeners do
		task.spawn(listener, def)
	end
end

-- the next scheduled event: every RaidEvery-th one is a raid, announced early
local function nextEvent()
	eventCount += 1
	local raid = nil
	if settings.RaidEvery and eventCount % settings.RaidEvery == 0 then
		for _, candidate in settings.List do
			if candidate.Raid then
				raid = candidate
			end
		end
	end
	if raid and (raid.Warn or 0) > 0 then
		raidAt = os.time() + raid.Warn
		nextAt = raidAt
		setAttributes()
		Net:Announce("🌙 THIEF NIGHT in %ds! Put your best pets in 🔒 vaults!", raid.Color, raid.Warn)
		Net:Broadcast("RaidWarning", raidAt)
	else
		Events:Trigger(if raid then raid.Id else nil)
	end
end

-- other services react to events (LuckyService: lucky block rain)
function Events:OnStart(callback)
	table.insert(listeners, callback)
end

---------------------------------------------------------------------------
-- every server at once (MessagingService)
---------------------------------------------------------------------------
local function publish(message)
	message.Job = game.JobId
	pcall(MessagingService.PublishAsync, MessagingService, TOPIC, message)
end

-- shout in this server + every other server (each player in their language)
function Events:GlobalAnnounce(fmt: string, color: Color3, ...)
	Net:Announce(fmt, color, ...)
	local args = { ... }
	for i, value in args do
		args[i] = tostring(value)
	end
	publish({ Kind = "Announce", Fmt = fmt, Args = args, Color = { color.R, color.G, color.B } })
end

function Events:PartyActive(): boolean
	return partyEnds > os.time()
end

-- 🎉 party: lucky block rain every few minutes, a starfall and 2x luck
function Events:StartParty(minutes: number): boolean
	if self:PartyActive() then
		return false
	end
	minutes = math.clamp(minutes, 1, 60)
	partyEnds = os.time() + minutes * 60
	workspace:SetAttribute("PartyEnd", partyEnds)
	Net:Announce("🎉 PARTY TIME! Lucky blocks, a starfall, a GIANT GOLDEN meteor and 2x luck!", Color3.fromRGB(255, 200, 80))
	Net:Broadcast("Party", partyEnds)
	if Services and Services.BoostService then
		Services.BoostService:AddServer("ServerLuck", minutes * 60)
	end
	self:Trigger("Starfall")
	-- ✨ and the next meteor is a GIANT GOLDEN one
	if Services and Services.MeteorService then
		Services.MeteorService:QueueSpecial("Giant", true)
	end
	task.spawn(function()
		while os.time() < partyEnds do
			local lucky = Services and Services.LuckyService
			if lucky then
				pcall(lucky.Rain, lucky, 8)
			end
			task.wait(PARTY.RainEvery)
		end
		workspace:SetAttribute("PartyEnd", 0)
	end)
	return true
end

-- the owner's "admin event": a party in EVERY server
function Events:GlobalParty(minutes: number)
	self:StartParty(minutes)
	if not RunService:IsStudio() then -- (a Studio test must never start a party in live servers)
		publish({ Kind = "Party", Minutes = minutes })
	end
end

local function onMessage(message)
	local data = message and message.Data
	if type(data) ~= "table" or data.Job == game.JobId then
		return
	end
	if data.Kind == "Announce" and type(data.Fmt) == "string" and type(data.Args) == "table" then
		local c = type(data.Color) == "table" and data.Color or { 1, 1, 1 }
		Net:Announce(data.Fmt, Color3.new(tonumber(c[1]) or 1, tonumber(c[2]) or 1, tonumber(c[3]) or 1), table.unpack(data.Args))
	elseif data.Kind == "Party" then
		Events:StartParty(tonumber(data.Minutes) or 10)
	end
end

-- the weekly party starts by itself (same UTC time in every server)
local function checkWeekly()
	local t = os.date("!*t")
	local day = math.floor(os.time() / 86400)
	if t.wday == PARTY.WeekDay and t.hour == PARTY.HourUTC and t.min < PARTY.Minutes and lastPartyDay ~= day then
		-- (if another party is still running, try again next second)
		if Events:StartParty(PARTY.Minutes - t.min) then
			lastPartyDay = day
		end
	elseif t.wday == PARTY.WeekDay and t.hour == PARTY.HourUTC - 1 and t.min >= 50 and warnedDay ~= day then
		warnedDay = day
		Net:Announce("🎉 The weekly PARTY starts in 10 minutes! Lucky blocks + 2x luck!", Color3.fromRGB(255, 200, 80))
	end
end

local function stop()
	if current then
		Net:Broadcast("EventEnded", current.Id)
	end
	current = nil
	endsAt = 0
	nextAt = os.time() + settings.IntervalSeconds
	setAttributes()
end

-- cloud tests: end the current event now
function Events:EndForTest()
	assert(not RunService:IsRunning(), "test hook used on a live server")
	stop()
	raidAt = 0
	setAttributes()
end

function Events:Init(services)
	Services = services
end

function Events:Start()
	setAttributes()
	workspace:SetAttribute("PartyEnd", 0)
	task.spawn(function()
		local ok, err = pcall(function()
			MessagingService:SubscribeAsync(TOPIC, onMessage)
		end)
		if not ok then
			warn("[Events] global messages unavailable: " .. tostring(err))
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(function()
				local now = os.time()
				checkWeekly()
				if current and now >= endsAt then
					stop()
				elseif not current and raidAt > 0 and now >= raidAt then
					local raid = nil
					for _, candidate in settings.List do
						if candidate.Raid then
							raid = candidate
						end
					end
					raidAt = 0
					self:Trigger(raid and raid.Id)
				elseif not current and raidAt == 0 and now >= nextAt then
					nextEvent()
				end
			end)
			if not ok then
				warn("[Events] loop error: " .. tostring(err))
				current = nil
				raidAt = 0
				nextAt = os.time() + settings.IntervalSeconds
				setAttributes()
			end
		end
	end)
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardService: global OrderedDataStore boards rendered on giant
	signs in the hub (Weekly ranked / Richest / Most rebirths).
	The weekly board resets every Monday (new store key per week); the global
	top 10 get gem rewards and in-server crown titles.
]]
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Leaderboards = {}
local Services
local Data

local MAX_VALUE = 2 ^ 53
local nameCache = {}
local storeCache = {}
local placementCache = {} -- [week] = { [userId] = place }
local currentTop = {} -- [boardKey] = entries

local function getStore(name: string)
	if storeCache[name] == nil then
		local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, Config.LeaderboardPrefix .. name)
		storeCache[name] = if ok then store else false
	end
	return storeCache[name] or nil
end

local function storeFor(board, week: number?)
	if board.Weekly then
		return getStore("Weekly_" .. (week or Util.WeekNumber()))
	end
	return getStore(board.Key)
end

local function valueFor(key: string, data): number
	if key == "Weekly" then
		return data.Weekly.Points
	elseif key == "LifetimeCoins" then
		return data.Stats.LifetimeCoins
	elseif key == "Rebirths" then
		return data.Rebirths
	elseif key == "Likes" then
		return data.Base and data.Base.Likes or 0
	end
	return 0
end

local function formatValue(key: string, value: number): string
	if key == "Weekly" then
		return Util.Comma(value) .. " pts"
	elseif key == "Likes" then
		return "❤️ " .. Util.Comma(value)
	end
	return Util.Format(value)
end

local function nameFor(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local player = Players:GetPlayerByUserId(userId)
	if player then
		nameCache[userId] = player.Name
		return player.Name
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	if ok and name then
		nameCache[userId] = name
		return name
	end
	return "Player"
end

local function buildBoardGui(part: BasePart)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.Parent = part

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Color3.fromRGB(20, 20, 32)
	root.BorderSizePixel = 0
	root.Parent = gui

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 16)
	padding.PaddingTop = UDim.new(0, 10)
	padding.Parent = root

	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0.13, 0)
	title.Font = Enum.Font.FredokaOne
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(255, 215, 80)
	Services.WorldService.SetText(title, part:GetAttribute("Title") or "LEADERBOARD")
	title.Parent = root

	local sub = Instance.new("TextLabel")
	sub.Name = "Sub"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.fromScale(0, 0.13)
	sub.Size = UDim2.new(1, 0, 0.06, 0)
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.TextColor3 = Color3.fromRGB(180, 180, 200)
	sub.Text = ""
	sub.Parent = root

	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0, 0.21)
	list.Size = UDim2.fromScale(1, 0.77)
	list.Parent = root
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 3)
	layout.Parent = list

	for i = 1, 10 do
		local row = Instance.new("Frame")
		row.Name = "Row" .. i
		row.LayoutOrder = i
		row.Size = UDim2.new(1, 0, 0.097, 0)
		row.BackgroundColor3 = if i % 2 == 0 then Color3.fromRGB(32, 32, 48) else Color3.fromRGB(40, 40, 60)
		row.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = row
		local color = if i == 1
			then Color3.fromRGB(255, 215, 60)
			elseif i == 2 then Color3.fromRGB(210, 220, 235)
			elseif i == 3 then Color3.fromRGB(230, 150, 80)
			else Color3.new(1, 1, 1)
		for _, spec in
			{
				{ "PlaceLabel", 0, 0.12, Enum.TextXAlignment.Center },
				{ "NameLabel", 0.13, 0.55, Enum.TextXAlignment.Left },
				{ "ValueLabel", 0.68, 0.31, Enum.TextXAlignment.Right },
			}
		do
			local label = Instance.new("TextLabel")
			label.Name = spec[1]
			label.BackgroundTransparency = 1
			label.Position = UDim2.fromScale(spec[2], 0.1)
			label.Size = UDim2.fromScale(spec[3], 0.8)
			label.Font = Enum.Font.FredokaOne
			label.TextScaled = true
			label.TextXAlignment = spec[4]
			label.TextColor3 = color
			label.Text = if spec[1] == "PlaceLabel" then "#" .. i else "-"
			label.Parent = row
		end
		row.Parent = list
	end
	return gui
end

local function render(board, entries)
	local part = Services.WorldService.Boards[board.Key]
	if not part then
		return
	end
	local gui = part:FindFirstChild("Board") or buildBoardGui(part)
	local root = gui:FindFirstChild("Root")
	local list = root:FindFirstChild("List")
	for i = 1, 10 do
		local row = list:FindFirstChild("Row" .. i)
		local entry = entries[i]
		local nameLabel = row:FindFirstChild("NameLabel") :: TextLabel
		local valueLabel = row:FindFirstChild("ValueLabel") :: TextLabel
		nameLabel.Text = if entry then nameFor(entry.UserId) else "-"
		valueLabel.Text = if entry then formatValue(board.Key, entry.Value) else ""
	end
	local sub = root:FindFirstChild("Sub") :: TextLabel
	if board.Weekly then
		Services.WorldService.SetText(sub, "Resets in %s • Top 10 win gems!", Util.FormatTime(Util.SecondsUntilNextWeek()))
	else
		Services.WorldService.SetText(sub, "All-time • Global")
	end
end

local function localEntries(key: string)
	local entries = {}
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		if data then
			table.insert(entries, { UserId = player.UserId, Value = math.floor(valueFor(key, data)) })
		end
	end
	table.sort(entries, function(a, b)
		return a.Value > b.Value
	end)
	return entries
end

local function fetchTop(store)
	local ok, pages = pcall(store.GetSortedAsync, store, false, 10)
	if not ok then
		return nil
	end
	local entries = {}
	for _, item in pages:GetCurrentPage() do
		table.insert(entries, { UserId = tonumber(item.key) or 0, Value = item.value })
	end
	return entries
end

local function updateTitles()
	local weekly = currentTop.Weekly or {}
	local titles = {}
	for place, entry in weekly do
		if place <= 3 then
			titles[entry.UserId] = ({ "👑 #1", "🥈 #2", "🥉 #3" })[place]
		elseif place <= 10 then
			titles[entry.UserId] = "⭐ TOP10"
		end
	end
	for _, player in Players:GetPlayers() do
		local title = titles[player.UserId] or ""
		if player:GetAttribute("Title") ~= title then
			player:SetAttribute("Title", title)
		end
	end
end

---------------------------------------------------------------------------
-- hall of fame: avatar statues of the all-time top players in the hub
---------------------------------------------------------------------------
local statueShown = {} -- [rank] = userId

local function statueFolder(): Folder?
	local map = workspace:FindFirstChild("Map")
	if not map then
		return nil
	end
	local folder = map:FindFirstChild("Statues")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Statues"
		folder.Parent = map
	end
	return folder :: Folder
end

local function plainStatue(): Model
	-- fallback when the avatar can't be loaded: a golden figure
	local model = Instance.new("Model")
	local gold = Color3.fromRGB(255, 205, 60)
	local function block(name, size, y)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = CFrame.new(0, y, 0)
		p.Color = gold
		p.Material = Enum.Material.Foil
		p.Parent = model
		return p
	end
	block("Legs", Vector3.new(2, 2, 1), 1)
	local torso = block("Torso", Vector3.new(2, 2, 1), 3)
	block("Head", Vector3.new(1.2, 1.2, 1.2), 4.6)
	model.PrimaryPart = torso
	return model
end

local function placeStatue(rank: number, entry)
	local folder = statueFolder()
	local spots = Services.WorldService.StatueSpots
	local spot = spots and spots[rank]
	if not folder or not spot then
		return
	end
	local old = folder:FindFirstChild("Statue" .. rank)
	if old then
		old:Destroy()
	end
	if not entry then
		return
	end
	local model = nil
	local ok = pcall(function()
		model = Players:CreateHumanoidModelFromUserId(entry.UserId)
	end)
	if not ok or not model then
		model = plainStatue()
	end
	model.Name = "Statue" .. rank
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
		elseif d:IsA("BaseScript") then
			d:Destroy()
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	pcall(function()
		model:ScaleTo(Config.Statues.Scale)
	end)
	local _, size = model:GetBoundingBox()
	model:PivotTo(spot * CFrame.new(0, size.Y / 2, 0))
	local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if anchor then
		local gui = Instance.new("BillboardGui")
		gui.Name = "Fame"
		gui.Size = UDim2.new(10, 0, 3, 0)
		gui.StudsOffsetWorldSpace = Vector3.new(0, size.Y / 2 + 2.4, 0)
		gui.LightInfluence = 0
		gui.MaxDistance = 140
		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = ({ Color3.fromRGB(255, 215, 70), Color3.fromRGB(220, 225, 235), Color3.fromRGB(230, 150, 90) })[rank]
			or Color3.new(1, 1, 1)
		label.Text = ({ "👑", "🥈", "🥉" })[rank]
			.. " #"
			.. rank
			.. " "
			.. nameFor(entry.UserId)
			.. "\n💰 "
			.. Util.Format(entry.Value)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2.5
		stroke.Parent = label
		label.Parent = gui
		gui.Parent = anchor
	end
	model.Parent = folder
end

local function updateStatues()
	local entries = currentTop[Config.Statues.Board] or {}
	for rank = 1, Config.Statues.Count do
		local entry = entries[rank]
		local id = entry and entry.UserId or 0
		if statueShown[rank] ~= id then
			statueShown[rank] = id
			local ok, err = pcall(placeStatue, rank, entry)
			if not ok then
				warn("[Leaderboards] statue failed: " .. tostring(err))
			end
		else
			-- same person: just refresh the number
			local folder = statueFolder()
			local model = folder and folder:FindFirstChild("Statue" .. rank)
			local label = model and model:FindFirstChild("Text", true)
			if label and label:IsA("TextLabel") and entry then
				label.Text = ({ "👑", "🥈", "🥉" })[rank]
					.. " #"
					.. rank
					.. " "
					.. nameFor(entry.UserId)
					.. "\n💰 "
					.. Util.Format(entry.Value)
			end
		end
	end
end
Leaderboards.UpdateStatues = updateStatues

local function refresh()
	-- push scores of everyone in this server
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		-- owner test mode: DEV-panel coins must not pollute the global boards
		local skip = Config.OwnerTestMode and Util.IsOwner(player)
		if data and not skip then
			for _, board in Config.Leaderboards.Boards do
				-- weekly points always go to the week they were earned in, so a
				-- refresh right after Monday 00:00 can't leak last week's points
				local store = if board.Weekly
					then (if data.Weekly.Week ~= 0 then storeFor(board, data.Weekly.Week) else nil)
					else storeFor(board)
				local value = math.floor(math.min(valueFor(board.Key, data), MAX_VALUE))
				if store and value > 0 then
					pcall(store.SetAsync, store, tostring(player.UserId), value)
				end
			end
		end
		task.wait(0.1)
	end
	-- pull global tops
	for _, board in Config.Leaderboards.Boards do
		local store = storeFor(board)
		local entries = store and fetchTop(store)
		if not entries then
			entries = localEntries(board.Key)
		end
		currentTop[board.Key] = entries
		render(board, entries)
	end
	updateTitles()
	task.spawn(updateStatues)
end

-- Returns the final placement (1-10) of a user in a past week, or nil.
function Leaderboards:GetWeeklyPlacement(week: number, userId: number): number?
	if not placementCache[week] then
		local weeklyBoard
		for _, board in Config.Leaderboards.Boards do
			if board.Weekly then
				weeklyBoard = board
			end
		end
		local store = weeklyBoard and storeFor(weeklyBoard, week)
		local entries = store and fetchTop(store)
		local map = {}
		for place, entry in entries or {} do
			map[entry.UserId] = place
		end
		placementCache[week] = map
	end
	return placementCache[week][userId]
end

function Leaderboards:Init(services)
	Services = services
	Data = services.DataService
end

function Leaderboards:Start()
	for _, board in Config.Leaderboards.Boards do
		local part = Services.WorldService.Boards[board.Key]
		if part then
			buildBoardGui(part)
		end
	end
	task.spawn(function()
		task.wait(10)
		while true do
			local ok, err = pcall(refresh)
			if not ok then
				warn("[Leaderboards] refresh failed: " .. tostring(err))
			end
			task.wait(Config.Leaderboards.RefreshSeconds)
		end
	end)
end

return Leaderboards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">LuckyService</string>
            <string name="Source"><![CDATA[--[[
	LuckyService: 🍀 lucky blocks.
	A few drop in the hub and on the base avenue every few minutes (lots
	during 🍀 LUCKY BLOCK RAIN and the weekly party). Hold to open one for a
	random surprise: coins, gems, boosts, a pet, a star egg to run home with,
	a HUGE pet, a gem jackpot... or a prank (launched into the sky, zapped).
	Great for "I opened 100 lucky blocks" moments.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Lucky = {}
local Services
local Data

local SETTINGS = Config.LuckyBlocks
local MAX_BLOCKS = 24
local rng = Random.new()
local blocks = {} -- [model] = true
local folder = nil

local GOOD = Color3.fromRGB(120, 255, 140)
local BAD = Color3.fromRGB(255, 150, 90)

local function count(): number
	local n = 0
	for model in blocks do
		if model.Parent then
			n += 1
		else
			blocks[model] = nil
		end
	end
	return n
end

-- somewhere open in the hub, or on the avenue between the houses
local function randomSpot(): Vector3
	for _ = 1, 30 do
		local spot
		if rng:NextNumber() < 0.6 then
			spot = Vector3.new(rng:NextNumber(-44, 44), 0, rng:NextNumber(-70, 66))
			local nearCrater = (spot - Config.Meteor.Position).Magnitude < 26
			local nearSpawn = (spot - Vector3.new(0, 0, -60)).Magnitude < 10
			local fame = spot.X < -12 and spot.Z > -14 and spot.Z < -2
			if not nearCrater and not nearSpawn and not fame then
				return spot
			end
		else
			local half = Config.World.Bases.HalfX - 20
			return Vector3.new(rng:NextNumber(-half, half), 0, Util.AvenueZ(Config) + rng:NextNumber(-8, 8))
		end
	end
	return Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(0, 20))
end

local function buildBlock(): Model
	local model = Instance.new("Model")
	model.Name = "LuckyBlock"
	local box = Instance.new("Part")
	box.Name = "Block"
	box.Anchored = true
	box.CanCollide = false
	box.Size = Vector3.one * 3.6
	box.Color = Color3.fromRGB(255, 205, 50)
	box.Material = Enum.Material.SmoothPlastic
	box.TopSurface = Enum.SurfaceType.Smooth
	box.BottomSurface = Enum.SurfaceType.Smooth
	box.Parent = model
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Top } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Text = "?"
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = Color3.new(1, 1, 1)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 6
		stroke.Color = Color3.fromRGB(170, 110, 0)
		stroke.Parent = label
		label.Parent = gui
		gui.Parent = box
	end
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 220, 110)
	glow.Range = 12
	glow.Brightness = 1.5
	glow.Parent = box
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 240, 150))
	sparkle.LightEmission = 1
	sparkle.Size = NumberSequence.new(0.4)
	sparkle.Lifetime = NumberRange.new(0.6, 1.2)
	sparkle.Rate = 6
	sparkle.Speed = NumberRange.new(1, 2)
	sparkle.Parent = box
	model.PrimaryPart = box
	model:SetAttribute("Spin", true)
	return model
end

-- the best coin egg the player has unlocked (pets from lucky blocks come from it)
local function zoneEgg(data): string
	local eggs = Config.Shards.ZoneEggs
	return eggs[math.clamp(data.ZoneLevel or 1, 1, #eggs)] or "Meadow"
end

-- open a block: roll a surprise and apply it
function Lucky:Open(player: Player, position: Vector3?)
	local data = Data:Get(player)
	if not data then
		return nil
	end
	data.Stats.LuckyBlocks = (data.Stats.LuckyBlocks or 0) + 1
	local entries = {}
	for index, outcome in SETTINGS.Outcomes do
		table.insert(entries, { index, outcome.Weight })
	end
	local outcome = SETTINGS.Outcomes[Util.WeightedPick(entries)]
	local kind = outcome.Kind
	local good = true
	if kind == "Coins" then
		local rate = Services.BaseService:IncomeRate(player, data)
		local amount = math.max(outcome.Min or 0, math.floor(rate * outcome.Seconds))
		data.Coins += amount
		data.Stats.LifetimeCoins += amount
		Services.Analytics:Economy(player, "Source", "Coins", amount, data.Coins, "Gameplay", "LuckyBlock")
		Net:Send(player, "Sold", amount)
		Net:Notify(player, "🍀 Lucky block: +💰%s!", GOOD, Util.Format(amount))
	elseif kind == "Gems" then
		local amount = rng:NextInteger(outcome.Min, outcome.Max)
		data.Gems += amount
		Net:Notify(player, "🍀 Lucky block: +💎%d!", GOOD, amount)
	elseif kind == "Boost" then
		Services.BoostService:Add(player, outcome.Boost, outcome.Seconds)
	elseif kind == "Pet" then
		Services.PetService:HatchStarEgg(player, zoneEgg(data), outcome.Luck or 1)
		Net:Notify(player, "🍀 Lucky block: a pet popped out!", GOOD)
	elseif kind == "StarEgg" then
		local shards = Services.ShardService
		if shards:IsCarrying(player) then
			data.Gems += 40
			Net:Notify(player, "🍀 Lucky block: +💎%d!", GOOD, 40)
		else
			shards:StartCarry(player, { Kind = "Egg", Rarity = outcome.Rarity, Egg = zoneEgg(data) }, nil)
			Net:Notify(player, "🍀 A star egg! Run it home before someone bonks you!", GOOD)
		end
	elseif kind == "Launch" then
		good = false
		Net:Send(player, "Launch", Vector3.new(0, 140, 0))
		Net:Notify(player, "💥 BOOM! It was a prank block!", BAD)
	elseif kind == "Zap" then
		good = false
		Services.CharacterService:Stun(player, outcome.Seconds)
		Net:Send(player, "Stunned", outcome.Seconds)
		Net:Notify(player, "⚡ ZAP! A prank block froze you!", BAD)
	elseif kind == "Huge" then
		local pick = Util.WeightedPick(Config.Eggs[zoneEgg(data)].Pets)
		Services.PetService:GrantPet(player, pick, "Huge")
		Net:Announce("🍀 %s found a HUGE %s in a lucky block!", Color3.fromRGB(255, 200, 60), player.DisplayName, pick)
	elseif kind == "Jackpot" then
		data.Gems += outcome.Gems
		Net:Announce("🍀 JACKPOT! %s won 💎%d from a lucky block!", Color3.fromRGB(255, 220, 90), player.DisplayName, outcome.Gems)
	end
	if position then
		Net:Broadcast(if good then "Confetti" else "Boom", position)
	end
	Services.ProgressionService:AddXP(player, 20)
	Services.Analytics:Custom(player, "LuckyBlock", 1)
	Data:MarkDirty(player)
	return kind
end

function Lucky:Spawn(position: Vector3?)
	if count() >= MAX_BLOCKS or not folder then
		return nil
	end
	local spot = position or randomSpot()
	local model = buildBlock()
	local ground = CFrame.new(spot + Vector3.new(0, 2.6, 0))
	model:PivotTo(ground + Vector3.new(0, 45, 0))
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Open"
	prompt.ObjectText = "Lucky Block"
	prompt.HoldDuration = SETTINGS.OpenHold
	prompt.MaxActivationDistance = 11
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = model.PrimaryPart
	prompt.Triggered:Connect(function(player)
		if not blocks[model] then
			return
		end
		blocks[model] = nil
		local where = model:GetPivot().Position
		model:Destroy()
		local ok, err = pcall(self.Open, self, player, where)
		if not ok then
			warn("[Lucky] open failed: " .. tostring(err))
		end
	end)
	blocks[model] = true
	model.Parent = folder
	-- drop from the sky
	task.spawn(function()
		for step = 1, 20 do
			if not model.Parent then
				return
			end
			local t = step / 20
			model:PivotTo(ground + Vector3.new(0, 45 * (1 - t * t), 0))
			task.wait(0.03)
		end
		if model.Parent then
			model:PivotTo(ground)
		end
	end)
	task.delay(SETTINGS.Lifetime, function()
		if blocks[model] then
			blocks[model] = nil
			model:Destroy()
		end
	end)
	return model
end

function Lucky:Rain(amount: number)
	for _ = 1, amount do
		self:Spawn(nil)
		task.wait(0.15)
	end
end

function Lucky:Init(services)
	Services = services
	Data = services.DataService
end

function Lucky:Start()
	local map = workspace:FindFirstChild("Map")
	folder = Instance.new("Folder")
	folder.Name = "LuckyBlocks"
	folder.Parent = map or workspace

	-- 🍀 LUCKY BLOCK RAIN event
	Services.EventService:OnStart(function(def)
		if def.LuckyBlocks then
			task.spawn(self.Rain, self, def.LuckyBlocks)
		end
	end)

	task.spawn(function()
		task.wait(40)
		while true do
			if #Players:GetPlayers() > 0 then
				local ok, err = pcall(self.Rain, self, SETTINGS.Count)
				if not ok then
					warn("[Lucky] spawn failed: " .. tostring(err))
				else
					Net:Announce("🍀 Lucky blocks just dropped! Find them!", GOOD)
				end
			end
			task.wait(rng:NextNumber(SETTINGS.MinInterval, SETTINGS.MaxInterval))
		end
	end)
end

return Lucky
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">MeteorService</string>
            <string name="Source"><![CDATA[--[[
	MeteorService: ☄️ METEOR RUSH - the heart of the game (docs/METEOR_RUSH.md).

	Every ~3 minutes:
	  1) WARNING (20s): a landing marker (red ring + light pillar + countdown)
	     appears at a random site - the hub, the base avenue or a mine zone.
	     "GO" (only now) teleports you to that area's entrance.
	  2) FALLING: the meteor crashes in (camera shake).
	  3) ACTIVE: everyone smashes it; score per hit = 1 + log10(damage), the
	     HP grows with every new participant so a crack takes ~30-40s.
	  4) BURST: star eggs of the meteor's kind (the top 3 get a head start,
	     the best eggs get a guardian), coin chunks, sometimes a lucky block.
	  Then the race home: carriers can be bonked and drop their egg.

	Meteor kind = a zone's eggs (🌿 Meadow ... 🌌 Cosmic); size Small / Big /
	Giant; 8% are ✨ GOLDEN (2x egg luck, 3x coin chunks). Cracking a kind for
	the first time fills the meteor index (+💎).

	New players get a small TUTORIAL meteor of their own next to the spawn.
]]
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Meteor = {}
local Services
local Data
local World

local settings = Config.Meteor
local rng = Random.new()
local state = "Idle" -- Idle | Warning | Falling | Active | Ending
local nextAt = os.time() + (settings.FirstSeconds or settings.IntervalSeconds)
local warnEnd = 0
local endsAt = 0
local hp, maxHp = 0, 0
local scores = {} -- [player] = score
local meteorPart: BasePart? = nil
local marker: Model? = nil
local summoner: Player? = nil
local summonQueue = {}
local special = nil -- forced size / golden for the next meteor (party "mega meteor")
local current = nil -- the meteor of this round (site, kind, size, golden)
local tutorialMeteors = {} -- [player] = { Part, Hits, Label }
local chunks = {} -- [part] = { Golden = bool }

local SITE_NAMES = { Hub = "Hub", Avenue = "Base Avenue" }

local function setAttributes()
	workspace:SetAttribute("MeteorState", state)
	workspace:SetAttribute("MeteorNext", nextAt)
	workspace:SetAttribute("MeteorWarnEnd", warnEnd)
	workspace:SetAttribute("MeteorEnd", endsAt)
	workspace:SetAttribute("MeteorHP", hp)
	workspace:SetAttribute("MeteorMaxHP", maxHp)
	workspace:SetAttribute("MeteorKind", if current then settings.Kinds[current.Kind].Name else "")
	workspace:SetAttribute("MeteorIcon", if current then settings.Kinds[current.Kind].Icon else "")
	workspace:SetAttribute("MeteorSize", if current then current.Size.Name else "")
	workspace:SetAttribute("MeteorGolden", current ~= nil and current.Golden)
	workspace:SetAttribute("MeteorSite", if current then current.SiteName else "")
	workspace:SetAttribute("MeteorSiteZone", if current then current.SiteZone else 0)
	workspace:SetAttribute("MeteorPos", if current then current.Position else Vector3.zero)
	workspace:SetAttribute("MeteorRadius", if current then current.Size.Radius else settings.Radius)
end

function Meteor:IsActive(): boolean
	return state == "Active"
end

function Meteor:Current()
	return current
end

function Meteor:InRange(position: Vector3): boolean
	if not meteorPart or not current then
		return false
	end
	return (position - meteorPart.Position).Magnitude <= current.Size.Radius + Config.World.Reach + 2
end

local function ranking()
	local list = {}
	for player, score in scores do
		if player.Parent then
			table.insert(list, { Player = player, Score = score })
		end
	end
	table.sort(list, function(a, b)
		return a.Score > b.Score
	end)
	return list
end

local function maxZoneInServer(): number
	local best = 1
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		if data then
			best = math.max(best, data.ZoneLevel)
		end
	end
	return math.clamp(best, 1, math.min(#Config.Zones, #settings.Kinds))
end

local function weighted(list)
	local entries = {}
	for index, entry in list do
		table.insert(entries, { index, entry.Weight })
	end
	return list[Util.WeightedPick(entries, nil, rng)]
end

-- where (and what) the next meteor is
function Meteor:PickSite(forceType: string?, forceZone: number?)
	local maxZone = maxZoneInServer()
	local siteType = forceType or weighted(settings.Sites).Kind
	local position, siteName, siteZone, lootZone
	if siteType == "Zone" and World.Zones[1] then
		siteZone = if forceZone and World.Zones[forceZone] then forceZone else rng:NextInteger(1, maxZone)
		local info = World.Zones[siteZone]
		position = Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(info.ZStart + 22, info.ZEnd - 16))
		siteName = Config.Zones[siteZone].Name
		lootZone = siteZone
	elseif siteType == "Avenue" then
		local xs = settings.AvenueX
		position = Vector3.new(xs[rng:NextInteger(1, #xs)], 0, Util.AvenueZ(Config))
		siteName = SITE_NAMES.Avenue
		siteZone = 0
		lootZone = rng:NextInteger(1, maxZone)
	else
		siteType = "Hub"
		local spots = settings.HubSpots
		position = spots[rng:NextInteger(1, #spots)]
		siteName = SITE_NAMES.Hub
		siteZone = 0
		lootZone = rng:NextInteger(1, maxZone)
	end
	local size = weighted(settings.Sizes)
	return {
		Type = siteType,
		SiteName = siteName,
		SiteZone = siteZone,
		Position = position,
		Kind = lootZone,
		Size = size,
		Golden = rng:NextNumber() < settings.GoldenChance,
	}
end

---------------------------------------------------------------------------
-- models
---------------------------------------------------------------------------
local function buildMeteor(radius: number, color: Color3, golden: boolean): BasePart
	local part = Instance.new("Part")
	part.Name = "Meteor"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one * radius * 2
	part.Material = if golden then Enum.Material.Foil else Enum.Material.Basalt
	part.Color = if golden then Color3.fromRGB(255, 200, 60) else Color3.fromRGB(70, 50, 45)
	part.Anchored = true
	part.CanCollide = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part:SetAttribute("Radius", radius)

	-- ☄️ a rough space rock: boulders on the surface, glowing lava veins and
	-- molten patches, all welded to the round core (that's the hit target)
	local veinColor = if golden then Color3.fromRGB(255, 225, 110) else color:Lerp(Color3.fromRGB(255, 150, 40), 0.55)
	local function stuck(name: string, size: Vector3, cf: CFrame, partColor: Color3, material: Enum.Material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = partColor
		p.Material = material
		p.Anchored = false
		p.Massless = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape then
			p.Shape = shape
		end
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = part
		weld.Part1 = p
		weld.Parent = p
		p.Parent = part
		return p
	end
	local rockRng = Random.new()
	local origin = part.CFrame
	for i = 1, 14 do
		-- spread directions over the sphere (golden angle spiral)
		local y = 1 - (i - 0.5) / 14 * 2
		local ring = math.sqrt(1 - y * y)
		local theta = i * 2.39996
		local direction = Vector3.new(math.cos(theta) * ring, y, math.sin(theta) * ring)
		local size = radius * rockRng:NextNumber(0.45, 0.8)
		stuck(
			"Shell",
			Vector3.new(size, size * rockRng:NextNumber(0.6, 0.9), size * rockRng:NextNumber(0.8, 1.1)),
			CFrame.new(origin.Position + direction * radius * 0.78)
				* CFrame.Angles(rockRng:NextNumber(0, 6.2), rockRng:NextNumber(0, 6.2), rockRng:NextNumber(0, 6.2)),
			if golden
				then Color3.fromRGB(230, 180, 60):Lerp(Color3.new(0, 0, 0), rockRng:NextNumber(0, 0.25))
				else Color3.fromRGB(62, 48, 44):Lerp(Color3.fromRGB(20, 16, 16), rockRng:NextNumber(0, 0.6)),
			if golden then Enum.Material.Foil elseif i % 3 == 0 then Enum.Material.Slate else Enum.Material.Basalt
		)
	end
	for i = 1, 8 do
		-- glowing cracks running over the surface
		local direction = Vector3.new(rockRng:NextNumber(-1, 1), rockRng:NextNumber(-1, 1), rockRng:NextNumber(-1, 1)).Unit
		stuck(
			"Vein",
			Vector3.new(0.35, radius * rockRng:NextNumber(0.7, 1.2), 0.35),
			CFrame.lookAt(origin.Position + direction * radius * 0.98, origin.Position + direction * radius * 2)
				* CFrame.Angles(math.rad(90), 0, rockRng:NextNumber(0, 6.2)),
			veinColor,
			Enum.Material.Neon
		)
		if i <= 4 then
			stuck(
				"Molten",
				Vector3.one * radius * rockRng:NextNumber(0.35, 0.55),
				CFrame.new(origin.Position + direction * radius * 0.82),
				veinColor,
				Enum.Material.CrackedLava,
				Enum.PartType.Ball
			)
		end
	end
	local core = stuck("Core", part.Size * 0.6, origin, veinColor, Enum.Material.Neon, Enum.PartType.Ball)
	core.Transparency = 0.5
	-- smoke + embers + a fiery tail while it falls
	local smoke = Instance.new("ParticleEmitter")
	smoke.Name = "Smoke"
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(90, 80, 80), Color3.fromRGB(40, 36, 36))
	smoke.Size = NumberSequence.new(radius * 0.6, radius * 1.6)
	smoke.Transparency = NumberSequence.new(0.35, 1)
	smoke.Lifetime = NumberRange.new(1.5, 2.5)
	smoke.Rate = 12
	smoke.Speed = NumberRange.new(1, 3)
	smoke.SpreadAngle = Vector2.new(40, 40)
	smoke.Parent = part
	local embers = Instance.new("ParticleEmitter")
	embers.Name = "Embers"
	embers.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	embers.Color = ColorSequence.new(veinColor)
	embers.LightEmission = 1
	embers.Size = NumberSequence.new(0.5, 0)
	embers.Lifetime = NumberRange.new(0.8, 1.6)
	embers.Rate = 25
	embers.Speed = NumberRange.new(3, 8)
	embers.SpreadAngle = Vector2.new(180, 180)
	embers.Acceleration = Vector3.new(0, 6, 0)
	embers.Parent = part
	local top = Instance.new("Attachment")
	top.Position = Vector3.new(0, radius * 0.6, 0)
	top.Parent = part
	local bottom = Instance.new("Attachment")
	bottom.Position = Vector3.new(0, -radius * 0.6, 0)
	bottom.Parent = part
	local trail = Instance.new("Trail")
	trail.Name = "Tail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = ColorSequence.new(veinColor, Color3.fromRGB(255, 90, 40))
	trail.LightEmission = 0.8
	trail.Lifetime = 0.9
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.WidthScale = NumberSequence.new(1, 0.2)
	trail.FaceCamera = true
	trail.Parent = part

	local light = Instance.new("PointLight")
	light.Color = veinColor
	light.Range = 40
	light.Brightness = 2.5
	light.Parent = part

	local fire = Instance.new("Fire")
	fire.Size = radius * 1.6
	fire.Heat = 12
	fire.Color = color
	fire.SecondaryColor = Color3.fromRGB(255, 220, 80)
	fire.Parent = part

	local gui = Instance.new("BillboardGui")
	gui.Name = "HPBar"
	gui.Size = UDim2.new(18, 0, 2, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, radius + 5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
	back.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = back
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = core.Color
	fill.BorderSizePixel = 0
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0.5, 0)
	fillCorner.Parent = fill
	fill.Parent = back
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = Color3.new(1, 1, 1)
	text.Text = "☄️ METEOR"
	text.ZIndex = 2
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = text
	text.Parent = back
	back.Parent = gui
	gui.Parent = part
	return part
end

-- the landing marker everybody runs to: red ring, light pillar, countdown
local function buildMarker(site): Model
	local model = Instance.new("Model")
	model.Name = "MeteorMarker"
	local color = if site.Golden then Color3.fromRGB(255, 210, 70) else settings.Kinds[site.Kind].Color
	local diameter = site.Size.Radius * 2 + 8
	local ring = Instance.new("Part")
	ring.Name = "Ring"
	ring.Shape = Enum.PartType.Cylinder
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 70, 60)
	ring.Transparency = 0.35
	ring.Size = Vector3.new(0.3, diameter, diameter)
	ring.CFrame = CFrame.new(site.Position + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = model
	local pillar = Instance.new("Part")
	pillar.Name = "Pillar"
	pillar.Shape = Enum.PartType.Cylinder
	pillar.Anchored = true
	pillar.CanCollide = false
	pillar.CanQuery = false
	pillar.CanTouch = false
	pillar.Material = Enum.Material.Neon
	pillar.Color = color
	pillar.Transparency = 0.55
	pillar.Size = Vector3.new(220, 3, 3)
	pillar.CFrame = CFrame.new(site.Position + Vector3.new(0, 110, 0)) * CFrame.Angles(0, 0, math.rad(90))
	pillar.Parent = model
	local gui = Instance.new("BillboardGui")
	gui.Name = "Countdown"
	gui.Size = UDim2.fromOffset(230, 56)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 12, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 1500
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = ring
	model.PrimaryPart = ring
	model.Parent = World:Folder("Drops")
	return model
end

local function updateMarker()
	local gui = marker and marker.PrimaryPart and marker.PrimaryPart:FindFirstChild("Countdown")
	local label = gui and gui:FindFirstChild("Text")
	if label and current then
		local kind = settings.Kinds[current.Kind]
		World.SetText(label, "☄️ %s %s  %ds", kind.Icon, kind.Name, math.max(0, warnEnd - os.time()))
	end
end

local function updateBar()
	if not meteorPart then
		return
	end
	local gui = meteorPart:FindFirstChild("HPBar")
	local back = gui and gui:FindFirstChildOfClass("Frame")
	if back then
		local ratio = if maxHp > 0 then math.clamp(hp / maxHp, 0, 1) else 0
		(back :: any).Fill.Size = UDim2.fromScale(ratio, 1)
		World.SetText((back :: any).Text, "☄️ METEOR  %s%%", math.ceil(ratio * 100))
	end
end

local function shatter(position: Vector3, color: Color3?)
	local folder = World:Folder("Drops")
	for _ = 1, 14 do
		local chunk = Instance.new("Part")
		chunk.Name = "MeteorChunk"
		chunk.Size = Vector3.one * math.random(15, 35) / 10
		chunk.Material = Enum.Material.Basalt
		chunk.Color = color or Color3.fromRGB(80, 55, 45)
		chunk.CanCollide = false
		chunk.CanQuery = false
		chunk.Position = position + Vector3.new(math.random(-4, 4), math.random(0, 4), math.random(-4, 4))
		chunk.AssemblyLinearVelocity = Vector3.new(math.random(-40, 40), math.random(40, 80), math.random(-40, 40))
		chunk.Parent = folder
		Debris:AddItem(chunk, 3)
	end
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastPressure = 0
	explosion.BlastRadius = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.Parent = workspace
end

---------------------------------------------------------------------------
-- coin chunks: walk over them for instant coins (scaled to your base)
---------------------------------------------------------------------------
function Meteor:ClaimChunk(player: Player, part: BasePart): number?
	local info = chunks[part]
	local data = Data:Get(player)
	if not info or not data then
		return nil
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or (root.Position - part.Position).Magnitude > 14 then
		return nil -- (touches are reported by clients: you must really be there)
	end
	chunks[part] = nil
	part:Destroy()
	local cfg = settings.Chunks
	local rate = Services.BaseService:IncomeRate(player, data)
	local amount = math.max(cfg.Min, math.floor(rate * cfg.Seconds))
	if info.Golden then
		amount *= cfg.GoldenMult
	end
	data.Coins += amount
	data.Stats.LifetimeCoins += amount
	Services.Analytics:Economy(player, "Source", "Coins", amount, data.Coins, "Gameplay", "MeteorChunk")
	Net:Send(player, "Sold", amount)
	Data:MarkDirty(player)
	return amount
end

local function spawnChunks(position: Vector3, count: number, golden: boolean, narrow: boolean?)
	local folder = World:Folder("Drops")
	for i = 1, count do
		local angle = (i / count) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local radius = rng:NextNumber(5, 13)
		local squash = if narrow then 0.6 else 1
		local part = Instance.new("Part")
		part.Name = "CoinChunk"
		part.Shape = Enum.PartType.Ball
		part.Size = Vector3.one * 1.6
		part.Material = Enum.Material.Neon
		part.Color = if golden then Color3.fromRGB(255, 235, 120) else Color3.fromRGB(255, 200, 60)
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = true
		part.CFrame = CFrame.new(position.X + math.cos(angle) * radius, 1, position.Z + math.sin(angle) * radius * squash)
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = part.Color
		sparkle.Parent = part
		part.Parent = folder
		chunks[part] = { Golden = golden }
		part.Touched:Connect(function(hit)
			local character = hit:FindFirstAncestorOfClass("Model")
			local player = character and Players:GetPlayerFromCharacter(character)
			if player then
				Meteor:ClaimChunk(player, part)
			end
		end)
		task.delay(settings.Chunks.Lifetime, function()
			if chunks[part] then
				chunks[part] = nil
				part:Destroy()
			end
		end)
	end
end
Meteor.SpawnChunks = spawnChunks

function Meteor:ChunksForTest()
	assert(not RunService:IsRunning(), "test hook used on a live server")
	return chunks
end

---------------------------------------------------------------------------
-- the round
---------------------------------------------------------------------------
local function finish(destroyed: boolean)
	if state ~= "Active" then
		return
	end
	state = "Ending"
	local list = ranking()
	local total = 0 -- (real players only: 🤖 robots don't shrink anyone's share)
	for _, entry in list do
		if not entry.Player.IsRival then
			total += entry.Score
		end
	end
	local mult = if destroyed then 1 else settings.FailedMultiplier
	local progression = Services.ProgressionService
	local topNames = {}
	local kind = current and settings.Kinds[current.Kind]

	for place, entry in list do
		local player = entry.Player
		local data = if player.IsRival then nil else Data:Get(player)
		if player.IsRival and settings.PlaceRewards[place] then
			table.insert(topNames, player.DisplayName) -- 🤖 robots can win places too
		end
		if data then
			local share = if total > 0 then entry.Score / total else 0
			local stardust = settings.ParticipationStardust + math.floor(share * settings.ShareStardust)
			local gems = 0
			local points = settings.ParticipationPoints
			local placeReward = settings.PlaceRewards[place]
			if placeReward then
				stardust += placeReward.Stardust
				gems += placeReward.Gems
				points = placeReward.Points
				table.insert(topNames, player.DisplayName)
			end
			stardust = math.floor(stardust * mult)
			gems = math.floor(gems * mult)
			if player == summoner then
				stardust *= 2
			end
			-- ☄️ meteor index: first crack of a kind pays extra
			local firstCrack = false
			if destroyed and current then
				local key = tostring(current.Kind)
				firstCrack = (data.MeteorIndex[key] or 0) == 0
				data.MeteorIndex[key] = (data.MeteorIndex[key] or 0) + 1
				if firstCrack then
					gems += settings.FirstCrackGems
				end
			end
			data.Stardust += stardust
			data.Gems += gems
			data.Stats.MeteorJoins += 1
			if destroyed then
				-- 🌱 the pets that helped grow
				pcall(Services.PetService.AddFollowXP, Services.PetService, player, Config.Growth.MeteorXP)
			end
			if place == 1 and destroyed then
				data.Stats.MeteorWins += 1
			end
			progression:AddQuest(player, "MeteorJoin", 1)
			if place <= 3 then
				progression:AddQuest(player, "MeteorTop3", 1)
			end
			progression:AddPoints(player, points)
			progression:AddSeasonXP(player, settings.PassXP)
			Net:Send(player, "MeteorResult", {
				Place = place,
				Total = #list,
				Stardust = stardust,
				Gems = gems,
				Points = points,
				Destroyed = destroyed,
				Kind = kind and kind.Name,
				Icon = kind and kind.Icon,
				FirstCrack = firstCrack,
			})
			Data:MarkDirty(player)
		end
	end

	local medals = { "🥇", "🥈", "🥉" }
	local parts = {}
	for i, name in topNames do
		table.insert(parts, medals[i] .. " " .. name)
	end
	local headline = if destroyed then "☄️ Meteor smashed! Grab the star eggs! %s" else "☄️ The meteor escaped! %s"
	Net:Announce(headline, Color3.fromRGB(255, 170, 80), table.concat(parts, "  "))

	local ground = if current then current.Position else settings.Position
	if meteorPart then
		local position = meteorPart.Position
		meteorPart:Destroy()
		meteorPart = nil
		shatter(position, kind and kind.Color)
	end
	if destroyed and current then
		local spill = settings.Spill
		-- the big payoff: star eggs to race for, coin chunks, maybe a lucky block
		local ok, err = pcall(function()
			Services.ShardService:SpillMeteor(Vector3.new(ground.X, 0, ground.Z), list, {
				Egg = kind.Egg,
				Kind = current.Kind,
				Golden = current.Golden,
				Luck = spill.Luck * (if current.Golden then spill.GoldenLuck else 1),
				Extra = current.Size.Eggs,
				Narrow = current.Type == "Avenue",
			})
		end)
		if not ok then
			warn("[Meteor] egg spill failed: " .. tostring(err))
		end
		local narrow = current.Type == "Avenue"
		spawnChunks(Vector3.new(ground.X, 0, ground.Z), settings.Chunks.Count, current.Golden, narrow)
		if rng:NextNumber() < spill.LuckyChance and Services.LuckyService then
			local offset = if narrow then Vector3.new(16, 0, 0) else Vector3.new(rng:NextNumber(-8, 8), 0, 14)
			pcall(Services.LuckyService.Spawn, Services.LuckyService, Vector3.new(ground.X, 0, ground.Z) + offset)
		end
		workspace:SetAttribute("MeteorLootUntil", os.time() + 25)
	end
	scores = {}
	summoner = nil
	hp, maxHp = 0, 0
	current = nil
	state = "Idle"
	nextAt = os.time() + settings.IntervalSeconds
	setAttributes()
	Net:Broadcast("MeteorRank", {})
end

-- back to a clean idle state so a failure never stops future events
local function resetToIdle()
	if meteorPart then
		meteorPart:Destroy()
		meteorPart = nil
	end
	if marker then
		marker:Destroy()
		marker = nil
	end
	scores = {}
	summoner = nil
	hp, maxHp = 0, 0
	current = nil
	state = "Idle"
	nextAt = os.time() + settings.IntervalSeconds
	setAttributes()
	Net:Broadcast("MeteorRank", {})
end

local function safeFinish(destroyed: boolean)
	local ok, err = pcall(finish, destroyed)
	if not ok then
		warn("[Meteor] finish failed: " .. tostring(err))
		resetToIdle()
	end
end

-- cooldown is the attacker's swing cooldown, used to size the meteor so the
-- event lasts about SecondsPerParticipant no matter how strong players are
function Meteor:Hit(player: Player, damage: number, cooldown: number?)
	if state ~= "Active" or not current then
		return
	end
	local score = 1 + math.log10(math.max(1, damage))
	if not scores[player] then
		-- each new participant makes the meteor tougher by ~N seconds of their own hitting
		local extra = settings.SecondsPerParticipant * current.Size.HP * score / math.max(0.2, cooldown or 0.5)
		maxHp += extra
		hp += extra
		workspace:SetAttribute("MeteorMaxHP", maxHp)
	end
	scores[player] = (scores[player] or 0) + score
	hp = math.max(0, hp - score)
	workspace:SetAttribute("MeteorHP", hp)
	updateBar()
	Net:Send(player, "MeteorHit", score)
	if hp <= 0 then
		safeFinish(true)
	end
end

-- a rival robot left: drop its score
function Meteor:Forget(entity)
	scores[entity] = nil
end

function Meteor:ScoreOf(who): number
	return scores[who] or 0
end

-- 🐾 following pets add score for a player who is already smashing
function Meteor:PetHit(player: Player, pets: number, damage: number): boolean
	if state ~= "Active" or not scores[player] or pets <= 0 then
		return false
	end
	local score = pets * Config.PetHelp.MeteorShare * (1 + math.log10(math.max(1, damage)))
	scores[player] += score
	hp = math.max(0, hp - score)
	workspace:SetAttribute("MeteorHP", hp)
	updateBar()
	if hp <= 0 then
		safeFinish(true)
	end
	return true
end

function Meteor:Position(): Vector3?
	return if meteorPart then meteorPart.Position else nil
end

function Meteor:Summon(player: Player)
	table.insert(summonQueue, player)
	if state == "Idle" then
		Net:Notify(player, "☄️ Your meteor is on its way!", Color3.fromRGB(255, 170, 80))
	else
		Net:Notify(player, "☄️ Your meteor will fall right after the current one!", Color3.fromRGB(255, 170, 80))
	end
end

-- the party's MEGA meteor: the next one is giant + golden, and comes soon
function Meteor:QueueSpecial(sizeId: string, golden: boolean)
	special = { Size = sizeId, Golden = golden }
	if state == "Idle" then
		nextAt = math.min(nextAt, os.time() + 10)
		setAttributes()
	end
end

local function startWarning(forced)
	local summoned = table.remove(summonQueue, 1)
	if summoned and not summoned.Parent then
		summoned = nil
	end
	summoner = summoned
	if summoned and not forced then
		-- a summoned meteor lands where its summoner is (hub / avenue / their mine)
		local character = summoned.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local position = if root and root:IsA("BasePart") then root.Position else nil
		local zone = position and Util.ZoneAt(Config, position)
		if zone and zone > 0 then
			forced = Meteor:PickSite("Zone", zone)
		elseif position and Util.InBases(Config, position) then
			forced = Meteor:PickSite("Avenue")
		else
			forced = Meteor:PickSite("Hub")
		end
	end
	current = forced or Meteor:PickSite()
	if special then
		for _, size in settings.Sizes do
			if size.Id == special.Size then
				current.Size = size
			end
		end
		current.Golden = current.Golden or special.Golden
		special = nil
	end
	state = "Warning"
	warnEnd = os.time() + (if summoned then settings.SummonWarningSeconds else settings.WarningSeconds)
	if marker then
		marker:Destroy()
	end
	marker = buildMarker(current)
	updateMarker()
	setAttributes()
	local kind = settings.Kinds[current.Kind]
	local seconds = warnEnd - os.time()
	if summoned then
		Net:Announce(
			"☄️ %s SUMMONED A METEOR! It lands on %s! (%ds)",
			Color3.fromRGB(255, 150, 60),
			summoned.DisplayName,
			current.SiteName,
			seconds
		)
	elseif current.Golden then
		Net:Announce("✨ A GOLDEN %s is falling on %s! (%ds)", Color3.fromRGB(255, 215, 80), kind.Name, current.SiteName, seconds)
	else
		Net:Announce("☄️ A %s %s is falling on %s! (%ds)", kind.Color, current.Size.Name, kind.Name, current.SiteName, seconds)
	end
end

local function startFalling()
	state = "Falling"
	setAttributes()
	local kind = settings.Kinds[current.Kind]
	local radius = current.Size.Radius
	local final = current.Position + Vector3.new(0, radius * 0.6, 0)
	local part = buildMeteor(radius, kind.Color, current.Golden)
	part:PivotTo(CFrame.new(final + Vector3.new(60, 320, 40)))
	part.Parent = World:Folder("Drops")
	meteorPart = part
	local info = TweenInfo.new(2.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	-- (tweening the anchored core's CFrame carries the welded rock with it)
	TweenService:Create(part, info, { CFrame = CFrame.new(final) * CFrame.Angles(1.2, 0.8, 0.4) }):Play()
	task.wait(2.25)
	-- calmer once it has landed: less smoke, no tail
	local tail = part:FindFirstChild("Tail")
	if tail then
		tail.Enabled = false
	end
	local smokeAfter = part:FindFirstChild("Smoke")
	if smokeAfter and smokeAfter:IsA("ParticleEmitter") then
		smokeAfter.Rate = 4
	end
	-- a scorched crater with rubble around the impact
	local crater = Instance.new("Model")
	crater.Name = "Crater"
	local scorch = Instance.new("Part")
	scorch.Name = "Scorch"
	scorch.Shape = Enum.PartType.Cylinder
	scorch.Anchored = true
	scorch.CanCollide = false
	scorch.CanQuery = false
	scorch.CanTouch = false
	scorch.Size = Vector3.new(0.2, radius * 3.2, radius * 3.2)
	scorch.CFrame = CFrame.new(current.Position + Vector3.new(0, 0.08, 0)) * CFrame.Angles(0, 0, math.rad(90))
	scorch.Color = Color3.fromRGB(35, 28, 26)
	scorch.Material = Enum.Material.Basalt
	scorch.Parent = crater
	local rubbleRng = Random.new()
	for i = 1, 12 do
		local angle = i / 12 * math.pi * 2 + rubbleRng:NextNumber(-0.2, 0.2)
		local size = rubbleRng:NextNumber(1.2, 2.6)
		local rubble = Instance.new("Part")
		rubble.Name = "Rubble"
		rubble.Anchored = true
		rubble.CanCollide = false
		rubble.CanQuery = false
		rubble.CanTouch = false
		rubble.Size = Vector3.new(size, size * 0.7, size)
		rubble.CFrame = CFrame.new(
			current.Position
				+ Vector3.new(math.cos(angle), 0, math.sin(angle)) * radius * rubbleRng:NextNumber(1.25, 1.55)
				+ Vector3.new(0, size * 0.25, 0)
		) * CFrame.Angles(rubbleRng:NextNumber(0, 3), rubbleRng:NextNumber(0, 3), rubbleRng:NextNumber(0, 3))
		rubble.Color = Color3.fromRGB(70, 58, 52)
		rubble.Material = Enum.Material.Basalt
		rubble.Parent = crater
	end
	crater.Parent = World:Folder("Drops")
	Debris:AddItem(crater, settings.DurationSeconds + 40)
	if marker then
		marker:Destroy()
		marker = nil
	end
	local explosion = Instance.new("Explosion")
	explosion.Position = final
	explosion.BlastPressure = 0
	explosion.BlastRadius = 0
	explosion.DestroyJointRadiusPercent = 0
	explosion.Parent = workspace
	Net:Broadcast("MeteorImpact", final)

	maxHp = settings.BaseHP * current.Size.HP
	hp = maxHp
	scores = {}
	endsAt = os.time() + settings.DurationSeconds
	state = "Active"
	setAttributes()
	updateBar()
end

---------------------------------------------------------------------------
-- tutorial: a small meteor just for one player, next to the spawn
---------------------------------------------------------------------------
function Meteor:TutorialMeteor(player: Player)
	if tutorialMeteors[player] then
		return
	end
	local cfg = settings.Tutorial
	local position = cfg.Position + Vector3.new(rng:NextNumber(-5, 5), 0, rng:NextNumber(-4, 4))
	local entry = { Hits = 0 }
	tutorialMeteors[player] = entry
	Net:Send(player, "StarFall", position, "Epic", 1.4)
	task.delay(1.4, function()
		if tutorialMeteors[player] ~= entry or not player.Parent then
			return
		end
		local kind = settings.Kinds[1]
		local part = buildMeteor(cfg.Radius, kind.Color, false)
		part.Name = "TutorialMeteor_" .. tostring(player.UserId)
		part:SetAttribute("OwnerId", player.UserId)
		part:PivotTo(CFrame.new(position + Vector3.new(0, cfg.Radius * 0.6, 0)))
		local tail = part:FindFirstChild("Tail")
		if tail then
			tail.Enabled = false
		end
		part.Parent = World:Folder("Drops")
		entry.Part = part
		local gui = part:FindFirstChild("HPBar")
		local back = gui and gui:FindFirstChildOfClass("Frame")
		entry.Back = back
		if back then
			World.SetText((back :: any).Text, "☄️ %d", cfg.Hits)
		end
		Net:Send(player, "MeteorImpact", part.Position)
		Net:Notify(player, "☄️ A meteor fell just for you! Smash it!", Color3.fromRGB(255, 170, 80))
	end)
end

-- returns true when the swing hit the player's tutorial meteor
function Meteor:TutorialHit(player: Player, position: Vector3): boolean
	local entry = tutorialMeteors[player]
	local part = entry and entry.Part
	if not part or not part.Parent then
		return false
	end
	local cfg = settings.Tutorial
	if (position - part.Position).Magnitude > cfg.Radius + Config.World.Reach + 2 then
		return false
	end
	entry.Hits += 1
	local left = cfg.Hits - entry.Hits
	Net:Send(player, "MeteorHit", 1)
	if entry.Back then
		(entry.Back :: any).Fill.Size = UDim2.fromScale(math.max(0, left / cfg.Hits), 1)
		World.SetText((entry.Back :: any).Text, "☄️ %d", math.max(0, left))
	end
	if left > 0 then
		return true
	end
	-- cracked! a star egg (only you can grab it first) + a few coin chunks
	tutorialMeteors[player] = nil
	local ground = Vector3.new(part.Position.X, 0, part.Position.Z)
	part:Destroy()
	shatter(ground + Vector3.new(0, 2, 0), settings.Kinds[1].Color)
	Net:Send(player, "MeteorImpact", ground)
	spawnChunks(ground, 3, false)
	-- the next tutorial step ("Grab") drops the star egg right here
	Services.ProgressionService:TutorialEvent(player, "Meteor", 1, { Position = ground + Vector3.new(0, 0, 7) })
	return true
end

function Meteor:HasTutorialMeteor(player: Player): boolean
	return tutorialMeteors[player] ~= nil
end

---------------------------------------------------------------------------
-- cloud tests only
---------------------------------------------------------------------------
-- start a meteor at a site type now; skipWarning = it falls right away
function Meteor:LaunchForTest(siteType: string?, skipWarning: boolean?)
	assert(not RunService:IsRunning(), "test hook used on a live server")
	resetToIdle()
	startWarning(self:PickSite(siteType))
	if skipWarning then
		warnEnd = os.time()
	else
		warnEnd = os.time() + 60
	end
	setAttributes()
	return current
end

function Meteor:StateForTest(): string
	return state
end

---------------------------------------------------------------------------
function Meteor:Init(services)
	Services = services
	Data = services.DataService
	World = services.WorldService
end

function Meteor:Start()
	setAttributes()
	workspace:SetAttribute("MeteorLootUntil", 0)
	task.spawn(function()
		local lastRankPush = 0
		local lastMarker = 0
		local function step()
			local now = os.time()
			if state == "Idle" then
				if now >= nextAt or #summonQueue > 0 then
					startWarning(nil)
				end
			elseif state == "Warning" then
				if now ~= lastMarker then
					lastMarker = now
					updateMarker()
				end
				if now >= warnEnd then
					startFalling()
				end
			elseif state == "Active" then
				if now >= endsAt then
					safeFinish(false)
				elseif os.clock() - lastRankPush >= 1 then
					lastRankPush = os.clock()
					local list = ranking()
					local top = {}
					for i = 1, math.min(5, #list) do
						table.insert(top, { Name = list[i].Player.DisplayName, Score = math.floor(list[i].Score) })
					end
					for place, entry in list do
						Net:Send(entry.Player, "MeteorRank", top, place, math.floor(entry.Score))
					end
					for _, player in Players:GetPlayers() do
						if not scores[player] then
							Net:Send(player, "MeteorRank", top, nil, 0)
						end
					end
				end
			end
		end
		while true do
			task.wait(0.25)
			local ok, err = pcall(step)
			if not ok then
				warn("[Meteor] loop error: " .. tostring(err))
				resetToIdle()
			elseif state == "Ending" then
				-- finish() never got back to Idle: recover
				resetToIdle()
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		scores[player] = nil
		local entry = tutorialMeteors[player]
		tutorialMeteors[player] = nil
		if entry and entry.Part then
			entry.Part:Destroy()
		end
	end)

	-- "GO": during the warning only, to the entrance of the landing area
	-- (you still have to run the last bit - that's the rush)
	Net:On("GoToMeteor", 2, function(player)
		local character = player.Character
		local data = Data:Get(player)
		if not character or not data or not current or state ~= "Warning" then
			return
		end
		if Services.ShardService:IsCarrying(player) then
			Net:Notify(player, "Run! You can't teleport while carrying a shard.")
			return
		end
		local destination
		if current.Type == "Zone" then
			if data.ZoneLevel < current.SiteZone then
				Net:Notify(player, "Unlock %s first!", nil, Config.Zones[current.SiteZone].Name)
				return
			end
			destination = World:SpawnFor(current.SiteZone)
		elseif current.Type == "Avenue" then
			destination = CFrame.new(0, 4, Config.World.Bases.ZStart - 12)
		else
			destination = World.HubSpawn
		end
		character:PivotTo(destination)
	end)
end

return Meteor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">MiningService</string>
            <string name="Source"><![CDATA[--[[
	MiningService: ore blocks (spawn / damage / respawn), the pickaxe swing
	handler (server-authoritative range + cooldown checks). Broken ore pays
	coins instantly (no backpack, no selling). Players carrying a star shard
	can be bonked to make them drop it.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Mining = {}
local Services
local Data
local World

local blockInfo = {} -- [part] = { Slot, Ore, HP, Zone }
local zoneBlocks = {} -- [zone] = { [part] = true }
local lastSwing = {} -- [player] = os.clock()
local immunity = {} -- [player] = os.clock() until
local combos = {} -- [player] = { Count, Last }
local feverUntil = {} -- [player] = server time
local feverStart = {} -- [player] = server time
local lastWarn = {} -- [player] = os.clock() (throttles hint messages)
local oreFolder: Folder

local oreRng = Random.new()

local function pickOre(zoneIndex: number): string
	return Util.WeightedPick(Config.Zones[zoneIndex].Ores, nil, oreRng)
end

local function rollLucky()
	local mult = Services.EventService:Get("LuckyMult", 1)
	for _, def in Config.LuckyOres do
		if oreRng:NextNumber() < def.Chance * mult then
			return def
		end
	end
	return nil
end

local function addSparkles(part: BasePart, color: Color3, rate: number)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sparkles"
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = rate
	emitter.Parent = part
end

-- small crystal spikes on top of rare ores so they read as "valuable" at a glance
local function addCrystals(part: BasePart, color: Color3, material: Enum.Material)
	local size = Config.World.OreSize
	for i = 1, 3 do
		local spike = Instance.new("Part")
		spike.Name = "Crystal"
		spike.Anchored = true
		spike.CanCollide = false
		spike.CanQuery = false
		spike.CanTouch = false
		spike.CastShadow = false
		spike.Material = material
		spike.Color = color
		spike.Size = Vector3.new(0.9, 2 + i * 0.5, 0.9)
		local angle = i * 2.1
		spike.CFrame = part.CFrame
			* CFrame.new(math.cos(angle) * size * 0.22, size / 2 + spike.Size.Y * 0.35, math.sin(angle) * size * 0.22)
			* CFrame.Angles(math.rad(18) * math.cos(angle), 0, math.rad(18) * math.sin(angle))
		spike.Parent = part
	end
end

-- 🪨 an ore node reads as a natural boulder: a rough rock shell (the zone's
-- stone) around a core of the ore, with crystals (gems) or nuggets (metals)
-- growing out of it. Only the core part is the hit target.
local GEM_MATERIALS = {
	[Enum.Material.Glass] = true,
	[Enum.Material.Neon] = true,
	[Enum.Material.Ice] = true,
}
local METAL_MATERIALS = {
	[Enum.Material.Metal] = true,
	[Enum.Material.Foil] = true,
	[Enum.Material.DiamondPlate] = true,
}

local function piece(parent: BasePart, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		p.Shape = shape
	end
	p.Parent = parent
	return p
end

local function rockColorFor(zone: number): Color3
	local def = Config.Zones[zone]
	local base = if def and def.FloorColor then def.FloorColor else Color3.fromRGB(120, 115, 110)
	return base:Lerp(Color3.fromRGB(95, 92, 90), 0.55)
end

local function decorate(part: BasePart, ore, _size: number, zone: number)
	local rock = rockColorFor(zone)
	local center = part.CFrame
	-- rough shell: rotated slabs hugging the core
	for i = 1, 4 do
		local angle = i * (math.pi / 2) + oreRng:NextNumber(-0.4, 0.4)
		local w = oreRng:NextNumber(2.2, 3.4)
		piece(
			part,
			"Rock",
			Vector3.new(w, oreRng:NextNumber(2, 3.2), w * oreRng:NextNumber(0.8, 1.2)),
			CFrame.new(center.Position + Vector3.new(math.cos(angle) * 1.5, -0.6, math.sin(angle) * 1.5))
				* CFrame.Angles(oreRng:NextNumber(-0.5, 0.5), oreRng:NextNumber(0, 6.2), oreRng:NextNumber(-0.5, 0.5)),
			rock:Lerp(Color3.new(0, 0, 0), oreRng:NextNumber(0, 0.2)),
			if i % 2 == 0 then Enum.Material.Slate else Enum.Material.Rock
		)
	end
	if GEM_MATERIALS[ore.Material] or ore.Glow then
		-- crystals growing out of the rock
		local material = if ore.Glow then Enum.Material.Neon else Enum.Material.Glass
		for i = 1, oreRng:NextInteger(4, 6) do
			local angle = i * 1.25 + oreRng:NextNumber(-0.3, 0.3)
			local h = oreRng:NextNumber(2.2, 4.6)
			local w = oreRng:NextNumber(0.7, 1.15)
			local tilt = oreRng:NextNumber(0.25, 0.6)
			local crystal = piece(
				part,
				"Crystal",
				Vector3.new(w, h, w),
				CFrame.new(center.Position + Vector3.new(math.cos(angle) * 1.1, 1 + h * 0.3, math.sin(angle) * 1.1))
					* CFrame.Angles(math.sin(angle) * tilt, angle, -math.cos(angle) * tilt)
					* CFrame.Angles(0, math.rad(45), 0),
				ore.Color:Lerp(Color3.new(1, 1, 1), oreRng:NextNumber(0, 0.25)),
				material
			)
			crystal.Transparency = if material == Enum.Material.Glass then 0.15 else 0
		end
	elseif METAL_MATERIALS[ore.Material] then
		-- shiny nuggets in the stone
		for i = 1, oreRng:NextInteger(4, 7) do
			local angle = i * 1.1 + oreRng:NextNumber(-0.4, 0.4)
			local sizeN = oreRng:NextNumber(0.8, 1.5)
			piece(
				part,
				"Nugget",
				Vector3.one * sizeN,
				CFrame.new(center.Position + Vector3.new(math.cos(angle) * 1.9, oreRng:NextNumber(-0.4, 1.4), math.sin(angle) * 1.9)),
				ore.Color,
				ore.Material,
				Enum.PartType.Ball
			)
		end
	elseif ore.Value >= 2 then
		-- coal / plain rock: dark lumps
		for i = 1, 4 do
			local angle = i * 1.6
			piece(
				part,
				"Vein",
				Vector3.one * oreRng:NextNumber(0.9, 1.4),
				CFrame.new(center.Position + Vector3.new(math.cos(angle) * 1.9, oreRng:NextNumber(-0.3, 1), math.sin(angle) * 1.9))
					* CFrame.Angles(oreRng:NextNumber(0, 3), oreRng:NextNumber(0, 3), 0),
				ore.Color,
				ore.Material
			)
		end
	end
end

local function spawnBlock(slot, forcedLucky)
	if slot.Part and slot.Part.Parent then
		return
	end
	local oreId = pickOre(slot.Zone)
	local ore = Config.Ores[oreId]
	local lucky = forcedLucky or rollLucky()
	local hp = ore.HP * (if lucky then lucky.HPMult or 1 else 1)
	local size = Config.World.OreSize
	local part = Instance.new("Part")
	part.Name = oreId
	part.Size = Vector3.new(size * 0.8, size * 0.7, size * 0.8)
	part.Anchored = true
	part.Material = ore.Material
	part.Color = ore.Color:Lerp(rockColorFor(slot.Zone), if ore.Glow then 0 else 0.2)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = CFrame.new(slot.Position - Vector3.new(0, 0.6, 0))
		* CFrame.Angles(math.rad(oreRng:NextNumber(-20, 20)), math.rad(oreRng:NextNumber(0, 360)), math.rad(oreRng:NextNumber(-20, 20)))
	part:SetAttribute("Ore", oreId)
	part:SetAttribute("HP", hp)
	part:SetAttribute("MaxHP", hp)
	part:SetAttribute("Zone", slot.Zone)
	if lucky then
		part:SetAttribute("Lucky", lucky.Id)
		if lucky.Id == "Golden" then
			part.Color = Color3.fromRGB(255, 205, 50)
			part.Material = Enum.Material.Foil
			addSparkles(part, Color3.fromRGB(255, 230, 120), 8)
		else
			part.Color = Color3.fromRGB(255, 80, 200) -- clients cycle the hue
			part.Material = Enum.Material.Neon
			addSparkles(part, Color3.new(1, 1, 1), 20)
		end
		local light = Instance.new("PointLight")
		light.Color = part.Color
		light.Range = 10
		light.Brightness = 1
		light.Parent = part
		addCrystals(part, part.Color, part.Material)
	elseif ore.Glow then
		local light = Instance.new("PointLight")
		light.Color = ore.Color
		light.Range = 8
		light.Brightness = 0.8
		light.Parent = part
		-- (glowing ores already grow neon crystals in decorate)
	end
	decorate(part, ore, size, slot.Zone)
	part.Parent = oreFolder
	slot.Part = part
	blockInfo[part] = { Slot = slot, Ore = oreId, HP = hp, MaxHP = hp, Zone = slot.Zone, Lucky = lucky }
	zoneBlocks[slot.Zone][part] = true
	if lucky and lucky.Announce then
		Net:Announce("🌈 A RAINBOW ORE appeared in %s! (50x value)", Color3.fromRGB(255, 120, 230), Config.Zones[slot.Zone].Name)
	end
end

local function removeBlock(part: BasePart, info)
	blockInfo[part] = nil
	zoneBlocks[info.Zone][part] = nil
	info.Slot.Part = nil
	part:Destroy()
	local delay = Config.World.OreRespawnSeconds * Services.EventService:Get("RespawnMult", 1)
	task.delay(delay, spawnBlock, info.Slot)
end

local function withinReach(root: BasePart, part: BasePart, extra: number?): boolean
	local reach = Config.World.Reach + (extra or 0) + part.Size.Magnitude / 2
	return (root.Position - part.Position).Magnitude <= reach
end

local function nearestBlock(root: BasePart): BasePart?
	local zone = World:ZoneAt(root.Position)
	if not zone or zone == 0 then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for part in zoneBlocks[zone] do
		local distance = (part.Position - root.Position).Magnitude
		if distance < bestDistance then
			best, bestDistance = part, distance
		end
	end
	if best and withinReach(root, best) then
		return best
	end
	return nil
end

local function now(): number
	return workspace:GetServerTimeNow()
end

local function warnOnce(player: Player, seconds: number, text: string, ...)
	if lastWarn[player] and os.clock() - lastWarn[player] < seconds then
		return
	end
	lastWarn[player] = os.clock()
	Net:Notify(player, text, Color3.fromRGB(255, 170, 110), ...)
end

---------------------------------------------------------------------------
-- FEVER: a long combo turns into a short frenzy
---------------------------------------------------------------------------
function Mining:IsFever(player: Player): boolean
	return (feverUntil[player] or 0) > now()
end

local function feverFX(player: Player, on: boolean)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local existing = root:FindFirstChild("FeverFX")
	if not on then
		if existing then
			existing:Destroy()
		end
		return
	end
	if existing then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "FeverFX"
	emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 170, 50), Color3.fromRGB(255, 60, 40))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 0) })
	emitter.Lifetime = NumberRange.new(0.4, 0.7)
	emitter.Speed = NumberRange.new(4, 8)
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.Rate = 40
	emitter.Parent = root
end

local function startFever(player: Player, data)
	local t = now()
	feverStart[player] = t
	feverUntil[player] = t + Config.Fever.Duration
	player:SetAttribute("FeverUntil", feverUntil[player])
	data.Stats.Fevers = (data.Stats.Fevers or 0) + 1
	feverFX(player, true)
	Services.CharacterService:ApplyWalkSpeed(player)
	Net:Send(player, "Fever", Config.Fever.Duration)
end

local function extendFever(player: Player)
	local cap = (feverStart[player] or now()) + Config.Fever.MaxDuration
	feverUntil[player] = math.min(cap, (feverUntil[player] or now()) + Config.Fever.Extend)
	player:SetAttribute("FeverUntil", feverUntil[player])
end

local function endFever(player: Player)
	feverUntil[player] = nil
	feverStart[player] = nil
	combos[player] = nil
	if player.Parent then
		player:SetAttribute("FeverUntil", nil)
		feverFX(player, false)
		Services.CharacterService:ApplyWalkSpeed(player)
		Net:Send(player, "FeverEnd")
	end
end

---------------------------------------------------------------------------
-- hitting / breaking blocks
---------------------------------------------------------------------------
local function breakBlock(player: Player, data, part: BasePart, info, crit: boolean)
	-- combo: consecutive breaks within the window
	local clock = os.clock()
	local combo = combos[player]
	if combo and clock - combo.Last <= Config.Combo.Window then
		combo.Count += 1
	else
		combo = { Count = 1, Last = clock }
		combos[player] = combo
	end
	combo.Last = clock
	data.Stats.BestCombo = math.max(data.Stats.BestCombo, combo.Count)
	local comboBonus = math.min(Config.Combo.MaxBonus, (combo.Count - 1) * Config.Combo.BonusPer)

	local fever = Mining:IsFever(player)
	if fever then
		extendFever(player)
	elseif combo.Count >= Config.Fever.Combo then
		startFever(player, data)
		fever = true
	end

	local ore = Config.Ores[info.Ore]
	local events = Services.EventService
	local lucky = info.Lucky
	local value = ore.Value
		* (if lucky then lucky.ValueMult else 1)
		* events:Get("ValueMult", 1)
		* (1 + comboBonus)
		* (if fever then Config.Fever.ValueMult else 1)
	-- coins straight away: one less step, and combos/FEVER never get interrupted
	local gained = math.max(1, math.floor(value * Services.StatsService:CoinMultiplier(player, data)))
	data.Coins += gained
	data.Stats.LifetimeCoins += gained
	data.Stats.BlocksMined += 1

	local extra = { Crit = crit, Combo = combo.Count, Lucky = if lucky then lucky.Id else nil, Fever = fever }
	local gems = 0
	if ore.GemChance and math.random() < ore.GemChance then
		gems += ore.Gems
	end
	local stormChance = events:Get("GemChance", 0)
	if stormChance > 0 and math.random() < stormChance then
		gems += info.Zone
	end
	if lucky then
		gems += lucky.Gems
		data.Stats.LuckyOres += 1
	end
	if gems > 0 then
		data.Gems += gems
		extra.Gems = gems
	end
	if ore.Stardust then
		data.Stardust += ore.Stardust
		extra.Stardust = ore.Stardust
	end
	local position = part.Position
	removeBlock(part, info)
	local progression = Services.ProgressionService
	progression:OnBlockMined(player, info.Zone)
	progression:AddXP(player, info.Zone * (if lucky then 10 else 1))
	Net:Send(player, "MineBreak", position, info.Ore, gained, extra)
	if lucky and lucky.Announce then
		Net:Announce("🌈 %s mined a RAINBOW %s! (+%d 💎)", Color3.fromRGB(255, 120, 230), player.DisplayName, ore.Name, gems)
	end
end

-- returns "hit" | "broken" | nil (not allowed)
local function hitBlock(player: Player, data, part: BasePart, damage: number, crit: boolean, isSplash: boolean)
	local info = blockInfo[part]
	if not info then
		return nil
	end
	if info.Zone > data.ZoneLevel then
		if not isSplash then
			warnOnce(player, 2, "Unlock %s to mine here!", Config.Zones[info.Zone].Name)
		end
		return nil
	end
	info.HP -= damage
	if info.HP > 0 then
		part:SetAttribute("HP", info.HP)
		Net:Send(player, "MineHit", part, info.HP / info.MaxHP, crit, damage, isSplash)
		return "hit"
	end
	breakBlock(player, data, part, info, crit)
	return "broken"
end

local function mineBlock(player: Player, data, part: BasePart)
	local info = blockInfo[part]
	if not info then
		return
	end
	local zone = info.Zone
	local center = part.Position
	local damage = Services.StatsService:Damage(player, data)
	local crit = math.random() < Config.Crit.Chance
	if crit then
		damage *= Config.Crit.Multiplier
		data.Stats.Crits += 1
	end
	local result = hitBlock(player, data, part, damage, crit, false)
	if result == "hit" or result == "broken" then
		-- shockwave: crits (and every hit during FEVER) damage nearby blocks too
		local fever = Mining:IsFever(player)
		if crit or fever then
			local radius = if fever then Config.Fever.SplashRadius else Config.Crit.SplashRadius
			local mult = if fever then Config.Fever.SplashDamage else Config.Crit.SplashDamage
			local targets = {}
			for other in zoneBlocks[zone] do
				if other ~= part and (other.Position - center).Magnitude <= radius then
					table.insert(targets, other)
				end
			end
			if #targets > 0 then
				Net:Send(player, "Shockwave", center, radius, fever)
				for _, other in targets do
					hitBlock(player, data, other, damage * mult, false, true)
				end
			end
		end
	end
	Data:MarkDirty(player)
end

-- DEV: turn the block closest to the player into a Rainbow ore
function Mining:DevRainbow(player: Player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart
	local target = root and nearestBlock(root)
	if not target then
		return false
	end
	local slot = blockInfo[target].Slot
	removeBlock(target, blockInfo[target]) -- the scheduled respawn no-ops because we refill now
	spawnBlock(slot, Config.LuckyOres[1])
	return true
end

---------------------------------------------------------------------------
-- PvP
---------------------------------------------------------------------------
local function tryBonk(attacker: Player, victim: Player)
	local aRoot = attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart") :: BasePart
	local vRoot = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") :: BasePart
	local aData, vData = Data:Get(attacker), Data:Get(victim)
	if not aRoot or not vRoot or not aData or not vData then
		return
	end
	if (aRoot.Position - vRoot.Position).Magnitude > Config.PvP.BonkRange then
		return
	end
	local shards = Services.ShardService
	if not shards:IsCarrying(victim) then
		warnOnce(attacker, 3, "⚔️ You can only bonk players carrying a shard!")
		return
	end
	if (vRoot.Position - World.HubSpawn.Position).Magnitude <= Config.World.SpawnSafeRadius then
		warnOnce(attacker, 3, "🛡️ The spawn is a safe zone!")
		return
	end
	-- a new player's very first egg (tutorial) can't be knocked away
	local tutorial = vData.Tutorial
	if tutorial and not tutorial.Done and tutorial.Step <= 3 then
		warnOnce(attacker, 3, "🛡️ That's a new player's first egg - let them bring it home!")
		return
	end
	local clock = os.clock()
	if (immunity[victim] or 0) > clock then
		return
	end
	immunity[victim] = clock + Config.PvP.ImmunitySeconds

	local meta = shards:CarryMeta(victim)
	local wasThief = meta ~= nil and meta.From ~= nil
	local firstCatch = wasThief and not meta.Caught -- one catch per theft (no re-grab farming)
	if firstCatch then
		meta.Caught = true
	end
	shards:Drop(victim, attacker)
	if wasThief then
		-- stopped a thief: counts for the 🛡️ Guardian title + claims any bounty
		Services.BaseService:ThiefCaught(attacker, victim, firstCatch)
	end
	aData.Stats.Bonks += 1
	local progression = Services.ProgressionService
	progression:AddQuest(attacker, "Bonk", 1)
	progression:AddPoints(attacker, Config.PvP.PointsPerBonk)

	local direction = (vRoot.Position - aRoot.Position) * Vector3.new(1, 0, 1)
	direction = if direction.Magnitude > 0.01 then direction.Unit else Vector3.zAxis
	Net:Send(victim, "Knockback", direction * Config.PvP.Knockback + Vector3.new(0, 35, 0))
	Net:Send(victim, "Bonked", attacker.DisplayName)
	Net:Send(attacker, "BonkHit", vRoot.Position)
	Data:MarkDirty(attacker)
	Data:MarkDirty(victim)
end

-- the closest shard carrier in bonk range (mobile players just hold MINE)
local function nearestCarrier(player: Player, root: BasePart): Player?
	local best, bestDistance = nil, Config.PvP.BonkRange
	for _, other in Players:GetPlayers() do
		if other ~= player and Services.ShardService:IsCarrying(other) then
			local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart
			if otherRoot then
				local distance = (otherRoot.Position - root.Position).Magnitude
				if distance <= bestDistance then
					best, bestDistance = other, distance
				end
			end
		end
	end
	return best
end

---------------------------------------------------------------------------
local function onSwing(player: Player, hint)
	local data = Data:Get(player)
	local character = player.Character
	if not data or not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	-- the pickaxe is always in hand; if it got unequipped, put it back
	if not character:FindFirstChild("Pickaxe") then
		local backpack = player:FindFirstChildOfClass("Backpack")
		local tool = backpack and backpack:FindFirstChild("Pickaxe")
		if tool and tool:IsA("Tool") then
			humanoid:EquipTool(tool)
		else
			Services.CharacterService:GivePickaxe(player)
		end
	end
	local clock = os.clock()
	local cooldown = Services.StatsService:SwingCooldown(player, data)
	if lastSwing[player] and clock - lastSwing[player] < cooldown * 0.8 then
		return
	end
	lastSwing[player] = clock

	if Services.ShardService:IsCarrying(player) then
		warnOnce(player, 4, "🌠 Hands full! Bring the shard to your base 🏠")
		return
	end

	local hintPart = if typeof(hint) == "Instance" and hint:IsA("BasePart") then hint else nil
	local meteor = Services.MeteorService

	-- 1) explicit target: another player (bonk) or a block
	if hintPart then
		local model = hintPart:FindFirstAncestorOfClass("Model")
		local victim = model and Players:GetPlayerFromCharacter(model)
		if victim and victim ~= player then
			tryBonk(player, victim)
			return
		end
		local shards = Services.ShardService
		if model and Services.RivalService:IsRival(model) then
			Services.RivalService:Bonk(player, model)
			return
		end
		if model and shards:IsGuardian(model) then
			if (hintPart.Position - root.Position).Magnitude <= Config.PvP.BonkRange + 2 then
				shards:HitGuardian(player, model)
			end
			return
		end
		if blockInfo[hintPart] and withinReach(root, hintPart, 3) then
			mineBlock(player, data, hintPart)
			return
		end
	end

	-- 2) meteor event (or the new player's own tutorial meteor)
	if meteor:HasTutorialMeteor(player) and meteor:TutorialHit(player, root.Position) then
		return
	end
	if meteor:IsActive() and meteor:InRange(root.Position) then
		meteor:Hit(player, Services.StatsService:Damage(player, data), cooldown)
		return
	end

	-- 3) a shard carrier (or a star guardian) right next to us
	local carrier = nearestCarrier(player, root)
	if carrier then
		tryBonk(player, carrier)
		return
	end
	local robot = Services.RivalService:NearestCarrying(root.Position, Config.PvP.BonkRange + 2)
	if robot then
		Services.RivalService:Bonk(player, robot)
		return
	end
	local guardian = Services.ShardService:NearestGuardian(root.Position, Config.PvP.BonkRange)
	if guardian then
		Services.ShardService:HitGuardian(player, guardian)
		return
	end

	-- 4) auto target the closest block (mobile friendly + auto mine pass)
	local target = nearestBlock(root)
	if target then
		mineBlock(player, data, target)
	end
end

---------------------------------------------------------------------------
-- 🐾 pet helpers: following pets hit ores / the meteor next to their owner
---------------------------------------------------------------------------
local PET_HELP = Config.PetHelp
-- (only clients close enough to see the pets get the hop animation)
local function sendPetHelp(player: Player, at: Vector3, targets)
	for _, other in Players:GetPlayers() do
		local character = other.Character
		local otherRoot = character and character:FindFirstChild("HumanoidRootPart")
		if otherRoot and otherRoot:IsA("BasePart") and (otherRoot.Position - at).Magnitude <= 160 then
			Net:Send(other, "PetHelp", player.UserId, targets)
		end
	end
end

local function petHelpFor(player: Player)
	local data = Data:Get(player)
	local last = lastSwing[player]
	local pets = data and #data.Equipped or 0
	if pets <= 0 or not last or os.clock() - last > PET_HELP.ActiveSeconds then
		return
	end
	if Services.ShardService:IsCarrying(player) then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local damage = Services.StatsService:Damage(player, data)
	local meteor = Services.MeteorService
	if meteor:IsActive() and meteor:InRange(root.Position) then
		if meteor:PetHit(player, pets, damage) then
			Services.PetService:AddFollowXP(player, Config.Growth.HelpXP)
			local at = meteor:Position()
			if at then
				sendPetHelp(player, root.Position, { at })
			end
		end
		return
	end
	local zone = World:ZoneAt(root.Position)
	if not zone or zone == 0 or zone > data.ZoneLevel then
		return
	end
	-- the closest ores around you, one per pet
	local near = {}
	for part in zoneBlocks[zone] do
		local distance = (part.Position - root.Position).Magnitude
		if distance <= PET_HELP.Range then
			table.insert(near, { Part = part, Distance = distance })
		end
	end
	if #near == 0 then
		return
	end
	table.sort(near, function(a, b)
		return a.Distance < b.Distance
	end)
	local targets = {}
	for i = 1, pets do
		local entry = near[((i - 1) % #near) + 1]
		if blockInfo[entry.Part] then
			table.insert(targets, entry.Part.Position)
			hitBlock(player, data, entry.Part, damage * PET_HELP.OreShare, false, true)
		end
	end
	if #targets > 0 then
		sendPetHelp(player, root.Position, targets)
		Services.PetService:AddFollowXP(player, Config.Growth.HelpXP)
		Data:MarkDirty(player)
	end
end

---------------------------------------------------------------------------
-- rival players (RivalService)
---------------------------------------------------------------------------
-- the closest ore in a zone (where a rival goes mining)
function Mining:NearestOreIn(zone: number, position: Vector3): BasePart?
	local best, bestDistance = nil, math.huge
	for part in zoneBlocks[zone] or {} do
		local distance = (part.Position - position).Magnitude
		if distance < bestDistance then
			best, bestDistance = part, distance
		end
	end
	return best
end

-- a rival hits an ore (no rewards; the ore breaks and respawns like any other)
function Mining:NpcHit(part: BasePart, damage: number): boolean
	local info = blockInfo[part]
	if not info then
		return false
	end
	info.HP -= damage
	if info.HP > 0 then
		part:SetAttribute("HP", info.HP)
		return true
	end
	removeBlock(part, info)
	return true
end

-- may a rival bonk this player? (same safety rules as players, plus: never a
-- new player's first egg, never in the base district)
-- (rivalId: a rival may chase a thief carrying ITS pet even into the base district)
function Mining:CanNpcBonk(victim: Player, rivalId: number?): boolean
	local data = Data:Get(victim)
	local root = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart")
	if not data or not root or not root:IsA("BasePart") or not Services.ShardService:IsCarrying(victim) then
		return false
	end
	local tutorial = data.Tutorial
	if tutorial and not tutorial.Done and tutorial.Step <= 3 then
		return false
	end
	if (root.Position - World.HubSpawn.Position).Magnitude <= Config.World.SpawnSafeRadius then
		return false
	end
	local meta = Services.ShardService:CarryMeta(victim)
	local ownPet = rivalId ~= nil and meta ~= nil and meta.RivalFrom == rivalId
	if Util.InBases(Config, root.Position) and not ownPet then
		return false
	end
	return (immunity[victim] or 0) <= os.clock()
end

function Mining:NpcBonk(attackerRoot: BasePart, attackerName: string, victim: Player, rivalId: number?): boolean
	if not self:CanNpcBonk(victim, rivalId) then
		return false
	end
	local vRoot = victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") :: BasePart
	if not vRoot or (vRoot.Position - attackerRoot.Position).Magnitude > Config.PvP.BonkRange then
		return false
	end
	immunity[victim] = os.clock() + Config.PvP.ImmunitySeconds
	Services.ShardService:Drop(victim, nil)
	local direction = (vRoot.Position - attackerRoot.Position) * Vector3.new(1, 0, 1)
	direction = if direction.Magnitude > 0.01 then direction.Unit else Vector3.zAxis
	Net:Send(victim, "Knockback", direction * Config.PvP.Knockback + Vector3.new(0, 35, 0))
	Net:Send(victim, "Bonked", attackerName)
	return true
end

-- cloud tests: one pet-help tick for a player now
function Mining:PetHelpForTest(player: Player, swungAgo: number?)
	assert(not game:GetService("RunService"):IsRunning(), "test hook used on a live server")
	lastSwing[player] = os.clock() - (swungAgo or 0)
	petHelpFor(player)
end

function Mining:Init(services)
	Services = services
	Data = services.DataService
	World = services.WorldService
end

function Mining:Start()
	oreFolder = World:Folder("Ores")
	for zone, slots in World.OreSlots do
		zoneBlocks[zone] = {}
		for _, slot in slots do
			spawnBlock(slot)
		end
	end

	Net:On("Swing", 0.08, onSwing)

	task.spawn(function()
		while true do
			task.wait(PET_HELP.Interval)
			for _, player in Players:GetPlayers() do
				local ok, err = pcall(petHelpFor, player)
				if not ok then
					warn("[Mining] pet help failed: " .. tostring(err))
				end
			end
		end
	end)

	-- fever expiry
	task.spawn(function()
		while true do
			task.wait(0.25)
			local t = now()
			for player, untilTime in feverUntil do
				if untilTime <= t then
					endFever(player)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastSwing[player] = nil
		immunity[player] = nil
		combos[player] = nil
		feverUntil[player] = nil
		feverStart[player] = nil
		lastWarn[player] = nil
	end)
end

return Mining
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--[[
	MonetizationService
	  * Game passes (ownership cache + purchase prompts + instant effects)
	  * Developer products via ProcessReceipt (idempotent: PurchaseId stored in data)
	  * Experience subscription (Miner Club)
	  * Roblox Premium upsell
	  * Native rewarded video ads (AdService) - disabled until you enable it
	  * PolicyService compliance: paid random items (Golden Egg) are hidden for
	    players where they are restricted, and odds are always shown before buying.

	Studio testing: any pass/product whose Id is 0 is granted instantly in
	Studio ("[TEST]") so the full flow can be tested before IDs exist.
]]
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Monetization = {}
local Services
local Data

local owned = {} -- [player] = { [passKey] = true }
local subscribed = {} -- [player] = bool
local passById = {}
local productById = {}

for key, pass in Config.GamePasses do
	if pass.Id ~= 0 then
		passById[pass.Id] = key
	end
end
for key, product in Config.Products do
	if product.Id ~= 0 then
		productById[product.Id] = key
	end
end

local GOLD = Color3.fromRGB(255, 210, 70)

function Monetization:HasPass(player: Player, key: string): boolean
	local list = owned[player]
	return list ~= nil and list[key] == true
end

function Monetization:OwnedPasses(player: Player)
	return owned[player] or {}
end

function Monetization:IsSubscribed(player: Player): boolean
	return subscribed[player] == true
end

local function applyPass(player: Player, key: string, isNewPurchase: boolean)
	local list = owned[player]
	if not list then
		list = {}
		owned[player] = list
	end
	if list[key] then
		return
	end
	list[key] = true
	player:SetAttribute("Pass_" .. key, true)
	if key == "VIP" then
		player:SetAttribute("VIP", true)
	end
	local character = Services.CharacterService
	if key == "Speed" then
		character:ApplyWalkSpeed(player)
	end
	character:RefreshOverhead(player)
	Services.PetService:RefreshEquipped(player)
	Data:MarkDirty(player)

	if isNewPurchase then
		local pass = Config.GamePasses[key]
		Net:Notify(player, "🎉 Unlocked %s!", GOLD, pass.Name)
		-- social proof: everyone sees supporters
		Net:Announce("%s %s just got %s!", GOLD, pass.Icon or "⭐", player.DisplayName, pass.Name)
	end
end

local function refreshSubscription(player: Player)
	local sub = Config.Subscription
	if sub.Id == "" then
		return
	end
	local ok, status = pcall(function()
		return MarketplaceService:GetUserSubscriptionStatusAsync(player, sub.Id)
	end)
	if ok and type(status) == "table" and player.Parent then
		local wasSubscribed = subscribed[player] == true
		subscribed[player] = status.IsSubscribed == true
		player:SetAttribute("Club", subscribed[player])
		if subscribed[player] and not wasSubscribed then
			Services.ProgressionService:CheckClubDaily(player)
		end
		Services.CharacterService:RefreshOverhead(player)
		Data:MarkDirty(player)
	end
end

local function checkPolicy(player: Player)
	for _ = 1, 3 do
		local ok, policy = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, player)
		if ok and type(policy) == "table" then
			player:SetAttribute("PaidRandomRestricted", policy.ArePaidRandomItemsRestricted == true)
			player:SetAttribute("PaidTradeAllowed", policy.IsPaidItemTradingAllowed == true)
			Data:MarkDirty(player)
			return
		end
		task.wait(2)
	end
	-- unknown policy: be safe and treat paid random items as restricted
	player:SetAttribute("PaidRandomRestricted", true)
	player:SetAttribute("PaidTradeAllowed", false)
	Data:MarkDirty(player)
end

local function onPlayerAdded(player: Player)
	owned[player] = owned[player] or {}
	for key, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			task.spawn(function()
				local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.Id)
				if ok and result and player.Parent then
					applyPass(player, key, false)
				end
			end)
		end
	end
	task.spawn(checkPolicy, player)
	task.spawn(refreshSubscription, player)
end

---------------------------------------------------------------------------
-- product granting
---------------------------------------------------------------------------
local function canBuy(player: Player, key: string, data): (boolean, string?)
	local product = Config.Products[key]
	if product.Kind == "StarterPack" and data.Flags.StarterPack then
		return false, "You already own the Starter Pack!"
	end
	if product.Kind == "SeasonPremium" and data.Season.Premium then
		return false, "You already own the Premium Pass!"
	end
	-- where paid random items are restricted, Robux can't buy the currencies
	-- that hatch random eggs either (gems / coins), nor the Robux egg itself
	local currency = product.Kind == "Gems" or product.Kind == "CoinPack" or product.Kind == "StarterPack"
	if currency and player:GetAttribute("PaidRandomRestricted") ~= false then
		return false, "This item isn't available in your region."
	end
	if product.Kind == "HouseSkin" and data.Base.Skins[product.Skin] then
		return false, "You already own this skin!"
	end
	if product.Kind == "PaidEgg" then
		if player:GetAttribute("PaidRandomRestricted") ~= false then
			return false, "This item isn't available in your region."
		end
		if #data.Pets + product.Count > Config.MaxPets then
			return false, "Your pet inventory is full!"
		end
	end
	if key == "AdReward" then
		return false, "Watch an ad to get this reward."
	end
	return true
end

local function grantProduct(player: Player, key: string, data)
	local product = Config.Products[key]
	local kind = product.Kind

	if kind == "Gems" then
		data.Gems += product.Amount
		Net:Notify(player, "💎 +%d Gems! Thank you!", GOLD, product.Amount)
	elseif kind == "CoinPack" then
		-- scales with progress: ~60% of the next pickaxe (or of the best one)
		local nextPick = Config.Pickaxes[data.PickaxeTier + 1] or Config.Pickaxes[#Config.Pickaxes]
		local amount = math.max(2500, math.floor(nextPick.Cost * 0.6))
		data.Coins += amount
		data.Stats.LifetimeCoins += amount
		Net:Send(player, "Sold", amount)
	elseif kind == "Boost" then
		Services.BoostService:Add(player, product.Boost, product.Seconds)
	elseif kind == "ServerBoost" then
		Services.BoostService:AddServer(product.Boost, product.Seconds, player)
	elseif kind == "SummonMeteor" then
		Services.MeteorService:Summon(player)
	elseif kind == "SeasonPremium" then
		data.Season.Premium = true
		Net:Notify(player, "🎫 Premium Pass unlocked! Claim your rewards.", GOLD)
		Net:Announce("🎫 %s unlocked the Premium Season Pass!", GOLD, player.DisplayName)
	elseif kind == "SkipTiers" then
		Services.ProgressionService:AddSeasonXP(player, Config.Season.XPPerTier * product.Amount)
	elseif kind == "StarterPack" then
		data.Flags.StarterPack = true
		Services.ProgressionService:GrantReward(player, Config.StarterPack.Reward, "Starter Pack")
	elseif kind == "PaidEgg" then
		Services.PetService:PaidHatch(player, product.Egg, product.Count)
	elseif kind == "HouseSkin" then
		Services.BaseService:GrantSkin(player, product.Skin)
	else
		error("Unknown product kind " .. tostring(kind))
	end
	data.Stats.Purchases += 1
	Data:MarkDirty(player)
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Data:WaitFor(player, 20)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receipt.PurchaseId)
	if Data:HasReceipt(player, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local key = productById[receipt.ProductId]
	if not key then
		warn("[Monetization] unknown product id " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, err = pcall(grantProduct, player, key, data)
	if not ok then
		warn("[Monetization] grant failed: " .. tostring(err))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	Data:AddReceipt(player, purchaseId)
	if not Data:Save(player) then
		-- granted in memory but not persisted: let Roblox retry. The stored
		-- PurchaseId prevents a double grant if this session is still alive.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------------------
-- rewarded video ads (native Roblox AdService)
---------------------------------------------------------------------------
local function watchAd(player: Player)
	local settings = Config.RewardedAds
	if not settings.Enabled then
		return false, Net:L(player, "Ads are not available.")
	end
	local data = Data:Get(player)
	if not data then
		return false, Net:L(player, "Loading...")
	end
	local remaining = settings.CooldownSeconds - (os.time() - data.LastAdTime)
	if remaining > 0 then
		return false, Net:L(player, "Next free reward in %d min", math.ceil(remaining / 60))
	end
	local product = Config.Products.AdReward
	if product.Id == 0 then
		if Util.CanTest(Config, player) then
			data.LastAdTime = os.time()
			grantProduct(player, "AdReward", data)
			return true, Net:L(player, "[TEST] Ad reward granted")
		end
		return false, Net:L(player, "Ad reward is not configured.")
	end
	-- NOTE: verify method names against the current AdService docs before enabling.
	local ok, result = pcall(function()
		local AdService = game:GetService("AdService")
		local availability = AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
		if availability.AdAvailabilityResult ~= Enum.AdAvailabilityResult.IsAvailable then
			return "unavailable"
		end
		local reward = AdService:CreateAdRewardFromDevProductId(product.Id)
		AdService:ShowRewardedVideoAdAsync(player, reward)
		return "shown"
	end)
	if not ok then
		warn("[Monetization] ad failed: " .. tostring(result))
		return false, Net:L(player, "No ad available right now.")
	end
	if result ~= "shown" then
		return false, Net:L(player, "No ad available right now.")
	end
	-- the reward itself arrives through ProcessReceipt
	data.LastAdTime = os.time()
	Data:MarkDirty(player)
	return true, Net:L(player, "Thanks for watching!")
end

---------------------------------------------------------------------------
function Monetization:Init(services)
	Services = services
	Data = services.DataService
end

function Monetization:Start()
	MarketplaceService.ProcessReceipt = processReceipt

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
		subscribed[player] = nil
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased then
			local key = passById[passId]
			if key then
				applyPass(player, key, true)
			end
		end
	end)

	pcall(function()
		(Players :: any).UserSubscriptionStatusChanged:Connect(function(player, subscriptionId)
			if subscriptionId == Config.Subscription.Id then
				refreshSubscription(player)
			end
		end)
	end)

	Net:On("BuyPass", 0.5, function(player, key)
		local pass = type(key) == "string" and Config.GamePasses[key]
		if not pass then
			return
		end
		if self:HasPass(player, key) then
			Net:Notify(player, "You already own %s!", nil, pass.Name)
			return
		end
		if pass.Id == 0 then
			if Util.CanTest(Config, player) then
				applyPass(player, key, true)
				Net:Notify(player, "[TEST] Simulated purchase (no Robux charged): %s", nil, pass.Name)
			else
				Net:Notify(player, "Coming soon!")
			end
			return
		end
		MarketplaceService:PromptGamePassPurchase(player, pass.Id)
	end)

	Net:On("BuyProduct", 0.5, function(player, key)
		local product = type(key) == "string" and Config.Products[key]
		local data = Data:Get(player)
		if not product or not data then
			return
		end
		local ok, reason = canBuy(player, key, data)
		if not ok then
			Net:Notify(player, reason or "Not available")
			return
		end
		if product.Id == 0 then
			if Util.CanTest(Config, player) then
				grantProduct(player, key, data)
				Net:Notify(player, "[TEST] Simulated purchase (no Robux charged): %s", nil, product.Name)
			else
				Net:Notify(player, "Coming soon!")
			end
			return
		end
		MarketplaceService:PromptProductPurchase(player, product.Id)
	end)

	Net:On("BuySubscription", 1, function(player)
		local sub = Config.Subscription
		if self:IsSubscribed(player) then
			Net:Notify(player, "You're already in the %s!", nil, sub.Name)
			return
		end
		if sub.Id == "" then
			if Util.CanTest(Config, player) then
				subscribed[player] = true
				player:SetAttribute("Club", true)
				Services.ProgressionService:CheckClubDaily(player)
				Services.CharacterService:RefreshOverhead(player)
				Data:MarkDirty(player)
				Net:Notify(player, "[TEST] Simulated subscription: %s", nil, sub.Name)
			else
				Net:Notify(player, "Coming soon!")
			end
			return
		end
		local ok, err = pcall(function()
			MarketplaceService:PromptSubscriptionPurchase(player, sub.Id)
		end)
		if not ok then
			warn("[Monetization] subscription prompt failed: " .. tostring(err))
		end
	end)

	Net:On("BuyPremium", 1, function(player)
		if player.MembershipType ~= Enum.MembershipType.Premium then
			pcall(MarketplaceService.PromptPremiumPurchase, MarketplaceService, player)
		end
	end)

	Net:OnRequest("WatchAd", 2, function(player)
		return watchAd(player)
	end)
end

return Monetization
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Net</string>
            <string name="Source"><![CDATA[--[[
	Networking: one RemoteEvent for client->server actions, one RemoteFunction
	for requests that need a reply, one RemoteEvent for server->client messages.
	Every action is rate limited per player and wrapped in pcall.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Lang = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Lang"))

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local actionRemote = Instance.new("RemoteEvent")
actionRemote.Name = "Action"
actionRemote.Parent = folder

local requestRemote = Instance.new("RemoteFunction")
requestRemote.Name = "Request"
requestRemote.Parent = folder

local messageRemote = Instance.new("RemoteEvent")
messageRemote.Name = "Message"
messageRemote.Parent = folder

folder.Parent = ReplicatedStorage

local actionHandlers = {}
local requestHandlers = {}
local lastCall = {} -- [player] = { [name] = os.clock() }

local function allowed(player, name, minInterval)
	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	local now = os.clock()
	local last = calls[name]
	if last and now - last < minInterval then
		return false
	end
	calls[name] = now
	return true
end

function Net:On(name: string, minInterval: number, handler)
	actionHandlers[name] = { Interval = minInterval, Fn = handler }
end

function Net:OnRequest(name: string, minInterval: number, handler)
	requestHandlers[name] = { Interval = minInterval, Fn = handler }
end

function Net:Send(player: Player, kind: string, ...)
	-- (cloud tests use stand-in players: only real Players get remote messages)
	if player and typeof(player) == "Instance" and player.Parent then
		messageRemote:FireClient(player, kind, ...)
	end
end

-- cloud tests only: run an action / request handler directly (never on live servers)
function Net:CallForTest(name: string, player: any, ...)
	assert(not game:GetService("RunService"):IsRunning(), "test hook used on a live server")
	local handler = requestHandlers[name] or actionHandlers[name]
	assert(handler, "no handler " .. name)
	return handler.Fn(player, ...)
end

function Net:Broadcast(kind: string, ...)
	messageRemote:FireAllClients(kind, ...)
end

-- text is English source / format string; args are formatted in.
-- Each player receives it in their own language.
function Net:L(player: Player, text: string, ...): string
	return Lang.F(Lang.LocaleOf(player), text, ...)
end

function Net:Notify(player: Player, text: string, color: Color3?, ...)
	self:Send(player, "Notify", self:L(player, text, ...), color)
end

function Net:Announce(text: string, color: Color3?, ...)
	for _, player in Players:GetPlayers() do
		messageRemote:FireClient(player, "Announce", self:L(player, text, ...), color)
	end
end

actionRemote.OnServerEvent:Connect(function(player, name, ...)
	if type(name) ~= "string" then
		return
	end
	local handler = actionHandlers[name]
	if not handler or not allowed(player, name, handler.Interval) then
		return
	end
	local ok, err = pcall(handler.Fn, player, ...)
	if not ok then
		warn(string.format("[Net] action %s from %s failed: %s", name, player.Name, tostring(err)))
	end
end)

requestRemote.OnServerInvoke = function(player, name, ...)
	if type(name) ~= "string" then
		return nil
	end
	local handler = requestHandlers[name]
	if not handler or not allowed(player, "req_" .. name, handler.Interval) then
		return nil
	end
	local results = table.pack(pcall(handler.Fn, player, ...))
	if not results[1] then
		warn(string.format("[Net] request %s from %s failed: %s", name, player.Name, tostring(results[2])))
		return nil
	end
	return table.unpack(results, 2, results.n)
end

Players.PlayerRemoving:Connect(function(player)
	lastCall[player] = nil
end)

return Net
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--[[
	PetService: eggs, hatching, mutations and the pet inventory.

	* Pets live in your base: the best ones sit on pedestals and earn coins
	  every second (BaseService). Your strongest pets also follow you around
	  and add their power to your mining damage - chosen automatically.
	* Coin eggs restock every 5 minutes (same stock in every server, see
	  Util.EggStock); each player can buy up to the stock per restock.
	* Mutations (Golden, Rainbow, Galaxy + weather-only Frozen / Molten) are
	  rolled on every hatch.
	* Star eggs from falling stars / meteors hatch when carried home.
	* Selling a pet pays one minute of its income.
]]
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local PetService = {}
local rng = Random.new()
local Services
local Data

local CURRENCY_NAMES = { Coins = "coins", Gems = "gems", Stardust = "stardust" }

-- serial numbers (#1, #2, ...) for huge and exclusive pets: one global counter
-- per pet. Cloud tests (not a live server) count in a separate store.
local serialStore = nil
pcall(function()
	local name = "MeteorMiners_Serials_v1" .. (if RunService:IsRunning() then "" else "_Test")
	serialStore = DataStoreService:GetDataStore(name)
end)

local function luckFn(luck: number)
	return function(name: string, weight: number): number
		local info = Config.Pets[name]
		local rarity = info and Config.Rarities[info.Rarity]
		if rarity and rarity.Order >= Config.LuckAffectsFromRarity then
			return weight * luck
		end
		return weight
	end
end
PetService.LuckFn = luckFn

local function power(pet): number
	return Util.PetPowerOf(Config, pet)
end

local function income(pet): number
	return Util.PetIncomeOf(Config, pet)
end
PetService.Income = income

function PetService:SellValue(name: string, variant: string?): number
	return math.max(1, math.floor(Util.PetIncome(Config, name, variant) * Config.PetSellSeconds))
end

-- (grown / evolved pets are worth more)
function PetService:SellValueOf(pet): number
	return math.max(1, math.floor(Util.PetIncomeOf(Config, pet) * Config.PetSellSeconds))
end

local function activeEventId(): string?
	local event = Services.EventService:Active()
	return event and event.Id or nil
end

-- mutation roll (rarest first); weather events unlock / boost some of them
local function rollVariant(luck: number): string?
	local mult = math.clamp(luck, 1, 4)
	local event = activeEventId()
	for _, def in Config.PetVariants do
		local chance = def.Chance or 0
		if def.Event and def.Event == event then
			chance = math.max(chance, def.EventChance or 0)
		end
		if chance > 0 and math.random() < chance * mult then
			return def.Id
		end
	end
	return nil
end
PetService.RollVariant = rollVariant

-- the strongest pets follow you (no equipping needed)
function PetService:RefreshEquipped(player: Player)
	local data = Data:Get(player)
	if not data then
		return
	end
	local sorted = {}
	for _, pet in data.Pets do
		if not pet.Away and Config.Pets[pet.Name] then
			table.insert(sorted, pet)
		end
	end
	table.sort(sorted, function(a, b)
		return power(a) > power(b)
	end)
	local slots = Services.StatsService:PetSlots(player, data)
	local ids, names = {}, {}
	for i = 1, math.min(slots, #sorted) do
		table.insert(ids, sorted[i].Id)
		-- "Variant|Name|Level|Stars" so every client can render golden / grown pets
		local pet = sorted[i]
		table.insert(names, (pet.Variant or "") .. "|" .. pet.Name .. "|" .. Util.PetLevel(pet) .. "|" .. Util.PetStars(pet))
	end
	data.Equipped = ids
	player:SetAttribute("Pets", HttpService:JSONEncode(names))
	Data:MarkDirty(player)
end

-- call after any change to the pet list
function PetService:Changed(player: Player)
	self:RefreshEquipped(player)
	local base = Services.BaseService
	if base then
		base:RenderDisplays(player)
	end
end

-- where a new pet ended up: shown on the hatch card so players always know
-- ("🔒 in your vault", "🏠 on display +💰/s", "📦 in storage", "⭐ follows you")
local function describe(player: Player, data, pet, isNew: boolean?)
	local where, rate = "Storage", 0
	local base = Services.BaseService
	if base then
		local vault, display = Util.ArrangePets(Config, data)
		if table.find(vault, pet) then
			where, rate = "Vault", base:PetRate(player, data, pet, true)
		elseif table.find(display, pet) then
			where, rate = "Display", base:PetRate(player, data, pet, false)
		end
	end
	return {
		Id = pet.Id,
		Name = pet.Name,
		Variant = pet.Variant,
		Where = where,
		Rate = rate,
		New = isNew == true,
		Follow = table.find(data.Equipped, pet.Id) ~= nil,
		Level = Util.PetLevel(pet),
		Stars = Util.PetStars(pet),
		Meteor = (Config.Pets[pet.Name] or {}).Meteor == true,
	}
end

local function findPet(data, petId)
	for index, pet in data.Pets do
		if pet.Id == petId then
			return pet, index
		end
	end
	return nil, nil
end
PetService.FindPet = findPet

local function addPet(data, name: string, variant: string?, serial: number?, growth)
	local pet = { Id = data.NextPetUid, Name = name, Variant = variant, Serial = serial }
	if growth then
		pet.Level = growth.Level
		pet.XP = growth.XP
		pet.Stars = growth.Stars
	end
	data.NextPetUid += 1
	table.insert(data.Pets, pet)
	data.PetIndex[name] = true
	return pet
end

local function nextSerial(key: string): number?
	if not serialStore then
		return nil
	end
	local value = nil
	local ok = pcall(function()
		value = serialStore:UpdateAsync(key, function(old)
			return (tonumber(old) or 0) + 1
		end)
	end)
	return if ok then tonumber(value) else nil
end

-- number a new huge / exclusive pet (async); then(serial?) runs afterwards
-- (the pet can't be traded / stolen / sold while it waits: no number gets lost)
local function giveSerial(player: Player, data, pet, andThen)
	pet.SerialPending = true
	task.spawn(function()
		local key = (if pet.Variant == "Huge" then "Huge|" else "") .. pet.Name
		local serial = nextSerial(key)
		pet.SerialPending = nil
		if serial and table.find(data.Pets, pet) and not pet.Serial then
			pet.Serial = serial
			Data:MarkDirty(player)
		end
		if player.Parent then
			PetService:Changed(player)
		end
		if andThen then
			andThen(serial)
		end
	end)
end

-- inventory full: keep the better of (new pet, weakest pet) and sell the other.
-- Returns true when the new pet may be added, plus coins paid for a sold pet.
local function makeRoom(player: Player, data, name: string, variant: string?, growth): (boolean, number)
	local incoming = { Name = name, Variant = variant, Level = growth and growth.Level, Stars = growth and growth.Stars }
	data.PetIndex[name] = true -- discovered, even if it gets sold right away
	if #data.Pets < Config.MaxPets then
		return true, 0
	end
	local weakest, weakestIndex = nil, nil
	for index, pet in data.Pets do
		local precious = pet.Serial ~= nil or pet.SerialPending or Util.IsExclusive(Config, pet)
		if not pet.Away and not precious and (not weakest or income(pet) < income(weakest)) then
			weakest, weakestIndex = pet, index
		end
	end
	if weakest and income(incoming) > income(weakest) then
		local coins = PetService:SellValueOf(weakest)
		table.remove(data.Pets, weakestIndex)
		data.Coins += coins
		data.Stats.LifetimeCoins += coins
		Net:Notify(
			player,
			"Pet storage full - sold your weakest %s for 💰%s",
			Color3.fromRGB(255, 220, 120),
			weakest.Name,
			Util.Format(coins)
		)
		return true, coins
	end
	local coins = PetService:SellValueOf(incoming)
	data.Coins += coins
	data.Stats.LifetimeCoins += coins
	Net:Notify(player, "Pet storage full - sold the new %s for 💰%s", Color3.fromRGB(255, 220, 120), name, Util.Format(coins))
	return false, coins
end

-- "1 in 12.5K" for the announcement (base odds, no luck)
local function oddsText(eggId: string?, name: string, variant: string?): string
	local chance = eggId and Util.HatchChance(Config, eggId, name, variant)
	if not chance or chance <= 0 then
		return ""
	end
	return " (1/" .. Util.Format(math.max(1, math.floor(1 / chance + 0.5))) .. ")"
end

local function announceIfRare(player: Player, name: string, variant: string?, eggId: string?, serial: number?)
	local info = Config.Pets[name]
	local rarity = info and Config.Rarities[info.Rarity]
	if not rarity then
		return
	end
	local eggName = eggId and Config.Eggs[eggId] and Config.Eggs[eggId].Name or ""
	-- big moments: a beam of light on the player for everyone in the server
	if variant == "Huge" or variant == "Titanic" or rarity.Order >= 7 then
		Net:Broadcast("BigHatch", player.UserId, variant or info.Rarity)
	end
	if variant == "Titanic" then
		-- shouted in EVERY server
		Services.EventService:GlobalAnnounce(
			"🗿 %s hatched a TITANIC %s%s!%s",
			Color3.fromRGB(255, 120, 60),
			player.DisplayName,
			name,
			if serial then " #" .. serial else "",
			oddsText(eggId, name, variant)
		)
	elseif variant == "Huge" then
		Net:Announce(
			"🐘 %s hatched a HUGE %s%s!%s",
			Color3.fromRGB(255, 200, 60),
			player.DisplayName,
			name,
			if serial then " #" .. serial else "",
			oddsText(eggId, name, variant)
		)
	elseif rarity.Order >= Config.AnnounceRarity or variant == "Rainbow" or variant == "Galaxy" then
		Net:Announce(
			"🥚 %s hatched a %s %s %s from the %s!%s",
			if variant == "Rainbow" then Color3.fromRGB(255, 120, 230) else rarity.Color,
			player.DisplayName,
			variant or "",
			info.Rarity,
			name,
			eggName,
			oddsText(eggId, name, variant)
		)
	end
end

-- roll `count` pets from an egg; extraLuck multiplies the player's luck
local function roll(player: Player, data, eggId: string, count: number, extraLuck: number?)
	local egg = Config.Eggs[eggId]
	local luck = Services.StatsService:Luck(player, data) * (extraLuck or 1)
	local fn = luckFn(luck)
	local made = {}
	for _ = 1, count do
		local name = Util.WeightedPick(egg.Pets, fn)
		local variant = rollVariant(luck)
		local isNew = not data.PetIndex[name]
		local ok, coins = makeRoom(player, data, name, variant)
		local pet = if ok then addPet(data, name, variant) else nil
		table.insert(made, { Pet = pet, Name = name, Variant = variant, New = isNew, Coins = if ok then nil else coins })
		if variant == "Huge" then
			data.Stats.HugesFound = (data.Stats.HugesFound or 0) + 1
		elseif variant == "Titanic" then
			data.Stats.TitanicsFound = (data.Stats.TitanicsFound or 0) + 1
		end
		if pet and Util.WantsSerial(Config, name, variant) then
			giveSerial(player, data, pet, function(serial)
				announceIfRare(player, name, variant, eggId, serial)
			end)
		else
			announceIfRare(player, name, variant, eggId, nil)
		end
	end
	data.Stats.EggsHatched += count
	Services.ProgressionService:TutorialEvent(player, "Hatch", count)
	Services.ProgressionService:AddQuest(player, "Hatch", count)
	Services.ProgressionService:AddSeasonXP(player, 25 * count)
	PetService:Changed(player)
	local results = {}
	for _, entry in made do
		if entry.Pet then
			table.insert(results, describe(player, data, entry.Pet, entry.New))
		else
			-- storage was full and the new pet was the weakest: sold right away
			table.insert(results, { Name = entry.Name, Variant = entry.Variant, Where = "Sold", Coins = entry.Coins, New = entry.New })
		end
	end
	return results
end

function PetService:GrantPet(player: Player, name: string, variant: string?)
	local data = Data:Get(player)
	if not data or not Config.Pets[name] then
		return
	end
	local isNew = not data.PetIndex[name]
	local ok, coins = makeRoom(player, data, name, variant)
	local pet = nil
	if ok then
		pet = addPet(data, name, variant)
		if Util.WantsSerial(Config, name, variant) then
			giveSerial(player, data, pet, nil)
		end
	end
	self:Changed(player)
	local result = if pet
		then describe(player, data, pet, isNew)
		else { Name = name, Variant = variant, Where = "Sold", Coins = coins, New = isNew }
	Net:Send(player, "HatchResult", { result }, nil)
end

function PetService:PaidHatch(player: Player, eggId: string, count: number)
	local data = Data:Get(player)
	if not data or not Config.Eggs[eggId] then
		error("invalid paid hatch")
	end
	local results = roll(player, data, eggId, count)
	Net:Send(player, "HatchResult", results, eggId)
end

-- a star egg carried home hatches (luck from the star's rarity)
-- meteor = { Kind = 1..5, Golden = bool, Rarity = "Epic" } for eggs from a meteor:
-- they can hatch that meteor's ☄️ METEOR PET
function PetService:HatchStarEgg(player: Player, eggId: string, luck: number, meteor)
	local data = Data:Get(player)
	if not data or not Config.Eggs[eggId] then
		return nil
	end
	local settings = Config.Meteor
	local meteorPet = meteor and settings.MeteorPets[meteor.Kind]
	if meteorPet and Config.Pets[meteorPet] then
		local chance = (settings.MeteorPetChance[meteor.Rarity] or 0) * (if meteor.Golden then 2 else 1)
		if rng:NextNumber() < chance then
			local variant = rollVariant(Services.StatsService:Luck(player, data) * luck)
			local isNew = not data.PetIndex[meteorPet]
			local ok, coins = makeRoom(player, data, meteorPet, variant)
			local pet = if ok then addPet(data, meteorPet, variant) else nil
			data.Stats.EggsHatched += 1
			data.Stats.MeteorPets = (data.Stats.MeteorPets or 0) + 1
			if variant == "Huge" then
				data.Stats.HugesFound = (data.Stats.HugesFound or 0) + 1
			elseif variant == "Titanic" then
				data.Stats.TitanicsFound = (data.Stats.TitanicsFound or 0) + 1
			end
			if pet and Util.WantsSerial(Config, meteorPet, variant) then
				giveSerial(player, data, pet, function(serial)
					announceIfRare(player, meteorPet, variant, nil, serial)
				end)
			elseif variant == "Huge" or variant == "Titanic" or variant == "Rainbow" or variant == "Galaxy" then
				announceIfRare(player, meteorPet, variant, nil, nil)
			end
			Services.ProgressionService:AddQuest(player, "Hatch", 1)
			Services.ProgressionService:AddSeasonXP(player, 25)
			self:Changed(player)
			local card = if pet
				then describe(player, data, pet, isNew)
				else { Name = meteorPet, Variant = variant, Where = "Sold", Coins = coins, New = isNew }
			card.Meteor = true
			Net:Send(player, "HatchResult", { card }, eggId)
			Net:Broadcast("BigHatch", player.UserId, "Meteor")
			Net:Announce(
				"☄️ %s hatched a METEOR PET: %s! (only from meteors)",
				Color3.fromRGB(255, 150, 80),
				player.DisplayName,
				meteorPet
			)
			return card
		end
	end
	local results = roll(player, data, eggId, 1, luck)
	Net:Send(player, "HatchResult", results, eggId)
	return results[1]
end

-- stealing: take a pet out of one inventory and put it into another
function PetService:TakePet(player: Player, petId: number)
	local data = Data:Get(player)
	local pet, index = nil, nil
	if data then
		pet, index = findPet(data, petId)
	end
	if not pet then
		return nil
	end
	table.remove(data.Pets, index)
	self:Changed(player)
	return { Name = pet.Name, Variant = pet.Variant, Serial = pet.Serial, Level = pet.Level, XP = pet.XP, Stars = pet.Stars }
end

-- numbered pets keep their number when they change owners
function PetService:GivePet(player: Player, name: string, variant: string?, serial: number?, growth)
	local data = Data:Get(player)
	if not data or not Config.Pets[name] then
		return
	end
	local isNew = not data.PetIndex[name]
	local pet = nil
	if makeRoom(player, data, name, variant, growth) then
		pet = addPet(data, name, variant, serial, growth)
	end
	self:Changed(player)
	return pet, isNew
end

-- (used to show a stolen pet with the same "where did it go" card)
function PetService:Describe(player: Player, pet, isNew: boolean?)
	local data = Data:Get(player)
	return data and describe(player, data, pet, isNew) or nil
end

---------------------------------------------------------------------------
-- egg shop stock (coin eggs restock every few minutes)
---------------------------------------------------------------------------
-- how many of this egg the player can still buy in the current restock (nil = unlimited)
function PetService:StockLeft(data, eggId: string): number?
	local slot = Util.ShopSlot(Config, workspace:GetServerTimeNow())
	local stock = Util.EggStock(Config, eggId, slot)
	if stock == nil then
		return nil
	end
	local shop = data.Shop
	if shop.Slot ~= slot then
		shop.Slot = slot
		shop.Bought = {}
	end
	return math.max(0, stock - (shop.Bought[eggId] or 0))
end

local function hatch(player: Player, eggId, count)
	local data = Data:Get(player)
	local egg = type(eggId) == "string" and Config.Eggs[eggId]
	if not data or not egg or egg.Currency == "Robux" then
		return { Error = Net:L(player, "Invalid egg") }
	end
	count = if count == 3 then 3 else 1
	if count == 3 and not Services.MonetizationService:HasPass(player, "TripleHatch") then
		return { Error = Net:L(player, "Triple Hatch requires the gamepass!"), Upsell = "TripleHatch" }
	end
	if data.ZoneLevel < egg.Zone then
		return { Error = Net:L(player, "Unlock %s first!", Config.Zones[egg.Zone].Name) }
	end
	local left = PetService:StockLeft(data, eggId)
	if left ~= nil and left < count then
		local wait = Util.ShopRestockIn(Config, workspace:GetServerTimeNow())
		if left == 0 then
			return { Error = Net:L(player, "Sold out! New stock in %s", Util.FormatTime(wait)) }
		end
		return { Error = Net:L(player, "Only %d left until the restock!", left) }
	end
	local cost = egg.Price * count
	local balance = data[egg.Currency] or 0
	if balance < cost then
		return { Error = Net:L(player, "Not enough %s! Need %s more.", CURRENCY_NAMES[egg.Currency], Util.Format(cost - balance)) }
	end
	data[egg.Currency] -= cost
	Services.Analytics:Economy(player, "Sink", egg.Currency, cost, data[egg.Currency], "Shop", "Egg_" .. eggId)
	if left ~= nil then
		data.Shop.Bought[eggId] = (data.Shop.Bought[eggId] or 0) + count
	end
	local results = roll(player, data, eggId, count)
	return { Pets = results, Egg = eggId }
end

-- egg stands: hold "Hatch" to hatch one without opening the shop
local quickHatchAt = {}
function PetService:QuickHatch(player: Player, eggId: string)
	if os.clock() - (quickHatchAt[player] or 0) < 0.6 then
		return
	end
	quickHatchAt[player] = os.clock()
	local result = hatch(player, eggId, 1)
	if type(result) ~= "table" then
		return
	end
	if result.Error then
		Net:Send(player, "Notify", result.Error, Color3.fromRGB(255, 110, 110))
		return
	end
	Net:Send(player, "HatchResult", result.Pets, eggId)
end

---------------------------------------------------------------------------
-- old saves: star shards (before pets earned money) become pets
---------------------------------------------------------------------------
local function migrate(player: Player, data)
	local shards = data.Base and data.Base.Shards
	if type(shards) ~= "table" or #shards == 0 then
		return
	end
	-- same rules as a star egg carried home: the player's zone egg, luck by rarity
	local zoneEgg = Config.Shards.ZoneEggs[math.clamp(data.ZoneLevel, 1, #Config.Shards.ZoneEggs)] or "Meadow"
	local pool = Config.Eggs[zoneEgg].Pets
	for _, entry in shards do
		local rarity = Config.Shards.Rarities[entry.Id]
		local luck = if rarity then rarity.Luck or 1 else 1
		local name = Util.WeightedPick(pool, luckFn(luck))
		if makeRoom(player, data, name, nil) then
			addPet(data, name, nil)
		end
	end
	data.Base.Shards = {}
	Net:Notify(player, "Your star shards hatched into pets! 🐾", Color3.fromRGB(150, 230, 255))
end

---------------------------------------------------------------------------
-- 🌱 growth: levels, feeding, ★ evolving
---------------------------------------------------------------------------
local GROWTH = Config.Growth

-- add xp to one pet; true when it reached a new level
local function grow(pet, amount: number): boolean
	if amount <= 0 or not Config.Pets[pet.Name] then
		return false
	end
	local level = Util.PetLevel(pet)
	if level >= GROWTH.MaxLevel then
		pet.XP = nil
		return false
	end
	pet.XP = (tonumber(pet.XP) or 0) + amount
	local leveled = false
	local guard = 0
	while level < GROWTH.MaxLevel and pet.XP >= Util.PetXPNeed(Config, pet) and guard < 20 do
		guard += 1
		pet.XP -= Util.PetXPNeed(Config, pet)
		level += 1
		pet.Level = level
		leveled = true
	end
	if level >= GROWTH.MaxLevel then
		pet.XP = nil
	end
	return leveled
end

-- give xp to some pets; level-ups are celebrated and the pets re-rendered
function PetService:AddXP(player: Player, pets, amount: number)
	local data = Data:Get(player)
	if not data or amount <= 0 then
		return {}
	end
	local ups = {}
	for _, pet in pets do
		if not pet.Away then
			local before = Util.PetStage(Config, Util.PetLevel(pet))
			if grow(pet, amount) then
				local stage = Util.PetStage(Config, Util.PetLevel(pet))
				table.insert(ups, {
					Id = pet.Id,
					Name = pet.Name,
					Variant = pet.Variant,
					Level = Util.PetLevel(pet),
					Stars = Util.PetStars(pet),
					Stage = stage.Id,
					Grew = stage ~= before,
				})
			end
		end
	end
	Data:MarkDirty(player)
	if #ups > 0 then
		Net:Send(player, "PetLevelUp", ups)
		local grew = false
		for _, up in ups do
			grew = grew or up.Grew
		end
		if grew then
			self:Changed(player) -- (a bigger model: re-render the pedestals)
		else
			-- just new numbers: follow-pet badges + pedestal labels
			self:RefreshEquipped(player)
			if Services.BaseService then
				Services.BaseService:RefreshPetLabels(player)
			end
		end
	end
	return ups
end

function PetService:FollowingPets(data)
	local list = {}
	for _, id in data.Equipped do
		local pet = findPet(data, id)
		if pet then
			table.insert(list, pet)
		end
	end
	return list
end

-- xp for the pets following you (pet help, meteors, deliveries)
function PetService:AddFollowXP(player: Player, amount: number)
	local data = Data:Get(player)
	if data then
		return self:AddXP(player, self:FollowingPets(data), amount)
	end
	return {}
end

-- pets standing in your home grow slowly (while you're in the game)
function PetService:HomeXP(player: Player)
	local data = Data:Get(player)
	if not data then
		return
	end
	local vault, display = Util.ArrangePets(Config, data)
	local list = table.clone(vault)
	for _, pet in display do
		table.insert(list, pet)
	end
	self:AddXP(player, list, GROWTH.HomeXPPerMinute)
end

local function feed(player: Player, petId)
	local data = Data:Get(player)
	local pet = data and type(petId) == "number" and findPet(data, petId)
	if not pet or pet.Away then
		return { Error = Net:L(player, "That pet isn't here right now.") }
	end
	if Util.PetLevel(pet) >= GROWTH.MaxLevel then
		return { Error = Net:L(player, "👑 Max level! Evolve it with %d copies ⭐", GROWTH.Evolve.Copies) }
	end
	local cost, xp = Util.PetFeed(Config, pet)
	if data.Stardust < cost then
		return { Error = Net:L(player, "Not enough ✨ stardust (%s) - smash meteors!", Util.Format(cost)) }
	end
	data.Stardust -= cost
	Services.Analytics:Economy(player, "Sink", "Stardust", cost, data.Stardust, "Gameplay", "PetFeed")
	local ups = PetService:AddXP(player, { pet }, xp)
	Data:MarkDirty(player) -- (the xp bar syncs with the data)
	return { Ok = true, Level = Util.PetLevel(pet), Up = #ups > 0 }
end

-- the copies an evolve would use (Util.EvolveCopies: plain, not more evolved)
local function evolveFodder(data, pet)
	return Util.EvolveCopies(Config, data, pet)
end
PetService.EvolveFodder = evolveFodder

local function evolve(player: Player, petId)
	local data = Data:Get(player)
	local pet = data and type(petId) == "number" and findPet(data, petId)
	if not pet or pet.Away or pet.SerialPending then
		return { Error = Net:L(player, "That pet isn't here right now.") }
	end
	if Services.TradeService and Services.TradeService:IsTrading(player) then
		return { Error = Net:L(player, "Finish your trade first.") }
	end
	local settings = GROWTH.Evolve
	if Util.PetStars(pet) >= settings.MaxStars then
		return { Error = Net:L(player, "This pet is fully evolved! ★★★") }
	end
	if Util.PetLevel(pet) < GROWTH.MaxLevel then
		return { Error = Net:L(player, "Grow it to level %d first 👑", GROWTH.MaxLevel) }
	end
	local fodder = evolveFodder(data, pet)
	if #fodder < settings.Copies then
		return { Error = Net:L(player, "You need %d more %s to evolve", settings.Copies - #fodder, pet.Name) }
	end
	for i = 1, settings.Copies do
		local index = table.find(data.Pets, fodder[i])
		if index then
			table.remove(data.Pets, index)
		end
	end
	pet.Stars = Util.PetStars(pet) + 1
	pet.Level = 1
	pet.XP = nil
	data.Stats.Evolved = (data.Stats.Evolved or 0) + 1
	PetService:Changed(player)
	Data:MarkDirty(player)
	local card = describe(player, data, pet, false)
	card.Evolved = true
	Net:Send(player, "PetEvolved", card)
	Net:Broadcast("BigHatch", player.UserId, "Evolve")
	if pet.Stars >= settings.MaxStars or (Config.Rarities[Config.Pets[pet.Name].Rarity].Order >= Config.AnnounceRarity) then
		Net:Announce("🌟 %s evolved a %s %s!", Color3.fromRGB(255, 210, 90), player.DisplayName, string.rep("★", pet.Stars), pet.Name)
	end
	return { Ok = true, Stars = pet.Stars }
end

-- 📖 index milestones: claim gems (+ a permanent home income bonus)
local function claimIndex(player: Player, index)
	local data = Data:Get(player)
	local milestone = data and type(index) == "number" and Config.Index.Milestones[index]
	if not milestone then
		return { Error = "?" }
	end
	data.IndexClaimed = data.IndexClaimed or {}
	local key = tostring(index)
	if data.IndexClaimed[key] then
		return { Error = Net:L(player, "Already claimed!") }
	end
	if Util.IndexCount(data) < milestone.Count then
		return { Error = Net:L(player, "Discover %d different pets first", milestone.Count) }
	end
	data.IndexClaimed[key] = true
	data.Gems += milestone.Gems or 0
	Services.Analytics:Economy(player, "Source", "Gems", milestone.Gems or 0, data.Gems, "Gameplay", "IndexMilestone")
	Data:MarkDirty(player)
	if Services.BaseService then
		Services.BaseService:RefreshLabels(player, true)
	end
	Net:Send(player, "Sold", 0)
	return { Ok = true, Gems = milestone.Gems or 0, Bonus = milestone.Bonus or 0 }
end

-- cloud tests: call the request handlers directly
PetService.FeedForTest = feed
PetService.EvolveForTest = evolve
PetService.ClaimIndexForTest = claimIndex

function PetService:Init(services)
	Services = services
	Data = services.DataService
end

function PetService:Start()
	Data:OnLoaded(function(player, data)
		for _, pet in data.Pets do
			pet.Away = nil -- a theft interrupted by a server shutdown never happened
			pet.SerialPending = nil
		end
		-- numbered pets whose number never arrived (DataStore hiccup): try again
		for _, pet in data.Pets do
			if not pet.Serial and Util.WantsSerial(Config, pet.Name, pet.Variant) then
				giveSerial(player, data, pet, nil)
			end
		end
		migrate(player, data)
		self:RefreshEquipped(player)
	end)

	Net:OnRequest("Hatch", 0.35, hatch)
	Net:OnRequest("PetFeed", 0.2, feed)
	Net:OnRequest("PetEvolve", 1, evolve)
	Net:OnRequest("IndexClaim", 0.5, claimIndex)
	-- pets at home grow a little every minute
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Data:LoadedPlayers() do
				local ok, err = pcall(PetService.HomeXP, PetService, player)
				if not ok then
					warn("[Pets] home xp: " .. tostring(err))
				end
			end
		end
	end)

	-- restock announcements (every server sees the same stock at the same time)
	task.spawn(function()
		local lastSlot = Util.ShopSlot(Config, workspace:GetServerTimeNow())
		while true do
			task.wait(1)
			local slot = Util.ShopSlot(Config, workspace:GetServerTimeNow())
			if slot ~= lastSlot then
				lastSlot = slot
				Net:Broadcast("Restock", slot)
				-- the rarest egg in stock gets a shout-out
				local best = nil
				for _, eggId in Config.EggOrder do
					local egg = Config.Eggs[eggId]
					local stock = Util.EggStock(Config, eggId, slot)
					if stock and stock > 0 and egg.Stock.Chance < 0.7 and (not best or egg.Price > Config.Eggs[best].Price) then
						best = eggId
					end
				end
				if best then
					Net:Announce("🥚 Egg restock! %s is in stock!", Config.Eggs[best].Color, Config.Eggs[best].Name)
				else
					Net:Announce("🥚 The egg shops just restocked!", Color3.fromRGB(150, 230, 120))
				end
			end
		end
	end)

	-- sell one pet for a minute of its income
	Net:On("SellPet", 0.1, function(player, petId)
		local data = Data:Get(player)
		if not data or type(petId) ~= "number" then
			return
		end
		local pet, index = findPet(data, petId)
		if not pet or pet.Away or pet.SerialPending then
			return
		end
		local coins = self:SellValueOf(pet)
		table.remove(data.Pets, index)
		data.Coins += coins
		data.Stats.LifetimeCoins += coins
		Net:Notify(player, "Sold %s for 💰%s", Color3.fromRGB(255, 220, 120), pet.Name, Util.Format(coins))
		self:Changed(player)
	end)

	-- quick cleanup: sell every plain pet of a low rarity (keeps your best ones)
	Net:On("SellRarity", 1, function(player, rarity)
		local data = Data:Get(player)
		if not data or (rarity ~= "Common" and rarity ~= "Uncommon") then
			return
		end
		local kept, coins, removed = {}, 0, 0
		for _, pet in data.Pets do
			local info = Config.Pets[pet.Name]
			-- mutated pets are never bulk-sold
			local grown = Util.PetLevel(pet) > 1 or Util.PetStars(pet) > 0
			if info and info.Rarity == rarity and not pet.Variant and not pet.Away and not grown then
				removed += 1
				coins += self:SellValueOf(pet)
			else
				table.insert(kept, pet)
			end
		end
		data.Pets = kept
		data.Coins += coins
		data.Stats.LifetimeCoins += coins
		self:Changed(player)
		Net:Notify(player, "Sold %d %s pets for 💰%s", Color3.fromRGB(255, 220, 120), removed, rarity, Util.Format(coins))
	end)
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[--[[
	ProgressionService: everything that brings players back every day/week.
	  * Daily login streak (7-day calendar, streak breaks if you miss a day)
	  * 3 random daily quests
	  * Playtime gifts (10+ min sessions -> Creator Rewards daily engagement)
	  * Weekly ranked points + tier rewards on week rollover (+ global top 10)
	  * Season pass (free + premium track)
	  * VIP daily chest, Miner Club daily gems, one-time group reward
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Progression = {}
local Services
local Data

local sessionStart = {} -- [player] = unix time
local overtakeCooldown = {} -- ["a>b"] = os.clock()
local giftsClaimed = {} -- [player] = { [index] = true }
local questById = {}
for _, quest in Config.Quests do
	questById[quest.Id] = quest
end

local GREEN = Color3.fromRGB(120, 255, 170)
local GOLD = Color3.fromRGB(255, 210, 70)

local function tierOf(xp: number): number
	return math.min(#Config.SeasonTiers, math.floor(xp / Config.Season.XPPerTier))
end
Progression.TierOf = tierOf

function Progression:SessionStart(player: Player): number
	return sessionStart[player] or os.time()
end

function Progression:GiftsClaimed(player: Player)
	local list = {}
	for index in giftsClaimed[player] or {} do
		table.insert(list, index)
	end
	return list
end

-- source is an English format string; sourceArgs are formatted into it
function Progression:GrantReward(player: Player, reward, source: string?, silent: boolean?, ...)
	local data = Data:Get(player)
	if not data or not reward then
		return
	end
	if reward.Gems then
		data.Gems += reward.Gems
	end
	if reward.Coins then
		data.Coins += reward.Coins
		data.Stats.LifetimeCoins += reward.Coins
	end
	if reward.Stardust then
		data.Stardust += reward.Stardust
	end
	if reward.Boost then
		Services.BoostService:Add(player, reward.Boost[1], reward.Boost[2])
	end
	if reward.Pet then
		Services.PetService:GrantPet(player, reward.Pet, reward.Variant)
	end
	Data:MarkDirty(player)
	if not silent then
		Net:Send(player, "Reward", self:RewardText(player, reward), if source then Net:L(player, source, ...) else nil)
	end
end

function Progression:RewardText(player: Player, reward): string
	return Util.RewardText(reward, function(text, ...)
		return Net:L(player, text, ...)
	end)
end

-- tutorial: Event(id) advances the current step when it matches
-- (context is handed to the next step's setup, e.g. where the egg pops out)
function Progression:TutorialEvent(player: Player, id: string, amount: number?, context)
	local data = Data:Get(player)
	local tutorial = data and data.Tutorial
	if not tutorial or tutorial.Done then
		return
	end
	local steps = Config.Tutorial.Steps
	local step = steps[tutorial.Step]
	if not step or step.Id ~= id then
		return
	end
	tutorial.Progress += amount or 1
	if tutorial.Progress < step.Target then
		Data:MarkDirty(player)
		return
	end
	self:GrantReward(player, step.Reward, nil, true)
	Services.Analytics:Funnel(player, tutorial.Step + 1, step.Id)
	tutorial.Step += 1
	tutorial.Progress = 0
	if tutorial.Step > #steps then
		tutorial.Done = true
		self:GrantReward(player, Config.Tutorial.FinalReward, nil, true)
		Net:Send(player, "TutorialDone", self:RewardText(player, Config.Tutorial.FinalReward))
	else
		Net:Send(player, "TutorialStep", tutorial.Step, self:RewardText(player, step.Reward))
		self:TutorialSetup(player, context)
	end
	Data:MarkDirty(player)
end

-- some steps need the world to cooperate (a meteor to smash, an egg to carry)
function Progression:TutorialSetup(player: Player, context)
	local data = Data:Get(player)
	local tutorial = data and data.Tutorial
	local step = tutorial and not tutorial.Done and Config.Tutorial.Steps[tutorial.Step]
	if not step then
		return
	end
	if step.Id == "Meteor" then
		Services.MeteorService:TutorialMeteor(player)
	elseif step.Id == "Grab" then
		if Services.ShardService:IsCarrying(player) then
			-- already holding an egg: that counts
			self:TutorialEvent(player, "Grab", 1)
		else
			Services.ShardService:TutorialStar(player, context and context.Position)
		end
	elseif step.Id == "Shard" and not Services.ShardService:IsCarrying(player) then
		-- (rejoined without the egg) a new one falls next to the spawn
		task.delay(2, function()
			if player.Parent then
				Services.ShardService:TutorialStar(player)
			end
		end)
	elseif step.Id == "Pickaxe" and (data.PickaxeTier or 1) > 1 then
		-- bought a pickaxe already (during the "mine" step): that counts
		self:TutorialEvent(player, "Pickaxe", 1)
	end
end

-- the tutorial can never get stuck: if the egg is gone (expired, lost on a
-- reset) or the meteor never came, the step is set up again
local emptyHanded = {} -- [player] = os.clock() since when they hold nothing in the "Shard" step
local function tutorialWatchdog()
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		local tutorial = data and data.Tutorial
		local step = tutorial and not tutorial.Done and Config.Tutorial.Steps[tutorial.Step]
		local id = step and step.Id
		local carrying = Services.ShardService:IsCarrying(player)
		if id == "Shard" and not carrying then
			emptyHanded[player] = emptyHanded[player] or os.clock()
			if os.clock() - emptyHanded[player] >= 15 then
				emptyHanded[player] = nil
				Services.ShardService:TutorialStar(player)
			end
		else
			emptyHanded[player] = nil
			if id == "Meteor" then
				Services.MeteorService:TutorialMeteor(player)
			elseif id == "Grab" and not carrying then
				Services.ShardService:TutorialStar(player)
			end
		end
	end
end

-- player level: every block gives XP; level-ups give gems + a permanent coin bonus
function Progression:AddXP(player: Player, amount: number)
	local data = Data:Get(player)
	if not data or amount <= 0 then
		return
	end
	data.XP += amount
	local levels = Config.Levels
	local guard = 0
	while data.XP >= Util.XPForLevel(Config, data.Level) and guard < 50 do
		guard += 1
		data.XP -= Util.XPForLevel(Config, data.Level)
		data.Level += 1
		local gems = levels.GemsPerLevel
		if data.Level % levels.MilestoneEvery == 0 then
			gems += levels.MilestoneGems
			Net:Announce("⭐ %s reached LEVEL %d!", Color3.fromRGB(255, 220, 90), player.DisplayName, data.Level)
		end
		data.Gems += gems
		Net:Send(player, "LevelUp", data.Level, gems)
		Services.CharacterService:RefreshOverhead(player)
	end
	Data:MarkDirty(player)
end

function Progression:AddQuest(player: Player, questType: string, amount: number)
	local data = Data:Get(player)
	if not data then
		return
	end
	for _, quest in data.Daily.Quests do
		local def = questById[quest.Id]
		if def and def.Type == questType and not quest.Claimed and quest.Progress < def.Target then
			quest.Progress = math.min(def.Target, quest.Progress + amount)
			if quest.Progress >= def.Target then
				Net:Notify(player, "✅ Quest complete: %s - claim it!", GREEN, def.Text)
			end
			Data:MarkDirty(player)
		end
	end
end

function Progression:AddPoints(player: Player, amount: number)
	local data = Data:Get(player)
	if not data then
		return
	end
	local _, before = Util.RankFor(Config, data.Weekly.Points)
	local oldPoints = data.Weekly.Points
	data.Weekly.Points += amount
	-- in-server rivalry: tell both players when someone overtakes
	local now = os.clock()
	for _, other in Data:LoadedPlayers() do
		local otherData = other ~= player and Data:Get(other)
		if otherData then
			local theirs = otherData.Weekly.Points
			if oldPoints <= theirs and data.Weekly.Points > theirs and theirs > 0 then
				local key = player.UserId .. ">" .. other.UserId
				if not overtakeCooldown[key] or now - overtakeCooldown[key] > 90 then
					overtakeCooldown[key] = now
					Net:Notify(player, "⬆️ You passed %s in the weekly ranking!", Color3.fromRGB(120, 255, 170), other.DisplayName)
					Net:Notify(other, "⬇️ %s just passed you! Take it back!", Color3.fromRGB(255, 120, 120), player.DisplayName)
				end
			end
		end
	end
	local rank, after = Util.RankFor(Config, data.Weekly.Points)
	if after > before then
		Net:Send(player, "RankUp", rank.Name)
		if after >= 5 then
			Net:Announce("🏅 %s reached %s rank this week!", rank.Color, player.DisplayName, rank.Name)
		end
		Services.CharacterService:RefreshOverhead(player)
	end
	Data:MarkDirty(player)
end

function Progression:AddSeasonXP(player: Player, amount: number)
	local data = Data:Get(player)
	if not data then
		return
	end
	local before = tierOf(data.Season.XP)
	data.Season.XP += amount
	local after = tierOf(data.Season.XP)
	if after > before then
		Net:Notify(player, "🎫 Season Pass tier %d reached! Claim your rewards.", GOLD, after)
	end
	Data:MarkDirty(player)
end

function Progression:OnBlockMined(player: Player, zone: number)
	self:TutorialEvent(player, "Mine", 1)
	self:AddQuest(player, "MineBlocks", 1)
	self:AddSeasonXP(player, Config.Season.XPPerBlock * zone)
	self:AddPoints(player, Config.PointsPerBlock[zone] or 1)
end

function Progression:CheckClubDaily(player: Player)
	local data = Data:Get(player)
	if not data or not Services.MonetizationService:IsSubscribed(player) then
		return
	end
	local today = Util.DayNumber()
	if data.Daily.ClubDay ~= today then
		data.Daily.ClubDay = today
		self:GrantReward(player, { Gems = Config.Subscription.DailyGems }, "%s daily gems", false, Config.Subscription.Name)
	end
end

local function rollQuests(data)
	local indices = {}
	for i = 1, #Config.Quests do
		indices[i] = i
	end
	for i = #indices, 2, -1 do
		local j = math.random(1, i)
		indices[i], indices[j] = indices[j], indices[i]
	end
	data.Daily.Quests = {}
	for i = 1, math.min(Config.DailyQuestCount, #indices) do
		local def = Config.Quests[indices[i]]
		table.insert(data.Daily.Quests, { Id = def.Id, Progress = 0, Claimed = false })
	end
end

local function checkRollovers(player: Player, data, isLoad: boolean)
	-- daily
	local today = Util.DayNumber()
	if data.Daily.Day ~= today then
		data.Daily.Day = today
		rollQuests(data)
		if not isLoad then
			Net:Notify(player, "📜 New daily quests are available!", GREEN)
		end
	end
	-- season
	if data.Season.Id ~= Config.Season.Id then
		data.Season = { Id = Config.Season.Id, XP = 0, Premium = false, ClaimedFree = {}, ClaimedPremium = {} }
	end
	-- weekly ranked
	local week = Util.WeekNumber()
	if data.Weekly.Week ~= week then
		local lastWeek, lastPoints = data.Weekly.Week, data.Weekly.Points
		data.Weekly.Week = week
		data.Weekly.Points = 0
		if lastWeek ~= 0 and lastPoints > 0 then
			local rank = Util.RankFor(Config, lastPoints)
			local gems = rank.RewardGems
			task.spawn(function()
				local placement = Services.LeaderboardService:GetWeeklyPlacement(lastWeek, player.UserId)
				local topReward = placement and Config.Leaderboards.WeeklyTopReward[placement] or 0
				local total = gems + topReward
				if total > 0 and player.Parent then
					local text = string.format("Last week: %s rank", string.upper(rank.Name))
					if placement then
						text ..= string.format(" + GLOBAL #%d", placement)
					end
					Progression:GrantReward(player, { Gems = total }, text)
				end
			end)
		end
		Services.CharacterService:RefreshOverhead(player)
	end
	Progression:CheckClubDaily(player)
	Data:MarkDirty(player)
end

function Progression:Init(services)
	Services = services
	Data = services.DataService
end

function Progression:Start()
	Data:OnLoaded(function(player, data)
		sessionStart[player] = os.time()
		giftsClaimed[player] = {}
		player:SetAttribute("Lang", data.Settings.Lang)
		if not data.Tutorial.Done and data.Tutorial.Step == 1 and data.Tutorial.Progress == 0 then
			Services.Analytics:Funnel(player, 1, "Joined")
		end
		-- ☄️ Meteor Rush: unfinished tutorials restart with the new first steps
		-- (veterans of the old game who already did everything skip it)
		local version = Config.Tutorial.Version or 1
		if (data.Tutorial.Version or 0) < version then
			if not data.Tutorial.Done and data.Stats.EggsHatched > 0 and data.PickaxeTier > 1 then
				data.Tutorial.Done = true
			end
			if not data.Tutorial.Done then
				data.Tutorial.Step = 1
				data.Tutorial.Progress = 0
			end
			data.Tutorial.Version = version
			Data:MarkDirty(player)
		end
		task.delay(if data.Tutorial.Step == 1 then 3 else 6, function()
			if player.Parent then
				self:TutorialSetup(player)
			end
		end)
		checkRollovers(player, data, true)
		-- daily reward reminder
		if data.Daily.LastClaimDay ~= Util.DayNumber() then
			task.delay(4, function()
				Net:Send(player, "OpenPanel", "Daily")
			end)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			local ok, err = pcall(tutorialWatchdog)
			if not ok then
				warn("[Progression] tutorial watchdog: " .. tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		emptyHanded[player] = nil
		sessionStart[player] = nil
		giftsClaimed[player] = nil
	end)

	-- minute ticker: play-time quests, rollovers
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Data:LoadedPlayers() do
				local data = Data:Get(player)
				if data then
					local ok, err = pcall(function()
						data.Stats.PlaySeconds += 60
						self:AddQuest(player, "PlayMinutes", 1)
						checkRollovers(player, data, false)
					end)
					if not ok then
						warn("[Progression] tick error: " .. tostring(err))
					end
				end
			end
		end
	end)

	Net:On("ClaimDaily", 1, function(player)
		local data = Data:Get(player)
		if not data then
			return
		end
		local today = Util.DayNumber()
		if data.Daily.LastClaimDay == today then
			Net:Notify(player, "Come back tomorrow for your next reward!")
			return
		end
		if data.Daily.LastClaimDay == today - 1 then
			data.Daily.Streak += 1
		else
			data.Daily.Streak = 1
		end
		data.Daily.LastClaimDay = today
		local index = ((data.Daily.Streak - 1) % #Config.DailyRewards) + 1
		self:GrantReward(player, Config.DailyRewards[index], "Day %d login reward", false, index)
	end)

	Net:On("ClaimQuest", 0.3, function(player, index)
		local data = Data:Get(player)
		local quest = data and type(index) == "number" and data.Daily.Quests[index]
		local def = quest and questById[quest.Id]
		if not def or quest.Claimed or quest.Progress < def.Target then
			return
		end
		quest.Claimed = true
		self:GrantReward(player, def.Reward, "Quest: %s", false, def.Text)
		self:AddSeasonXP(player, def.XP)
		self:AddPoints(player, def.Points)
	end)

	Net:On("ClaimGift", 0.3, function(player, index)
		local gift = type(index) == "number" and Config.PlaytimeGifts[index]
		local claimed = giftsClaimed[player]
		if not gift or not claimed or claimed[index] then
			return
		end
		if os.time() - (sessionStart[player] or os.time()) < gift.Minutes * 60 then
			return
		end
		claimed[index] = true
		self:GrantReward(player, gift.Reward, "Playtime gift")
	end)

	local function claimTier(player: Player, data, tier: number, track: string): boolean
		local tierDef = Config.SeasonTiers[tier]
		if not tierDef or tierOf(data.Season.XP) < tier then
			return false
		end
		local key = tostring(tier)
		local claimed = if track == "Premium" then data.Season.ClaimedPremium else data.Season.ClaimedFree
		if claimed[key] then
			return false
		end
		if track == "Premium" and not data.Season.Premium then
			return false
		end
		claimed[key] = true
		self:GrantReward(player, tierDef[track], "Season tier %d", false, tier)
		return true
	end

	Net:On("ClaimTier", 0.15, function(player, tier, track)
		local data = Data:Get(player)
		if not data or type(tier) ~= "number" or (track ~= "Free" and track ~= "Premium") then
			return
		end
		if track == "Premium" and not data.Season.Premium then
			Net:Send(player, "UpsellProduct", "SeasonPremium")
			return
		end
		claimTier(player, data, math.floor(tier), track)
	end)

	Net:On("ClaimAllTiers", 1, function(player)
		local data = Data:Get(player)
		if not data then
			return
		end
		for tier = 1, tierOf(data.Season.XP) do
			claimTier(player, data, tier, "Free")
			if data.Season.Premium then
				claimTier(player, data, tier, "Premium")
			end
		end
	end)

	Net:On("ClaimVip", 1, function(player)
		local data = Data:Get(player)
		if not data then
			return
		end
		if not Services.MonetizationService:HasPass(player, "VIP") then
			Net:Send(player, "Upsell", "VIP")
			return
		end
		local today = Util.DayNumber()
		if data.Daily.VipChestDay == today then
			Net:Notify(player, "VIP chest already claimed today!")
			return
		end
		data.Daily.VipChestDay = today
		self:GrantReward(player, { Gems = Config.Social.VipDailyGems }, "VIP daily chest")
	end)

	-- promo codes ---------------------------------------------------------
	Net:OnRequest("RedeemCode", 1, function(player, code)
		local data = Data:Get(player)
		if not data or type(code) ~= "string" then
			return false, Net:L(player, "Enter a code")
		end
		code = string.upper((code:gsub("%s+", "")))
		local def = Config.Codes[code]
		if not def then
			return false, Net:L(player, "Invalid code")
		end
		if def.ExpiresAt and def.ExpiresAt > 0 and os.time() > def.ExpiresAt then
			return false, Net:L(player, "This code has expired")
		end
		if data.Codes[code] then
			return false, Net:L(player, "Already redeemed")
		end
		data.Codes[code] = true
		self:GrantReward(player, def.Reward, "Code %s", false, code)
		return true, Net:L(player, "Redeemed: %s", self:RewardText(player, def.Reward))
	end)

	-- free prize wheel ------------------------------------------------------
	Net:OnRequest("Spin", 1, function(player)
		local data = Data:Get(player)
		if not data then
			return nil
		end
		local now = os.time()
		if data.FreeSpinAt > now then
			return { Error = Net:L(player, "Next free spin in %s", Util.FormatTime(data.FreeSpinAt - now)) }
		end
		local cooldown = if Services.MonetizationService:HasPass(player, "VIP")
			then Config.Spin.VipCooldownSeconds
			else Config.Spin.CooldownSeconds
		data.FreeSpinAt = now + cooldown
		local entries = {}
		for i, entry in Config.Spin.Rewards do
			entries[i] = { i, entry.Weight }
		end
		local index = Util.WeightedPick(entries)
		local entry = Config.Spin.Rewards[index]
		-- granted now, revealed by the wheel animation on the client
		self:GrantReward(player, entry.Reward, "Spin", true)
		if entry.Jackpot then
			Net:Announce("🎡 %s hit the JACKPOT on the prize wheel!", Color3.fromRGB(255, 230, 120), player.DisplayName)
		end
		Data:MarkDirty(player)
		return { Index = index, Text = self:RewardText(player, entry.Reward) }
	end)

	-- 👑 Titles panel: wear an unlocked title ("" = the best one automatically)
	Net:On("SetTitle", 0.5, function(player, id)
		local data = Data:Get(player)
		if not data or type(id) ~= "string" then
			return
		end
		if id ~= "" then
			local found = nil
			for _, title in Config.Titles do
				if title.Id == id then
					found = title
				end
			end
			local hasPass = function(key)
				return Services.MonetizationService:HasPass(player, key)
			end
			if not found or not Util.TitleUnlocked(Config, found, data, hasPass) then
				return
			end
		end
		data.Title = id
		Data:MarkDirty(player)
		Services.CharacterService:RefreshOverhead(player)
	end)

	Net:On("SeenHowTo", 5, function(player)
		local data = Data:Get(player)
		if data and not (data.Flags.HowToSeen and data.Flags.HowToRush) then
			data.Flags.HowToSeen = true
			data.Flags.HowToRush = true -- (the ☄️ Meteor Rush rules were shown)
			Data:MarkDirty(player)
		end
	end)

	-- sound effects / music on or off (remembered)
	Net:On("SetAudio", 0.3, function(player, sfx, music)
		local data = Data:Get(player)
		if not data or type(sfx) ~= "boolean" or type(music) ~= "boolean" then
			return
		end
		data.Settings.Sfx = sfx
		data.Settings.Music = music
		Data:MarkDirty(player)
	end)

	Net:On("SetLanguage", 1, function(player, lang)
		local data = Data:Get(player)
		if not data or (lang ~= "ko" and lang ~= "en" and lang ~= "auto") then
			return
		end
		data.Settings.Lang = lang
		player:SetAttribute("Lang", lang)
		Data:MarkDirty(player)
	end)

	Net:On("ClaimGroup", 2, function(player)
		local data = Data:Get(player)
		if not data or Config.GroupId == 0 or data.Flags.GroupReward then
			return
		end
		local ok, inGroup = pcall(player.IsInGroup, player, Config.GroupId)
		if ok and inGroup then
			data.Flags.GroupReward = true
			player:SetAttribute("InGroup", true)
			self:GrantReward(player, { Gems = Config.Social.GroupJoinGems }, "Thanks for joining the group!")
		else
			Net:Notify(player, "Join our Roblox group first, then claim again!")
		end
	end)
end

return Progression
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">RivalHomes</string>
            <string name="Source"><![CDATA[--[[
	RivalHomes: rival players own a home too - a real estate in the base
	district with a house and pets on display.

	  * 🌙 Thief Night (or revenge): you can steal a rival's displayed pet and
	    run it home. The rival runs after you (they may bonk you even inside
	    the base district - it's their pet). One theft per rival home per
	    few minutes (like players' theft shield).
	  * 🌙 Thief Night: a rival may sneak into YOUR home and grab a pet from a
	    display pedestal (never a vault / exclusive pet, never through locks
	    or shields). You get an alarm - bonk them before they get home! If
	    they make it, the pet stands in their home: steal it back (revenge
	    for 5 minutes, or the next Thief Night). When a rival leaves the
	    server, pets they took go back to their owners.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local PetModel = require(Shared.PetModel)
local DecorModel = require(Shared.DecorModel)
local Net = require(script.Parent.Net)

local Homes = {}
local Services
local Data
local World

local SETTINGS = Config.Base
local SLOTS = { { -12, 4 }, { -6, 2 }, { 0, 2 }, { 6, 2 }, { 12, 4 } }
local rng = Random.new()
local byIndex = {} -- [plot index] = rival record
local byUser = {} -- [rival UserId] = rival record
local nextUid = 0

local function newPet(fields)
	nextUid += 1
	fields.Uid = nextUid
	return fields
end

local function findPet(record, uid)
	for index, pet in record.HomePets or {} do
		if pet.Uid == uid then
			return pet, index
		end
	end
	return nil, nil
end

-- the weakest pet that may make room (not away, not a player's)
local function weakestIndex(record)
	local best, bestIndex = nil, nil
	for index, pet in record.HomePets do
		if not pet.Away and not pet.FromUserId and (not best or Util.PetIncomeOf(Config, pet) < Util.PetIncomeOf(Config, best)) then
			best, bestIndex = pet, index
		end
	end
	return best, bestIndex
end

local function now(): number
	return workspace:GetServerTimeNow()
end

local function internal()
	return Services.BaseService.Internal
end

local function raidActive(): boolean
	local events = Services.EventService
	return events ~= nil and events:RaidActive()
end

-- may this player steal from this rival right now?
local function canRaid(player: Player, record): boolean
	if (record.HomeShieldUntil or 0) > now() then
		return false
	end
	if raidActive() then
		return true
	end
	return player:GetAttribute("RevengeTarget") == record.Entity.UserId and (player:GetAttribute("RevengeUntil") or 0) > now()
end

-- a fresh set of pets for a new rival (from the server's eggs, a little grown)
local function startingPets(zone: number)
	local pool = Config.Eggs[Config.Shards.ZoneEggs[math.clamp(zone, 1, #Config.Shards.ZoneEggs)]].Pets
	local pets = {}
	for _ = 1, rng:NextInteger(3, 5) do
		local name = Util.WeightedPick(pool, nil, rng)
		table.insert(
			pets,
			newPet({
				Name = name,
				Variant = if rng:NextNumber() < 0.08 then "Golden" else nil,
				Level = rng:NextInteger(1, 8),
				Stars = if rng:NextNumber() < 0.15 then 1 else 0,
			})
		)
	end
	return pets
end

local function homeRate(record): number
	local total = 0
	for _, pet in record.HomePets do
		if not pet.Away then
			total += Util.PetIncomeOf(Config, pet)
		end
	end
	return total
end

local function refreshSign(record)
	local plot = internal().Plots[record.HomeIndex]
	if not plot then
		return
	end
	local open = raidActive() and (record.HomeShieldUntil or 0) <= now()
	local status = if open then "🔓 OPEN" else "🏠 SAFE"
	plot.Model:SetAttribute("Protection", if open then "" else "safe")
	plot.Model:SetAttribute("Rate", homeRate(record))
	local key = status .. "|" .. math.floor(homeRate(record))
	if key ~= record.SignKey then
		record.SignKey = key
		World.SetText(
			plot.Sign,
			"🏠 %s's HOUSE\n💰 %s/s  ❤️ %s  ⭐ Lv.%s\n%s",
			record.Name,
			Util.Format(homeRate(record)),
			tostring(record.Likes),
			tostring(record.HouseLevel),
			status
		)
	end
end

function Homes:Render(record)
	local plot = internal().Plots[record.HomeIndex]
	if not plot then
		return
	end
	plot.Displays:ClearAllChildren()
	for slot, pet in record.HomePets do
		local spot = SLOTS[slot]
		if spot then
			local cf = plot.CFrame * CFrame.new(spot[1], 0.52, spot[2])
			local pedestal = DecorModel.Build(Config, "Pedestal", nil)
			pedestal:PivotTo(cf)
			pedestal.Parent = plot.Displays
			if not pet.Away then
				local top = pedestal:FindFirstChild("Top")
				local petModel = PetModel.Build(pet.Name, pet.Variant, { Level = pet.Level, Stars = pet.Stars })
				petModel.Name = "RivalPet_" .. slot
				local base = if top and top:IsA("BasePart") then top.Position else cf.Position + Vector3.new(0, 2.6, 0)
				petModel:PivotTo(CFrame.new(base + Vector3.new(0, 1.6, 0)) * (cf - cf.Position))
				local box, size = petModel:GetBoundingBox()
				local lift = (base.Y + 0.2) - (box.Position.Y - size.Y / 2)
				if lift > 0 then
					petModel:PivotTo(petModel:GetPivot() + Vector3.new(0, lift, 0))
				end
				petModel:SetAttribute("Spin", true)
				petModel:SetAttribute("PetId", -1000 - slot)
				petModel.Parent = plot.Displays
				local info = Config.Pets[pet.Name]
				local rarity = info and Config.Rarities[info.Rarity] or Config.Rarities.Common
				local anchor = petModel.PrimaryPart :: BasePart
				local label = internal().Billboard(anchor, 5.5, 1.7, size.Y + 1, rarity.Color, 40)
				World.SetText(
					label,
					"%s %s%s\n%s  💰 %s/s",
					"🌠",
					if pet.Variant then pet.Variant .. " " else "",
					pet.Name,
					Util.PetBadge(Config, pet),
					Util.Format(Util.PetIncomeOf(Config, pet))
				)
				local uid = pet.Uid
				internal().SetPrompt(anchor, "Steal", pet.Name, "Thief", SETTINGS.StealHold, function(thief)
					Homes:StealFrom(thief, record, uid)
				end)
			end
		end
	end
	record.SignKey = nil
	refreshSign(record)
end

-- a rival moves into a free plot (never one a player could need: see BaseService assign)
function Homes:Claim(record): boolean
	local plot = nil
	for _, candidate in internal().Plots do
		if not candidate.Owner and not candidate.Rival then
			plot = candidate
		end
	end
	if not plot then
		return false
	end
	local zone = 1
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		if data then
			zone = math.max(zone, data.ZoneLevel or 1)
		end
	end
	plot.Rival = record
	record.HomeIndex = plot.Index
	record.HouseLevel = rng:NextInteger(1, 3)
	record.Likes = rng:NextInteger(0, 25)
	record.HomePets = startingPets(zone)
	byIndex[plot.Index] = record
	byUser[record.Entity.UserId] = record
	local fake = { Base = { Level = record.HouseLevel, Skin = "Auto", Roof = rng:NextInteger(0, #Config.Paint), Items = {}, Skins = {} } }
	internal().ApplyStyle(plot, fake)
	plot.Model:SetAttribute("OwnerId", record.Entity.UserId)
	plot.Model:SetAttribute("OwnerName", record.Name)
	plot.Model:SetAttribute("HouseLevel", record.HouseLevel)
	plot.Model:SetAttribute("Likes", record.Likes)
	self:Render(record)
	return true
end

-- leaving: pets taken from players go back to them, the plot is free again
function Homes:Release(record)
	local plot = record.HomeIndex and internal().Plots[record.HomeIndex]
	for _, pet in record.HomePets or {} do
		local owner = nil
		for _, player in Data:LoadedPlayers() do
			if player.UserId == pet.FromUserId then
				owner = player
			end
		end
		if owner and not pet.Away then
			Services.PetService:GivePet(owner, pet.Name, pet.Variant, pet.Serial, pet)
			Net:Notify(owner, "🛡️ %s left - your %s came back home!", Color3.fromRGB(120, 230, 255), record.Name, pet.Name)
		end
	end
	if plot then
		byIndex[plot.Index] = nil
		plot.Rival = nil
		internal().ClearPlot(plot)
	end
	byUser[record.Entity.UserId] = nil
	record.HomeIndex = nil
	record.HomePets = {}
end

-- a player needs this plot: the rival moves out (keeps playing without a home)
function Homes:EvictFor(plot)
	local record = byIndex[plot.Index]
	if record then
		self:Release(record)
	end
end

function Homes:HomeSpot(record): Vector3?
	local plot = record.HomeIndex and internal().Plots[record.HomeIndex]
	return plot and (plot.CFrame * CFrame.new(0, 3, -4)).Position
end

function Homes:IsHomeOf(record, position: Vector3): boolean
	local plot = record.HomeIndex and internal().Plots[record.HomeIndex]
	if not plot then
		return false
	end
	local localPos = plot.CFrame:PointToObjectSpace(position)
	local half = internal().PlotHalf
	return math.abs(localPos.X) <= half and math.abs(localPos.Z) <= half + 1
end

---------------------------------------------------------------------------
-- players steal from rivals
---------------------------------------------------------------------------
function Homes:StealFrom(thief: Player, record, uid: number)
	local pet = findPet(record, uid)
	if not pet or pet.Away or not record.HomeIndex then
		return
	end
	local shards = Services.ShardService
	if shards:IsCarrying(thief) then
		Net:Notify(thief, "Your hands are full!")
		return
	end
	if not Services.BaseService:HasBase(thief) then
		Net:Notify(thief, "You need a base to steal pets!")
		return
	end
	if not canRaid(thief, record) then
		Net:Notify(thief, "🏠 Homes are safe! Raids only happen on 🌙 Thief Night.")
		return
	end
	local item = { Kind = "Pet", Name = pet.Name, Variant = pet.Variant }
	local meta = {
		RivalFrom = record.Entity.UserId,
		RivalSlot = uid,
		Growth = { Level = pet.Level, Stars = pet.Stars },
		Thief = thief,
		Deadline = os.clock() + SETTINGS.StolenCarrySeconds,
	}
	pet.Away = true
	if not shards:StartCarry(thief, item, meta) then
		pet.Away = nil
		return
	end
	self:Render(record)
	-- the owner runs after you
	Services.RivalService:Defend(record, thief)
	Net:Notify(thief, "🦹 You grabbed %s's %s - run home!", Color3.fromRGB(255, 170, 90), record.Name, pet.Name)
end

-- the stolen pet made it to the thief's home
function Homes:PetGone(rivalId: number, uid: number)
	local record = byUser[rivalId]
	if not record then
		return
	end
	local _, index = findPet(record, uid)
	if not index then
		return
	end
	table.remove(record.HomePets, index)
	record.HomeShieldUntil = now() + SETTINGS.TheftShieldSeconds
	self:Render(record)
end

-- dropped / too slow: the pet runs back to the rival's home
function Homes:PetBack(rivalId: number, uid: number)
	local record = byUser[rivalId]
	local pet = if record then findPet(record, uid) else nil
	if pet then
		pet.Away = nil
		self:Render(record)
	end
end

---------------------------------------------------------------------------
-- rivals steal from players (🌙 Thief Night only)
---------------------------------------------------------------------------
-- a pet on display in an unprotected home (owner, pet, position of the pet)
function Homes:RaidTarget(record)
	if not raidActive() then
		return nil
	end
	local base = Services.BaseService
	local options = {}
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		local plot = base:PlotOf(player)
		if data and plot and base:Protection(player) == nil then
			for _, pet in base.DisplayedPets(data) do
				if not pet.Away and not pet.SerialPending and not Util.IsExclusive(Config, pet) then
					local model = plot.Displays:FindFirstChild("Pet_" .. pet.Id)
					if model and model:IsA("Model") then
						table.insert(options, { Owner = player, Pet = pet, Position = model:GetPivot().Position })
					end
				end
			end
		end
	end
	if #options == 0 or not record then
		return nil
	end
	return options[rng:NextInteger(1, #options)]
end

-- grab it (the owner gets an alarm); returns the carried item + meta
function Homes:TakeFromPlayer(record, owner: Player, petId: number)
	local base = Services.BaseService
	local data = Data:Get(owner)
	local pet = data and Services.PetService.FindPet(data, petId)
	if not pet or pet.Away or base:Protection(owner) ~= nil then
		return nil
	end
	local onDisplay = false
	for _, shown in base.DisplayedPets(data) do
		onDisplay = onDisplay or shown == pet
	end
	if not onDisplay or Util.IsExclusive(Config, pet) then
		return nil
	end
	base:SetAway(owner, petId, true)
	Net:Notify(owner, "🚨 %s is stealing your %s! Bonk them before they get home!", Color3.fromRGB(255, 90, 90), record.Name, pet.Name)
	Net:Send(owner, "RaidAlarm", record.Name)
	return { Kind = "Pet", Name = pet.Name, Variant = pet.Variant }, {
		From = owner,
		PetId = petId,
		RivalThief = record.Entity.UserId,
		Deadline = os.clock() + SETTINGS.StolenCarrySeconds,
	}
end

-- the rival brought a star egg home: it hatches on their display
function Homes:EggHome(record, item)
	if not record.HomeIndex or not item or not item.Egg or not Config.Eggs[item.Egg] then
		return
	end
	local name = Util.WeightedPick(Config.Eggs[item.Egg].Pets, nil, rng)
	if #record.HomePets >= #SLOTS then
		-- keep the best ones
		local weakest, index = weakestIndex(record)
		if not weakest or Util.PetIncome(Config, name, nil) <= Util.PetIncomeOf(Config, weakest) then
			return
		end
		table.remove(record.HomePets, index)
	end
	table.insert(record.HomePets, newPet({ Name = name, Level = 1, Stars = 0 }))
	self:Render(record)
end

-- the rival made it home with a player's pet: it stands on their display now
function Homes:Delivered(record, meta)
	local owner = meta and meta.From
	if not owner or not owner.Parent or not meta.PetId then
		return
	end
	local taken = Services.PetService:TakePet(owner, meta.PetId)
	if not taken then
		return
	end
	if #record.HomePets >= #SLOTS then
		local _, index = weakestIndex(record)
		if index then
			table.remove(record.HomePets, index)
		end
	end
	table.insert(
		record.HomePets,
		newPet({
			Name = taken.Name,
			Variant = taken.Variant,
			Serial = taken.Serial,
			Level = taken.Level,
			XP = taken.XP,
			Stars = taken.Stars,
			FromUserId = owner.UserId,
		})
	)
	self:Render(record)
	-- revenge: steal it back for 5 minutes (even outside Thief Night)
	owner:SetAttribute("RevengeTarget", record.Entity.UserId)
	owner:SetAttribute("RevengeUntil", now() + SETTINGS.RevengeSeconds)
	Net:Send(owner, "Revenge", record.Entity.UserId, record.Name, now() + SETTINGS.RevengeSeconds)
	Net:Notify(
		owner,
		"💔 %s stole your %s! Get it back from their house - revenge for 5 minutes!",
		Color3.fromRGB(255, 90, 90),
		record.Name,
		taken.Name
	)
end

function Homes:Init(services)
	Services = services
	Data = services.DataService
	World = services.WorldService
end

function Homes:Start()
	task.spawn(function()
		while true do
			task.wait(1)
			for _, record in byIndex do
				pcall(refreshSign, record)
			end
		end
	end)
end

return Homes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">RivalService</string>
            <string name="Source"><![CDATA[--[[
	RivalService: rival players for small servers (solo play).

	With only 1-2 real players a server feels empty, so two rivals join in -
	regular-looking avatars (official Roblox catalog items), with a name,
	level, title, pickaxe and pets following them, who play the game like
	anybody else:
	  * between meteors they mine ores in the mines (or hang around the hub),
	  * a meteor warning sends them running to the landing spot (far away:
	    they "teleport" to the area entrance, like the GO button),
	  * they smash the meteor (a bit slower than a real player) and show up
	    in the live ranking - beat them for 1st place!
	  * after the burst they grab star eggs nobody picked up and run home
	    with them (to the base district) - bonk them to make them drop it,
	  * now and then they try to bonk YOU when you carry an egg (never a new
	    player's first egg, never near the spawn or in the base district).
	They never take reserved eggs (tutorial / top 3) or guarded ones, never
	enter people's homes, and leave once the server fills up. They are game
	characters: no fake chat, no fake join messages, no real user accounts.
]]
local HttpService = game:GetService("HttpService")
local PathfindingService = game:GetService("PathfindingService")
local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Rival = {}
local Services
local Data
local World

local SETTINGS = Config.Rivals
local rng = Random.new()
local rivals = {} -- [model] = record
local forcedCount: number? = nil -- cloud tests
local nextId = 0
local usedNames = {}
local spawning = false
local spawnRetryAt = 0

local GROUP = "Rivals"
local GATE_GROUP = "ZoneGates"
local PLAYER_GROUP = "PlayerCharacters"
local ANIMS = {
	Idle = "rbxassetid://507766388",
	Run = "rbxassetid://913376220",
	Jump = "rbxassetid://507765000",
	Fall = "rbxassetid://507767968",
	Slash = "rbxassetid://522635514",
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

-- which area a position is in: 0 = hub, 1..n = mine zone, -1 = bases, nil = elsewhere
local function areaOf(position: Vector3): number?
	local probe = Vector3.new(position.X, 3, position.Z)
	if Util.InBases(Config, probe) then
		return -1
	end
	return Util.ZoneAt(Config, probe)
end

local function areaEntrance(area: number): Vector3
	-- (a few studs beside the spawn point, never right on it)
	local side = Vector3.new(if rng:NextNumber() < 0.5 then -1 else 1, 0, 0) * rng:NextNumber(7, 12)
	if area > 0 and World.Zones[area] then
		return World:SpawnFor(area).Position + side + Vector3.new(0, 0, 6)
	elseif area == -1 then
		return Vector3.new(0, 4, Config.World.Bases.ZStart - 12) + side
	end
	return World.HubSpawn.Position + side + Vector3.new(0, 0, rng:NextNumber(4, 10))
end

local function homeSpot(): Vector3
	return Vector3.new(rng:NextNumber(-6, 6), 3, Util.AvenueZ(Config))
end

---------------------------------------------------------------------------
-- the character
---------------------------------------------------------------------------
local function describe()
	local look = SETTINGS.Look
	local desc = Instance.new("HumanoidDescription")
	local skin = pick(look.Skins)
	desc.HeadColor = skin
	desc.TorsoColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.LeftLegColor = skin
	desc.RightLegColor = skin
	desc.HairAccessory = tostring(pick(look.Hair))
	if rng:NextNumber() < look.HatChance then
		desc.HatAccessory = tostring(pick(look.Hats))
	end
	desc.Shirt = pick(look.Shirts)
	desc.Pants = pick(look.Pants)
	return desc
end

-- the same overhead tag players have (title / name / level + rank)
local function overhead(model: Model, name: string, level: number, title, rank)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Overhead"
	gui.Size = UDim2.new(7, 0, 2.6, 0)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.MaxDistance = 90
	gui.LightInfluence = 0
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = gui
	for i, row in { "Bounty", "Title", "Tags", "Name", "Rank" } do
		local label = Instance.new("TextLabel")
		label.Name = row
		label.LayoutOrder = i
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, if row == "Name" then 0.26 else 0.18, 0)
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.RichText = true
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Visible = row == "Name" or row == "Rank" or (row == "Title" and title ~= nil)
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2
		stroke.Parent = label
		label.Parent = gui
	end
	(gui:FindFirstChild("Name") :: TextLabel).Text = name
	local rankLabel = gui:FindFirstChild("Rank") :: TextLabel
	rankLabel.Text = string.format("Lv.%d %s", level, rank.Icon or "")
	rankLabel.TextColor3 = rank.Color
	if title then
		local titleLabel = gui:FindFirstChild("Title") :: TextLabel
		titleLabel.Text = title.Name
		titleLabel.TextColor3 = title.Color
		titleLabel:SetAttribute("LangFmt", "%s")
		titleLabel:SetAttribute("LangArgs", HttpService:JSONEncode({ title.Name }))
	end
	gui.Parent = head
end

local function serverPeers()
	local level, tier, zone, n = 0, 0, 1, 0
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		if data then
			level += data.Level or 1
			tier += data.PickaxeTier or 1
			zone = math.max(zone, data.ZoneLevel or 1)
			n += 1
		end
	end
	if n == 0 then
		return 3, 2, 1
	end
	return math.floor(level / n + 0.5), math.floor(tier / n + 0.5), zone
end

local function playAnim(record, name: string, speed: number?)
	local track = record.Tracks[name]
	if not track then
		return
	end
	if name == "Slash" then
		track:Play(0.05)
		return
	end
	if record.Playing ~= name then
		if record.Playing and record.Tracks[record.Playing] then
			record.Tracks[record.Playing]:Stop(0.2)
		end
		record.Playing = name
		track:Play(0.2)
	end
	if speed then
		track:AdjustSpeed(speed)
	end
end

local function spawnRival(index: number)
	nextId += 1
	local name
	for _ = 1, 20 do
		name = pick(SETTINGS.Names)
		if not usedNames[name] then
			break
		end
	end
	local peerLevel, peerTier, peerZone = serverPeers()
	local level = math.max(1, peerLevel + rng:NextInteger(-2, 3))
	local model = Players:CreateHumanoidModelFromDescription(describe(), Enum.HumanoidRigType.R15)
	model.Name = name
	model:SetAttribute("Rival", true)
	local animate = model:FindFirstChild("Animate")
	if animate then
		animate:Destroy() -- (animations are played by the server)
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = SETTINGS.Speed
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = GROUP
		end
	end
	-- a title like the ones players earn, a weekly rank
	local titles = {}
	for _, title in Config.Titles do
		local need = title.Need or {}
		if title.Id ~= "Newcomer" and need.Level and need.Level <= level then
			table.insert(titles, title)
		end
	end
	local title = if #titles > 0 and rng:NextNumber() < 0.6 then pick(titles) else nil
	local rank = Config.Ranks[rng:NextInteger(1, math.min(3, #Config.Ranks))]
	overhead(model, name, level, title, rank)
	local spawnAt = areaEntrance(0)
	model:PivotTo(CFrame.new(spawnAt + Vector3.new(0, 2, 0)))
	-- a pickaxe like everyone else's (a tier near the server's players)
	local tier = math.clamp(peerTier + rng:NextInteger(0, 1), 1, #Config.Pickaxes)
	local tool = Services.CharacterService.BuildPickaxe(tier)
	tool.Parent = model
	-- 2-3 pets following (rendered by every client, like players' pets)
	local pets = {}
	local pool = Config.Eggs[Config.Shards.ZoneEggs[math.clamp(peerZone, 1, #Config.Shards.ZoneEggs)]].Pets
	for _ = 1, rng:NextInteger(2, 3) do
		local entry = pick(pool)
		table.insert(pets, "|" .. entry[1] .. "|" .. rng:NextInteger(1, 8) .. "|0")
	end
	model:SetAttribute("Pets", HttpService:JSONEncode(pets))

	-- (animations need the character in the world; an error from here on
	-- removes the half-built rival again)
	model.Parent = workspace
	local okBuild, buildErr = pcall(function()
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		pcall(function()
			humanoid:EquipTool(tool)
		end)
	end)
	if not okBuild then
		model:Destroy()
		error(buildErr)
	end
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local tracks = {}
	for animName, id in ANIMS do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		local ok, track = pcall(animator.LoadAnimation, animator, animation)
		if ok and track then
			track.Priority = if animName == "Slash" then Enum.AnimationPriority.Action else Enum.AnimationPriority.Movement
			track.Looped = animName == "Idle" or animName == "Run"
			tracks[animName] = track
		end
	end
	local record = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Tracks = tracks,
		Name = name,
		Index = index,
		Level = level,
		Tier = tier,
		StunnedUntil = 0,
		NextHit = 0,
		NextBonk = now() + rng:NextNumber(10, 30),
		NextPlan = 0,
		Aggression = rng:NextNumber(0.25, 0.7),
		Carry = nil,
		Task = "Idle",
		-- identity in the meteor ranking
		Entity = { DisplayName = name, Name = name, UserId = -1000000 - nextId, Parent = workspace, IsRival = true },
	}
	humanoid.Running:Connect(function(speed)
		if speed > 1 then
			playAnim(record, "Run", math.clamp(speed / 16, 0.6, 1.4))
		else
			playAnim(record, "Idle")
		end
	end)
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Jumping then
			local track = tracks.Jump
			if track then
				track:Play(0.1)
			end
		end
	end)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = GROUP
		end
	end
	playAnim(record, "Idle")
	usedNames[name] = true
	rivals[model] = record
	-- 🏠 a home of their own in the base district (pets on display)
	local okHome, homeErr = pcall(Services.RivalHomes.Claim, Services.RivalHomes, record)
	if not okHome then
		warn("[Rival] home failed: " .. tostring(homeErr))
	end
	return record
end

local function setCarry(record, item, meta)
	record.CarryMeta = if item then meta else nil
	if record.CarryModel then
		record.CarryModel:Destroy()
		record.CarryModel = nil
	end
	record.Carry = item
	local shards = Services.ShardService
	if item then
		-- the egg above the head, like players carrying one
		local head = record.Model:FindFirstChild("Head") :: BasePart
		local egg = shards.BuildItemModel(item, 1)
		for _, part in egg:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = false
				part.CanCollide = false
				part.Massless = true
				part.CollisionGroup = GROUP
			end
		end
		egg:PivotTo(head.CFrame * CFrame.new(0, 3, 0))
		for _, part in egg:GetDescendants() do
			if part:IsA("BasePart") then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = head
				weld.Part1 = part
				weld.Parent = part
			end
		end
		egg.Parent = record.Model
		record.CarryModel = egg
		record.Model:SetAttribute("Carrying", true)
		record.CarryUntil = os.clock() + SETTINGS.CarrySeconds
		local def = Config.Shards.Rarities[item.Rarity]
		record.Humanoid.WalkSpeed = SETTINGS.Speed * (if def then def.Speed else 0.85)
	else
		record.Model:SetAttribute("Carrying", nil)
		record.Humanoid.WalkSpeed = SETTINGS.Speed
	end
end

local function despawn(record)
	rivals[record.Model] = nil
	usedNames[record.Name] = nil
	if record.Carry then
		-- (never take an egg / a stolen pet away when leaving: drop it)
		local item, meta = record.Carry, record.CarryMeta
		setCarry(record, nil)
		Services.ShardService:SpawnGround(item, flat(record.Root.Position), meta, { Beacon = true, RivalBlockSeconds = 20 })
	end
	pcall(Services.RivalHomes.Release, Services.RivalHomes, record)
	Services.MeteorService:Forget(record.Entity)
	if record.Model.Parent then
		record.Model:Destroy()
	end
end

local function count(): number
	local n = 0
	for _ in rivals do
		n += 1
	end
	return n
end

---------------------------------------------------------------------------
-- walking: pathfinding, area changes ("teleport" like the GO / zone buttons)
---------------------------------------------------------------------------
local function teleport(record, position: Vector3)
	record.Model:PivotTo(CFrame.new(position + Vector3.new(0, 3, 0)))
	record.Waypoints = nil
	record.Goal = nil
	record.Stuck = 0
end

local function walkTo(record, goal: Vector3, allowTeleport: boolean?)
	local root = record.Root
	local here = root.Position
	local hereArea, goalArea = areaOf(here), areaOf(goal)
	-- far away in another area: take the shortcut (players use GO / the zone teleport)
	if allowTeleport ~= false and not record.Carry and hereArea ~= goalArea and (flat(goal - here)).Magnitude > 140 then
		if not record.TeleportAt then
			record.TeleportAt = os.clock() + rng:NextNumber(0.6, 2.5) -- (a human needs a moment to press it)
		elseif os.clock() >= record.TeleportAt then
			record.TeleportAt = nil
			teleport(record, areaEntrance(goalArea or 0))
		end
		return
	end
	record.TeleportAt = nil
	local distance = (flat(goal - here)).Magnitude
	if distance <= 3 then
		return -- (there)
	end
	if distance <= 14 then
		-- close: straight there, no path needed
		record.Waypoints = nil
		record.Goal = goal
		record.Humanoid:MoveTo(goal)
		return
	end
	if not record.Goal or (record.Goal - goal).Magnitude > 10 or os.clock() - (record.PathAt or 0) > 4 then
		record.Goal = goal
		record.PathAt = os.clock()
		record.Waypoints = nil
		local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 6 })
		local ok = pcall(path.ComputeAsync, path, here, goal)
		if ok and path.Status == Enum.PathStatus.Success then
			record.Waypoints = path:GetWaypoints()
			record.WaypointIndex = 2
		end
	end
	local target = goal
	if record.Waypoints then
		local waypoint = record.Waypoints[record.WaypointIndex]
		while waypoint and (flat(waypoint.Position - here)).Magnitude < 3 do
			record.WaypointIndex += 1
			waypoint = record.Waypoints[record.WaypointIndex]
		end
		if waypoint then
			target = waypoint.Position
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				record.Humanoid.Jump = true
			end
		end
	end
	record.Humanoid:MoveTo(target)
	-- stuck? jump, then re-plan, then hop closer
	local moved = if record.LastPos then (flat(here - record.LastPos)).Magnitude else 99
	if os.clock() - (record.LastCheck or 0) > 1.5 then
		record.LastCheck = os.clock()
		record.LastPos = here
		if moved < 1.2 and (flat(goal - here)).Magnitude > 5 then
			record.Stuck = (record.Stuck or 0) + 1
			record.Humanoid.Jump = true
			record.PathAt = 0
			if
				record.Stuck >= 4
				and not record.Carry
				and allowTeleport ~= false
				and not Util.InBases(Config, goal + Vector3.new(0, 3, 0))
			then
				teleport(record, goal + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4)))
			end
		else
			record.Stuck = 0
		end
	end
end

local function stop(record)
	record.Humanoid:MoveTo(record.Root.Position)
	record.Goal = nil
	record.Waypoints = nil
end

local function face(record, position: Vector3)
	local root = record.Root
	local look = flat(position - root.Position)
	if look.Magnitude > 0.5 then
		root.CFrame = CFrame.lookAt(root.Position, root.Position + look)
	end
end

---------------------------------------------------------------------------
-- brains
---------------------------------------------------------------------------
-- how a rival smashes: a bit slower than the average real player here
local function rivalPace(): (number, number)
	local damage, cooldown, n = 0, 0, 0
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		if data then
			damage += Services.StatsService:Damage(player, data)
			cooldown += Services.StatsService:SwingCooldown(player, data)
			n += 1
		end
	end
	if n == 0 then
		return 10, 0.5 / SETTINGS.Pace
	end
	return damage / n, (cooldown / n) / SETTINGS.Pace
end

-- a real player carrying an egg that this rival could try to bonk
local function bonkTarget(record): Player?
	if record.Carry or now() < record.NextBonk then
		return nil
	end
	local best, bestDistance = nil, SETTINGS.Bonk.ChaseRange
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and Services.ShardService:IsCarrying(player) then
			local distance = (root.Position - record.Root.Position).Magnitude
			if distance < bestDistance and Services.MiningService:CanNpcBonk(player) then
				best, bestDistance = player, distance
			end
		end
	end
	return best
end

local function think(record)
	local t = now()
	local root = record.Root
	if not root.Parent or not record.Model.Parent or root.Position.Y < -40 then
		-- (fell out of the world somehow: leave; a new rival joins later)
		despawn(record)
		return
	end
	if record.StunnedUntil > t then
		stop(record)
		return
	end
	local meteor = Services.MeteorService
	local shards = Services.ShardService
	local current = meteor:Current()
	local state = workspace:GetAttribute("MeteorState")

	-- 1) carrying an egg / a stolen pet: run home with it (like everybody)
	local homes = Services.RivalHomes
	if record.Carry and os.clock() > (record.CarryUntil or math.huge) then
		-- couldn't make it home in time: drop it here
		local item, meta = record.Carry, record.CarryMeta
		setCarry(record, nil)
		record.Home = nil
		shards:SpawnGround(item, flat(root.Position), meta, { Beacon = true, RivalBlockSeconds = SETTINGS.DropBlockSeconds })
	end
	if record.Carry then
		record.Task = "Home"
		local home = record.Home or homes:HomeSpot(record) or homeSpot()
		record.Home = home
		walkTo(record, home, false)
		local arrived = (flat(home - root.Position)).Magnitude <= 8 or homes:IsHomeOf(record, root.Position)
		if arrived then
			local item, meta = record.Carry, record.CarryMeta
			setCarry(record, nil)
			record.Home = nil
			if item.Kind == "Pet" then
				homes:Delivered(record, meta)
			else
				homes:EggHome(record, item)
				if Util.ShardIndex(Config, item.Rarity) >= 4 then
					Net:Announce("🌟 %s brought a %s home!", shards.ItemColor(item), record.Name, shards.ItemName(item))
				end
			end
		end
		return
	end

	-- 2) chasing a player who carries an egg (now and then)
	local chase = record.ChaseTarget
	-- (gives up at once near the spawn / in the base district / on a new player)
	local defendId = if record.Defending then record.Entity.UserId else nil
	if chase and (not chase.Parent or t > record.ChaseUntil or not Services.MiningService:CanNpcBonk(chase, defendId)) then
		record.ChaseTarget = nil
		record.Defending = nil
		chase = nil
	end
	if not chase then
		local target = bonkTarget(record)
		if target and rng:NextNumber() < record.Aggression then
			record.ChaseTarget = target
			record.ChaseUntil = t + SETTINGS.Bonk.ChaseSeconds
			chase = target
		elseif target then
			record.NextBonk = t + 6 -- (decided not to, this time)
		end
	end
	if chase then
		record.Task = "Chase"
		local victimRoot = chase.Character and chase.Character:FindFirstChild("HumanoidRootPart")
		if victimRoot and victimRoot:IsA("BasePart") then
			walkTo(record, victimRoot.Position, false)
			if (victimRoot.Position - root.Position).Magnitude <= SETTINGS.Bonk.Range then
				face(record, victimRoot.Position)
				playAnim(record, "Slash")
				Services.MiningService:NpcBonk(root, record.Name, chase, defendId)
				record.ChaseTarget = nil
				record.Defending = nil
				record.NextBonk = t + SETTINGS.Bonk.Cooldown
			end
		end
		return
	end

	-- 🌙 Thief Night: sneak into a player's home and grab a pet from display
	if workspace:GetAttribute("RaidActive") == true and record.HomeIndex then
		if not record.RaidPlan and (record.RaidsTonight or 0) < SETTINGS.RaidsPerNight and rng:NextNumber() < SETTINGS.RaidChance then
			record.RaidPlan = homes:RaidTarget(record)
		end
		local plan = record.RaidPlan
		if plan then
			if not plan.Owner.Parent or plan.Pet.Away then
				record.RaidPlan = nil
			else
				record.Task = "Raid"
				walkTo(record, plan.Position)
				if (flat(plan.Position - root.Position)).Magnitude <= 6 then
					face(record, plan.Position)
					local item, meta = homes:TakeFromPlayer(record, plan.Owner, plan.Pet.Id)
					record.RaidPlan = nil
					record.RaidsTonight = (record.RaidsTonight or 0) + 1
					if item then
						setCarry(record, item, meta)
					end
				end
				return
			end
		end
	else
		record.RaidPlan = nil
		record.RaidsTonight = 0
	end

	-- 3) a meteor is coming / being smashed: go there and smash it
	if current and (state == "Warning" or state == "Falling" or state == "Active") then
		record.Task = "Meteor"
		local radius = current.Size.Radius
		local angle = record.Index * 2.4 + 0.6
		local spot = current.Position + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (radius + 3)
		local close = (flat(root.Position) - flat(current.Position)).Magnitude <= radius + 7
		if close and state == "Active" then
			stop(record)
			face(record, current.Position)
			if t >= record.NextHit then
				local damage, cooldown = rivalPace()
				record.NextHit = t + cooldown * rng:NextNumber(0.85, 1.2)
				playAnim(record, "Slash")
				meteor:Hit(record.Entity, damage, cooldown)
			end
		else
			walkTo(record, spot)
		end
		return
	end

	-- 4) star eggs nobody picked up: go get one
	local target = record.TargetEgg
	if target and not shards:IsOnGround(target) then
		target = nil
	end
	if not target then
		local taken = {}
		for _, other in rivals do
			if other ~= record and other.TargetEgg then
				taken[other.TargetEgg] = true
			end
		end
		local best, bestDistance = nil, SETTINGS.SearchRange
		for _, entry in shards:RivalTargets(record.Entity.UserId, SETTINGS.GrabDelay) do
			if not taken[entry.Model] and not Util.InBases(Config, entry.Position + Vector3.new(0, 3, 0)) then
				local distance = (flat(entry.Position) - flat(root.Position)).Magnitude
				if distance < bestDistance then
					best, bestDistance = entry.Model, distance
				end
			end
		end
		target = best
	end
	record.TargetEgg = target
	if target then
		local position = shards:GroundPosition(target)
		if position then
			record.Task = "Egg"
			walkTo(record, position, false)
			if (flat(position) - flat(root.Position)).Magnitude <= SETTINGS.GrabRange then
				local item = shards:TakeForRival(target)
				record.TargetEgg = nil
				if item then
					setCarry(record, item)
				end
			end
			return
		end
	end

	-- 5) between meteors: mine for a while, sometimes hang around the hub
	if t >= record.NextPlan then
		record.NextPlan = t + rng:NextNumber(40, 90)
		local _, _, maxZone = serverPeers()
		if rng:NextNumber() < 0.75 then
			record.Task = "Mine"
			record.MineZone = rng:NextInteger(1, math.min(maxZone, 3))
		else
			record.Task = "Hub"
			record.HubSpot = World.HubSpawn.Position + Vector3.new(rng:NextNumber(-40, 40), 0, rng:NextNumber(10, 50))
		end
		record.Ore = nil
	end
	if record.Task == "Mine" and record.MineZone then
		local ore = record.Ore
		if not ore or not ore.Parent then
			ore = Services.MiningService:NearestOreIn(record.MineZone, root.Position)
			record.Ore = ore
		end
		if not ore then
			walkTo(record, areaEntrance(record.MineZone))
			return
		end
		local reach = Config.World.Reach + ore.Size.Magnitude / 2 - 1
		if (ore.Position - root.Position).Magnitude <= reach then
			stop(record)
			face(record, ore.Position)
			if t >= record.NextHit then
				local damage = rivalPace()
				record.NextHit = t + rng:NextNumber(0.7, 1.2)
				playAnim(record, "Slash")
				Services.MiningService:NpcHit(ore, damage)
			end
		else
			walkTo(record, ore.Position)
		end
		return
	end
	walkTo(record, record.HubSpot or World.HubSpawn.Position)
end

---------------------------------------------------------------------------
-- public
---------------------------------------------------------------------------
function Rival:IsRival(model: Instance?): boolean
	return model ~= nil and rivals[model] ~= nil
end

-- the closest rival carrying an egg within range of a position
function Rival:NearestCarrying(position: Vector3, range: number): Model?
	local best, bestDistance = nil, range
	for model, record in rivals do
		if record.Carry then
			local distance = (record.Root.Position - position).Magnitude
			if distance <= bestDistance then
				best, bestDistance = model, distance
			end
		end
	end
	return best
end

-- a player swung at a rival: knock them back; if they carried an egg it drops
function Rival:Bonk(player: Player, model: Model): boolean
	local record = rivals[model]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not record or not root or not root:IsA("BasePart") then
		return false
	end
	if (root.Position - record.Root.Position).Magnitude > Config.PvP.BonkRange + 3 then
		return false
	end
	local t = now()
	if record.StunnedUntil > t then
		return false
	end
	record.StunnedUntil = t + SETTINGS.StunSeconds
	local push = flat(record.Root.Position - root.Position)
	push = if push.Magnitude > 0.1 then push.Unit else Vector3.zAxis
	record.Root.AssemblyLinearVelocity = push * 45 + Vector3.new(0, 30, 0)
	Net:Send(player, "BonkHit", record.Root.Position)
	local item = record.Carry
	local carriedMeta = record.CarryMeta
	if not item then
		return true
	end
	setCarry(record, nil)
	record.Home = nil
	-- the egg drops: the bonker gets the first grab, rivals keep off it for a while
	Services.ShardService:SpawnGround(item, flat(record.Root.Position), carriedMeta, {
		Beacon = true,
		PriorityUser = player.UserId,
		PriorityUntil = t + 4,
		RivalBlockSeconds = SETTINGS.DropBlockSeconds,
	})
	local data = Data:Get(player)
	if not data or item.RivalBonked then
		Net:Notify(
			player,
			"💥 %s dropped a %s - grab it!",
			Color3.fromRGB(255, 170, 80),
			record.Name,
			Services.ShardService.ItemName(item)
		)
		return true
	end
	-- (a reward only the first time an egg is knocked loose: no farming)
	item.RivalBonked = true
	local coins = math.max(SETTINGS.BonkMinCoins, math.floor(Services.BaseService:IncomeRate(player, data) * SETTINGS.BonkIncomeSeconds))
	data.Coins += coins
	data.Stats.LifetimeCoins += coins
	data.Stats.Bonks += 1
	Services.Analytics:Economy(player, "Source", "Coins", coins, data.Coins, "Gameplay", "RivalBonk")
	Services.ProgressionService:AddQuest(player, "Bonk", 1)
	Net:Send(player, "Sold", coins)
	Data:MarkDirty(player)
	Net:Notify(
		player,
		"💥 %s dropped a %s - grab it! +💰%s",
		Color3.fromRGB(255, 170, 80),
		record.Name,
		Services.ShardService.ItemName(item),
		Util.Format(coins)
	)
	return true
end

-- someone grabbed a pet from this rival's home: run after them
function Rival:Defend(record, thief: Player)
	if not rivals[record.Model] or record.Carry then
		return
	end
	record.ChaseTarget = thief
	record.ChaseUntil = now() + SETTINGS.DefendSeconds
	record.Defending = true
	record.RaidPlan = nil
end

function Rival:Wanted(): number
	if forcedCount then
		return forcedCount
	end
	local real = #Players:GetPlayers()
	return if real >= 1 and real <= SETTINGS.MaxRealPlayers then SETTINGS.Count else 0
end

-- cloud tests ---------------------------------------------------------------
function Rival:ForceForTest(n: number?)
	assert(not RunService:IsRunning(), "test hook used on a live server")
	forcedCount = n
end

function Rival:RecordsForTest()
	assert(not RunService:IsRunning(), "test hook used on a live server")
	local list = {}
	for _, record in rivals do
		table.insert(list, record)
	end
	table.sort(list, function(a, b)
		return a.Index < b.Index
	end)
	return list
end

function Rival:PlaceForTest(record, position: Vector3)
	assert(not RunService:IsRunning(), "test hook used on a live server")
	teleport(record, Vector3.new(position.X, 0, position.Z))
end

---------------------------------------------------------------------------
function Rival:Init(services)
	Services = services
	Data = services.DataService
	World = services.WorldService
end

function Rival:Start()
	-- rivals walk through the zone gates (they "unlocked" them); players
	-- still see and bump into the gates of zones they haven't unlocked
	pcall(function()
		PhysicsService:RegisterCollisionGroup(GROUP)
		PhysicsService:RegisterCollisionGroup(GATE_GROUP)
		PhysicsService:CollisionGroupSetCollidable(GROUP, GATE_GROUP, false)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup(PLAYER_GROUP)
		PhysicsService:CollisionGroupSetCollidable(GROUP, PLAYER_GROUP, false)
	end)
	local function groupCharacter(character: Model)
		for _, part in character:GetDescendants() do
			if part:IsA("BasePart") then
				part.CollisionGroup = PLAYER_GROUP
			end
		end
		character.DescendantAdded:Connect(function(part)
			if part:IsA("BasePart") then
				part.CollisionGroup = PLAYER_GROUP
			end
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(groupCharacter)
		if player.Character then
			groupCharacter(player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	for _, zone in World.Zones do
		if zone.Gate then
			zone.Gate.CollisionGroup = GATE_GROUP
			local modifier = Instance.new("PathfindingModifier")
			modifier.PassThrough = true
			modifier.Parent = zone.Gate
		end
	end

	task.spawn(function()
		while true do
			task.wait(0.25)
			local ok, err = pcall(function()
				-- join / leave (only between meteors, never while carrying)
				local wanted = self:Wanted()
				local idle = workspace:GetAttribute("MeteorState") == "Idle"
				if count() < wanted and idle then
					local used = {}
					for _, record in rivals do
						used[record.Index] = true
					end
					for index = 1, wanted do
						if not used[index] and count() < wanted and not spawning and os.clock() >= spawnRetryAt then
							-- (building an avatar downloads its items: off the brain loop)
							spawning = true
							task.spawn(function()
								local ok, err = pcall(spawnRival, index)
								spawning = false
								if not ok then
									warn("[Rival] spawn failed: " .. tostring(err))
									spawnRetryAt = os.clock() + 30
									-- (nothing half-built stays in the world)
									for _, child in workspace:GetChildren() do
										if child:IsA("Model") and child:GetAttribute("Rival") == true and not rivals[child] then
											child:Destroy()
										end
									end
								end
							end)
						end
					end
				elseif count() > wanted and idle then
					for _, record in rivals do
						if count() > wanted then
							despawn(record)
						end
					end
				end
			end)
			if not ok then
				warn("[Rival] " .. tostring(err))
			end
			for _, record in rivals do
				local okThink, errThink = pcall(think, record)
				if not okThink then
					warn("[Rival] think: " .. tostring(errThink))
				end
			end
		end
	end)
end

return Rival
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">ShardService</string>
            <string name="Source"><![CDATA[--[[
	ShardService: star shards in the world.

	* Falling stars crash every ~40-70s somewhere players can reach (hub or an
	  unlocked mine) and leave a shard with a tall light beacon.
	* A destroyed meteor spills a burst of better shards (the top hitter gets
	  an Epic+ one reserved for a few seconds).
	* Touch a shard to pick it up: it floats over your head, you're slower,
	  and ANYONE can bonk you (anywhere but the spawn) to make you drop it.
	* Walk into your own base to put it on a pedestal (BaseService).
	* Stolen shards remember their owner: if dropped and nobody grabs them
	  they fly home; the owner can touch them to get them back instantly.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local ShardModel = require(Shared.ShardModel)
local PetModel = require(Shared.PetModel)
local Net = require(script.Parent.Net)

local Shards = {}
local Services
local Data
local World

local SETTINGS = Config.Shards
local rng = Random.new()

local carrying = {} -- [player] = { Id, Meta, Model }
local ground = {} -- [model] = record

local HUB_SPOTS = {
	Vector3.new(-30, 0, -10),
	Vector3.new(30, 0, -10),
	Vector3.new(-32, 0, 55),
	Vector3.new(32, 0, 55),
	Vector3.new(-20, 0, 20),
	Vector3.new(22, 0, 18),
	Vector3.new(0, 0, -5),
	Vector3.new(-40, 0, -60),
	Vector3.new(40, 0, -60),
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart
end

local function rarityName(id: string): string
	local def = SETTINGS.Rarities[id]
	return if def then def.Name else id
end

--[[ carried / dropped items:
	{ Kind = "Egg", Rarity = "Rare", Egg = "Meadow" }  -- a star egg (hatches at home)
	{ Kind = "Pet", Name = "Fox", Variant = "Golden"? } -- a stolen pet ]]
local function itemName(item): string
	if item.Kind == "Pet" then
		return item.Name -- plain species name: translates on every client
	end
	return rarityName(item.Rarity)
end

local function itemColor(item): Color3
	if item.Kind == "Pet" then
		local info = Config.Pets[item.Name]
		local rarity = info and Config.Rarities[info.Rarity]
		return if rarity then rarity.Color else Color3.new(1, 1, 1)
	end
	local def = SETTINGS.Rarities[item.Rarity]
	return if def then def.Color else Color3.new(1, 1, 1)
end

-- 1..7: how valuable the item is (speed penalty, guardian, points)
local function itemTier(item): number
	if item.Kind == "Pet" then
		local info = Config.Pets[item.Name]
		local rarity = info and Config.Rarities[info.Rarity]
		return if rarity then rarity.Order else 1
	end
	return Util.ShardIndex(Config, item.Rarity)
end

local function buildItemModel(item, scale: number): Model
	if item.Kind == "Pet" then
		return PetModel.Build(item.Name, item.Variant)
	end
	return ShardModel.Build(Config, item.Rarity, scale)
end

---------------------------------------------------------------------------
-- carrying
---------------------------------------------------------------------------
-- the theft record of whatever the player carries (nil = nothing / not stolen)
function Shards:CarryMeta(player: Player)
	local info = carrying[player]
	return info and info.Meta or nil
end

function Shards:IsCarrying(player: Player): boolean
	return carrying[player] ~= nil
end

-- walk speed multiplier while carrying (heavier = rarer = slower)
function Shards:SpeedMult(player: Player): number
	local info = carrying[player]
	if not info then
		return 1
	end
	local mult = 0.95 - itemTier(info.Item) * 0.045 -- 0.9 (common) .. 0.64 (secret)
	if Services.MonetizationService:HasPass(player, "FastCarry") then
		mult *= Config.PvP.CarrySpeedPass
	end
	return mult
end

local function attachModel(player: Player, item): Model?
	local root = rootOf(player)
	if not root then
		return nil
	end
	local model = buildItemModel(item, 0.8)
	model.Name = "CarriedShard"
	-- weld every part to the main one so the whole model rides along
	local primary = model.PrimaryPart :: BasePart
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= primary then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = primary
			weld.Part1 = d
			weld.Parent = d
			d.Massless = true
		end
	end
	primary.Massless = true
	ShardModel.SetAnchored(model, false)
	model:PivotTo(root.CFrame * CFrame.new(0, 5.2, 0))
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = model.PrimaryPart
	weld.Parent = model.PrimaryPart
	local highlight = Instance.new("Highlight")
	highlight.Name = "CarrierGlow"
	highlight.FillTransparency = 1
	highlight.OutlineColor = itemColor(item)
	highlight.OutlineTransparency = 0.1
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model
	model.Parent = player.Character
	-- the highlight outlines the whole character so hunters can spot carriers
	highlight.Adornee = player.Character
	return model
end

local function endCarry(player: Player)
	local info = carrying[player]
	carrying[player] = nil
	if info and info.Model then
		info.Model:Destroy()
	end
	player:SetAttribute("Carrying", nil)
	player:SetAttribute("CarryTier", nil)
	player:SetAttribute("CarryStolen", nil)
	Services.CharacterService:ApplyWalkSpeed(player)
	return info
end

function Shards:StartCarry(player: Player, item, meta)
	if carrying[player] or type(item) ~= "table" then
		return false
	end
	local model = attachModel(player, item)
	if not model then
		return false
	end
	carrying[player] = { Item = item, Meta = meta or {}, Model = model }
	player:SetAttribute("Carrying", itemName(item))
	player:SetAttribute("CarryTier", itemTier(item))
	player:SetAttribute("CarryStolen", meta ~= nil and (meta.From ~= nil or meta.RivalFrom ~= nil))
	Services.CharacterService:ApplyWalkSpeed(player)
	local fromName = if meta and meta.From then meta.From.DisplayName else nil
	Net:Send(player, "CarryStart", itemName(item), fromName, itemTier(item))
	return true
end

-- a stolen pet runs back to the base it was taken from
local function returnHome(meta, message: boolean)
	if meta and meta.RivalFrom then
		-- a pet stolen from a rival player's home runs back there
		Services.RivalHomes:PetBack(meta.RivalFrom, meta.RivalSlot)
		return
	end
	local owner = meta and meta.From
	if not owner or not owner.Parent or not meta.PetId then
		return
	end
	Services.BaseService:SetAway(owner, meta.PetId, false)
	if message then
		Net:Notify(owner, "🛡️ Your pet ran back home!", Color3.fromRGB(120, 230, 255))
	end
end

---------------------------------------------------------------------------
-- shards on the ground
---------------------------------------------------------------------------
local function destroyGround(model: Model)
	ground[model] = nil
	if model.Parent then
		model:Destroy()
	end
end

local tryPickup -- forward declaration

---------------------------------------------------------------------------
-- star guardians: rock golems that protect a fallen star and chase the
-- player who grabs it. If they catch you, they take the shard back to the
-- crash site. Bonk one (swing at it) to stun it - friends can cover you!
---------------------------------------------------------------------------
local GUARDIAN = Config.Guardian
local GUARDIAN_Y = 1.7 -- root height: the golem hovers just above the ground
local guardians = {} -- [model] = guardian record

local function buildGuardian(color: Color3): (Model, BasePart)
	local model = Instance.new("Model")
	model.Name = "StarGuardian"
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.Parent = model
	local function limb(name: string, size: Vector3, offset: CFrame, partColor: Color3, material: Enum.Material)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = root.CFrame * offset
		p.Color = partColor
		p.Material = material
		p.Anchored = true -- moved by the server every frame (no physics needed)
		p.CanCollide = false
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local rock = Color3.fromRGB(85, 80, 95)
	limb("Torso", Vector3.new(3.4, 3.2, 2.4), CFrame.new(0, 0.6, 0), rock, Enum.Material.Basalt)
	limb("Head", Vector3.new(2.4, 2, 2.2), CFrame.new(0, 3.2, 0), rock, Enum.Material.Basalt)
	for _, x in { -0.55, 0.55 } do
		limb("Eye", Vector3.new(0.5, 0.35, 0.2), CFrame.new(x, 3.4, -1.1), color, Enum.Material.Neon)
	end
	for _, x in { -2.3, 2.3 } do
		limb("Arm", Vector3.new(1.2, 3.4, 1.3), CFrame.new(x, 0.2, 0) * CFrame.Angles(0, 0, math.rad(x * 3)), rock, Enum.Material.Basalt)
	end
	local crystal =
		limb("Crystal", Vector3.new(0.9, 2.4, 0.9), CFrame.new(0, 2.6, 1.2) * CFrame.Angles(0.5, 0, 0), color, Enum.Material.Neon)
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Range = 14
	glow.Brightness = 2
	glow.Parent = crystal

	model.PrimaryPart = root

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(7, 0, 1.6, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 5.5, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = color
	World.SetText(text, "🗿 STAR GUARDIAN")
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = text
	text.Parent = gui
	gui.Parent = root
	return model, root
end

local function spawnGuardian(item, home: Vector3)
	local index = itemTier(item)
	local model, root = buildGuardian(itemColor(item))
	local start = Vector3.new(home.X + 6, GUARDIAN_Y, home.Z)
	model:PivotTo(CFrame.new(start))
	model.Parent = World:Folder("Shards")
	local record = {
		Model = model,
		Root = root,
		Home = home,
		Position = start,
		Facing = Vector3.zAxis,
		Destination = start,
		Speed = GUARDIAN.Speed + (index - 1) * GUARDIAN.SpeedPerRarity,
		Target = nil,
		ChaseUntil = 0,
		StunnedUntil = 0,
		Item = item,
	}
	guardians[model] = record
	return record
end

local function despawnGuardian(record)
	if not record then
		return
	end
	guardians[record.Model] = nil
	if record.Model.Parent then
		record.Model:Destroy()
	end
end

function Shards:IsGuardian(model: Instance?): boolean
	return model ~= nil and guardians[model] ~= nil
end

-- a bonk stuns the guardian for a moment
function Shards:HitGuardian(player: Player, model: Model): boolean
	local record = guardians[model]
	if not record then
		return false
	end
	record.StunnedUntil = os.clock() + GUARDIAN.StunSeconds
	Net:Notify(player, "💥 Guardian stunned!", Color3.fromRGB(255, 200, 90))
	Net:Send(player, "BonkHit", record.Root.Position)
	return true
end

function Shards:NearestGuardian(position: Vector3, range: number): Model?
	local best, bestDistance = nil, range
	for model, record in guardians do
		local distance = (record.Root.Position - position).Magnitude
		if distance <= bestDistance then
			best, bestDistance = model, distance
		end
	end
	return best
end

-- opts: Beacon (bool), PriorityUser/PriorityUntil, BlockUser/BlockUntil, Lifetime
function Shards:SpawnGround(item, position: Vector3, meta, opts)
	opts = opts or {}
	local color = itemColor(item)
	local model = buildItemModel(item, 1.15)
	model.Name = if item.Kind == "Pet" then "Shard_Pet" else "Shard_" .. item.Rarity
	ShardModel.SetAnchored(model, true)
	model:PivotTo(CFrame.new(position + Vector3.new(0, 7.5, 0)))
	model:SetAttribute("Spin", true)
	model:SetAttribute("Stolen", meta ~= nil and meta.From ~= nil)

	local hitbox = Instance.new("Part")
	hitbox.Name = "Hitbox"
	hitbox.Size = Vector3.new(7, 13, 7)
	hitbox.CFrame = CFrame.new(position + Vector3.new(0, 5.5, 0))
	hitbox.Anchored = true
	hitbox.CanCollide = false
	hitbox.CanQuery = true -- so taps on it walk you there
	hitbox.Transparency = 1
	hitbox.Parent = model

	if opts.Beacon ~= false then
		local index = itemTier(item)
		local beacon = Instance.new("Part")
		beacon.Name = "Beacon"
		beacon.Shape = Enum.PartType.Cylinder
		beacon.Size = Vector3.new(180, 1 + index * 0.5, 1 + index * 0.5)
		beacon.CFrame = CFrame.new(position + Vector3.new(0, 90, 0)) * CFrame.Angles(0, 0, math.rad(90))
		beacon.Color = color
		beacon.Material = Enum.Material.Neon
		beacon.Transparency = 0.45
		beacon.Anchored = true
		beacon.CanCollide = false
		beacon.CanQuery = false
		beacon.CanTouch = false
		beacon.CastShadow = false
		beacon.Parent = model
	end

	local label = Instance.new("BillboardGui")
	label.Name = "Label"
	label.Size = UDim2.new(8, 0, 2, 0)
	label.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	label.LightInfluence = 0
	label.MaxDistance = 220
	label.AlwaysOnTop = true
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.FredokaOne
	text.TextScaled = true
	text.TextColor3 = color
	World.SetText(text, if meta and meta.From then "⚠️ %s" else "🌠 %s", itemName(item))
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Parent = text
	text.Parent = label
	label.Parent = model.PrimaryPart

	model.Parent = World:Folder("Shards")
	local record = {
		Item = item,
		Meta = meta,
		Position = position,
		SpawnedAt = os.clock(),
		PriorityUser = opts.PriorityUser,
		PriorityUntil = opts.PriorityUntil or 0,
		BlockUser = opts.BlockUser,
		BlockUntil = opts.BlockUntil or 0,
		NoRival = opts.NoRival, -- (tutorial eggs: robots never take them)
		RivalBlockUntil = os.clock() + (opts.RivalBlockSeconds or 0),
	}
	ground[model] = record
	if opts.Guardian then
		record.Guardian = opts.Guardian
	elseif opts.WithGuardian and itemTier(item) >= GUARDIAN.MinRarity then
		record.Guardian = spawnGuardian(item, position)
	end

	hitbox.Touched:Connect(function(hit)
		if ground[model] then
			tryPickup(model, record, hit)
		end
	end)

	-- stolen shards fly home if nobody grabs them; others fade out eventually
	local lifetime = if meta and (meta.From or meta.RivalFrom) then SETTINGS.ReturnSeconds else (opts.Lifetime or SETTINGS.GroundLifetime)
	task.delay(lifetime, function()
		if ground[model] then
			destroyGround(model)
			returnHome(meta, true)
			if record.Guardian and not record.Guardian.Target then
				despawnGuardian(record.Guardian)
			end
		end
	end)
	return model
end

-- 🤖 rival robots (RivalService) -------------------------------------------
Shards.ItemColor = itemColor
Shards.ItemName = itemName
Shards.BuildItemModel = buildItemModel

function Shards:IsOnGround(model: Model): boolean
	return ground[model] ~= nil
end

function Shards:GroundPosition(model: Model): Vector3?
	local record = ground[model]
	return record and record.Position
end

-- star eggs a robot may go for: lying there for a few seconds, not guarded,
-- not a stolen pet, not reserved for somebody else (tutorial / top 3)
function Shards:RivalTargets(rivalId: number, minAge: number)
	local list = {}
	local t = now()
	for model, record in ground do
		local reservedForOther = record.PriorityUser ~= nil and record.PriorityUser ~= rivalId and t < record.PriorityUntil
		local blocked = record.BlockUser == rivalId and t < record.BlockUntil
		if
			record.Item.Kind == "Egg"
			and not record.Meta
			and not record.Guardian
			and not record.NoRival
			and os.clock() >= (record.RivalBlockUntil or 0)
			and not reservedForOther
			and not blocked
			and os.clock() - (record.SpawnedAt or 0) >= minAge
		then
			table.insert(list, { Model = model, Position = record.Position })
		end
	end
	return list
end

function Shards:TakeForRival(model: Model)
	local record = ground[model]
	if not record or record.Guardian or record.Meta then
		return nil
	end
	destroyGround(model)
	return record.Item
end

tryPickup = function(model: Model, record, hit: BasePart)
	local character = hit:FindFirstAncestorOfClass("Model")
	local player = character and Players:GetPlayerFromCharacter(character)
	if not player or carrying[player] then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or not Data:Get(player) then
		return
	end
	local t = now()
	if record.BlockUser == player.UserId and t < record.BlockUntil then
		return
	end
	if record.PriorityUser and record.PriorityUser ~= player.UserId and t < record.PriorityUntil then
		return
	end
	local meta = record.Meta
	-- the owner of a stolen pet gets it back instantly
	if meta and meta.From == player then
		destroyGround(model)
		Services.BaseService:SetAway(player, meta.PetId, false)
		Net:Notify(player, "🛡️ You got your %s back!", Color3.fromRGB(120, 230, 255), itemName(record.Item))
		Net:Send(player, "ShardRecovered", itemName(record.Item))
		return
	end
	if not Services.BaseService:HasBase(player) then
		Net:Notify(player, "All bases are taken - you'll get one when someone leaves.")
		return
	end
	-- start carrying first; only then remove it from the ground (if carrying
	-- fails, e.g. no character yet, the item simply stays where it is)
	ground[model] = nil
	if not Shards:StartCarry(player, record.Item, meta) then
		ground[model] = record
		return
	end
	destroyGround(model)
	Services.ProgressionService:TutorialEvent(player, "Grab", 1)
	if record.Guardian then
		local guardian = record.Guardian
		guardian.Target = player
		guardian.ChaseUntil = os.clock() + GUARDIAN.ChaseSeconds
		carrying[player].Guardian = guardian
		Net:Send(player, "GuardianChase", GUARDIAN.ChaseSeconds)
	end
end

-- stun traps: a thief carrying a shard stolen from `owner` loses it instantly
function Shards:Confiscate(player: Player, owner: Player): boolean
	local info = carrying[player]
	if not info or not info.Meta or info.Meta.From ~= owner then
		return false
	end
	endCarry(player)
	returnHome(info.Meta, false)
	Net:Send(player, "CarryLost", itemName(info.Item), owner.DisplayName)
	return true
end

-- drop whatever the player carries (bonked / died / left)
function Shards:Drop(player: Player, attacker: Player?)
	local info = carrying[player]
	if not info then
		return
	end
	local root = rootOf(player)
	local position = if root then root.Position else nil
	endCarry(player)
	if not position then
		returnHome(info.Meta, true)
		return
	end
	local angle = rng:NextNumber(0, math.pi * 2)
	local spot = Vector3.new(position.X + math.cos(angle) * 5, 0, position.Z + math.sin(angle) * 5)
	local meta = if info.Meta and (info.Meta.From or info.Meta.RivalFrom) then info.Meta else nil
	self:SpawnGround(info.Item, spot, meta, {
		Beacon = true,
		BlockUser = player.UserId,
		BlockUntil = now() + SETTINGS.RegrabDelay,
	})
	Net:Send(player, "CarryLost", itemName(info.Item), if attacker then attacker.DisplayName else nil)
	if attacker then
		Net:Notify(attacker, "💥 %s dropped a %s - grab it!", Color3.fromRGB(255, 170, 80), player.DisplayName, itemName(info.Item))
	end
end

---------------------------------------------------------------------------
-- delivery
---------------------------------------------------------------------------
local nightBonusPaid = {} -- ["thief:owner"] = os.clock() (no passing one pet back and forth)
local function deliver(player: Player)
	local info = endCarry(player)
	if not info then
		return
	end
	local item = info.Item
	local meta = info.Meta
	local data = Data:Get(player)
	local tier = itemTier(item)
	local pets = Services.PetService
	if item.Kind == "Pet" and meta and meta.RivalFrom then
		-- a pet stolen from a rival player's home
		local given, isNew = pets:GivePet(player, item.Name, item.Variant, nil, meta.Growth)
		Services.RivalHomes:PetGone(meta.RivalFrom, meta.RivalSlot)
		if data then
			data.Stats.ShardsStolen += 1
		end
		Services.ProgressionService:AddQuest(player, "Steal", 1)
		Net:Send(player, "ShardDelivered", item.Name, "Stolen", 0)
		local card = given and pets:Describe(player, given, isNew)
		if card then
			card.Stolen = true
			Net:Send(player, "HatchResult", { card }, nil, "Stolen")
		end
		return
	end
	if item.Kind == "Pet" then
		-- a stolen pet: it leaves the owner's base and joins ours
		local owner = meta and meta.From
		local taken = owner and owner.Parent and meta.PetId and pets:TakePet(owner, meta.PetId)
		if not taken then
			Net:Notify(player, "The owner left - the pet vanished!")
			return
		end
		local given, isNew = pets:GivePet(player, taken.Name, taken.Variant, taken.Serial, taken)
		-- a freshly stolen pet can't hide in the thief's vault yet: revenge can win it back
		if given and not (meta.Revenge and meta.Thief == player) then
			given.HotUntil = os.time() + Config.Base.HotSeconds
		end
		-- save both right away so a crash can't leave the pet in two places
		task.spawn(Data.Save, Data, owner)
		task.spawn(Data.Save, Data, player)
		-- theft shield for the victim, revenge window, bounty on serial thieves
		Services.BaseService:StealDelivered(owner, player, meta, taken)
		-- 🌙 Thief Night: delivered steals pay a bonus
		local bonusSeconds = Services.EventService:Get("StealBonus", 0)
		local pairKey = player.UserId .. ":" .. owner.UserId
		local repeatPair = os.clock() - (nightBonusPaid[pairKey] or -1e9) < 600
		if bonusSeconds > 0 and data and not meta.Revenge and not repeatPair then
			nightBonusPaid[pairKey] = os.clock()
			local bonus = math.floor(Util.PetIncomeOf(Config, taken) * bonusSeconds)
			if bonus > 0 then
				data.Coins += bonus
				data.Stats.LifetimeCoins += bonus
				Net:Send(player, "Sold", bonus)
				Net:Notify(player, "🌙 Thief Night bonus: +💰%s!", Color3.fromRGB(170, 140, 255), Util.Format(bonus))
			end
		end
		local display = taken.Name
		Net:Notify(owner, "💔 %s stole your %s!", Color3.fromRGB(255, 90, 90), player.DisplayName, display)
		if data then
			data.Stats.ShardsStolen += 1
		end
		Services.ProgressionService:AddQuest(player, "Steal", 1)
		Services.Analytics:Custom(player, "PetStolen", tier)
		Net:Send(player, "ShardDelivered", display, "Stolen", 0)
		-- the same "where did it go" card as a hatch (no egg)
		local card = given and pets:Describe(player, given, isNew)
		if card then
			card.Stolen = true
			Net:Send(player, "HatchResult", { card }, nil, "Stolen")
		end
		if tier >= 5 then
			Net:Announce("🦹 %s stole a %s from %s!", itemColor(item), player.DisplayName, display, owner.DisplayName)
		end
	else
		-- a star egg: it hatches right here
		local def = SETTINGS.Rarities[item.Rarity]
		local meteorInfo = if item.MeteorKind then { Kind = item.MeteorKind, Golden = item.Golden, Rarity = item.Rarity } else nil
		local result = pets:HatchStarEgg(player, item.Egg, if def then def.Luck or 1 else 1, meteorInfo)
		pcall(pets.AddFollowXP, pets, player, Config.Growth.DeliverXP)
		if data then
			data.Stats.ShardsDelivered = (data.Stats.ShardsDelivered or 0) + 1
		end
		Services.Analytics:Custom(player, "StarEggHatched", tier)
		Net:Send(player, "ShardDelivered", rarityName(item.Rarity), "Hatched", 0, result and result.Name)
		if tier >= 4 then
			Net:Announce("🌟 %s brought a %s home!", itemColor(item), player.DisplayName, rarityName(item.Rarity))
		end
	end
	Services.ProgressionService:AddQuest(player, "Shard", 1)
	Services.ProgressionService:TutorialEvent(player, "Shard", 1)
	Services.ProgressionService:AddPoints(player, SETTINGS.Points[math.clamp(tier, 1, #SETTINGS.Points)] or 10)
end

---------------------------------------------------------------------------
-- falling stars + meteor spill
---------------------------------------------------------------------------
local function maxZoneInServer(): number
	local best = 1
	for _, player in Data:LoadedPlayers() do
		local data = Data:Get(player)
		if data then
			best = math.max(best, data.ZoneLevel)
		end
	end
	return math.min(best, #Config.Zones)
end

function Shards:FallingStar(forcedZone: number?)
	local zone = forcedZone
	if not zone then
		zone = if rng:NextNumber() < SETTINGS.FallingStar.HubChance then 0 else rng:NextInteger(1, maxZoneInServer())
	end
	local position
	if zone == 0 then
		local spot = HUB_SPOTS[rng:NextInteger(1, #HUB_SPOTS)]
		position = spot + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
	else
		local info = World.Zones[zone]
		position = Vector3.new(rng:NextNumber(-36, 36), 0, rng:NextNumber(info.ZStart + 18, info.ZEnd - 10))
	end
	local luck = 1 + math.max(0, zone - 1) * SETTINGS.FallingStar.LuckPerZone
	local id = Util.RollShard(Config, luck, rng)
	local item = { Kind = "Egg", Rarity = id, Egg = SETTINGS.ZoneEggs[math.max(zone, 1)] or "Meadow" }
	local flight = 1.8
	Net:Broadcast("StarFall", position, id, flight)
	task.delay(flight, function()
		self:SpawnGround(item, position, nil, { Beacon = true, WithGuardian = true })
		local where = if zone == 0 then "Hub" else Config.Zones[zone].Name
		Net:Announce("🌠 A falling star crashed in %s! Grab the %s!", SETTINGS.Rarities[id].Color, where, rarityName(id))
	end)
	return id
end

-- tutorial: a guaranteed star egg just for this player (popped out of their
-- tutorial meteor at `position`, or falling into the hub after a rejoin)
local tutorialStars = {} -- [player] = ground model
function Shards:TutorialStar(player: Player, position: Vector3?)
	local existing = tutorialStars[player]
	if existing and existing.Parent then
		return
	end
	if carrying[player] then
		return
	end
	local function spawn(at: Vector3)
		tutorialStars[player] = self:SpawnGround({ Kind = "Egg", Rarity = "Rare", Egg = "Meadow" }, at, nil, {
			Beacon = true,
			PriorityUser = player.UserId,
			PriorityUntil = now() + 600,
			Lifetime = 900,
			NoRival = true,
		})
	end
	if position then
		spawn(position)
		Net:Notify(player, "🥚 A star egg popped out! Grab it!", Color3.fromRGB(120, 230, 255))
		return
	end
	local spot = Config.Meteor.Tutorial.Position + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
	local flight = 1.6
	Net:Send(player, "StarFall", spot, "Rare", flight)
	task.delay(flight, function()
		if not player.Parent then
			return
		end
		spawn(spot)
		Net:Notify(player, "🌠 A star fell just for you! Grab it!", Color3.fromRGB(120, 230, 255))
	end)
end

-- ☄️ the meteor bursts: star eggs of its kind scatter around the crater.
-- ranking = { { Player = p, Score = n }, ... } best first
-- info = { Egg = "Lava", Luck = 2.5, Extra = 0..3, Narrow = avenue? } (from MeteorService)
function Shards:SpillMeteor(position: Vector3, ranking, info)
	info = info or {}
	local spill = Config.Meteor.Spill
	local real = 0 -- (🤖 robots don't add eggs)
	for _, entry in ranking do
		if not entry.Player.IsRival then
			real += 1
		end
	end
	local count = math.min(spill.Base + spill.PerParticipant * real, spill.Max) + (info.Extra or 0)
	count = math.max(count, 1)
	local egg = info.Egg or "Cosmic"
	local luck = info.Luck or spill.Luck
	local priority = SETTINGS.Meteor.TopPriority
	-- roll everything first: the top 3 get one reserved egg each (1st: Epic+)
	local eggs = {}
	for i = 1, count do
		local reserved = ranking[i] and i <= 3 and ranking[i].Player or nil
		local id = Util.RollShard(Config, luck, rng, if i == 1 and reserved then 3 else nil)
		table.insert(eggs, { Id = id, Tier = Util.ShardIndex(Config, id), Reserved = reserved, Place = i })
	end
	-- the best eggs are guarded by meteor golems
	local order = table.clone(eggs)
	table.sort(order, function(a, b)
		return a.Tier > b.Tier
	end)
	-- (not on the avenue: guardians never chase into the base district)
	local guarded = if info.Narrow then 0 else spill.Guardians
	for i = 1, math.min(guarded, #order) do
		order[i].Guardian = true
	end
	for i, entry in eggs do
		local angle = (i / count) * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local radius = rng:NextNumber(11, 19)
		local dx, dz = math.cos(angle) * radius, math.sin(angle) * radius
		if info.Narrow then
			-- (on the avenue: spread along the street, not into people's gardens)
			dx, dz = math.cos(angle) * (radius + 5), math.sin(angle) * rng:NextNumber(3, 10)
		end
		local spot = Vector3.new(position.X + dx, 0, position.Z + dz)
		local opts = { Beacon = true, WithGuardian = entry.Guardian }
		if entry.Reserved then
			opts.PriorityUser = entry.Reserved.UserId
			opts.PriorityUntil = now() + (if entry.Place == 1 then priority else priority - 1)
		end
		self:SpawnGround({ Kind = "Egg", Rarity = entry.Id, Egg = egg, MeteorKind = info.Kind, Golden = info.Golden }, spot, nil, opts)
		if entry.Reserved and typeof(entry.Reserved) == "Instance" then -- (robots get no messages)
			local medal = ({ "🥇", "🥈", "🥉" })[entry.Place]
			Net:Notify(entry.Reserved, "%s Your %s is waiting - grab it first!", Color3.fromRGB(255, 220, 90), medal, rarityName(entry.Id))
		end
	end
	return eggs
end

---------------------------------------------------------------------------
function Shards:Init(services)
	Services = services
	Data = services.DataService
	World = services.WorldService
end

-- move one guardian toward its destination (anchored + server-driven)
local function moveGuardian(g, dt: number)
	local flat = (g.Destination - g.Position) * Vector3.new(1, 0, 1)
	local distance = flat.Magnitude
	if distance > 0.3 then
		local stepLength = math.min(distance, g.Speed * dt)
		g.Facing = flat.Unit
		g.Position += g.Facing * stepLength
	end
	local bob = math.sin(os.clock() * 6 + g.Home.X) * 0.25
	local at = Vector3.new(g.Position.X, GUARDIAN_Y + bob, g.Position.Z)
	g.Model:PivotTo(CFrame.lookAt(at, at + g.Facing))
end

local function stepGuardians(dt: number)
	local clock = os.clock()
	for model, g in guardians do
		if not model.Parent then
			guardians[model] = nil
		elseif g.StunnedUntil > clock then
			-- dazed: wobble in place
			local at = Vector3.new(g.Position.X, GUARDIAN_Y, g.Position.Z)
			g.Model:PivotTo(CFrame.lookAt(at, at + g.Facing) * CFrame.Angles(0, 0, math.sin(clock * 20) * 0.15))
		else
			if g.Target then
				local target = g.Target
				local info = carrying[target]
				local root = rootOf(target)
				local giveUp = not target.Parent
					or not info
					or info.Guardian ~= g
					or not root
					or clock > g.ChaseUntil
					or (g.Position - g.Home).Magnitude > GUARDIAN.ChaseRange
					or Util.InBases(Config, root.Position)
				if giveUp then
					g.Target = nil
					g.Done = true -- the shard is gone: walk back and vanish
					if info and info.Guardian == g then
						info.Guardian = nil
					end
					g.Destination = g.Home
				elseif root then
					g.Destination = root.Position
					local gap = ((root.Position - g.Position) * Vector3.new(1, 0, 1)).Magnitude
					if gap <= GUARDIAN.CatchRange then
						-- caught! the guardian takes the shard back to the crash site
						local caughtItem = info.Item
						endCarry(target)
						Services.CharacterService:Stun(target, 1.2)
						local push = (root.Position - g.Position) * Vector3.new(1, 0, 1)
						push = if push.Magnitude > 0.01 then push.Unit else Vector3.zAxis
						Net:Send(target, "Knockback", push * 45 + Vector3.new(0, 30, 0))
						Net:Send(target, "CaughtByGuardian", itemName(caughtItem))
						g.Target = nil
						g.Done = false
						Shards:SpawnGround(caughtItem, g.Home, nil, {
							Beacon = true,
							Guardian = g,
							BlockUser = target.UserId,
							BlockUntil = now() + 2,
						})
						g.Destination = g.Home + Vector3.new(6, 0, 0)
					end
				end
			else
				local homeSpot = g.Home + Vector3.new(6, 0, 0)
				local distance = ((g.Position - homeSpot) * Vector3.new(1, 0, 1)).Magnitude
				if g.Done and distance < 3 then
					despawnGuardian(g)
					continue
				end
				g.Destination = homeSpot
			end
			moveGuardian(g, dt)
		end
	end
end

-- test hook (cloud tests): the live guardian records
function Shards:GuardiansForTest()
	return guardians
end

function Shards:Start()
	RunService.Heartbeat:Connect(function(dt)
		if next(guardians) == nil then
			return
		end
		local ok, err = pcall(stepGuardians, math.min(dt, 0.1))
		if not ok then
			warn("[Shards] guardian step failed: " .. tostring(err))
		end
	end)
	-- delivery + safety checks
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.15 then
			return
		end
		accumulator = 0
		for player, info in carrying do
			local root = rootOf(player)
			if not root or not info.Model or not info.Model.Parent then
				-- character vanished (respawn/reset): the shard drops where it was
				if root then
					self:Drop(player)
				else
					endCarry(player)
					returnHome(info.Meta, true)
				end
			elseif info.Meta and info.Meta.Deadline and os.clock() > info.Meta.Deadline then
				-- held too long: the stolen pet escapes back home
				endCarry(player)
				returnHome(info.Meta, true)
				Net:Notify(player, "⏰ Too slow - the pet ran back home!", Color3.fromRGB(255, 150, 90))
			elseif Services.BaseService:InOwnPlot(player, root.Position) then
				local ok, err = pcall(deliver, player)
				if not ok then
					warn("[Shards] delivery failed: " .. tostring(err))
				end
			end
		end
	end)

	local function onCharacter(player: Player, character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if humanoid then
			humanoid.Died:Connect(function()
				if carrying[player] then
					self:Drop(player)
				end
			end)
		end
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local star = tutorialStars[player]
		tutorialStars[player] = nil
		if star and ground[star] then
			destroyGround(star)
		end
		local info = carrying[player]
		if info then
			endCarry(player)
			returnHome(info.Meta, true) -- a thief who leaves gives the shard back
		end
		-- the owner left: shards stolen from them vanish (they keep theirs)
		for carrier, other in carrying do
			if other.Meta and other.Meta.From == player then
				endCarry(carrier)
				Net:Notify(carrier, "The owner left - the shard vanished!")
			end
		end
		for model, record in ground do
			if record.Meta and record.Meta.From == player then
				destroyGround(model)
			end
		end
	end)

	-- falling stars
	task.spawn(function()
		task.wait(25)
		while true do
			local star = SETTINGS.FallingStar
			local mult = math.max(1, Services.EventService:Get("StarMult", 1))
			task.wait(rng:NextNumber(star.MinInterval, star.MaxInterval) / mult)
			if #Players:GetPlayers() > 0 then
				local ok, err = pcall(self.FallingStar, self)
				if not ok then
					warn("[Shards] falling star failed: " .. tostring(err))
				end
			end
		end
	end)
end

return Shards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">StatsService</string>
            <string name="Source"><![CDATA[--[[
	StatsService: single source of truth for every multiplier
	(damage, coins, luck, capacity, pet slots) + social bonuses.
	Also builds the "Derived" block that is synced to the client UI.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Stats = {}
local Services
local Data

local friendCache = {} -- ["a:b"] = bool
local serverRank

local function has(player, key)
	return Services.MonetizationService:HasPass(player, key)
end

local function boost(player, key)
	return Services.BoostService:IsActive(player, key)
end

function Stats:PetPower(_player, data): number
	local equipped = {}
	for _, id in data.Equipped do
		equipped[id] = true
	end
	local total = 0
	for _, pet in data.Pets do
		if equipped[pet.Id] then
			total += Util.PetPowerOf(Config, pet)
		end
	end
	return total
end

function Stats:PetSlots(player, data): number
	local slots = Config.BasePetSlots + math.floor(data.Rebirths / Config.Rebirth.ExtraPetSlotEvery)
	if has(player, "ExtraPets") then
		slots += 3
	end
	if has(player, "VIP") then
		slots += 1
	end
	return math.min(slots, Config.MaxPetSlots)
end

function Stats:Damage(player, data): number
	local pickaxe = Config.Pickaxes[data.PickaxeTier] or Config.Pickaxes[1]
	local mult = 1 + self:PetPower(player, data)
	if has(player, "MegaPower") then
		mult *= 2
	end
	if boost(player, "Power2x") then
		mult *= 2
	end
	return pickaxe.Power * mult
end

function Stats:SwingCooldown(player, data): number
	local pickaxe = Config.Pickaxes[data.PickaxeTier] or Config.Pickaxes[1]
	local mining = Services.MiningService
	if mining and mining:IsFever(player) then
		return pickaxe.Cooldown * Config.Fever.CooldownMult
	end
	return pickaxe.Cooldown
end

function Stats:SocialBonus(player): (number, number, boolean, boolean)
	local friends = player:GetAttribute("FriendsInServer") or 0
	local friendBonus = math.min(Config.Social.FriendBonusMax, friends * Config.Social.FriendBonusPer)
	local inGroup = player:GetAttribute("InGroup") == true
	local premium = player.MembershipType == Enum.MembershipType.Premium
	local bonus = friendBonus
	if inGroup then
		bonus += Config.Social.GroupBonus
	end
	if premium then
		bonus += Config.Social.PremiumBonus
	end
	return bonus, friendBonus, inGroup, premium
end

function Stats:CoinMultiplier(player, data): number
	local mult = 1 + data.Rebirths * Config.Rebirth.CoinBonusPer
	if has(player, "DoubleCoins") then
		mult *= 2
	end
	if boost(player, "Coins2x") then
		mult *= 2
	end
	local bonus = self:SocialBonus(player)
	bonus += (data.Level - 1) * Config.Levels.CoinBonusPer
	if has(player, "VIP") then
		bonus += Config.Social.VipCoinBonus
	end
	if Services.MonetizationService:IsSubscribed(player) then
		bonus += Config.Subscription.CoinBonus
	end
	return mult * (1 + bonus)
end

function Stats:Luck(player, _data): number
	local luck = 1
	if has(player, "Lucky") then
		luck *= 1.5
	end
	if boost(player, "Luck2x") then
		luck *= 2
	end
	if Services.BoostService:ServerActive("ServerLuck") then
		luck *= 2
	end
	return luck
end

-- weekly-points standing among players in THIS server (+ who to beat next)
serverRank = function(player: Player, data)
	local list = {}
	for _, other in Data:LoadedPlayers() do
		local otherData = Data:Get(other)
		if otherData then
			table.insert(list, { Player = other, Points = otherData.Weekly.Points })
		end
	end
	table.sort(list, function(a, b)
		return a.Points > b.Points
	end)
	for place, entry in list do
		if entry.Player == player then
			local ahead = list[place - 1]
			return {
				Place = place,
				Count = #list,
				NextName = ahead and ahead.Player.DisplayName or nil,
				NextGap = ahead and (ahead.Points - data.Weekly.Points + 1) or nil,
			}
		end
	end
	return { Place = 1, Count = 1 }
end

function Stats:BuildDerived(player)
	local data = Data:Get(player)
	if not data then
		return {}
	end
	local bonus, friendBonus, inGroup, premium = self:SocialBonus(player)
	local rank, rankIndex = Util.RankFor(Config, data.Weekly.Points)
	local progression = Services.ProgressionService
	return {
		Damage = self:Damage(player, data),
		CoinMult = self:CoinMultiplier(player, data),
		Luck = self:Luck(player, data),
		Cooldown = (Config.Pickaxes[data.PickaxeTier] or Config.Pickaxes[1]).Cooldown, -- client applies FEVER itself
		PetSlots = self:PetSlots(player, data),
		PetPower = self:PetPower(player, data),
		Passes = Services.MonetizationService:OwnedPasses(player),
		Subscribed = Services.MonetizationService:IsSubscribed(player),
		RebirthCost = Util.RebirthCost(Config, data.Rebirths),
		SocialBonus = bonus,
		FriendBonus = friendBonus,
		InGroup = inGroup,
		Premium = premium,
		Rank = rank.Name,
		RankIndex = rankIndex,
		Week = Util.WeekNumber(),
		Today = Util.DayNumber(),
		SessionStart = progression and progression:SessionStart(player) or os.time(),
		GiftsClaimed = progression and progression:GiftsClaimed(player) or {},
		-- unknown policy (still loading) counts as restricted, same as the server
		PaidRandomRestricted = player:GetAttribute("PaidRandomRestricted") ~= false,
		AdsEnabled = Config.RewardedAds.Enabled,
		XPNeeded = Util.XPForLevel(Config, data.Level),
		SpinCooldown = if Services.MonetizationService:HasPass(player, "VIP")
			then Config.Spin.VipCooldownSeconds
			else Config.Spin.CooldownSeconds,
		ServerRank = serverRank(player, data),
		ServerTime = os.time(),
	}
end

-- social -------------------------------------------------------------------
local function areFriends(a: Player, b: Player): boolean
	local low, high = math.min(a.UserId, b.UserId), math.max(a.UserId, b.UserId)
	local key = low .. ":" .. high
	if friendCache[key] == nil then
		local ok, result = pcall(a.IsFriendsWith, a, b.UserId)
		friendCache[key] = ok and result == true
	end
	return friendCache[key]
end

local function recountFriends()
	local players = Players:GetPlayers()
	for _, player in players do
		local count = 0
		for _, other in players do
			if other ~= player and areFriends(player, other) then
				count += 1
			end
		end
		if player:GetAttribute("FriendsInServer") ~= count then
			player:SetAttribute("FriendsInServer", count)
			Data:MarkDirty(player)
		end
	end
end

function Stats:Init(services)
	Services = services
	Data = services.DataService
	Data.BuildDerived = function(player)
		return Stats:BuildDerived(player)
	end
end

function Stats:Start()
	local function onPlayer(player: Player)
		if Config.GroupId ~= 0 then
			task.spawn(function()
				local ok, inGroup = pcall(player.IsInGroup, player, Config.GroupId)
				player:SetAttribute("InGroup", ok and inGroup == true)
				Data:MarkDirty(player)
			end)
		end
		task.spawn(recountFriends)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function()
		task.defer(recountFriends)
	end)
	Players.PlayerMembershipChanged:Connect(function(player)
		Data:MarkDirty(player)
	end)
	task.spawn(recountFriends)
end

return Stats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--[[
	TradeService: swap pets with another player in the same server.

	Flow: request -> the other player accepts -> both pick up to MaxPets pets
	-> both press Ready -> 3 second countdown -> swap.
	Safety: every change resets both Ready flags (no bait-and-switch), the
	server re-checks ownership at the moment of the swap, pets being stolen
	can't be traded, and the swap happens all at once (both sides or none).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local Trade = {}
local Services
local Data

local SETTINGS = { MaxPets = 4, Countdown = 3, RequestSeconds = 20 }
Trade.Settings = SETTINGS

local requests = {} -- [target] = { From = player, Expires = os.clock() }
local trades = {} -- [player] = session (both players point to the same session)

local function other(session, player: Player): Player
	return if session.A == player then session.B else session.A
end

local function petInfo(data, petId)
	for _, pet in data.Pets do
		if pet.Id == petId then
			return pet
		end
	end
	return nil
end

-- what each client sees: both offers (names so the other side can render them)
local function sendState(session)
	for _, player in { session.A, session.B } do
		local partner = other(session, player)
		local function describe(who: Player)
			local data = Data:Get(who)
			local list = {}
			for _, petId in session.Offers[who] do
				local pet = data and petInfo(data, petId)
				if pet then
					table.insert(list, {
						Id = pet.Id,
						Name = pet.Name,
						Variant = pet.Variant,
						Serial = pet.Serial,
						Level = pet.Level,
						Stars = pet.Stars,
					})
				end
			end
			return list
		end
		Net:Send(player, "TradeState", {
			Partner = partner.DisplayName,
			Mine = describe(player),
			Theirs = describe(partner),
			MyReady = session.Ready[player] == true,
			TheirReady = session.Ready[partner] == true,
			Countdown = session.CountdownEnds,
		})
	end
end

local function close(session, reason: string?)
	for _, player in { session.A, session.B } do
		if trades[player] == session then
			trades[player] = nil
			if player.Parent then
				Net:Send(player, "TradeClosed", if reason then Net:L(player, reason) else nil)
			end
		end
	end
	session.Closed = true
end

local function resetReady(session)
	session.Ready = {}
	session.CountdownEnds = nil
end

-- validate + swap atomically
local function complete(session)
	local a, b = session.A, session.B
	local dataA, dataB = Data:Get(a), Data:Get(b)
	if not dataA or not dataB then
		close(session, "Trade cancelled.")
		return
	end
	local shards = Services.ShardService
	if shards:IsCarrying(a) or shards:IsCarrying(b) then
		close(session, "Trade cancelled - someone is carrying something.")
		return
	end
	local function collect(data, ids)
		local list = {}
		for _, petId in ids do
			local pet = petInfo(data, petId)
			if not pet or pet.Away or pet.SerialPending then
				return nil
			end
			-- both sides must be allowed to trade paid items
			if
				Util.IsExclusive(Config, pet)
				and not (a:GetAttribute("PaidTradeAllowed") == true and b:GetAttribute("PaidTradeAllowed") == true)
			then
				return nil
			end
			table.insert(list, pet)
		end
		return list
	end
	local giveA = collect(dataA, session.Offers[a])
	local giveB = collect(dataB, session.Offers[b])
	if not giveA or not giveB then
		close(session, "Trade cancelled - a pet is no longer available.")
		return
	end
	if #dataA.Pets - #giveA + #giveB > Config.MaxPets or #dataB.Pets - #giveB + #giveA > Config.MaxPets then
		close(session, "Trade cancelled - not enough pet storage.")
		return
	end
	-- remove from both, then add to both (all checks passed above)
	local function remove(data, pets)
		for _, pet in pets do
			local index = table.find(data.Pets, pet)
			if index then
				table.remove(data.Pets, index)
			end
		end
	end
	local function add(data, pets)
		for _, pet in pets do
			local copy = {
				Id = data.NextPetUid,
				Name = pet.Name,
				Variant = pet.Variant,
				Serial = pet.Serial,
				Level = pet.Level,
				XP = pet.XP,
				Stars = pet.Stars,
			}
			data.NextPetUid += 1
			table.insert(data.Pets, copy)
			data.PetIndex[pet.Name] = true
		end
	end
	remove(dataA, giveA)
	remove(dataB, giveB)
	add(dataA, giveB)
	add(dataB, giveA)
	Services.PetService:Changed(a)
	Services.PetService:Changed(b)
	Services.Analytics:Custom(a, "Trade", #giveA + #giveB)
	Services.Analytics:Custom(b, "Trade", #giveA + #giveB)
	-- save both right away so a crash can't duplicate or lose pets
	task.spawn(Data.Save, Data, a)
	task.spawn(Data.Save, Data, b)
	for _, player in { a, b } do
		Net:Send(player, "TradeDone", other(session, player).DisplayName)
	end
	close(session, nil)
end

-- cloud tests only: open a trade between two stand-in players
function Trade:BeginForTest(a: any, b: any)
	assert(not game:GetService("RunService"):IsRunning(), "test hook used on a live server")
	local session = { A = a, B = b, Offers = { [a] = {}, [b] = {} }, Ready = {} }
	trades[a] = session
	trades[b] = session
	return session
end

function Trade:IsTrading(player: Player): boolean
	return trades[player] ~= nil
end

function Trade:Init(services)
	Services = services
	Data = services.DataService
end

function Trade:Start()
	Net:On("TradeRequest", 3, function(player, targetUserId)
		local target = type(targetUserId) == "number" and Players:GetPlayerByUserId(targetUserId)
		if not target or target == player or not Data:Get(player) or not Data:Get(target) then
			return
		end
		if trades[player] or trades[target] then
			Net:Notify(player, "That player is busy trading.")
			return
		end
		requests[target] = { From = player, Expires = os.clock() + SETTINGS.RequestSeconds }
		Net:Send(target, "TradeRequested", player.UserId, player.DisplayName)
		Net:Notify(player, "🤝 Trade request sent to %s", Color3.fromRGB(150, 230, 255), target.DisplayName)
	end)

	Net:On("TradeRespond", 1, function(player, accept)
		local request = requests[player]
		requests[player] = nil
		if not request or os.clock() > request.Expires then
			return
		end
		local from = request.From
		if not accept then
			Net:Notify(from, "%s declined the trade.", nil, player.DisplayName)
			return
		end
		if not from.Parent or trades[from] or trades[player] then
			Net:Notify(player, "That player is busy trading.")
			return
		end
		local session = { A = from, B = player, Offers = { [from] = {}, [player] = {} }, Ready = {} }
		trades[from] = session
		trades[player] = session
		sendState(session)
	end)

	Net:On("TradeSetOffer", 0.2, function(player, petIds)
		local session = trades[player]
		local data = Data:Get(player)
		if not session or not data or type(petIds) ~= "table" or #petIds > SETTINGS.MaxPets then
			return
		end
		local clean, seen = {}, {}
		for i = 1, #petIds do
			local petId = petIds[i]
			if type(petId) == "number" and not seen[petId] and #clean < SETTINGS.MaxPets then
				local pet = petInfo(data, petId)
				-- exclusive (Robux) pets can't be traded where Roblox restricts paid item trading
				local blocked = Util.IsExclusive(Config, pet) and player:GetAttribute("PaidTradeAllowed") ~= true
				if pet and not pet.Away and not pet.SerialPending and not blocked then
					seen[petId] = true
					table.insert(clean, petId)
				elseif pet and blocked then
					Net:Notify(player, "💎 Exclusive pets can't be traded in your region.")
				end
			end
		end
		session.Offers[player] = clean
		resetReady(session) -- any change: both have to confirm again
		sendState(session)
	end)

	Net:On("TradeReady", 0.3, function(player, ready)
		local session = trades[player]
		if not session then
			return
		end
		session.Ready[player] = ready == true
		if session.Ready[session.A] and session.Ready[session.B] then
			session.CountdownEnds = workspace:GetServerTimeNow() + SETTINGS.Countdown
			local token = {}
			session.Token = token
			sendState(session)
			task.delay(SETTINGS.Countdown, function()
				if not session.Closed and session.Token == token and session.Ready[session.A] and session.Ready[session.B] then
					complete(session)
				end
			end)
		else
			session.CountdownEnds = nil
			sendState(session)
		end
	end)

	Net:On("TradeCancel", 0.3, function(player)
		local session = trades[player]
		if session then
			close(session, "Trade cancelled.")
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		requests[player] = nil
		local session = trades[player]
		if session then
			close(session, "The other player left.")
		end
	end)
end

return Trade
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	WorldService: builds the whole map procedurally (no assets required):
	hub plaza, shops, egg stands, sell pad, meteor crater, leaderboards and
	five mining zones separated by gates. Swap any part for a real model later.
]]
local HttpService = game:GetService("HttpService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Net = require(script.Parent.Net)

local World = {}
local Services

local LAYOUT = Config.World.Layout
local HUB_HALF = LAYOUT.HubHalf
local ZONE_W = LAYOUT.ZoneWidth
local ZONE_L = LAYOUT.ZoneLength
local GAP = LAYOUT.Gap
local FIRST_Z = LAYOUT.FirstZ
local CORRIDOR_W = 24
local WALL_H = 16

-- per-zone ambient particles (index = zone)
local AMBIENCE = {
	{ -- Meadow: fireflies
		Color = Color3.fromRGB(220, 255, 120),
		Light = 1,
		Size = 0.25,
		Life = { 3, 5 },
		Rate = 14,
		Speed = { 0.4, 1.2 },
		Acceleration = Vector3.new(0, 0.3, 0),
		Direction = Enum.NormalId.Top,
		Height = 4,
	},
	{ -- Frost: snow
		Color = Color3.fromRGB(240, 250, 255),
		Light = 0.3,
		Size = 0.35,
		Life = { 7, 9 },
		Rate = 45,
		Speed = { 2, 4 },
		Acceleration = Vector3.new(0.5, -1, 0),
		Direction = Enum.NormalId.Bottom,
		Height = 30,
	},
	{ -- Lava: rising embers
		Color = Color3.fromRGB(255, 130, 40),
		Light = 1,
		Size = 0.3,
		Life = { 3, 5 },
		Rate = 35,
		Speed = { 3, 6 },
		Acceleration = Vector3.new(0, 2, 0),
		Direction = Enum.NormalId.Top,
		Height = 0.6,
	},
	{ -- Void: drifting motes
		Color = Color3.fromRGB(190, 120, 255),
		Light = 1,
		Size = 0.4,
		Life = { 4, 6 },
		Rate = 22,
		Speed = { 0.5, 1.5 },
		Acceleration = Vector3.new(0, 0.5, 0),
		Direction = Enum.NormalId.Top,
		Height = 6,
	},
	{ -- Star Crater: falling stars
		Color = Color3.fromRGB(255, 140, 220),
		Light = 1,
		Size = 0.5,
		Life = { 4, 6 },
		Rate = 28,
		Speed = { 6, 10 },
		Acceleration = Vector3.new(1, -2, 0),
		Direction = Enum.NormalId.Bottom,
		Height = 45,
	},
}

World.Zones = {}
World.OreSlots = {}
World.Boards = {}
World.PvPZone = 0
World.HubSpawn = CFrame.new(0, 4, -60)

local map = Instance.new("Folder")
map.Name = "Map"

local function folder(name: string, parent: Instance)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function newPart(props, parent: Instance?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = parent or map
	return p
end

-- marks a world TextLabel for client-side translation (LangFmt + JSON args)
function World.SetText(label: TextLabel, fmt: string, ...)
	local args = { ... }
	for i, v in args do
		if type(v) ~= "string" then
			args[i] = tostring(v)
		end
	end
	label:SetAttribute("LangFmt", fmt)
	label:SetAttribute("LangArgs", HttpService:JSONEncode(args))
	local ok, text = pcall(string.format, fmt, table.unpack(args))
	label.Text = if ok then text else fmt
end

-- width / height are in STUDS so labels shrink with distance like real signs
local function billboard(adornee: BasePart, fmt: string, color: Color3, offsetY: number, width: number?, height: number?, ...)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.new(width or 12, 0, height or 3, 0)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 160
	gui.AlwaysOnTop = false
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = color
	label.RichText = true
	World.SetText(label, fmt, ...)
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Parent = label
	label.Parent = gui
	gui.Parent = adornee
	return gui, label
end

local function prompt(parent: BasePart, actionText: string, objectText: string, handler)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = actionText
	p.ObjectText = objectText
	p.HoldDuration = 0
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.Parent = parent
	p.Triggered:Connect(function(player)
		local ok, err = pcall(handler, player)
		if not ok then
			warn("[World] prompt failed: " .. tostring(err))
		end
	end)
	return p
end

local function openPanel(panel: string, arg: any?)
	return function(player)
		Net:Send(player, "OpenPanel", panel, arg)
	end
end

function World.ZoneStart(index: number): number
	return FIRST_Z + (index - 1) * (ZONE_L + GAP)
end

-- 0 = hub, 1..n = zone index, nil = outside
function World:ZoneAt(position: Vector3): number?
	if math.abs(position.X) <= HUB_HALF and math.abs(position.Z) <= HUB_HALF then
		return 0
	end
	if Util.InBases(Config, position) then
		return 0
	end
	if math.abs(position.X) > ZONE_W / 2 + 1 then
		return nil
	end
	for index, zone in self.Zones do
		if position.Z >= zone.ZStart and position.Z <= zone.ZEnd then
			return index
		end
	end
	return nil
end

function World:SpawnFor(index: number): CFrame
	if index == 0 or not self.Zones[index] then
		return self.HubSpawn
	end
	return self.Zones[index].Spawn
end

---------------------------------------------------------------------------
-- builders
---------------------------------------------------------------------------
local function wall(cf: CFrame, size: Vector3, color: Color3, parent)
	return newPart({
		Name = "Wall",
		CFrame = cf,
		Size = size,
		Color = color,
		Material = Enum.Material.Rock,
	}, parent)
end

-- a fuller tree: trunk + a few overlapping leaf clumps (varied size / colour)
local treeRng = Random.new(77)
local function tree(position: Vector3, parent, scale: number?)
	local k = (scale or 1) * treeRng:NextNumber(0.85, 1.25)
	local trunkH = 7 * k
	newPart({
		Name = "Trunk",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(trunkH, 1.6 * k, 1.6 * k),
		CFrame = CFrame.new(position + Vector3.new(0, trunkH / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(105, 72, 48),
		Material = Enum.Material.Wood,
	}, parent)
	local green = Color3.fromRGB(70, 150, 70):Lerp(Color3.fromRGB(110, 180, 80), treeRng:NextNumber())
	for i = 1, 4 do
		local angle = i * 1.7 + treeRng:NextNumber(0, 1)
		local r = if i == 1 then 0 else 2.2 * k
		local size = (if i == 1 then 8 else 5.5) * k * treeRng:NextNumber(0.9, 1.1)
		newPart({
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * size,
			CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * r, trunkH + (if i == 1 then 1.5 else 0) * k, math.sin(angle) * r)),
			Color = green:Lerp(Color3.new(0, 0, 0), if i == 1 then 0 else 0.08 * i),
			Material = Enum.Material.Grass,
			CanCollide = false,
		}, parent)
	end
end

local function lamp(position: Vector3, color: Color3, parent)
	newPart({
		Name = "LampPost",
		Size = Vector3.new(0.8, 10, 0.8),
		CFrame = CFrame.new(position + Vector3.new(0, 5, 0)),
		Color = Color3.fromRGB(40, 40, 45),
		Material = Enum.Material.Metal,
	}, parent)
	local bulb = newPart({
		Name = "Bulb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.6,
		CFrame = CFrame.new(position + Vector3.new(0, 10.3, 0)),
		Color = color,
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		CanCollide = false,
	}, parent)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 22
	light.Brightness = 1.2
	light.Parent = bulb
end

local function booth(position: Vector3, title: string, color: Color3, parent)
	local base = newPart({
		Name = "BoothBase",
		Size = Vector3.new(14, 1, 14),
		CFrame = CFrame.new(position + Vector3.new(0, 0.5, 0)),
		Color = Color3.fromRGB(60, 60, 70),
		Material = Enum.Material.WoodPlanks,
	}, parent)
	for _, offset in { Vector3.new(-6, 0, -6), Vector3.new(6, 0, -6), Vector3.new(-6, 0, 6), Vector3.new(6, 0, 6) } do
		newPart({
			Name = "Pillar",
			Size = Vector3.new(1, 9, 1),
			CFrame = CFrame.new(position + offset + Vector3.new(0, 5.5, 0)),
			Color = Color3.fromRGB(240, 240, 240),
			Material = Enum.Material.SmoothPlastic,
		}, parent)
	end
	newPart({
		Name = "Roof",
		Size = Vector3.new(16, 1.2, 16),
		CFrame = CFrame.new(position + Vector3.new(0, 10.6, 0)),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	local counter = newPart({
		Name = "Counter",
		Size = Vector3.new(8, 3.5, 3),
		CFrame = CFrame.new(position + Vector3.new(0, 2.75, 0)),
		Color = color:Lerp(Color3.new(1, 1, 1), 0.25),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	billboard(base, title, Color3.new(1, 1, 1), 13, 13, 3)
	return counter
end

local function eggStand(position: Vector3, eggId: string, parent)
	local egg = Config.Eggs[eggId]
	newPart({
		Name = "Pedestal",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 10, 10),
		CFrame = CFrame.new(position + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(235, 235, 240),
		Material = Enum.Material.Marble,
	}, parent)
	local eggPart = newPart({
		Name = eggId .. "Egg",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(6, 6, 6),
		CFrame = CFrame.new(position + Vector3.new(0, 5.5, 0)),
		Color = egg.Color,
		Material = if egg.Currency == "Robux" then Enum.Material.Foil else Enum.Material.SmoothPlastic,
	}, parent)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(1, 1.3, 1)
	mesh.Parent = eggPart
	local light = Instance.new("PointLight")
	light.Color = egg.Color
	light.Range = 12
	light.Parent = eggPart

	local priceText
	if egg.Currency == "Robux" then
		priceText = "<font color='#7CFF8A'>R$ " .. tostring(Config.Products[egg.ProductSingle].Price) .. "</font>"
	else
		local icon = if egg.Currency == "Gems" then "💎" elseif egg.Currency == "Stardust" then "✨" else "💰"
		priceText = icon .. " " .. Util.Format(egg.Price)
	end
	billboard(eggPart, "%s\n%s", Color3.new(1, 1, 1), 6, 9, 3.4, egg.Name, priceText)
	prompt(eggPart, "Open", egg.Name, openPanel("Egg", eggId))
	if egg.Currency ~= "Robux" then
		-- quick hatch right at the stand (no menu needed)
		local quick = prompt(eggPart, "Hatch x1", egg.Name, function(player)
			Services.PetService:QuickHatch(player, eggId)
		end)
		quick.KeyboardKeyCode = Enum.KeyCode.F
		quick.HoldDuration = 0.25
		quick.UIOffset = Vector2.new(0, 70)
	end
	eggPart:SetAttribute("EggId", eggId)
	return eggPart
end

local function leaderboard(cf: CFrame, size: Vector3, key: string, title: string, parent)
	local board = newPart({
		Name = "Leaderboard_" .. key,
		Size = size,
		CFrame = cf,
		Color = Color3.fromRGB(25, 25, 35),
		Material = Enum.Material.SmoothPlastic,
	}, parent)
	local frame = newPart({
		Name = "Frame",
		Size = size + Vector3.new(1, 1, -0.4),
		CFrame = cf * CFrame.new(0, 0, 0.4),
		Color = Color3.fromRGB(255, 200, 60),
		Material = Enum.Material.Neon,
	}, parent)
	frame.CanCollide = false
	board:SetAttribute("Title", title)
	World.Boards[key] = board
	return board
end

-- big gate arch with a sign, spanning a corridor
local function arch(position: Vector3, text: string, color: Color3, parent)
	for _, side in { -1, 1 } do
		newPart({
			Name = "ArchPillar",
			Size = Vector3.new(3, 22, 3),
			CFrame = CFrame.new(position + Vector3.new(side * (CORRIDOR_W / 2 + 1.5), 11, 0)),
			Color = Color3.fromRGB(45, 45, 60),
			Material = Enum.Material.Slate,
		}, parent)
		newPart({
			Name = "ArchGlow",
			Size = Vector3.new(3.4, 1, 3.4),
			CFrame = CFrame.new(position + Vector3.new(side * (CORRIDOR_W / 2 + 1.5), 21.5, 0)),
			Color = color,
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, parent)
	end
	local beam = newPart({
		Name = "ArchBeam",
		Size = Vector3.new(CORRIDOR_W + 8, 5, 2),
		CFrame = CFrame.new(position + Vector3.new(0, 24, 0)),
		Color = Color3.fromRGB(30, 30, 44),
		Material = Enum.Material.Slate,
	}, parent)
	for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = color
		World.SetText(label, text)
		label.Parent = gui
		gui.Parent = beam
	end
end

World.SpeedPads = {}
-- neon dash pad: touching it gives a short burst of speed (see CharacterService)
local function speedPad(position: Vector3, yaw: number, parent)
	local pad = newPart({
		Name = "SpeedPad",
		Size = Vector3.new(9, 0.3, 9),
		CFrame = CFrame.new(position + Vector3.new(0, 0.16, 0)) * CFrame.Angles(0, yaw, 0),
		Color = Color3.fromRGB(60, 230, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, parent)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Text = "⏫"
	label.Parent = gui
	gui.Parent = pad
	local light = Instance.new("PointLight")
	light.Color = pad.Color
	light.Range = 12
	light.Brightness = 1.5
	light.Parent = pad
	table.insert(World.SpeedPads, pad)
	return pad
end

---------------------------------------------------------------------------
-- hub
---------------------------------------------------------------------------
local function buildHub()
	local hub = folder("Hub", map)

	newPart({
		Name = "Floor",
		Size = Vector3.new(HUB_HALF * 2, 4, HUB_HALF * 2),
		CFrame = CFrame.new(0, -2, 0),
		Color = Color3.fromRGB(110, 175, 90),
		Material = Enum.Material.Grass,
	}, hub)
	newPart({
		Name = "Path",
		Size = Vector3.new(18, 0.2, HUB_HALF * 2),
		CFrame = CFrame.new(0, 0.05, 0),
		Color = Color3.fromRGB(215, 200, 170),
		Material = Enum.Material.Cobblestone,
	}, hub)
	newPart({
		Name = "Plaza",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, 46, 46),
		CFrame = CFrame.new(0, 0.08, -25) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(225, 215, 190),
		Material = Enum.Material.Cobblestone,
	}, hub)

	local wallColor = Color3.fromRGB(120, 115, 110)
	local half = HUB_HALF
	wall(CFrame.new(-half - 1, WALL_H / 2, 0), Vector3.new(2, WALL_H, half * 2 + 4), wallColor, hub)
	wall(CFrame.new(half + 1, WALL_H / 2, 0), Vector3.new(2, WALL_H, half * 2 + 4), wallColor, hub)
	local segment = half - CORRIDOR_W / 2
	wall(CFrame.new(-(CORRIDOR_W / 2 + segment / 2), WALL_H / 2, -half - 1), Vector3.new(segment + 2, WALL_H, 2), wallColor, hub)
	wall(CFrame.new(CORRIDOR_W / 2 + segment / 2, WALL_H / 2, -half - 1), Vector3.new(segment + 2, WALL_H, 2), wallColor, hub)
	wall(CFrame.new(-(CORRIDOR_W / 2 + segment / 2), WALL_H / 2, half + 1), Vector3.new(segment + 2, WALL_H, 2), wallColor, hub)
	wall(CFrame.new(CORRIDOR_W / 2 + segment / 2, WALL_H / 2, half + 1), Vector3.new(segment + 2, WALL_H, 2), wallColor, hub)

	-- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.5, -60) * CFrame.Angles(0, math.pi, 0) -- face the mines
	spawn.Color = Color3.fromRGB(255, 220, 120)
	spawn.Material = Enum.Material.Neon
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = hub
	billboard(spawn, "%s", Color3.fromRGB(255, 230, 120), 14, 18, 4, Config.GameName)

	-- signs facing the spawn: the core hooks + "like & favorite" (algorithm signal)
	local function sign(position: Vector3, text: string, color: Color3)
		local board = newPart({
			Name = "Sign",
			Size = Vector3.new(16, 7, 0.6),
			CFrame = CFrame.new(position),
			Color = Color3.fromRGB(25, 25, 38),
			Material = Enum.Material.SmoothPlastic,
		}, hub)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 30
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.FredokaOne
		label.TextScaled = true
		label.TextColor3 = color
		World.SetText(label, text)
		label.Parent = gui
		gui.Parent = board
		for _, x in { -7.6, 7.6 } do
			newPart({
				Name = "Post",
				Size = Vector3.new(0.6, 6, 0.6),
				CFrame = CFrame.new(position + Vector3.new(x, -6, 0.4)),
				Color = Color3.fromRGB(60, 60, 70),
				Material = Enum.Material.Metal,
			}, hub)
		end
	end
	sign(Vector3.new(-18, 9, -46), "👍 LIKE + ⭐ FAVORITE\nfor new CODES & updates!", Color3.fromRGB(255, 220, 90))
	sign(Vector3.new(18, 9, -46), "☄️ Smash meteors together\n🥚 Grab a star egg & run home!", Color3.fromRGB(120, 230, 255))

	-- plaza centerpiece: star fountain (ore pays coins directly, no selling)
	newPart({
		Name = "FountainBasin",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(2, 15, 15),
		CFrame = CFrame.new(0, 1, -25) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(235, 235, 245),
		Material = Enum.Material.Marble,
	}, hub)
	newPart({
		Name = "FountainWater",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 13, 13),
		CFrame = CFrame.new(0, 2.05, -25) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(90, 190, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		CanCollide = false,
	}, hub)
	local statue = newPart({
		Name = "FountainStar",
		Size = Vector3.new(2.4, 5, 2.4),
		CFrame = CFrame.new(0, 6, -25) * CFrame.Angles(0, math.rad(45), math.rad(15)),
		Color = Color3.fromRGB(120, 220, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, hub)
	local glow = Instance.new("PointLight")
	glow.Color = statue.Color
	glow.Range = 18
	glow.Brightness = 2
	glow.Parent = statue

	-- meteor crater
	local crater = newPart({
		Name = "MeteorCrater",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 44, 44),
		CFrame = CFrame.new(Config.Meteor.Position + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(60, 45, 40),
		Material = Enum.Material.CrackedLava,
	}, hub)
	billboard(crater, "☄️ METEOR CRATER", Color3.fromRGB(255, 150, 80), 4, 14, 2.8)
	local rng = Random.new(7)
	for i = 1, 14 do
		local angle = (i / 14) * math.pi * 2
		local r = 23 + rng:NextNumber(-1, 1)
		local size = rng:NextNumber(2.5, 5)
		newPart({
			Name = "CraterRock",
			Size = Vector3.new(size, size * 0.8, size),
			CFrame = CFrame.new(Config.Meteor.Position + Vector3.new(math.cos(angle) * r, size * 0.3, math.sin(angle) * r))
				* CFrame.Angles(rng:NextNumber(0, 1), rng:NextNumber(0, 6), rng:NextNumber(0, 1)),
			Color = Color3.fromRGB(90, 80, 75),
			Material = Enum.Material.Basalt,
		}, hub)
	end

	-- shops (east)
	local shops = folder("Shops", hub)
	local pick = booth(Vector3.new(56, 0, -45), "⛏️ PICKAXES", Color3.fromRGB(255, 170, 60), shops)
	prompt(pick, "Open", "Pickaxe Shop", openPanel("Shop", "Pickaxes"))
	local rebirth = booth(Vector3.new(56, 0, 5), "♻️ REBIRTH", Color3.fromRGB(190, 90, 255), shops)
	prompt(rebirth, "Open", "Rebirth Altar", openPanel("Rebirth"))
	local store = booth(Vector3.new(56, 0, 30), "🛒 STORE", Color3.fromRGB(80, 220, 120), shops)
	prompt(store, "Open", "Store", openPanel("Store"))

	-- eggs (west)
	local eggs = folder("Eggs", hub)
	eggStand(Vector3.new(-56, 0, -45), "Meadow", eggs)
	eggStand(Vector3.new(-56, 0, -20), "Gem", eggs)
	eggStand(Vector3.new(-56, 0, 5), "Cosmic", eggs)
	eggStand(Vector3.new(-56, 0, 30), "Golden", eggs)

	-- leaderboards (facing the spawn)
	local boards = folder("Leaderboards", hub)
	local defs = Config.Leaderboards.Boards
	if defs[1] then
		leaderboard(CFrame.new(0, 27, HUB_HALF - 1), Vector3.new(30, 20, 1), defs[1].Key, defs[1].Title, boards)
	end
	if defs[2] then
		leaderboard(CFrame.new(-50, 11, HUB_HALF - 2), Vector3.new(24, 18, 1), defs[2].Key, defs[2].Title, boards)
	end
	if defs[3] then
		leaderboard(CFrame.new(50, 11, HUB_HALF - 2), Vector3.new(24, 18, 1), defs[3].Key, defs[3].Title, boards)
	end

	-- hall of fame: statues of the all-time richest players (LeaderboardService)
	local fame = folder("HallOfFame", hub)
	World.StatueSpots = {}
	for rank, spot in { { -30, 4 }, { -42, 3 }, { -18, 2.2 } } do
		local position = Vector3.new(spot[1], spot[2] / 2, -8)
		local plinth = newPart({
			Name = "Plinth" .. rank,
			Size = Vector3.new(7, spot[2], 7),
			CFrame = CFrame.lookAt(position, Vector3.new(0, position.Y, -60)),
			Color = ({ Color3.fromRGB(255, 205, 60), Color3.fromRGB(210, 215, 225), Color3.fromRGB(215, 140, 80) })[rank],
			Material = Enum.Material.Marble,
		}, fame)
		World.StatueSpots[rank] = plinth.CFrame * CFrame.new(0, spot[2] / 2, 0)
	end
	billboard(fame:FindFirstChild("Plinth1") :: BasePart, "🏆 HALL OF FAME", Color3.fromRGB(255, 220, 90), 13, 16, 3)

	-- gates: mines to the north, bases to the south
	arch(Vector3.new(0, 0, HUB_HALF - 2), "⛏️ MINES", Color3.fromRGB(255, 200, 80), hub)
	arch(Vector3.new(0, 0, -HUB_HALF + 2), "🏠 BASES", Color3.fromRGB(120, 230, 255), hub)
	-- dash pads along the main road (point toward the mines / the bases)
	speedPad(Vector3.new(0, 0, -45), 0, hub)
	speedPad(Vector3.new(0, 0, 8), 0, hub)
	speedPad(Vector3.new(0, 0, 66), 0, hub)
	speedPad(Vector3.new(0, 0, -72), math.pi, hub)

	-- decor
	for _, pos in
		{
			Vector3.new(-70, 0, -70),
			Vector3.new(70, 0, -70),
			Vector3.new(-72, 0, 62),
			Vector3.new(72, 0, 62),
			Vector3.new(-30, 0, -72),
			Vector3.new(30, 0, -72),
		}
	do
		tree(pos, hub)
	end
	for z = -60, 60, 30 do
		lamp(Vector3.new(-11, 0, z), Color3.fromRGB(255, 220, 160), hub)
		lamp(Vector3.new(11, 0, z), Color3.fromRGB(255, 220, 160), hub)
	end
end

---------------------------------------------------------------------------
-- base district (south): gardens, avenue, walls; the territories themselves
-- come from BaseService (Util.PlotLayout: two rows facing the avenue)
---------------------------------------------------------------------------
local function buildBaseDistrict()
	local district = folder("District", map)
	local bases = Config.World.Bases
	local halfX = bases.HalfX
	local length = bases.ZStart - bases.ZEnd
	local centerZ = (bases.ZStart + bases.ZEnd) / 2
	local wallColor = Color3.fromRGB(70, 72, 92)
	local base = Config.Base
	local half = base.PlotSize / 2
	local layout = base.Layout
	local avenueZ = Util.AvenueZ(Config)
	local northZ = bases.ZStart - layout.Margin - half
	local southZ = avenueZ - layout.Avenue / 2 - half

	-- corridor from the hub's south gate
	newPart({
		Name = "Corridor",
		Size = Vector3.new(CORRIDOR_W, 4, -HUB_HALF - bases.ZStart + 2),
		CFrame = CFrame.new(0, -2, (-HUB_HALF + bases.ZStart) / 2),
		Color = Color3.fromRGB(150, 140, 130),
		Material = Enum.Material.Cobblestone,
	}, district)
	for _, side in { -1, 1 } do
		wall(
			CFrame.new(side * (CORRIDOR_W / 2 + 1), WALL_H / 2, (-HUB_HALF + bases.ZStart) / 2),
			Vector3.new(2, WALL_H, -HUB_HALF - bases.ZStart + 2),
			wallColor,
			district
		)
	end

	-- soft grass everywhere between the houses
	newPart({
		Name = "Floor",
		Size = Vector3.new(halfX * 2, 4, length),
		CFrame = CFrame.new(0, -2, centerZ),
		Color = Color3.fromRGB(85, 145, 80),
		Material = Enum.Material.Grass,
	}, district)

	-- entrance lane: gate -> avenue (between the two inner houses)
	local laneLength = bases.ZStart - (avenueZ + layout.Avenue / 2)
	newPart({
		Name = "Lane",
		Size = Vector3.new(layout.EntranceGap - 6, 0.2, laneLength),
		CFrame = CFrame.new(0, 0.05, bases.ZStart - laneLength / 2),
		Color = Color3.fromRGB(205, 195, 175),
		Material = Enum.Material.Cobblestone,
	}, district)
	speedPad(Vector3.new(0, 0, bases.ZStart - 14), math.pi, district)

	-- the avenue every house faces
	newPart({
		Name = "Avenue",
		Size = Vector3.new(halfX * 2 - 6, 0.2, layout.Avenue),
		CFrame = CFrame.new(0, 0.06, avenueZ),
		Color = Color3.fromRGB(205, 195, 175),
		Material = Enum.Material.Cobblestone,
	}, district)
	for _, side in { -1, 1 } do
		newPart({
			Name = "AvenueLine",
			Size = Vector3.new(halfX * 2 - 6, 0.25, 0.6),
			CFrame = CFrame.new(0, 0.09, avenueZ + side * (layout.Avenue / 2 - 0.5)),
			Color = Color3.fromRGB(120, 230, 255),
			Material = Enum.Material.Neon,
			CanCollide = false,
		}, district)
	end
	-- dash pads pointing to the outer houses, lamps along the avenue
	for _, x in { 34, 120 } do
		speedPad(Vector3.new(x, 0, avenueZ), -math.pi / 2, district)
		speedPad(Vector3.new(-x, 0, avenueZ), math.pi / 2, district)
	end
	for x = -halfX + 20, halfX - 20, 40 do
		lamp(Vector3.new(x, 0, avenueZ - layout.Avenue / 2 - 1.5), Color3.fromRGB(255, 220, 160), district)
		lamp(Vector3.new(x, 0, avenueZ + layout.Avenue / 2 + 1.5), Color3.fromRGB(255, 220, 160), district)
	end

	-- gardens between neighbours: two staggered tree lines in every gap
	local gapX = layout.EntranceGap / 2 + half * 2 + layout.Gap / 2
	for _, rowZ in { northZ, southZ } do
		for _, x in { -gapX, gapX } do
			for dz = -half + 6, half - 6, 13 do
				tree(Vector3.new(x - 9, 0, rowZ + dz), district, 1.1)
				tree(Vector3.new(x + 9, 0, rowZ + dz + 6), district, 1.1)
			end
		end
	end
	-- and along the outer edges of the far houses
	local outerX = layout.EntranceGap / 2 + half * 4 + layout.Gap + 8
	for _, rowZ in { northZ, southZ } do
		for _, x in { -outerX, outerX } do
			for dz = -half + 8, half - 8, 16 do
				tree(Vector3.new(x, 0, rowZ + dz), district, 1.2)
			end
		end
	end

	-- a little park between the far houses
	newPart({
		Name = "Park",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, layout.EntranceGap - 6, layout.EntranceGap - 6),
		CFrame = CFrame.new(0, 0.07, southZ) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(215, 205, 180),
		Material = Enum.Material.Cobblestone,
	}, district)
	newPart({
		Name = "ParkFountain",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.6, 12, 12),
		CFrame = CFrame.new(0, 0.8, southZ) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(235, 235, 245),
		Material = Enum.Material.Marble,
	}, district)
	newPart({
		Name = "ParkWater",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 10.5, 10.5),
		CFrame = CFrame.new(0, 1.65, southZ) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(90, 190, 255),
		Material = Enum.Material.Glass,
		Transparency = 0.25,
		CanCollide = false,
	}, district)
	local parkStar = newPart({
		Name = "ParkStar",
		Size = Vector3.new(1.8, 3.6, 1.8),
		CFrame = CFrame.new(0, 4.4, southZ) * CFrame.Angles(0, math.rad(45), math.rad(15)),
		Color = Color3.fromRGB(255, 210, 110),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}, district)
	local glow = Instance.new("PointLight")
	glow.Color = parkStar.Color
	glow.Range = 16
	glow.Brightness = 1.5
	glow.Parent = parkStar
	for _, corner in { { -14, -14 }, { 14, -14 }, { -14, 14 }, { 14, 14 } } do
		tree(Vector3.new(corner[1], 0, southZ + corner[2]), district)
	end

	-- walls around the district (gap for the corridor)
	for _, side in { -1, 1 } do
		wall(CFrame.new(side * (halfX + 1), WALL_H / 2, centerZ), Vector3.new(2, WALL_H, length + 2), wallColor, district)
		local segment = halfX - CORRIDOR_W / 2
		wall(
			CFrame.new(side * (CORRIDOR_W / 2 + segment / 2), WALL_H / 2, bases.ZStart + 1),
			Vector3.new(segment + 2, WALL_H, 2),
			wallColor,
			district
		)
	end
	wall(CFrame.new(0, WALL_H / 2, bases.ZEnd - 1), Vector3.new(halfX * 2 + 4, WALL_H, 2), wallColor, district)

	-- twinkling stars above the district (it's where the pets live)
	local sky = newPart({
		Name = "Ambience",
		Size = Vector3.new(halfX * 2, 1, length),
		CFrame = CFrame.new(0, 26, centerZ),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, district)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(150, 220, 255))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new(0.35)
	emitter.Lifetime = NumberRange.new(3, 5)
	emitter.Rate = 24
	emitter.Speed = NumberRange.new(0.3, 1)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = sky
end

---------------------------------------------------------------------------
-- zones
---------------------------------------------------------------------------
local function buildZones()
	local zonesFolder = folder("Zones", map)
	local gates = folder("Gates", map)
	local wallColor = Color3.fromRGB(95, 90, 90)

	-- corridor from the hub into zone 1
	newPart({
		Name = "Corridor",
		Size = Vector3.new(CORRIDOR_W, 4, GAP + 2),
		CFrame = CFrame.new(0, -2, HUB_HALF + GAP / 2),
		Color = Color3.fromRGB(150, 140, 130),
		Material = Enum.Material.Cobblestone,
	}, zonesFolder)
	for _, side in { -1, 1 } do
		wall(
			CFrame.new(side * (CORRIDOR_W / 2 + 1), WALL_H / 2, HUB_HALF + GAP / 2),
			Vector3.new(2, WALL_H, GAP + 2),
			wallColor,
			zonesFolder
		)
	end

	for index, zone in Config.Zones do
		local zStart = World.ZoneStart(index)
		local zEnd = zStart + ZONE_L
		local zf = folder(string.format("%d_%s", index, zone.Name), zonesFolder)
		local isLast = index == #Config.Zones

		newPart({
			Name = "Floor",
			Size = Vector3.new(ZONE_W, 4, ZONE_L),
			CFrame = CFrame.new(0, -2, zStart + ZONE_L / 2),
			Color = zone.FloorColor,
			Material = zone.Floor,
		}, zf)

		local color = wallColor:Lerp(zone.Accent, 0.25)
		wall(CFrame.new(-ZONE_W / 2 - 1, WALL_H / 2, zStart + ZONE_L / 2), Vector3.new(2, WALL_H, ZONE_L + 2), color, zf)
		wall(CFrame.new(ZONE_W / 2 + 1, WALL_H / 2, zStart + ZONE_L / 2), Vector3.new(2, WALL_H, ZONE_L + 2), color, zf)
		local seg = ZONE_W / 2 - CORRIDOR_W / 2
		for _, side in { -1, 1 } do
			wall(CFrame.new(side * (CORRIDOR_W / 2 + seg / 2), WALL_H / 2, zStart - 1), Vector3.new(seg + 2, WALL_H, 2), color, zf)
			if not isLast then
				wall(CFrame.new(side * (CORRIDOR_W / 2 + seg / 2), WALL_H / 2, zEnd + 1), Vector3.new(seg + 2, WALL_H, 2), color, zf)
			end
		end
		if isLast then
			wall(CFrame.new(0, WALL_H / 2, zEnd + 1), Vector3.new(ZONE_W + 4, WALL_H, 2), color, zf)
		else
			newPart({
				Name = "Corridor",
				Size = Vector3.new(CORRIDOR_W, 4, GAP + 2),
				CFrame = CFrame.new(0, -2, zEnd + GAP / 2),
				Color = Color3.fromRGB(120, 115, 110),
				Material = Enum.Material.Cobblestone,
			}, zf)
			for _, side in { -1, 1 } do
				wall(CFrame.new(side * (CORRIDOR_W / 2 + 1), WALL_H / 2, zEnd + GAP / 2), Vector3.new(2, WALL_H, GAP + 2), color, zf)
			end
		end

		-- accent lights in the corners
		for _, pos in
			{ Vector3.new(-44, 0, zStart + 6), Vector3.new(44, 0, zStart + 6), Vector3.new(-44, 0, zEnd - 6), Vector3.new(44, 0, zEnd - 6) }
		do
			lamp(pos, zone.Accent, zf)
		end

		-- ambient particles: every zone has its own mood
		local mood = AMBIENCE[index]
		if mood then
			local emitterPart = newPart({
				Name = "Ambience",
				Size = Vector3.new(ZONE_W - 4, 1, ZONE_L - 4),
				CFrame = CFrame.new(0, mood.Height, zStart + ZONE_L / 2),
				Transparency = 1,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
			}, zf)
			local emitter = Instance.new("ParticleEmitter")
			emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			emitter.Color = ColorSequence.new(mood.Color)
			emitter.LightEmission = mood.Light
			emitter.Size = NumberSequence.new(mood.Size)
			emitter.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.2, 0.15),
				NumberSequenceKeypoint.new(0.8, 0.3),
				NumberSequenceKeypoint.new(1, 1),
			})
			emitter.Lifetime = NumberRange.new(mood.Life[1], mood.Life[2])
			emitter.Rate = mood.Rate
			emitter.Speed = NumberRange.new(mood.Speed[1], mood.Speed[2])
			emitter.Acceleration = mood.Acceleration
			emitter.EmissionDirection = mood.Direction
			emitter.SpreadAngle = Vector2.new(25, 25)
			emitter.Parent = emitterPart
		end

		-- glowing crystal clusters along the walls
		local crystalRng = Random.new(500 + index)
		for i = 1, 8 do
			local side = if i % 2 == 0 then 1 else -1
			local base = Vector3.new(side * 47, 0, zStart + 10 + (i - 1) * 11)
			for _ = 1, 3 do
				local height = crystalRng:NextNumber(3, 7)
				newPart({
					Name = "WallCrystal",
					Size = Vector3.new(1.4, height, 1.4),
					CFrame = CFrame.new(
						base + Vector3.new(crystalRng:NextNumber(-1.5, 1.5), height / 2 - 0.5, crystalRng:NextNumber(-1.5, 1.5))
					)
						* CFrame.Angles(crystalRng:NextNumber(-0.35, 0.35), crystalRng:NextNumber(0, 3), crystalRng:NextNumber(-0.35, 0.35)),
					Color = zone.Accent,
					Material = Enum.Material.Neon,
					Transparency = 0.15,
					CanCollide = false,
					CanQuery = false,
					CastShadow = false,
				}, zf)
			end
		end

		-- floating zone title
		local titleAnchor = newPart({
			Name = "TitleAnchor",
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.new(0, 20, zStart + 4),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
		}, zf)
		if zone.PvP then
			billboard(
				titleAnchor,
				"%s\n<font color='#FF5A7A'>⚔️ PVP ZONE - bonk players to steal ore!</font>",
				zone.Accent,
				0,
				30,
				7,
				zone.Name
			)
		else
			billboard(titleAnchor, "%s", zone.Accent, 0, 26, 4, zone.Name)
		end

		World.Zones[index] = {
			ZStart = zStart,
			ZEnd = zEnd,
			Spawn = CFrame.new(0, 4, zStart + 6),
			Name = zone.Name,
		}
		if zone.PvP then
			World.PvPZone = index
		end

		-- gate (zone 2+)
		if index > 1 then
			local gate = newPart({
				Name = "Gate_" .. index,
				Size = Vector3.new(CORRIDOR_W, WALL_H, 1),
				CFrame = CFrame.new(0, WALL_H / 2, zStart - GAP / 2),
				Color = zone.Accent,
				Material = Enum.Material.ForceField,
				Transparency = 0.1,
			}, gates)
			gate:SetAttribute("ZoneIndex", index)
			local gateLabel = billboard(gate, "🔒 %s\n💰 %s", Color3.new(1, 1, 1), -1, 14, 4.2, zone.Name, Util.Format(zone.Cost))
			gateLabel.StudsOffsetWorldSpace = Vector3.new(0, -1, -2) -- in front of the forcefield, facing the approach
			prompt(gate, "Unlock", zone.Name, function(player)
				Services.EconomyService:UnlockZone(player, index)
			end).MaxActivationDistance =
				14
			World.Zones[index].Gate = gate
		end

		-- zone egg
		for eggId, egg in Config.Eggs do
			if egg.Zone == index and index > 1 then
				eggStand(Vector3.new(-28, 0, zStart + 6), eggId, zf)
			end
		end

		-- ore slots: natural clusters (veins) with paths between them, instead
		-- of a dense grid of blocks
		local slots = {}
		local rng = Random.new(1000 + index)
		local half = Config.World.OreSize / 2
		local minGap = Config.World.OreSpacing
		local function free(position: Vector3): boolean
			if math.abs(position.X) < 6 or math.abs(position.X) > ZONE_W / 2 - 7 then
				return false
			end
			if position.Z < zStart + 16 or position.Z > zEnd - 7 then
				return false
			end
			for _, other in slots do
				if (other.Position - position).Magnitude < minGap then
					return false
				end
			end
			return true
		end
		for _ = 1, Config.World.OreClusters do
			local center = Vector3.new(rng:NextNumber(-34, 34), half, rng:NextNumber(zStart + 24, zEnd - 14))
			local placed = 0
			for _ = 1, 24 do
				local angle = rng:NextNumber(0, math.pi * 2)
				local position = center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * rng:NextNumber(0, 13)
				if placed < 8 and free(position) then
					placed += 1
					table.insert(slots, { Zone = index, Position = position })
				end
			end
		end
		World.OreSlots[index] = slots
	end
end

---------------------------------------------------------------------------
-- 🌄 landscape: real terrain instead of flat plates - grass / snow / basalt /
-- slate / lava ground, rocky cliffs instead of walls, hills on the horizon
---------------------------------------------------------------------------
local TERRAIN = {
	[Enum.Material.Grass] = Enum.Material.Grass,
	[Enum.Material.LeafyGrass] = Enum.Material.LeafyGrass,
	[Enum.Material.Snow] = Enum.Material.Snow,
	[Enum.Material.Ice] = Enum.Material.Glacier,
	[Enum.Material.Basalt] = Enum.Material.Basalt,
	[Enum.Material.Slate] = Enum.Material.Slate,
	[Enum.Material.CrackedLava] = Enum.Material.CrackedLava,
	[Enum.Material.Cobblestone] = Enum.Material.Cobblestone,
	[Enum.Material.Sand] = Enum.Material.Sand,
	[Enum.Material.Rock] = Enum.Material.Rock,
	[Enum.Material.Ground] = Enum.Material.Ground,
	[Enum.Material.Pavement] = Enum.Material.Pavement,
}
-- cliff rock per zone (hub = grassy rock)
local CLIFF = {
	[0] = { Rock = Enum.Material.Rock, Top = Enum.Material.Grass },
	[1] = { Rock = Enum.Material.Rock, Top = Enum.Material.Grass },
	[2] = { Rock = Enum.Material.Glacier, Top = Enum.Material.Snow },
	[3] = { Rock = Enum.Material.Basalt, Top = Enum.Material.CrackedLava },
	[4] = { Rock = Enum.Material.Slate, Top = Enum.Material.Slate },
	[5] = { Rock = Enum.Material.Basalt, Top = Enum.Material.Rock },
}

local function landscape()
	local terrain = workspace.Terrain
	local rng = Random.new(2024)
	pcall(function()
		terrain.Decoration = true -- (animated grass where supported)
	end)
	pcall(function()
		terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(106, 170, 82))
		terrain:SetMaterialColor(Enum.Material.LeafyGrass, Color3.fromRGB(96, 156, 74))
		terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(128, 122, 114))
		terrain:SetMaterialColor(Enum.Material.Ground, Color3.fromRGB(122, 96, 70))
		terrain:SetMaterialColor(Enum.Material.Cobblestone, Color3.fromRGB(186, 172, 150))
	end)
	if not terrain:FindFirstChildOfClass("Clouds") then
		local clouds = Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Color = Color3.fromRGB(255, 255, 255)
		clouds.Parent = terrain
	end

	local function zoneOf(position: Vector3): number
		return Util.ZoneAt(Config, Vector3.new(position.X, 3, position.Z)) or 0
	end

	-- floors and corridors become terrain (the parts stay as invisible floors)
	for _, part in map:GetDescendants() do
		if part:IsA("BasePart") and (part.Name == "Floor" or part.Name == "Corridor") and part.Size.Y >= 2 then
			local material = TERRAIN[part.Material] or Enum.Material.Ground
			-- (a hair lower, so paths / plazas lying on the floor stay visible)
			terrain:FillBlock(part.CFrame * CFrame.new(0, -0.3, 0), part.Size, material)
			terrain:FillBlock(
				part.CFrame * CFrame.new(0, -part.Size.Y / 2 - 4, 0),
				Vector3.new(part.Size.X, 8, part.Size.Z),
				Enum.Material.Rock
			)
			part.Transparency = 1
		end
	end

	-- walls become rocky cliffs (the wall parts stay as invisible borders)
	for _, part in map:GetDescendants() do
		if part:IsA("BasePart") and part.Name == "Wall" then
			local cliff = CLIFF[zoneOf(part.Position)] or CLIFF[0]
			local size = part.Size
			local long = if size.X >= size.Z then Vector3.xAxis else Vector3.zAxis
			local length = math.max(size.X, size.Z)
			local height = size.Y + 6
			terrain:FillBlock(
				CFrame.new(part.Position + Vector3.new(0, 3, 0)),
				Vector3.new(math.max(size.X, 8), height, math.max(size.Z, 8)),
				cliff.Rock
			)
			-- an uneven top: boulders along the ridge
			for d = -length / 2, length / 2, 9 do
				local center = part.Position + long * (d + rng:NextNumber(-2, 2)) + Vector3.new(0, size.Y / 2 + rng:NextNumber(2, 6), 0)
				terrain:FillBall(center, rng:NextNumber(5, 8), cliff.Rock)
				if rng:NextNumber() < 0.5 then
					terrain:FillBall(center + Vector3.new(0, 3, 0), rng:NextNumber(3, 5), cliff.Top)
				end
			end
			part.Transparency = 1
		end
	end

	-- the horizon: rolling grassy hills around the hub and the homes
	local layout = Config.World.Layout
	local half = layout.HubHalf
	for _ = 1, 26 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = half + rng:NextNumber(30, 70)
		local center = Vector3.new(math.cos(angle) * distance, rng:NextNumber(-10, 4), math.sin(angle) * distance)
		if math.abs(center.X) > layout.ZoneWidth / 2 + 20 or center.Z < 0 then
			terrain:FillBall(center, rng:NextNumber(24, 40), Enum.Material.Grass)
		end
	end
	local bases = Config.World.Bases
	for x = -bases.HalfX - 30, bases.HalfX + 30, 45 do
		terrain:FillBall(Vector3.new(x, -8, bases.ZEnd - 40 - rng:NextNumber(0, 20)), rng:NextNumber(26, 40), Enum.Material.Grass)
	end
	for _, side in { -1, 1 } do
		for z = bases.ZStart - 20, bases.ZEnd, -45 do
			terrain:FillBall(
				Vector3.new(side * (bases.HalfX + 40 + rng:NextNumber(0, 15)), -8, z),
				rng:NextNumber(26, 38),
				Enum.Material.Grass
			)
		end
	end
	-- low grassy mounds in the gardens between homes (estates, not a grid)
	local baseLayout = Config.Base.Layout
	local plotHalf = Config.Base.PlotSize / 2
	local avenueZ = Util.AvenueZ(Config)
	local northZ = bases.ZStart - baseLayout.Margin - plotHalf
	local southZ = avenueZ - baseLayout.Avenue / 2 - plotHalf
	local gapX = baseLayout.EntranceGap / 2 + plotHalf * 2 + baseLayout.Gap / 2
	for _, rowZ in { northZ, southZ } do
		for _, x in { -gapX, gapX } do
			for dz = -plotHalf + 4, plotHalf - 4, 10 do
				terrain:FillBall(Vector3.new(x + rng:NextNumber(-3, 3), -3.5, rowZ + dz), rng:NextNumber(6, 8), Enum.Material.Grass)
			end
		end
	end
	-- mines: rock spires beyond the cliffs
	for index in Config.Zones do
		local info = World.Zones[index]
		local cliff = CLIFF[index] or CLIFF[0]
		if info then
			for _, side in { -1, 1 } do
				for z = info.ZStart + 10, info.ZEnd - 10, 22 do
					local center = Vector3.new(side * (layout.ZoneWidth / 2 + rng:NextNumber(14, 26)), rng:NextNumber(4, 14), z)
					terrain:FillBall(center, rng:NextNumber(10, 16), cliff.Rock)
				end
			end
		end
	end
	-- trees on the hills outside the hub
	local nature = folder("Nature", map)
	for _ = 1, 40 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = half + rng:NextNumber(8, 40)
		local position = Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		if math.abs(position.X) > CORRIDOR_W and math.abs(position.X) < half + 60 and position.Z > -half - 4 then
			local hit = workspace:Raycast(position + Vector3.new(0, 80, 0), Vector3.new(0, -160, 0))
			if hit and hit.Instance == terrain then
				tree(hit.Position - Vector3.new(0, 0.5, 0), nature, rng:NextNumber(1, 1.5))
			end
		end
	end
end

local function setupLighting()
	Lighting.ClockTime = 14.5
	-- (tuned for phones: bright and colourful but nothing glares - white
	-- pets / marble / gold must stay readable in the sun)
	Lighting.Brightness = 1.9
	Lighting.ExposureCompensation = -0.15
	Lighting.GlobalShadows = true
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 140, 150)
	Lighting.Ambient = Color3.fromRGB(70, 70, 80)

	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Haze = 0.5
	atmosphere.Color = Color3.fromRGB(200, 215, 255)
	atmosphere.Decay = Color3.fromRGB(120, 110, 160)
	atmosphere.Parent = Lighting

	local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect")
	bloom.Intensity = 0.3
	bloom.Size = 18
	bloom.Threshold = 2 -- only real light sources glow, not white surfaces
	bloom.Parent = Lighting

	local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.22
	cc.Contrast = 0.08
	cc.Parent = Lighting

	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
	rays.Intensity = 0.03
	rays.Spread = 0.6
	rays.Parent = Lighting

	-- shinier materials (metal ores, neon, glass) without extra parts
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.45 -- (foil / gold reflections were blinding)
end

function World:Init(services)
	Services = services
	local old = workspace:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	buildHub()
	buildBaseDistrict()
	buildZones()
	folder("Ores", map)
	folder("Drops", map)
	folder("Shards", map)
	folder("Bases", map)
	map.Parent = workspace
	setupLighting()
	local ok, err = pcall(landscape)
	if not ok then
		warn("[World] landscape failed: " .. tostring(err))
	end
end

function World:Folder(name: string): Folder
	return map:FindFirstChild(name) :: Folder
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="37">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="38">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="39">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="40">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Ambience</string>
              <string name="Source"><![CDATA[--[[
	Zone ambience: entering a zone tints the screen to its mood, shows a big
	zone title (sense of progress/exploration) and switches background music
	if you set music ids in Config.Music.
]]
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local Lib = require(Client.UI.Lib)
local State = require(Client.State)
local Root = require(Client.UI.Root)

local player = Players.LocalPlayer

local MOODS = {
	[0] = { Title = "🏠 HUB", Tint = Color3.fromRGB(255, 255, 255) },
	[1] = { Title = "🌿 MEADOW MINE", Tint = Color3.fromRGB(245, 255, 235) },
	[2] = { Title = "❄️ FROST CAVERN", Tint = Color3.fromRGB(215, 235, 255) },
	[3] = { Title = "🔥 LAVA DEPTHS", Tint = Color3.fromRGB(255, 222, 200) },
	[4] = { Title = "🔮 CRYSTAL VOID", Tint = Color3.fromRGB(232, 215, 255) },
	[5] = { Title = "⚔️ STAR CRATER", Tint = Color3.fromRGB(255, 210, 232) },
	[-2] = { Title = "🏠 BASES", Tint = Color3.fromRGB(225, 235, 255) }, -- base district
}

local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "ZoneTint"
tint.Parent = Lighting

-- big zone title
local cluster = Root.Cluster("ZoneTitle", Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.22), UDim2.fromOffset(600, 80))
local title = Lib.Text({ Text = "", Size = UDim2.fromScale(1, 1), MaxTextSize = 60, Visible = false, Parent = cluster })
local titleToken = 0
local function showTitle(text: string, color: Color3)
	titleToken += 1
	local token = titleToken
	title.Text = text
	title.TextColor3 = color
	title.TextTransparency = 0
	title.Visible = true
	Lib.Pop(title)
	task.delay(1.8, function()
		if token ~= titleToken then
			return
		end
		local tween = TweenService:Create(title, TweenInfo.new(0.6), { TextTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		if token == titleToken then
			title.Visible = false
		end
	end)
end

-- background music: two players that crossfade, a track for every situation
-- (meteor fight > party > Thief Night > carrying a stolen pet / star >
-- your own house > the base avenue > hub > mines > deep mines). Big
-- fanfares duck the music for a moment (Lib.DuckMusic).
local musicGroup = Instance.new("SoundGroup")
musicGroup.Name = "Music"
musicGroup.Volume = 1
musicGroup.Parent = SoundService
local players = {}
for i = 1, 2 do
	local sound = Instance.new("Sound")
	sound.Name = "BGM" .. i
	sound.Looped = true
	sound.Volume = 0
	sound.SoundGroup = musicGroup
	sound.Parent = musicGroup
	players[i] = sound
end
local active = 1
local currentTrack = ""
local duckUntil = 0
local MUSIC = Config.Music

local function targetVolume(): number
	if Lib.MusicOff then
		return 0
	end
	local volume = MUSIC.Volume or 0.3
	if os.clock() < duckUntil then
		volume *= 0.25
	end
	return volume
end

local function playTrack(id: string)
	if id == currentTrack then
		return
	end
	currentTrack = id
	local old = players[active]
	active = 3 - active
	local nextSound = players[active]
	TweenService:Create(old, TweenInfo.new(1.2), { Volume = 0 }):Play()
	task.delay(1.3, function()
		if players[active] ~= old then
			old:Stop()
		end
	end)
	if id == "" then
		return
	end
	nextSound.SoundId = id
	nextSound.TimePosition = 0
	nextSound.Volume = 0
	nextSound:Play()
	TweenService:Create(nextSound, TweenInfo.new(1.5), { Volume = targetVolume() }):Play()
end

-- big moments: the music steps back so the fanfare shines
Lib.DuckMusic = function(seconds: number)
	duckUntil = math.max(duckUntil, os.clock() + seconds)
	local sound = players[active]
	TweenService:Create(sound, TweenInfo.new(0.25), { Volume = targetVolume() }):Play()
	task.delay(seconds + 0.05, function()
		if os.clock() >= duckUntil then
			TweenService:Create(players[active], TweenInfo.new(1), { Volume = targetVolume() }):Play()
		end
	end)
end

-- (Settings toggles music on/off)
function Lib.SetMusic(on: boolean)
	Lib.MusicOff = not on
	TweenService:Create(players[active], TweenInfo.new(0.5), { Volume = targetVolume() }):Play()
end

-- remembered sound / music settings
local appliedSettings = false
State.OnChanged(function()
	local settings = State.Data and State.Data.Settings
	if settings and not appliedSettings then
		appliedSettings = true
		Lib.Muted = settings.Sfx == false
		Lib.SetMusic(settings.Music ~= false)
	end
end)

local function inOwnPlot(position: Vector3): boolean
	local index = player:GetAttribute("BaseIndex")
	local map = workspace:FindFirstChild("Map")
	local plot = index and map and map:FindFirstChild("Bases") and map.Bases:FindFirstChild("Plot_" .. tostring(index))
	local floor = plot and plot:FindFirstChild("Floor")
	if not floor or not floor:IsA("BasePart") then
		return false
	end
	local p = floor.CFrame:PointToObjectSpace(position)
	local half = Config.Base.PlotSize / 2
	return math.abs(p.X) <= half and math.abs(p.Z) <= half
end

local currentZone = -1

local function wantedTrack(position: Vector3): string
	local now = workspace:GetServerTimeNow()
	local meteor = workspace:GetAttribute("MeteorState")
	if meteor == "Active" or meteor == "Falling" then
		return MUSIC.Meteor
	end
	if meteor == "Warning" then
		return MUSIC.Chase -- (the rush to the landing spot)
	end
	-- carrying any star egg home: chase music (you can be bonked!)
	if player:GetAttribute("Carrying") ~= nil then
		return MUSIC.Chase
	end
	if (workspace:GetAttribute("PartyEnd") or 0) > now then
		return MUSIC.Party
	end
	if workspace:GetAttribute("EventId") == "ThiefNight" then
		return MUSIC.Night
	end
	if currentZone == -2 then
		return if inOwnPlot(position) then MUSIC.Home else MUSIC.Bases
	end
	if currentZone == 0 then
		return MUSIC.Hub
	end
	return if (currentZone or 1) >= 4 then MUSIC.DeepMine else MUSIC.Mine
end

task.spawn(function()
	while true do
		task.wait(0.5)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart
		if root then
			local zone = Util.ZoneAt(Config, root.Position)
			if zone == 0 and Util.InBases(Config, root.Position) then
				zone = -2
			end
			if zone and zone ~= currentZone then
				local first = currentZone == -1
				currentZone = zone
				local mood = MOODS[zone] or MOODS[0]
				TweenService:Create(tint, TweenInfo.new(1.2), { TintColor = mood.Tint }):Play()
				if not first then
					local zoneConfig = Config.Zones[zone]
					showTitle(Lib.T(mood.Title), if zoneConfig then zoneConfig.Accent else Color3.fromRGB(255, 230, 120))
				end
			end
			local ok, track = pcall(wantedTrack, root.Position)
			if ok then
				playTrack(track or "")
			end
		end
	end
end)

return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Build</string>
              <string name="Source"><![CDATA[--[[
	Build mode: decorate your own base.
	* Stand in your base -> tap "🔨 DECORATE".
	* The camera looks down on your base. Pick an item from the catalog,
	  tap the floor to move the preview (green = OK, red = blocked),
	  🔄 rotate, ✅ place. Placing again keeps the same item selected, so
	  floors and fences are quick to lay out.
	* Tap something you already placed to ✋ move, 🔄 rotate, 🎨 paint or
	  🗑 remove it (removing refunds everything, so redecorating is free).
	* 🏠 House tab: expand the land (house level), name your house, pick a
	  wall skin and see your decoration sets (complete one = bonus income).
	The server re-validates every action (BaseService).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local DecorModel = require(Shared.DecorModel)

local Client = script.Parent.Parent
local Net = require(Client.Net)
local State = require(Client.State)
local Lib = require(Client.UI.Lib)
local Root = require(Client.UI.Root)
local Upsell = require(Client.UI.Upsell)

local player = Players.LocalPlayer
local C = Lib.Colors
local New = Lib.New
local T = Lib.T

local Build = {}
local SETTINGS = Config.Base
local PLOT_HALF = SETTINGS.PlotSize / 2
local FLOOR_Y = 0.42

State.BuildMode = false

---------------------------------------------------------------------------
-- plot helpers
---------------------------------------------------------------------------
local function myPlot(): Model?
	local index = player:GetAttribute("BaseIndex")
	local map = workspace:FindFirstChild("Map")
	local bases = map and map:FindFirstChild("Bases")
	local plot = index and bases and bases:FindFirstChild("Plot_" .. tostring(index))
	if plot and plot:GetAttribute("OwnerId") == player.UserId then
		return plot :: Model
	end
	return nil
end

local function plotFrame(plot: Model): CFrame?
	local floor = plot:FindFirstChild("Floor")
	return if floor and floor:IsA("BasePart") then floor.CFrame * CFrame.new(0, -0.2, 0) else nil
end

local function insideMyPlot(): boolean
	local plot = myPlot()
	local frame = plot and plotFrame(plot)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not frame or not root or not root:IsA("BasePart") then
		return false
	end
	local p = frame:PointToObjectSpace(root.Position)
	return math.abs(p.X) <= PLOT_HALF + 1 and math.abs(p.Z) <= PLOT_HALF + 1
end

local function items()
	local data = State.Data
	return if data and data.Base then data.Base.Items else {}
end

local function houseLevel(): number
	return Util.HouseLevel(Config, State.Data)
end

local function validateOpts()
	return { Level = houseLevel(), Vaults = Util.VaultLimit(Config, State.Data, State.HasPass("VIP")) }
end

local function findItem(uid: number)
	for _, item in items() do
		if item.Uid == uid then
			return item
		end
	end
	return nil
end

local function priceText(id: string): string
	local currency, price = DecorModel.Price(Config, id, items())
	if price <= 0 then
		return T("FREE")
	elseif price == math.huge then
		return T("MAX")
	end
	return (if currency == "Gems" then "💎 " else "💰 ") .. Util.Format(price)
end

local function canAfford(id: string): boolean
	local data = State.Data
	if not data then
		return false
	end
	local currency, price = DecorModel.Price(Config, id, items())
	return (if currency == "Gems" then data.Gems else data.Coins) >= price
end

