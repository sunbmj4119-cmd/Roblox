Config.SeasonTiers = {}
for tier = 1, 30 do
	local free, premium
	if tier % 5 == 0 then
		free = { Gems = math.floor(25 * tier / 5) * 2 }
		premium = { Gems = math.floor(60 * tier / 5) * 2 }
	elseif tier % 3 == 0 then
		free = { Boost = { "Coins2x", 600 } }
		premium = { Stardust = 100 + tier * 10 }
	else
		free = { Gems = 10 }
		premium = { Gems = 30 }
	end
	Config.SeasonTiers[tier] = { Free = free, Premium = premium }
end
