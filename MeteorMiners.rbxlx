-- generic catalog card -----------------------------------------------------
local function makeCard(order: number, icon: string, name: string, onClick)
	local button = New("TextButton", {
		AutoButtonColor = true,
		BackgroundColor3 = C.Card,
		Size = UDim2.fromOffset(112, 112),
		LayoutOrder = order,
		Text = "",
		Parent = cardScroll,
	}, { Lib.Corner(12), Lib.Stroke(Color3.new(0, 0, 0), 2, 0.4) })
	Lib.Text({ Text = icon, Size = UDim2.new(1, 0, 0, 46), Position = UDim2.fromOffset(0, 6), MaxTextSize = 40, Parent = button })
	local title =
		Lib.Text({ Text = name, Size = UDim2.new(1, -8, 0, 26), Position = UDim2.fromOffset(4, 52), MaxTextSize = 15, Parent = button })
	local price = Lib.Text({
		Text = "",
		TextColor3 = C.Coins,
		Size = UDim2.new(1, -8, 0, 22),
		Position = UDim2.fromOffset(4, 82),
		MaxTextSize = 16,
		Parent = button,
	})
	local count = Lib.Text({
		Text = "",
		Font = Lib.BodyFont,
		TextColor3 = C.Sub,
		Size = UDim2.fromOffset(48, 16),
		Position = UDim2.new(1, -52, 0, 4),
		MaxTextSize = 12,
		Parent = button,
	})
	button.Activated:Connect(function()
		Lib.PlaySound("UI")
		onClick()
	end)
	return { Button = button, Price = price, Count = count, Title = title }
end

local function itemLimit(id: string): number?
	local def = Config.Decor[id]
	if def.Function == "Pedestal" then
		return SETTINGS.MaxPedestals
	elseif def.Function == "Vault" then
		return validateOpts().Vaults
	end
	return def.Limit
end

local function refreshHouse()
	local data = State.Data
	if not data then
		return
	end
	local level = houseLevel()
	local base = data.Base
	for _, entry in houseCards do
		local kind, card, def = entry.Kind, entry.Card, entry.Def
		if kind == "Expand" then
			local nextDef = SETTINGS.Levels[level + 1]
			card.Title.Text = if nextDef then T(nextDef.Name) else T(Util.HouseDef(Config, level).Name)
			card.Count.Text = "Lv." .. level
			if nextDef then
				card.Price.Text = "💰 " .. Util.Format(nextDef.Cost)
				card.Button.BackgroundColor3 = if data.Coins >= nextDef.Cost
					then Color3.fromRGB(60, 110, 60)
					else Color3.fromRGB(60, 40, 50)
			else
				card.Price.Text = T("MAX")
				card.Button.BackgroundColor3 = C.Card
			end
		elseif kind == "Name" then
			card.Price.Text = if base.Name ~= "" then base.Name else T("tap to name")
			card.Price.TextColor3 = C.Sub
		elseif kind == "Roof" then
			local color = Config.Paint[tonumber(base.Roof) or 0]
			card.Price.Text = if color then "■■■" else T("Auto")
			card.Price.TextColor3 = color or C.Sub
		elseif kind == "Tidy" then
			card.Price.Text = T("one tap")
			card.Price.TextColor3 = C.Sub
		elseif kind == "Skin" then
			local owned = def.Id == "Auto" or base.Skins[def.Id] == true
			local active = (base.Skin or "Auto") == def.Id
			local text
			if active then
				text = T("✅ ON")
			elseif owned then
				text = T("Use")
			elseif def.Gems then
				text = "💎 " .. Util.Format(def.Gems)
			elseif def.Pass then
				text = if State.HasPass(def.Pass) then T("Use") else "👑 VIP"
			elseif def.Level then
				text = if level >= def.Level then T("Use") else T("🔒 Lv.%d", def.Level)
			elseif def.Product then
				text = "R$ " .. tostring(Lib.Price("Product", def.Product))
			end
			card.Price.Text = text or ""
			card.Price.TextColor3 = if active then C.Green else C.Coins
			card.Button.BackgroundColor3 = if active then Color3.fromRGB(40, 90, 60) else C.Card
		elseif kind == "Set" then
			local have = {}
			for _, item in base.Items do
				have[item.Id] = true
			end
			local got = 0
			for _, id in def.Items do
				if have[id] then
					got += 1
				end
			end
			card.Count.Text = string.format("%d/%d", got, #def.Items)
			card.Price.Text = "+" .. math.floor(def.Bonus * 100 + 0.5) .. "% 💰"
			card.Price.TextColor3 = if got >= #def.Items then C.Green else C.Sub
			card.Button.BackgroundColor3 = if got >= #def.Items then Color3.fromRGB(40, 90, 60) else C.Card
		end
	end
end

local function buildHouseCards()
	houseCards = {}
	local order = 0
	local function add(kind: string, card, def)
		table.insert(houseCards, { Kind = kind, Card = card, Def = def })
	end
	order += 1
	add(
		"Expand",
		makeCard(order, "🏗️", "Expand", function()
			task.spawn(function()
				local ok, message = Net.Invoke("HouseUpgrade")
				local hud = Build.HUD
				if ok then
					Lib.PlaySound("Build")
					Lib.PlaySound("Success")
					task.delay(0.3, function()
						Build.Refocus()
					end)
				elseif type(message) == "string" and hud then
					hud.Toast(message, C.Red)
				end
			end)
		end)
	)
	order += 1
	add(
		"Tidy",
		makeCard(order, "🐾", "Tidy Pets", function()
			task.spawn(function()
				local ok, message = Net.Invoke("BaseArrange")
				if ok then
					Lib.PlaySound("Reward")
					if Build.HUD then
						Build.HUD.Toast(T("🐾 Pedestals lined up neatly!"), C.Green)
					end
				elseif type(message) == "string" and Build.HUD then
					Build.HUD.Toast(message, C.Red)
				end
			end)
		end)
	)
	order += 1
	add(
		"Roof",
		makeCard(order, "🎨", "Roof Color", function()
			local data = State.Data
			local current = data and tonumber(data.Base.Roof) or 0
			task.spawn(function()
				if Net.Invoke("HouseRoof", (current + 1) % (#Config.Paint + 1)) then
					Lib.PlaySound("UI", 0.7, 0.2)
				end
			end)
		end)
	)
	order += 1
	add(
		"Name",
		makeCard(order, "✏️", "House Name", function()
			local data = State.Data
			renameBox.Text = data and data.Base.Name or ""
			renameCard.Visible = true
			renameBox:CaptureFocus()
		end)
	)
	for _, def in Config.HouseSkins do
		order += 1
		add(
			"Skin",
			makeCard(order, def.Icon, def.Name, function()
				local data = State.Data
				if not data then
					return
				end
				local owned = def.Id == "Auto" or data.Base.Skins[def.Id] == true
				if not owned and def.Product then
					Net.Fire("BuyProduct", def.Product)
					return
				end
				if not owned and def.Pass and not State.HasPass(def.Pass) then
					Upsell.Pass(def.Pass, true)
					return
				end
				task.spawn(function()
					local ok, message = Net.Invoke("HouseSkin", def.Id)
					if ok then
						Lib.PlaySound("Reward")
					elseif type(message) == "string" and Build.HUD then
						Build.HUD.Toast(message, C.Red)
					end
				end)
			end),
			def
		)
	end
	for _, def in Config.DecorSets do
		order += 1
		local names = {}
		for _, id in def.Items do
			local item = Config.Decor[id]
			table.insert(names, if item then item.Icon else "?")
		end
		local card = makeCard(order, def.Icon, def.Name, function()
			if Build.HUD then
				Build.HUD.Toast(
					T("%s: place %s for +%d%% base income", T(def.Name), table.concat(names, " "), math.floor(def.Bonus * 100 + 0.5)),
					C.Gold
				)
			end
		end)
		add("Set", card, def)
	end
	refreshHouse()
end

local function refreshCatalog()
	local level = houseLevel()
	for id, card in cards do
		local def = Config.Decor[id]
		local limit = itemLimit(id)
		card.Count.Text = if limit then string.format("%d/%d", DecorModel.Count(items(), id), limit) else ""
		if def.MinLevel and level < def.MinLevel then
			card.Price.Text = T("🔒 Lv.%d", def.MinLevel)
			card.Button.BackgroundColor3 = Color3.fromRGB(50, 50, 62)
		else
			card.Price.Text = priceText(id)
			card.Button.BackgroundColor3 = if canAfford(id) then C.Card else Color3.fromRGB(60, 40, 50)
		end
	end
	for id, button in tabButtons do
		button.BackgroundColor3 = if id == currentCategory then Color3.fromRGB(255, 160, 70) else C.Gray
	end
	if currentCategory == HOUSE_TAB then
		refreshHouse()
	end
end

local function buildCards()
	Lib.Clear(cardScroll)
	cards = {}
	houseCards = {}
	if currentCategory == HOUSE_TAB then
		buildHouseCards()
		refreshCatalog()
		return
	end
	for order, id in Config.DecorOrder do
		local def = Config.Decor[id]
		if def and def.Category == currentCategory then
			local card = makeCard(order, def.Icon, def.Name, function()
				if def.MinLevel and houseLevel() < def.MinLevel then
					if Build.HUD then
						Build.HUD.Toast(T("Upgrade your house to unlock this item!"), C.Red)
					end
					return
				end
				startPlacing(id, nil)
			end)
			card.Price.TextColor3 = if def.Gems then C.Gems else C.Coins
			cards[id] = card
		end
	end
	refreshCatalog()
end

local tabs = { { Id = HOUSE_TAB, Name = "House", Icon = "🏠" } }
for _, category in Config.DecorCategories do
	table.insert(tabs, category)
end
for order, category in tabs do
	local button = Lib.Button({
		Text = category.Icon .. " " .. T(category.Name),
		Color = C.Gray,
		Size = UDim2.fromOffset(92, 36),
		LayoutOrder = order,
		TextSize = 14,
		Parent = tabRow,
		OnClick = function()
			currentCategory = category.Id
			buildCards()
		end,
	})
	tabButtons[category.Id] = button
end

---------------------------------------------------------------------------
-- tapping in the world while building
---------------------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function tapAt(position: Vector3)
	local camera = workspace.CurrentCamera
	local plot = myPlot()
	local frame = plot and plotFrame(plot)
	if not camera or not plot or not frame then
		return
	end
	local ray = camera:ScreenPointToRay(position.X, position.Y)
	local ignore = { player.Character :: Instance }
	if ghost then
		table.insert(ignore, ghost)
	end
	local shell = plot:FindFirstChild("Shell")
	if shell then
		table.insert(ignore, shell)
	end
	rayParams.FilterDescendantsInstances = ignore
	local result = workspace:Raycast(ray.Origin, ray.Direction * 400, rayParams)
	if not result then
		return
	end
	-- tapped one of our decorations?
	local folder = plot:FindFirstChild("Items")
	local model = result.Instance:FindFirstAncestorOfClass("Model")
	if mode ~= "placing" and model and folder and model.Parent == folder then
		local uid = model:GetAttribute("Uid")
		if type(uid) == "number" then
			mode = "selected"
			selectItem(uid)
			refreshActions()
			Lib.PlaySound("UI")
		end
		return
	end
	local localPos = frame:PointToObjectSpace(result.Position)
	if mode == "placing" then
		snapGhost(localPos.X, localPos.Z)
	elseif mode == "selected" then
		backToBrowse()
	end
end

local touches = {}
UserInputService.InputBegan:Connect(function(input, processed)
	if not State.BuildMode or processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		tapAt(input.Position)
	elseif input.UserInputType == Enum.UserInputType.Touch then
		touches[input] = { Start = input.Position, Time = os.clock(), Drag = false }
	end
end)
UserInputService.InputChanged:Connect(function(input)
	local touch = touches[input]
	if touch and (input.Position - touch.Start).Magnitude > 16 then
		touch.Drag = true
	end
end)
UserInputService.InputEnded:Connect(function(input)
	local touch = touches[input]
	touches[input] = nil
	if State.BuildMode and touch and not touch.Drag and os.clock() - touch.Time < 0.45 then
		tapAt(input.Position)
	end
end)

---------------------------------------------------------------------------
-- enter / exit (overview camera of the base)
---------------------------------------------------------------------------
local savedCameraType = Enum.CameraType.Custom

-- overview camera that fits the whole buildable land (it grows with the level)
function Build.Refocus()
	local plot = myPlot()
	local frame = plot and plotFrame(plot)
	local camera = workspace.CurrentCamera
	if not frame or not camera or not State.BuildMode then
		return
	end
	local bounds = DecorModel.Bounds(Config, houseLevel())
	local depth = bounds.MaxZ - bounds.MinZ
	local width = bounds.MaxX - bounds.MinX
	local size = math.max(depth, width * 0.8)
	local centerZ = (bounds.MinZ + bounds.MaxZ) / 2
	local eye = frame * CFrame.new(0, 18 + size * 1.05, centerZ - 16 - size * 0.8)
	local target = frame * CFrame.new(0, 0, centerZ + 2)
	TweenService:Create(camera, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {
		CFrame = CFrame.lookAt(eye.Position, target.Position),
	}):Play()
end

function Build.Enter()
	if State.BuildMode or player:GetAttribute("Carrying") then
		return
	end
	local plot = myPlot()
	local frame = plot and plotFrame(plot)
	if not frame then
		return
	end
	State.BuildMode = true
	entryButton.Visible = false
	screen.Visible = true
	local camera = workspace.CurrentCamera
	if camera then
		savedCameraType = camera.CameraType
		camera.CameraType = Enum.CameraType.Scriptable
	end
	Build.Refocus()
	Lib.PlaySound("UI")
	buildCards()
	backToBrowse()
end

function Build.Exit()
	if not State.BuildMode then
		return
	end
	State.BuildMode = false
	backToBrowse()
	renameCard.Visible = false
	screen.Visible = false
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = if savedCameraType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else savedCameraType
	end
end

-- leave build mode if we walk out / start carrying / respawn
player.CharacterAdded:Connect(function()
	Build.Exit()
end)

local accumulator = 0
RunService.Heartbeat:Connect(function(dt)
	accumulator += dt
	if accumulator < 0.3 then
		return
	end
	accumulator = 0
	local inside = insideMyPlot()
	local carrying = player:GetAttribute("Carrying") ~= nil
	entryButton.Visible = inside and not carrying and not State.BuildMode
	if State.BuildMode and (carrying or not myPlot()) then
		Build.Exit()
	end
end)

State.OnChanged(function()
	if State.BuildMode then
		refreshCatalog()
		if mode == "placing" then
			updateGhost()
		elseif mode == "selected" and selectedUid and not findItem(selectedUid) then
			backToBrowse()
		end
	end
end)

return Build
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">DevTools</string>
              <string name="Source"><![CDATA[--[[
	DEV buttons: visible in Studio, and for the game owner in live servers
	while Config.OwnerTestMode is on (so you can test from a phone).
	The server re-checks permission for every command (DevService).
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local Net = require(Client.Net)
local Lib = require(Client.UI.Lib)
local Root = require(Client.UI.Root)

local C = Lib.Colors

local function build()
	local cluster = Root.Cluster("Dev", Vector2.new(0, 1), UDim2.new(0, 12, 1, -12), UDim2.fromOffset(150, 540))
	local list = Lib.New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -40), Visible = false, Parent = cluster }, {
		Lib.List(Enum.FillDirection.Vertical, 4, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom),
	})
	for order, command in
		{
			"Coins",
			"Gems",
			"Level",
			"Star",
			"Shard",
			"Huge",
			"Titanic",
			"House",
			"Lucky",
			"Party",
			"Event",
			"Raid",
			"Meteor",
			"Golden",
			"Reset",
		}
	do
		Lib.Button({
			Text = command,
			Color = if command == "Reset" then C.Red else C.Gray,
			Size = UDim2.fromOffset(140, 30),
			LayoutOrder = order,
			TextSize = 16,
			Parent = list,
			OnClick = function()
				Net.Fire("Dev", command)
			end,
		})
	end
	Lib.Button({
		Text = "🛠 DEV",
		Color = Color3.fromRGB(60, 60, 70),
		Size = UDim2.fromOffset(100, 34),
		Position = UDim2.new(0, 0, 1, -34),
		TextSize = 16,
		Parent = cluster,
		OnClick = function()
			list.Visible = not list.Visible
		end,
	})
end

-- Util.CanTest may do a web call (group rank), so check off the main thread
task.spawn(function()
	if Util.CanTest(Config, Players.LocalPlayer) then
		build()
	end
end)

return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Guide</string>
              <string name="Source"><![CDATA[--[[
	Guide: a glowing beam from your character to the next thing to do -
	your tutorial meteor, the star egg, home, and for everyone: the meteor
	of this round while it is falling / being smashed. The first minutes
	decide whether a player comes back (D1 retention), so never leave them
	wondering what to do. Turns itself off once the player is established.
]]
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local State = require(Client.State)
local Lib = require(Client.UI.Lib)

local player = Players.LocalPlayer
local T = Lib.T

local MAX_LEVEL = 8 -- guide disappears after this level / zone 3
local PICKAXE_SHOP = Vector3.new(56, 4, -45)
local MINE_ENTRANCE = Vector3.new(0, 4, Config.World.Layout.FirstZ + 10)

-- local-only marker part the beam points at
local marker = Instance.new("Part")
marker.Name = "GuideMarker"
marker.Anchored = true
marker.CanCollide = false
marker.CanQuery = false
marker.CanTouch = false
marker.Transparency = 1
marker.Size = Vector3.one
marker.Parent = workspace
local targetAttachment = Instance.new("Attachment")
targetAttachment.Parent = marker

local beam = Instance.new("Beam")
beam.Attachment1 = targetAttachment
beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
beam.TextureMode = Enum.TextureMode.Wrap
beam.TextureLength = 3
beam.TextureSpeed = 2
beam.Color = ColorSequence.new(Color3.fromRGB(255, 230, 120), Color3.fromRGB(255, 160, 60))
beam.LightEmission = 1
beam.Width0 = 1.6
beam.Width1 = 1.6
beam.FaceCamera = true
beam.Segments = 20
beam.Transparency = NumberSequence.new(0.1, 0.4)
beam.Enabled = false
beam.Parent = marker

local billboard = Lib.New("BillboardGui", {
	-- studs, not pixels: a small sign near you, never a giant banner over the HUD
	Size = UDim2.new(9, 0, 2.6, 0),
	StudsOffsetWorldSpace = Vector3.new(0, 5, 0),
	AlwaysOnTop = true,
	MaxDistance = 160,
	Adornee = marker,
	Enabled = false,
	ResetOnSpawn = false,
	Parent = player:WaitForChild("PlayerGui"),
})
local label = Lib.Text({
	Text = "",
	TextColor3 = Color3.fromRGB(255, 230, 120),
	Size = UDim2.fromScale(1, 0.55),
	MaxTextSize = 22,
	Parent = billboard,
})
local arrow = Lib.Text({
	Text = "⬇",
	TextColor3 = Color3.fromRGB(255, 230, 120),
	Size = UDim2.fromScale(1, 0.45),
	Position = UDim2.fromScale(0, 0.55),
	MaxTextSize = 30,
	Parent = billboard,
})

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function part(path: { string }): BasePart?
	local node: Instance? = workspace:FindFirstChild("Map")
	for _, name in path do
		node = node and node:FindFirstChild(name)
	end
	return if node and node:IsA("BasePart") then node else nil
end

local function nearestOre(root: BasePart, maxZone: number): Vector3?
	local map = workspace:FindFirstChild("Map")
	local ores = map and map:FindFirstChild("Ores")
	if not ores then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for _, ore in ores:GetChildren() do
		if ore:IsA("BasePart") and (ore:GetAttribute("Zone") or 99) <= maxZone then
			local distance = (ore.Position - root.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = ore, distance
			end
		end
	end
	return best and best.Position + Vector3.new(0, 2.5, 0)
end

-- "go mine": the nearest ore when in a mine, else the mine entrance
local function mineTarget(root: BasePart, data)
	if Util.ZoneAt(Config, root.Position) ~= 0 then
		local ore = nearestOre(root, data.ZoneLevel)
		if ore then
			return ore, T("⛏️ TAP ORE TO MINE")
		end
	end
	return MINE_ENTRANCE, T("⛏️ MINE ORE HERE")
end

-- your base's entrance (collect pad)
local function baseTarget()
	local index = player:GetAttribute("BaseIndex")
	local pad = index and part({ "Bases", "Plot_" .. tostring(index), "CollectPad" })
	return pad and pad.Position + Vector3.new(0, 1, 0)
end

-- the closest shard lying around in a place we can reach
local function shardTarget(root: BasePart, data)
	local map = workspace:FindFirstChild("Map")
	local folder = map and map:FindFirstChild("Shards")
	if not folder then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for _, model in folder:GetChildren() do
		local hitbox = model:FindFirstChild("Hitbox")
		if hitbox and hitbox:IsA("BasePart") then
			local zone = Util.ZoneAt(Config, hitbox.Position)
			if zone ~= nil and zone <= data.ZoneLevel then
				local distance = (hitbox.Position - root.Position).Magnitude
				if distance < bestDistance then
					best, bestDistance = hitbox, distance
				end
			end
		end
	end
	return best and best.Position
end

-- ☄️ the meteor of this round (warning marker or the meteor itself), if we can get there
local function meteorTarget(root: BasePart, data)
	local state = workspace:GetAttribute("MeteorState")
	if state ~= "Warning" and state ~= "Falling" and state ~= "Active" then
		return nil
	end
	local site = workspace:GetAttribute("MeteorSiteZone") or 0
	if site > (data.ZoneLevel or 1) then
		return nil -- (a zone we haven't unlocked)
	end
	local position = workspace:GetAttribute("MeteorPos")
	if typeof(position) ~= "Vector3" then
		return nil
	end
	local radius = workspace:GetAttribute("MeteorRadius") or Config.Meteor.Radius
	if flat(position - root.Position).Magnitude <= radius + 12 then
		return nil -- we're there: just hit it
	end
	return position + Vector3.new(0, radius + 2, 0), if state == "Active" then T("☄️ SMASH IT!") else T("☄️ METEOR HERE!")
end

-- the new player's own tutorial meteor
local function tutorialMeteor()
	local map = workspace:FindFirstChild("Map")
	local drops = map and map:FindFirstChild("Drops")
	local meteor = drops and drops:FindFirstChild("TutorialMeteor_" .. tostring(player.UserId))
	return if meteor and meteor:IsA("BasePart") then meteor.Position + Vector3.new(0, 3, 0) else nil
end

-- returns target position + label, or nil when the player needs no help
local function pickTarget(root: BasePart)
	local data, derived = State.Data, State.Derived
	if not data or not derived then
		return nil
	end
	if player:GetAttribute("Carrying") then
		local home = baseTarget()
		if home then
			return home, T("🏠 RUN HOME!")
		end
	end
	local tutorial = data.Tutorial
	local step = tutorial and not tutorial.Done and Config.Tutorial.Steps[tutorial.Step]
	local id = step and step.Id
	if id == "Meteor" then
		local meteor = tutorialMeteor()
		if meteor then
			return meteor, T("☄️ SMASH IT!")
		end
		return nil
	elseif id == "Grab" or id == "Shard" then
		local shard = shardTarget(root, data)
		if shard then
			return shard, T("🥚 GRAB THE STAR EGG")
		end
	end
	local meteorAt, meteorText = meteorTarget(root, data)
	if meteorAt then
		return meteorAt, meteorText
	end
	if step then
		local nextPick = Config.Pickaxes[(data.PickaxeTier or 1) + 1]
		if id == "Pickaxe" and nextPick and data.Coins >= nextPick.Cost then
			return PICKAXE_SHOP, T("⛏️ BUY A PICKAXE")
		elseif id == "Hatch" and data.Coins >= Config.Eggs.Meadow.Price then
			local egg = part({ "Hub", "Eggs", "MeadowEgg" })
			return egg and egg.Position, T("🥚 HATCH HERE")
		end
		return mineTarget(root, data)
	end
	local shard = shardTarget(root, data)
	if shard then
		return shard, T("🥚 GRAB THE STAR EGG")
	end
	if (data.Level or 1) >= MAX_LEVEL or data.ZoneLevel >= 3 then
		return nil
	end
	local zone = Config.Zones[data.ZoneLevel + 1]
	if zone and data.Coins >= zone.Cost then
		local gate = part({ "Gates", "Gate_" .. (data.ZoneLevel + 1) })
		return gate and gate.Position, T("🔓 UNLOCK %s", zone.Name)
	end
	if Util.ZoneAt(Config, root.Position) == 0 then
		return MINE_ENTRANCE, T("⛏️ MINE ORE HERE")
	end
	return nil
end

local rootAttachment: Attachment? = nil
local function attachTo(character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root then
		local attachment = Instance.new("Attachment")
		attachment.Name = "GuideAttachment"
		attachment.Parent = root
		rootAttachment = attachment
		beam.Attachment0 = attachment
	end
end
player.CharacterAdded:Connect(attachTo)
if player.Character then
	task.spawn(attachTo, player.Character)
end

local accumulator = 0
RunService.Heartbeat:Connect(function(dt)
	arrow.Position = UDim2.fromScale(0, 0.55 + math.sin(os.clock() * 5) * 0.06)
	accumulator += dt
	if accumulator < 0.4 then
		return
	end
	accumulator = 0
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart
	if not root or not rootAttachment then
		beam.Enabled = false
		billboard.Enabled = false
		return
	end
	local ok, position, text = pcall(pickTarget, root)
	if not ok or not position then
		beam.Enabled = false
		billboard.Enabled = false
		return
	end
	marker.Position = position
	label.Text = text
	beam.Enabled = true
	billboard.Enabled = true
end)

return {}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">HUD</string>
              <string name="Source"><![CDATA[--[[
	Main HUD - designed for phones first and to reveal things gradually:
	  * objective: top center during the tutorial, then a small card in the
	    right column (nothing big in the middle of the screen)
	  * top left: money, level, and a menu that grows with progress
	  * right: server event, boosts, your rank in this server
	  * bottom: auto mine / starter pack (after tutorial)
	Plus toasts, announcements and celebrations (level up, rank up, tutorial).
]]
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Client = script.Parent.Parent
local Net = require(Client.Net)
local State = require(Client.State)
local Lib = require(Client.UI.Lib)
local Root = require(Client.UI.Root)
local Panels = require(Client.UI.Panels)
local Upsell = require(Client.UI.Upsell)

local New, C, T = Lib.New, Lib.Colors, Lib.T
local HUD = {}
local player = Players.LocalPlayer

local DARK = Color3.fromRGB(20, 22, 34)

---------------------------------------------------------------------------
-- toasts & announcements
---------------------------------------------------------------------------
local toastCluster = Root.Cluster("Toasts", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 110), UDim2.fromOffset(480, 130), Root.Overlay)
toastCluster.ZIndex = 40
Lib.List(Enum.FillDirection.Vertical, 6).Parent = toastCluster

local toastOrder = 0
function HUD.Toast(text: string, color: Color3?)
	toastOrder += 1
	if color == C.Red then
		Lib.PlaySound("Error")
	end
	local toast = New("Frame", {
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.15,
		Size = UDim2.fromOffset(470, 36),
		LayoutOrder = toastOrder,
		ZIndex = 40,
		Parent = toastCluster,
	}, { Lib.Corner(12), Lib.Stroke(color or C.Blue, 2, 0.2) })
	Lib.Text({
		Text = text,
		TextColor3 = color or C.Text,
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromOffset(8, 4),
		MaxTextSize = 18,
		ZIndex = 41,
		Parent = toast,
	})
	Lib.Pop(toast)
	local toasts = {}
	for _, child in toastCluster:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 2 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
	task.delay(3, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

local bannerCluster = Root.Cluster("Banner", Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 56), UDim2.fromOffset(680, 44))
bannerCluster.ZIndex = 45
local banner = New("Frame", {
	BackgroundColor3 = Color3.fromRGB(15, 15, 25),
	BackgroundTransparency = 0.1,
	Size = UDim2.fromScale(1, 1),
	Visible = false,
	ZIndex = 45,
	Parent = bannerCluster,
}, { Lib.Corner(16), Lib.Stroke(C.Gold, 3, 0) })
local bannerText = Lib.Text({
	Text = "",
	Size = UDim2.new(1, -20, 1, -10),
	Position = UDim2.fromOffset(10, 5),
	MaxTextSize = 22,
	ZIndex = 46,
	Parent = banner,
})
local bannerQueue = {}
local bannerBusy = false

function HUD.Announce(text: string, color: Color3?)
	if #bannerQueue >= 3 then
		table.remove(bannerQueue, 1) -- never fall minutes behind
	end
	table.insert(bannerQueue, { Text = text, Color = color or C.Gold })
	if bannerBusy then
		return
	end
	bannerBusy = true
	task.spawn(function()
		while #bannerQueue > 0 do
			local item = table.remove(bannerQueue, 1)
			bannerText.Text = item.Text
			bannerText.TextColor3 = item.Color
			banner:FindFirstChildOfClass("UIStroke").Color = item.Color
			banner.Visible = true
			Lib.Pop(banner)
			task.wait(if #bannerQueue > 2 then 2 else 3.2)
		end
		banner.Visible = false
		bannerBusy = false
	end)
end

