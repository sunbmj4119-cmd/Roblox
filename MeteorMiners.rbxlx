	{ "Store", "🛒", "Store", Color3.fromRGB(60, 200, 110), tutorialDone },
	{
		"Settings",
		"⚙️",
		"Settings",
		C.Gray,
		function()
			return true
		end,
	},
}
local menuButtons = {}
