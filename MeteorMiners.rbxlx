		{ Name = "Meadow Meteor", Icon = "🌿", Egg = "Meadow", Color = Color3.fromRGB(120, 220, 110) },
		{ Name = "Frost Meteor", Icon = "❄️", Egg = "Frost", Color = Color3.fromRGB(130, 200, 255) },
